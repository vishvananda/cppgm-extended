declare function @operatornew__(%arg0 : i64) -> ptr [role=allocate_memory, binding=strong, object=cppgm_builtin_operator_new_array]
declare function @operatordelete__(%arg0 : ptr) -> void [unwind=no, role=free_memory, binding=strong, object=cppgm_builtin_operator_delete_array]

function @count() -> u32 [binding=strong, object=_Z5countv] {
  block ^entry:
    return u32 3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $buckets : ptr
  slot $ok : i32
  slot $cond__1 : i32

  block ^entry:
    %t1 = call u32 @count()
    %t2 = convert zext i64 u32 %t1
    %t3 = binary mul i64 %t2, 16
    %t4 = call ptr @operatornew__(%t3)
    store typed ptr %t4, $buckets
    %t5 = load typed ptr $buckets
    %t6 = load typed ptr $buckets
    %t7 = binary mul i64 1, 16
    %t8 = index i8 [projection=array_element] %t6, %t7
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = index i8 [projection=field] %t9, 0
    store typed ptr %t5, %t10
    %t11 = load typed ptr $buckets
    %t12 = binary mul i64 1, 16
    %t13 = index i8 [projection=array_element] %t11, %t12
    %t14 = index i8 [projection=field] %t13, 0
    %t15 = index i8 [projection=field] %t14, 0
    %t16 = load typed ptr %t15
    %t17 = load typed ptr $buckets
    %t18 = cmp eq ptr %t16, %t17
    %t19 = convert trunc i32 i64 %t18
    store typed i32 %t19, $ok
    %t20 = load typed ptr $buckets
    call void @operatordelete__(%t20)
    %t21 = load typed i32 $ok
    branch %t21, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t22 = load typed i32 $cond__1
    return i32 %t22
}
