function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $src : obj<4x4>
  slot $dst : obj<4x4>
  slot $lhs : ptr
  slot $rhs : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $src
    %t2 = addr $dst
    %t3 = addr $src
    %t4 = index inbounds i8 [projection=field] %t3, 0
    store typed i32 305419896, %t4
    %t5 = addr $dst
    %t6 = index inbounds i8 [projection=field] %t5, 0
    store typed i32 2139062143, %t6
    %t7 = addr $dst
    %t8 = index i8 %t7, 0
    store typed ptr %t8, $lhs
    %t9 = addr $src
    %t10 = index i8 %t9, 0
    store typed ptr %t10, $rhs
    %t11 = load typed ptr $lhs
    %t12 = load typed ptr $rhs
    %t13 = addr $dst
    %t14 = index inbounds i8 [projection=field] %t13, 0
    %t15 = load typed i32 %t14
    %t16 = cmp eq i32 %t15, 2139062143
    branch %t16, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t17 = load typed i32 $cond__1
    return i32 %t17
}
