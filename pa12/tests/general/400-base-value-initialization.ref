global @buffer : obj<32x16> [binding=strong] = {
  zero 32
}

function @fill() -> void [binding=strong, object=_Z4fillv] {
  slot $i : u32

  block ^entry:
    store typed u32 0, $i
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = load typed u32 $i
    %t2 = const i64 32
    %t3 = convert zext i64 u32 %t1
    %t4 = cmp ult i64 %t3, %t2
    branch %t4, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t5 = addr @buffer
    %t6 = load typed u32 $i
    %t7 = index inbounds u8 [projection=array_element] %t5, %t6
    store u8 85, %t7
    jump ^for_iter_3

  block ^for_iter_3:
    %t8 = load typed u32 $i
    %t9 = binary add u32 %t8, 1
    store typed u32 %t9, $i
    jump ^for_cond_1

  block ^for_end_4:
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $built : ptr
  slot $aggregate : ptr

  block ^entry:
    call void @fill()
    %t1 = convert sext i64 i32 12
    %t2 = addr @buffer
    call void @Builds__Builds(%t2)
    store typed ptr %t2, $built
    %t3 = load typed ptr $built
    %t4 = index i8 %t3, 0
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    %t7 = cmp ne i32 %t6, 0
    branch %t7, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t8 = load typed ptr $built
    %t9 = index i8 %t8, 0
    %t10 = index i8 [projection=field] %t9, 4
    %t11 = load i8 %t10
    %t12 = convert sext i32 i8 %t11
    %t13 = cmp ne i32 %t12, 0
    branch %t13, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t14 = load typed ptr $built
    %t15 = index i8 [projection=field] %t14, 8
    %t16 = load i8 %t15
    %t17 = convert sext i32 i8 %t16
    %t18 = cmp ne i32 %t17, 7
    branch %t18, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_5

  block ^if_end_5:
    call void @fill()
    %t19 = convert sext i64 i32 12
    %t20 = addr @buffer
    call void @Aggregates__Aggregates(%t20)
    store typed ptr %t20, $aggregate
    %t21 = load typed ptr $aggregate
    %t22 = index i8 %t21, 0
    %t23 = index i8 [projection=field] %t22, 0
    %t24 = load typed i32 %t23
    %t25 = cmp ne i32 %t24, 0
    branch %t25, ^if_then_6, ^lor_rhs_9

  block ^lor_rhs_9:
    %t26 = load typed ptr $aggregate
    %t27 = index i8 %t26, 0
    %t28 = index i8 [projection=field] %t27, 4
    %t29 = load typed i32 %t28
    %t30 = cmp ne i32 %t29, 0
    branch %t30, ^if_then_6, ^lor_rhs_8

  block ^lor_rhs_8:
    %t31 = load typed ptr $aggregate
    %t32 = index i8 [projection=field] %t31, 8
    %t33 = load typed i32 %t32
    %t34 = cmp ne i32 %t33, 8
    branch %t34, ^if_then_6, ^if_else_7

  block ^if_then_6:
    return i32 2

  block ^if_else_7:
    jump ^if_end_10

  block ^if_end_10:
    return i32 0
}
function @Builds__Builds(%this : ptr [object_bytes=12]) -> void [binding=weak, object=_ZN6BuildsC1Ev, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 %t1, 0
    zeroinit 8x4 %t2
    %t3 = load typed ptr $this
    %t4 = index i8 [projection=field] %t3, 8
    store i8 7, %t4
    return void
}
function @Aggregates__Aggregates(%this : ptr [object_bytes=12]) -> void [binding=weak, object=_ZN10AggregatesC1Ev, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index i8 %t1, 0
    zeroinit 8x4 %t2
    %t3 = load typed ptr $this
    %t4 = index i8 [projection=field] %t3, 8
    store typed i32 8, %t4
    return void
}
alias object _ZN6BuildsC2Ev = @Builds__Builds
alias object _ZN10AggregatesC2Ev = @Aggregates__Aggregates
