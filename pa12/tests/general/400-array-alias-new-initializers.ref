declare function @__cppgm_builtin_memset(%arg0 : ptr, %arg1 : i32, %arg2 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_memset]
declare function @operatornew__(%arg0 : i64) -> ptr [role=allocate_memory, binding=strong, object=cppgm_builtin_operator_new_array]
declare function @operatordelete__(%arg0 : ptr) -> void [unwind=no, role=free_memory, binding=strong, object=cppgm_builtin_operator_delete_array]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $p : ptr
  slot $q : ptr
  slot $matrix : ptr
  slot $explicit_count : ptr

  block ^entry:
    %t1 = call ptr @operatornew__(12)
    %t2 = call ptr @__cppgm_builtin_memset(%t1, 0, 12)
    store typed ptr %t1, $p
    %t3 = load typed ptr $p
    %t4 = index i32 [projection=array_element] %t3, 0
    %t5 = load typed i32 %t4
    branch %t5, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t6 = load typed ptr $p
    %t7 = index i32 [projection=array_element] %t6, 1
    %t8 = load typed i32 %t7
    branch %t8, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t9 = load typed ptr $p
    %t10 = index i32 [projection=array_element] %t9, 2
    %t11 = load typed i32 %t10
    branch %t11, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_5

  block ^if_end_5:
    %t12 = load typed ptr $p
    call void @operatordelete__(%t12)
    %t13 = call ptr @operatornew__(12)
    %t14 = index i32 [projection=array_element] %t13, 0
    store typed i32 4, %t14
    %t15 = index i32 [projection=array_element] %t13, 1
    store typed i32 5, %t15
    %t16 = index i8 %t13, 8
    %t17 = binary sub i64 12, 8
    %t18 = call ptr @__cppgm_builtin_memset(%t16, 0, %t17)
    store typed ptr %t13, $q
    %t19 = load typed ptr $q
    %t20 = index i32 [projection=array_element] %t19, 0
    %t21 = load typed i32 %t20
    %t22 = cmp ne i32 %t21, 4
    branch %t22, ^if_then_6, ^lor_rhs_9

  block ^lor_rhs_9:
    %t23 = load typed ptr $q
    %t24 = index i32 [projection=array_element] %t23, 1
    %t25 = load typed i32 %t24
    %t26 = cmp ne i32 %t25, 5
    branch %t26, ^if_then_6, ^lor_rhs_8

  block ^lor_rhs_8:
    %t27 = load typed ptr $q
    %t28 = index i32 [projection=array_element] %t27, 2
    %t29 = load typed i32 %t28
    branch %t29, ^if_then_6, ^if_else_7

  block ^if_then_6:
    return i32 2

  block ^if_else_7:
    jump ^if_end_10

  block ^if_end_10:
    %t30 = load typed ptr $q
    call void @operatordelete__(%t30)
    %t31 = call ptr @operatornew__(24)
    %t32 = index obj<12x4> [projection=array_element] %t31, 0
    %t33 = index i32 [projection=array_element] %t32, 0
    store typed i32 1, %t33
    %t34 = index obj<12x4> [projection=array_element] %t31, 0
    %t35 = index i32 [projection=array_element] %t34, 1
    store typed i32 2, %t35
    %t36 = index obj<12x4> [projection=array_element] %t31, 0
    %t37 = index i32 [projection=array_element] %t36, 2
    store typed i32 3, %t37
    %t38 = index obj<12x4> [projection=array_element] %t31, 1
    %t39 = index i32 [projection=array_element] %t38, 0
    store typed i32 4, %t39
    %t40 = index obj<12x4> [projection=array_element] %t31, 1
    %t41 = index i32 [projection=array_element] %t40, 1
    store typed i32 5, %t41
    %t42 = index obj<12x4> [projection=array_element] %t31, 1
    %t43 = index i32 [projection=array_element] %t42, 2
    store typed i32 6, %t43
    %t44 = index i8 %t31, 24
    store typed ptr %t31, $matrix
    %t45 = load typed ptr $matrix
    %t46 = binary mul i64 0, 12
    %t47 = index i8 [projection=array_element] %t45, %t46
    %t48 = index i32 [projection=array_element] %t47, 2
    %t49 = load typed i32 %t48
    %t50 = cmp ne i32 %t49, 3
    branch %t50, ^if_then_11, ^lor_rhs_13

  block ^lor_rhs_13:
    %t51 = load typed ptr $matrix
    %t52 = binary mul i64 1, 12
    %t53 = index i8 [projection=array_element] %t51, %t52
    %t54 = index i32 [projection=array_element] %t53, 2
    %t55 = load typed i32 %t54
    %t56 = cmp ne i32 %t55, 6
    branch %t56, ^if_then_11, ^if_else_12

  block ^if_then_11:
    return i32 3

  block ^if_else_12:
    jump ^if_end_14

  block ^if_end_14:
    %t57 = load typed ptr $matrix
    call void @operatordelete__(%t57)
    %t58 = call ptr @operatornew__(24)
    %t59 = call ptr @__cppgm_builtin_memset(%t58, 0, 24)
    store typed ptr %t58, $explicit_count
    %t60 = load typed ptr $explicit_count
    %t61 = binary mul i64 1, 12
    %t62 = index i8 [projection=array_element] %t60, %t61
    %t63 = index i32 [projection=array_element] %t62, 2
    store typed i32 42, %t63
    %t64 = load typed ptr $explicit_count
    %t65 = binary mul i64 0, 12
    %t66 = index i8 [projection=array_element] %t64, %t65
    %t67 = index i32 [projection=array_element] %t66, 2
    %t68 = load typed i32 %t67
    branch %t68, ^if_then_15, ^lor_rhs_17

  block ^lor_rhs_17:
    %t69 = load typed ptr $explicit_count
    %t70 = binary mul i64 1, 12
    %t71 = index i8 [projection=array_element] %t69, %t70
    %t72 = index i32 [projection=array_element] %t71, 2
    %t73 = load typed i32 %t72
    %t74 = cmp ne i32 %t73, 42
    branch %t74, ^if_then_15, ^if_else_16

  block ^if_then_15:
    return i32 4

  block ^if_else_16:
    jump ^if_end_18

  block ^if_end_18:
    %t75 = load typed ptr $explicit_count
    call void @operatordelete__(%t75)
    return i32 0
}
