function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @run(5)
    %t2 = cmp eq i32 %t1, 5
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @run(%value : i32) -> i32 [binding=weak, object=_Z3runIiEiT_] {
  slot $value : i32
  slot $local : obj<4x4>

  block ^entry:
    store i32 %value, $value
    %t1 = addr $local
    %t2 = load i32 $value
    %t3 = call i32 @helper__id(%t2)
    call void @holder__holder(%t1, %t3)
    %t4 = addr $local
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    return i32 %t6
}
function @helper__id(%value : i32) -> i32 [binding=weak, object=_ZN6helper2idIiEEiT_] {
  slot $value : i32

  block ^entry:
    store i32 %value, $value
    %t1 = load i32 $value
    return i32 %t1
}
function @holder__holder(%this : ptr, %v : i32) -> void [binding=weak, object=_ZN6holderC1Ei] {
  slot $this : ptr
  slot $v : i32

  block ^entry:
    store ptr %this, $this
    store i32 %v, $v
    %t1 = load i32 $v
    %t2 = load ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store i32 %t1, %t3
    return void
}
alias object _ZN6holderC2Ei = @holder__holder
