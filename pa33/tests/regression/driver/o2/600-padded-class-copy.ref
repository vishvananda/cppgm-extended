function @move(%to : ptr, %from : ptr) -> void [binding=strong, object=_Z4moveP7OperandPKS_] {
  block ^entry:
    copyobj 8x4 %from, %to
    return void
}
function @move__ov2(%to : ptr, %from : ptr) -> void [binding=strong, object=_Z4moveP4PairPKS_] {
  block ^entry:
    %t1 = load i64 %from
    store i64 %t1, %to
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    return i32 0
}
