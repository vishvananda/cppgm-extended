global @data [binding=internal, object=_ZL4data] = {
  zero 1000
}
global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  u32 1
  u32 2
  u32 3
  u32 4
  u32 5
  u32 6
  u32 7
  u32 8
}

function @digest(%n : i64) -> u32 [binding=internal, object=_ZL6digestm, no_inline=yes] {
  slot $hashes : obj<32x4>

  block ^entry:
    %t1 = addr $hashes
    copyobj 32x4 @__constexpr_template__1, %t1
    branch %n, ^loop_preheader_1, ^unrolled_7

  block ^loop_preheader_1:
    %t2 = cmp uge i64 %n, 8
    %t3 = addr @data
    branch %t2, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i64 %n, -8
    %t5 = load v128 %t1
    %t6 = index i8 %t1, 16
    %t7 = load v128 %t6
    %t8 = vector pzero
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t9 = phi v128 [^loop_preheader_2: %t7, ^wide_loop_3: %t36]
    %t10 = phi v128 [^loop_preheader_2: %t5, ^wide_loop_3: %t23]
    %t11 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t37]
    %t12 = vector pslldi %t10, 5
    %t13 = vector paddd %t10, %t12
    %t14 = index inbounds u8 [projection=array_element] %t3, %t11
    %t15 = load i32 %t14
    %t16 = vector fromi32 %t15
    %t17 = vector punpcklbw %t16, %t8
    %t18 = vector punpcklwd %t17, %t8
    %t19 = vector paddd %t13, %t18
    %t20 = vector pslldi %t19, 10
    %t21 = vector paddd %t19, %t20
    %t22 = vector psrldi %t19, 6
    %t23 = vector pxor %t21, %t22
    %t24 = binary add nowrap i64 %t11, 4
    %t25 = vector pslldi %t9, 5
    %t26 = vector paddd %t9, %t25
    %t27 = index inbounds u8 [projection=array_element] %t3, %t24
    %t28 = load i32 %t27
    %t29 = vector fromi32 %t28
    %t30 = vector punpcklbw %t29, %t8
    %t31 = vector punpcklwd %t30, %t8
    %t32 = vector paddd %t26, %t31
    %t33 = vector pslldi %t32, 10
    %t34 = vector paddd %t32, %t33
    %t35 = vector psrldi %t32, 6
    %t36 = vector pxor %t34, %t35
    %t37 = binary add nowrap i64 %t11, 8
    %t38 = cmp ule i64 %t37, %t4
    branch %t38, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t39 = index i8 %t1, 16
    store v128 %t23, %t1
    store v128 %t36, %t39
    %t40 = cmp ult i64 %t37, %n
    branch %t40, ^loop_preheader_5, ^unrolled_7

  block ^loop_preheader_5:
    %t41 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t37]
    jump ^for_body_6

  block ^for_body_6:
    %t42 = phi i64 [^for_body_6: %t56, ^loop_preheader_5: %t41]
    %t43 = binary umod i64 %t42, 8
    %t44 = index inbounds u32 [projection=array_element] %t1, %t43
    %t45 = load typed u32 %t44
    %t46 = binary shl u32 %t45, 5
    %t47 = binary add u32 %t45, %t46
    %t48 = index inbounds u8 [projection=array_element] %t3, %t42
    %t49 = load u8 %t48
    %t50 = convert zext u32 u8 %t49
    %t51 = binary add u32 %t47, %t50
    %t52 = binary shl u32 %t51, 10
    %t53 = binary add u32 %t51, %t52
    %t54 = binary ushr u32 %t51, 6
    %t55 = binary xor u32 %t53, %t54
    store typed u32 %t55, %t44
    %t56 = binary add i64 %t42, 1
    %t57 = cmp ult i64 %t56, %n
    branch %t57, ^for_body_6, ^unrolled_7

  block ^unrolled_7:
    %t58 = load typed u32 %t1
    %t59 = binary mul u32 %t58, 31
    %t60 = index inbounds u32 [projection=array_element] %t1, 1
    %t61 = load typed u32 %t60
    %t62 = binary add u32 %t59, %t61
    %t63 = binary mul u32 %t62, 31
    %t64 = index inbounds u32 [projection=array_element] %t1, 2
    %t65 = load typed u32 %t64
    %t66 = binary add u32 %t63, %t65
    %t67 = binary mul u32 %t66, 31
    %t68 = index inbounds u32 [projection=array_element] %t1, 3
    %t69 = load typed u32 %t68
    %t70 = binary add u32 %t67, %t69
    %t71 = binary mul u32 %t70, 31
    %t72 = index inbounds u32 [projection=array_element] %t1, 4
    %t73 = load typed u32 %t72
    %t74 = binary add u32 %t71, %t73
    %t75 = binary mul u32 %t74, 31
    %t76 = index inbounds u32 [projection=array_element] %t1, 5
    %t77 = load typed u32 %t76
    %t78 = binary add u32 %t75, %t77
    %t79 = binary mul u32 %t78, 31
    %t80 = index inbounds u32 [projection=array_element] %t1, 6
    %t81 = load typed u32 %t80
    %t82 = binary add u32 %t79, %t81
    %t83 = binary mul u32 %t82, 31
    %t84 = index inbounds u32 [projection=array_element] %t1, 7
    %t85 = load typed u32 %t84
    %t86 = binary add u32 %t83, %t85
    return u32 %t86
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @data
    %t2 = vector fromi64 4294967296
    %t3 = vector fromi64 12884901890
    %t4 = vector punpcklqdq %t2, %t3
    %t5 = vector pzero
    %t6 = vector paddd %t5, %t4
    %t7 = vector fromi32 7
    %t8 = vector pshufd %t7, 0
    %t9 = vector fromi32 255
    %t10 = vector pshuflw %t9, 0
    %t11 = vector pshufd %t10, 0
    %t12 = vector fromi32 4
    %t13 = vector pshufd %t12, 0
    %t14 = vector psrlqi %t8, 32
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t15 = phi v128 [^entry: %t6, ^wide_loop_1: %t32]
    %t16 = phi i64 [^entry: 0, ^wide_loop_1: %t30]
    %t17 = vector pmuludq %t15, %t8
    %t18 = vector psrlqi %t15, 32
    %t19 = vector pmuludq %t18, %t14
    %t20 = vector pshufd %t17, 8
    %t21 = vector pshufd %t19, 8
    %t22 = vector punpckldq %t20, %t21
    %t23 = vector pslldi %t22, 16
    %t24 = vector psradi %t23, 16
    %t25 = vector packssdw %t24, %t24
    %t26 = vector pand %t25, %t11
    %t27 = vector packuswb %t26, %t26
    %t28 = index inbounds u8 [projection=array_element] %t1, %t16
    %t29 = vector toi32 %t27
    store i32 %t29, %t28
    %t30 = binary add nowrap i64 %t16, 4
    %t31 = convert trunc exact i32 i64 %t30
    %t32 = vector paddd %t15, %t13
    %t33 = cmp le i32 %t31, 996
    branch %t33, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t34 = cmp lt i32 %t31, 1000
    branch %t34, ^loop_preheader_3, ^for_end_5

  block ^loop_preheader_3:
    %t35 = binary mul i32 %t31, 7
    %t36 = convert sext i64 i32 %t31
    jump ^for_body_4

  block ^for_body_4:
    %t37 = phi i32 [^loop_preheader_3: %t35, ^for_body_4: %t43]
    %t38 = phi i64 [^for_body_4: %t41, ^loop_preheader_3: %t36]
    %t39 = convert trunc u8 i32 %t37
    %t40 = index inbounds u8 [projection=array_element] %t1, %t38
    store u8 %t39, %t40
    %t41 = binary add nowrap i64 %t38, 1
    %t42 = convert trunc exact i32 i64 %t41
    %t43 = binary add nowrap i32 %t37, 7
    %t44 = cmp lt i32 %t42, 1000
    branch %t44, ^for_body_4, ^for_end_5

  block ^for_end_5:
    %t45 = call u32 @digest(1000)
    %t46 = cmp eq u32 %t45, 911731218
    branch %t46, ^land_rhs_6, ^cond_else_8

  block ^land_rhs_6:
    %t47 = call u32 @digest(13)
    %t48 = cmp eq u32 %t47, 3500121845
    branch %t48, ^land_rhs_7, ^cond_else_8

  block ^land_rhs_7:
    %t49 = call u32 @digest(8)
    %t50 = cmp eq u32 %t49, 793687266
    branch %t50, ^cond_end_9, ^cond_else_8

  block ^cond_else_8:
    jump ^cond_end_9

  block ^cond_end_9:
    %t51 = phi i32 [^cond_else_8: 1, ^land_rhs_7: 0]
    return i32 %t51
}
