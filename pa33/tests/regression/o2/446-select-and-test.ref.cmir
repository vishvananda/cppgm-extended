machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pick
  abi
    param %x -> rdi : i64
    param %y -> rsi : i64
    param %a -> rdx : i64
    param %b -> rcx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.i64 rdi, rsi
    cmovne rcx, rdx
    ret rcx

function @bit
  abi
    param %x -> rdi : i32
    param %a -> rsi : i32
    param %b -> rdx : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.i32 rdi, 1024
    cmovne rdx, rsi
    ret rdx

function @shared
  abi
    param %x -> rdi : i64
    param %y -> rsi : i64
    param %a -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    and rdi, rsi
    mov <gpr0>, 7
    cmove rdx, <gpr0>
    add rdx, rdi
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov rdi, 6
    mov rsi, 3
    mov rdx, 10
    mov rcx, 20
    call @pick [args=(rcx,rdx,rsi,rdi)]
    mov <gpr1>, rax
    mov rdi, 4
    mov rsi, 3
    mov rdx, 10
    mov rcx, 20
    call @pick [args=(rcx,rdx,rsi,rdi)]
    mov <gpr2>, rax
    mov rdi, 1024
    mov rsi, 1
    mov rdx, 2
    call @bit [args=(rdx,rsi,rdi)]
    mov <gpr3>, rax
    mov rdi, 1023
    mov rsi, 1
    mov rdx, 2
    call @bit [args=(rdx,rsi,rdi)]
    mov <gpr4>, rax
    mov rdi, 6
    mov rsi, 3
    mov rdx, 100
    call @shared [args=(rdx,rsi,rdi)]
    add <gpr1>, <gpr2>
    add rax, <gpr1>
    imul.i32 <gpr3>, 10
    add.i32 <gpr3>, <gpr4>
    add.i32 rax, <gpr3>
    ret rax
