declare function @use(%p : ptr) -> void

function @sum_down(%n : i64, %total : i64) -> i64 [no_inline=yes] {
  block ^0:
    %t1 = binary and i64 %n, -8
    branch %t1, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t2 = binary sub i64 %n, %t1
    jump ^unrolled_2

  block ^unrolled_2:
    %t3 = phi i64 [^loop_preheader_1: %total, ^unrolled_2: %t20]
    %t4 = phi i64 [^loop_preheader_1: %n, ^unrolled_2: %t19]
    %t5 = binary sub i64 %t4, 1
    %t6 = binary add i64 %t3, %t4
    %t7 = binary sub i64 %t4, 2
    %t8 = binary add i64 %t5, %t6
    %t9 = binary sub i64 %t4, 3
    %t10 = binary add i64 %t7, %t8
    %t11 = binary sub i64 %t4, 4
    %t12 = binary add i64 %t9, %t10
    %t13 = binary sub i64 %t4, 5
    %t14 = binary add i64 %t11, %t12
    %t15 = binary sub i64 %t4, 6
    %t16 = binary add i64 %t13, %t14
    %t17 = binary sub i64 %t4, 7
    %t18 = binary add i64 %t15, %t16
    %t19 = binary sub i64 %t4, 8
    %t20 = binary add i64 %t17, %t18
    %t21 = cmp ne i64 %t2, %t19
    branch %t21, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t22 = phi i64 [^0: %total, ^unrolled_2: %t20]
    %t23 = phi i64 [^0: %n, ^unrolled_2: %t19]
    jump ^entry

  block ^entry:
    %t24 = phi i64 [^wide_tail_3: %t22, ^more: %t]
    %t25 = phi i64 [^wide_tail_3: %t23, ^more: %m]
    %c = cmp eq i64 %t25, 0
    branch %c, ^done, ^more

  block ^done:
    return i64 %t24

  block ^more:
    %t = binary add i64 %t24, %t25
    %m = binary sub i64 %t25, 1
    jump ^entry
}
function @step(%n : i32, %k : i32) -> i32 [no_inline=yes] {
  block ^0:
    jump ^entry

  block ^entry:
    %t1 = phi i32 [^0: %n, ^high: %m]
    %c = cmp gt i32 %t1, %k
    branch %c, ^high, ^out

  block ^high:
    %m = binary sub i32 %t1, %k
    jump ^entry

  block ^out:
    return i32 %t1
}
function @walk(%p : ptr, %n : i64) -> void [no_inline=yes] {
  block ^0:
    %t1 = binary and i64 %n, -8
    branch %t1, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t2 = binary sub i64 %n, %t1
    jump ^unrolled_2

  block ^unrolled_2:
    %t3 = phi i64 [^loop_preheader_1: %n, ^unrolled_2: %t11]
    store i64 %t3, %p
    %t4 = binary sub i64 %t3, 1
    store i64 %t4, %p
    %t5 = binary sub i64 %t3, 2
    store i64 %t5, %p
    %t6 = binary sub i64 %t3, 3
    store i64 %t6, %p
    %t7 = binary sub i64 %t3, 4
    store i64 %t7, %p
    %t8 = binary sub i64 %t3, 5
    store i64 %t8, %p
    %t9 = binary sub i64 %t3, 6
    store i64 %t9, %p
    %t10 = binary sub i64 %t3, 7
    store i64 %t10, %p
    %t11 = binary sub i64 %t3, 8
    %t12 = cmp ne i64 %t2, %t11
    branch %t12, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t13 = phi i64 [^0: %n, ^unrolled_2: %t11]
    jump ^entry

  block ^entry:
    %t14 = phi i64 [^wide_tail_3: %t13, ^more: %m]
    %c = cmp eq i64 %t14, 0
    branch %c, ^done, ^more

  block ^done:
    return void

  block ^more:
    store i64 %t14, %p
    %m = binary sub i64 %t14, 1
    jump ^entry
}
function @local(%n : i64) -> i64 [no_inline=yes] {
  slot $s : obj<16x8>

  block ^0:
    jump ^entry

  block ^entry:
    %t1 = phi i64 [^0: %n, ^more: %m]
    %a = addr $s
    %b = index i8 %a, 8
    store volatile i64 %t1, %b
    %v = load volatile i64 %b
    %c = cmp eq i64 %v, 0
    branch %c, ^done, ^more

  block ^done:
    return i64 0

  block ^more:
    %m = binary sub i64 %v, 1
    jump ^entry
}
function @escaping(%n : i64) -> i64 [no_inline=yes] {
  slot $s : obj<8x8>

  block ^entry:
    %a = addr $s
    store volatile i64 %n, %a
    call void @use(%a)
    %c = cmp eq i64 %n, 0
    branch %c, ^done, ^more

  block ^done:
    return i64 0

  block ^more:
    %m = binary sub i64 %n, 1
    %r = call i64 @escaping(%m)
    return i64 %r
}
function @after(%n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %c = cmp eq i64 %n, 0
    branch %c, ^done, ^more

  block ^done:
    return i64 1

  block ^more:
    %m = binary sub i64 %n, 1
    %r = call i64 @after(%m)
    %s = binary xor i64 %n, %r
    return i64 %s
}
