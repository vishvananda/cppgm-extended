function @rows(%base : ptr, %step : i32, %row : i32, %plane : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t2 = binary add i32 %row, %plane
    %t3 = binary and i32 %n, -4
    %t4 = cmp gt i32 %t3, 0
    branch %t4, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t5 = phi i32 [^unrolled_1: %t24, ^entry: 0]
    %t6 = phi i32 [^unrolled_1: %t23, ^entry: %t2]
    %t7 = phi i64 [^unrolled_1: %t22, ^entry: 0]
    %t8 = index f64 %base, %t6
    %t9 = load i64 %t8
    %t10 = binary add i64 %t7, %t9
    %t11 = binary add nowrap i32 %step, %t6
    %t12 = index f64 %base, %t11
    %t13 = load i64 %t12
    %t14 = binary add i64 %t10, %t13
    %t15 = binary add nowrap i32 %step, %t11
    %t16 = index f64 %base, %t15
    %t17 = load i64 %t16
    %t18 = binary add i64 %t14, %t17
    %t19 = binary add nowrap i32 %step, %t15
    %t20 = index f64 %base, %t19
    %t21 = load i64 %t20
    %t22 = binary add i64 %t18, %t21
    %t23 = binary add nowrap i32 %step, %t19
    %t24 = binary add nowrap i32 %t5, 4
    %t25 = cmp ne i32 %t3, %t24
    branch %t25, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t26 = cmp lt i32 %t24, %n
    branch %t26, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t27 = phi i32 [^entry: 0, ^loop_exit_2: %t24]
    %t28 = phi i32 [^entry: %t2, ^loop_exit_2: %t23]
    %t29 = phi i64 [^entry: 0, ^loop_exit_2: %t22]
    %t30 = convert sext i64 i32 %t28
    %t31 = convert sext i64 i32 %step
    jump ^body

  block ^body:
    %c = phi i32 [^wide_tail_3: %t27, ^body: %c1]
    %t33 = phi i64 [^wide_tail_3: %t30, ^body: %t38]
    %t = phi i64 [^wide_tail_3: %t29, ^body: %t1]
    %p = index f64 %base, %t33
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %t38 = binary add nowrap i64 %t33, %t31
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    %t41 = phi i64 [^body: %t1, ^loop_exit_2: %t22]
    return i64 %t41
}
function @wrapping(%base : ptr, %start : i32, %step : i32, %row : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t2 = binary add i32 %start, %row
    %t3 = binary and i32 %n, -4
    %t4 = cmp gt i32 %t3, 0
    branch %t4, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t5 = phi i32 [^unrolled_1: %t24, ^entry: 0]
    %t6 = phi i32 [^unrolled_1: %t23, ^entry: %t2]
    %t7 = phi i64 [^unrolled_1: %t22, ^entry: 0]
    %t8 = index f64 %base, %t6
    %t9 = load i64 %t8
    %t10 = binary add i64 %t7, %t9
    %t11 = binary add i32 %step, %t6
    %t12 = index f64 %base, %t11
    %t13 = load i64 %t12
    %t14 = binary add i64 %t10, %t13
    %t15 = binary add i32 %step, %t11
    %t16 = index f64 %base, %t15
    %t17 = load i64 %t16
    %t18 = binary add i64 %t14, %t17
    %t19 = binary add i32 %step, %t15
    %t20 = index f64 %base, %t19
    %t21 = load i64 %t20
    %t22 = binary add i64 %t18, %t21
    %t23 = binary add i32 %step, %t19
    %t24 = binary add nowrap i32 %t5, 4
    %t25 = cmp ne i32 %t3, %t24
    branch %t25, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t26 = cmp lt i32 %t24, %n
    branch %t26, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t27 = phi i32 [^entry: 0, ^loop_exit_2: %t24]
    %t28 = phi i32 [^entry: %t2, ^loop_exit_2: %t23]
    %t29 = phi i64 [^entry: 0, ^loop_exit_2: %t22]
    jump ^body

  block ^body:
    %c = phi i32 [^wide_tail_3: %t27, ^body: %c1]
    %at = phi i32 [^wide_tail_3: %t28, ^body: %at1]
    %t = phi i64 [^wide_tail_3: %t29, ^body: %t1]
    %p = index f64 %base, %at
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %at1 = binary add i32 %step, %at
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    %t39 = phi i64 [^body: %t1, ^loop_exit_2: %t22]
    return i64 %t39
}
function @read_after(%step : i64, %row : i64, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -8
    %t2 = cmp gt i64 %t1, 0
    branch %t2, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t13, ^entry: 0]
    %t4 = phi i64 [^unrolled_1: %t12, ^entry: %row]
    %t5 = binary add i64 %step, %t4
    %t6 = binary add i64 %step, %t5
    %t7 = binary add i64 %step, %t6
    %t8 = binary add i64 %step, %t7
    %t9 = binary add i64 %step, %t8
    %t10 = binary add i64 %step, %t9
    %t11 = binary add i64 %step, %t10
    %t12 = binary add i64 %step, %t11
    %t13 = binary add nowrap i64 %t3, 8
