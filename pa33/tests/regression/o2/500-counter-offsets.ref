    branch %t14, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t15 = cmp lt i64 %t13, %n
    branch %t15, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t16 = phi i64 [^entry: 0, ^loop_exit_2: %t13]
    %t17 = phi i64 [^entry: %row, ^loop_exit_2: %t12]
    jump ^body

  block ^body:
    %c = phi i64 [^wide_tail_3: %t16, ^body: %c1]
    %at = phi i64 [^wide_tail_3: %t17, ^body: %at1]
    %at1 = binary add i64 %step, %at
    %c1 = binary add nowrap i64 %c, 1
    %d = cmp lt i64 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    %t23 = phi i64 [^body: %at, ^loop_exit_2: %t11]
    return i64 %t23
}
function @some_passes(%base : ptr, %step : i32, %row : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %c = phi i32 [^entry: 0, ^tail: %c1]
    %at = phi i32 [^entry: %row, ^tail: %at1]
    %t = phi i64 [^entry: 0, ^tail: %t1]
    %odd = binary and i32 %c, 1
    branch %odd, ^read, ^tail

  block ^read:
    %p = index f64 %base, %at
    %v = load i64 %p
    %w = binary add i64 %t, %v
    jump ^tail

  block ^tail:
    %t1 = phi i64 [^body: %t, ^read: %w]
    %at1 = binary add i32 %step, %at
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @tested(%base : ptr, %row : i64, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %at = phi i64 [^entry: 0, ^body: %at1]
