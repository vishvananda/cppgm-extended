global @words : obj<64x4> = {
  zero 64
}

function @masked_sum(%mask : v128) -> v128 [binding=strong, no_inline=yes] {
  block ^entry:
    %base = addr @words
    %zero = vector pzero
    jump ^unrolled_1

  block ^unrolled_1:
    %t3 = phi v128 [^unrolled_1: %t20, ^entry: %zero]
    %t4 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t5 = index inbounds u32 [projection=array_element] %base, %t4
    %t6 = load v128 %t5
    %t7 = vector pand %t6, %mask
    %t8 = vector paddd %t3, %t7
    %t9 = index inbounds u32 [projection=array_element] %t5, 4
    %t10 = load v128 %t9
    %t11 = vector pand %t10, %mask
    %t12 = vector paddd %t8, %t11
    %t13 = index inbounds u32 [projection=array_element] %t5, 8
    %t14 = load v128 %t13
    %t15 = vector pand %t14, %mask
    %t16 = vector paddd %t12, %t15
    %t17 = index inbounds u32 [projection=array_element] %t5, 12
    %t18 = load v128 %t17
    %t19 = vector pand %t18, %mask
    %t20 = vector paddd %t16, %t19
    %t21 = binary add nowrap i64 %t4, 16
    %t22 = convert trunc exact u32 i64 %t21
    %t23 = cmp ne u32 %t22, 64
    branch %t23, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    return v128 %t20
}
function @narrow_counter(%mask : v128, %count : u32) -> v128 [binding=strong, no_inline=yes] {
  block ^entry:
    %base = addr @words
    %zero = vector pzero
    %t3 = binary and u32 %count, 4294967280
    branch %t3, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t4 = phi v128 [^unrolled_2: %t22, ^loop_preheader_1: %zero]
    %t5 = phi i64 [^unrolled_2: %t23, ^loop_preheader_1: 0]
    %t6 = copy i64 %t5
    %t7 = index inbounds i32 %base, %t6
    %t8 = load v128 %t7
    %t9 = vector pxor %t8, %mask
    %t10 = vector paddd %t4, %t9
    %t11 = index inbounds i32 %t7, 4
    %t12 = load v128 %t11
    %t13 = vector pxor %t12, %mask
    %t14 = vector paddd %t10, %t13
    %t15 = index inbounds i32 %t7, 8
    %t16 = load v128 %t15
    %t17 = vector pxor %t16, %mask
    %t18 = vector paddd %t14, %t17
    %t19 = index inbounds i32 %t7, 12
    %t20 = load v128 %t19
    %t21 = vector pxor %t20, %mask
    %t22 = vector paddd %t18, %t21
    %t23 = binary add nowrap i64 %t5, 16
    %t24 = convert trunc exact u32 i64 %t23
    %t25 = cmp ne u32 %t3, %t24
    branch %t25, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t26 = cmp ult u32 %t24, %count
    branch %t26, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t27 = phi v128 [^entry: %zero, ^loop_exit_3: %t22]
    %t28 = phi u32 [^entry: 0, ^loop_exit_3: %t24]
    %t29 = convert zext i64 u32 %t28
    jump ^loop

  block ^loop:
    %sum = phi v128 [^wide_tail_4: %t27, ^loop: %next_sum]
    %t31 = phi i64 [^wide_tail_4: %t29, ^loop: %t37]
    %wide = copy i64 %t31
    %at = index inbounds i32 %base, %wide
    %four = load v128 %at
    %kept = vector pxor %four, %mask
    %next_sum = vector paddd %sum, %kept
    %t37 = binary add nowrap i64 %t31, 4
    %next = convert trunc exact u32 i64 %t37
    %more = cmp ult u32 %next, %count
    branch %more, ^loop, ^done

  block ^done:
    %t40 = phi v128 [^loop: %next_sum, ^loop_exit_3: %t22]
    return v128 %t40
}
