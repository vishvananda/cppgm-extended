function @float_over_int(%p : ptr, %q : ptr, %v : f32) -> i32 [no_inline=yes] {
  block ^entry:
    %a = load typed i32 %p
    store typed f32 %v, %q
    %r = binary add i32 %a, %a
    return i32 %r
}
