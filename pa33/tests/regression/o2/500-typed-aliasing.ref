function @extent_leaves_loop(%p : ptr, %q : ptr, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 %p
    %t2 = binary and i64 %t1, -8
    branch %t2, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t3 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t19]
    %t4 = index i64 %q, %t3
    store typed f64 %v, %t4
    %t5 = binary add i64 %t3, 1
    %t6 = index i64 %q, %t5
    store typed f64 %v, %t6
    %t7 = binary add i64 %t3, 2
    %t8 = index i64 %q, %t7
    store typed f64 %v, %t8
    %t9 = binary add i64 %t3, 3
    %t10 = index i64 %q, %t9
    store typed f64 %v, %t10
    %t11 = binary add i64 %t3, 4
    %t12 = index i64 %q, %t11
    store typed f64 %v, %t12
    %t13 = binary add i64 %t3, 5
    %t14 = index i64 %q, %t13
    store typed f64 %v, %t14
    %t15 = binary add i64 %t3, 6
    %t16 = index i64 %q, %t15
    store typed f64 %v, %t16
    %t17 = binary add i64 %t3, 7
    %t18 = index i64 %q, %t17
    store typed f64 %v, %t18
    %t19 = binary add i64 %t3, 8
    %t20 = cmp ne i64 %t2, %t19
    branch %t20, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t21 = cmp ult i64 %t19, %t1
    branch %t21, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t22 = phi i64 [^entry: 0, ^loop_exit_3: %t19]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_4: %t22, ^head: %next]
    %at = index i64 %q, %i
    store typed f64 %v, %at
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %t1
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @extent_stays(%p : ptr, %q : ptr, %v : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %n = load typed i64 %p
    %at = index i64 %q, %i
    store typed i64 %v, %at
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @branchy_extent(%p : ptr, %q : ptr, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 %p
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %y = binary and i64 %i, 1
    %z = cmp eq i64 %y, 0
    branch %z, ^write, ^tail

  block ^write:
    %at = index i64 %q, %i
    store typed f64 %v, %at
    jump ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %t1
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @branchy_untyped(%p : ptr, %q : ptr, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %n = load typed i64 %p
    %y = binary and i64 %i, 1
    %z = cmp eq i64 %y, 0
    branch %z, ^write, ^tail

  block ^write:
    %at = index i64 %q, %i
    store f64 %v, %at
    jump ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
