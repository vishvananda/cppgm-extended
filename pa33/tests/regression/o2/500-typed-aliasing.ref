function @pointers_agree(%p : ptr, %q : ptr, %v : ptr) -> ptr [no_inline=yes] {
  block ^entry:
    %a = load typed ptr %p
    store typed ptr %v, %q
    %b = load typed ptr %p
    %c = cmp eq ptr %a, %b
    %r = select ptr %c, %a, %p
    return ptr %r
}
