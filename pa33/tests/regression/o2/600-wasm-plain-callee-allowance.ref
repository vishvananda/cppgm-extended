target wasm32 1

function @mix(%p : ptr, %x : i64) -> i64 {
  block ^entry:
    %f0 = index i8 %p, 8
    %v0 = load typed i64 %f0
    %s0 = binary add i64 %x, %v0
    %f1 = index i8 %p, 16
    %v1 = load typed i64 %f1
    %s1 = binary xor i64 %s0, %v1
    %f2 = index i8 %p, 24
    %v2 = load typed i64 %f2
