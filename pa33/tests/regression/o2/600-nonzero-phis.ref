global @cell : i64 = 0

function @sum(%m : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    branch %m, ^loop_preheader_1, ^zero

  block ^loop_preheader_1:
    %t1 = binary and i64 %m, -8
    branch %t1, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    %t2 = binary sub i64 %m, %t1
    jump ^unrolled_3

  block ^unrolled_3:
    %t3 = phi i64 [^loop_preheader_2: %m, ^unrolled_3: %t20]
    %t4 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t19]
    %t5 = binary add i64 %t3, %t4
    %t6 = binary sub i64 %t3, 1
    %t7 = binary add i64 %t5, %t6
    %t8 = binary sub i64 %t3, 2
    %t9 = binary add i64 %t7, %t8
    %t10 = binary sub i64 %t3, 3
    %t11 = binary add i64 %t9, %t10
    %t12 = binary sub i64 %t3, 4
    %t13 = binary add i64 %t11, %t12
    %t14 = binary sub i64 %t3, 5
    %t15 = binary add i64 %t13, %t14
    %t16 = binary sub i64 %t3, 6
    %t17 = binary add i64 %t15, %t16
    %t18 = binary sub i64 %t3, 7
    %t19 = binary add i64 %t17, %t18
    %t20 = binary sub i64 %t3, 8
    %t21 = cmp ne i64 %t2, %t20
    branch %t21, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    branch %t20, ^wide_tail_5, ^done

  block ^wide_tail_5:
    %t22 = phi i64 [^loop_preheader_1: %m, ^loop_exit_4: %t20]
    %t23 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t19]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_5: %t22, ^head: %j]
    %s = phi i64 [^wide_tail_5: %t23, ^head: %t]
    %t = binary add i64 %i, %s
    %j = binary sub i64 %i, 1
    branch %j, ^head, ^done

  block ^zero:
    return i64 0

  block ^done:
    %t28 = phi i64 [^head: %t, ^loop_exit_4: %t19]
    return i64 %t28
}
function @compared(%p : ptr, %q : ptr, %n : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %q0 = cmp eq ptr %q, 0
    %t2 = cmp eq i64 %q0, 0
    %t3 = cmp ne ptr %p, 0
    %t4 = select i64 %t3, %t2, 0
    return i64 %t4
}
function @untested(%a : i64, %b : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = select i64 %b, 1, 2
    %t2 = select i64 %a, 1, %t1
    return i64 %t2
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call i64 @sum(3)
    %b = call i64 @sum(0)
    %c = call i64 @compared(@cell, @cell, 1)
    %d = call i64 @compared(@cell, 0, 1)
    %e = call i64 @untested(0, 0)
    %f = call i64 @untested(1, 0)
    %g = binary add i64 %a, %b
    %h = binary add i64 %c, %d
    %i = binary add i64 %e, %f
    %j = binary add i64 %g, %h
    %k = binary add i64 %i, %j
    %r = convert trunc i32 i64 %k
    return i32 %r
}
