function @private_slot(%p : ptr, %q : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %has = cmp gt i64 %n, 0
    branch %has, ^split_1, ^done

  block ^split_1:
    %t2 = load i64 %q
    %t3 = load typed i64 %p
    %c = binary add i64 %t2, %t3
    %t5 = binary and i64 %n, -8
    %t6 = cmp gt i64 %t5, 0
    branch %t6, ^unrolled_2, ^wide_tail_4

  block ^unrolled_2:
    %t7 = phi i64 [^unrolled_2: %t17, ^split_1: 0]
    %t8 = phi i64 [^unrolled_2: %t16, ^split_1: 0]
    %t9 = binary add i64 %c, %t8
    %t10 = binary add i64 %c, %t9
    %t11 = binary add i64 %c, %t10
    %t12 = binary add i64 %c, %t11
    %t13 = binary add i64 %c, %t12
    %t14 = binary add i64 %c, %t13
    %t15 = binary add i64 %c, %t14
    %t16 = binary add i64 %c, %t15
    %t17 = binary add nowrap i64 %t7, 8
    %t18 = cmp ne i64 %t5, %t17
    branch %t18, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t19 = cmp lt i64 %t17, %n
    branch %t19, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t20 = phi i64 [^split_1: 0, ^loop_exit_3: %t17]
    %t21 = phi i64 [^split_1: 0, ^loop_exit_3: %t16]
    jump ^loop

  block ^loop:
    %i = phi i64 [^wide_tail_4: %t20, ^loop: %next]
    %sum = phi i64 [^wide_tail_4: %t21, ^loop: %more]
    %more = binary add i64 %sum, %c
    %next = binary add nowrap i64 %i, 1
    %again = cmp lt i64 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i64 [^entry: 0, ^loop: %more, ^loop_exit_3: %t16]
    return i64 %r
}
function @escaped_slot(%holder : ptr, %q : ptr, %n : i64, %out : ptr) -> i64 [no_inline=yes] {
  slot $s : obj<16x8>

  block ^entry:
    %a = addr $s
    store typed ptr %a, %out
    %p = load typed ptr %holder
    %has = cmp gt i64 %n, 0
    branch %has, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t4 = binary and i64 %n, -2
    %t5 = cmp gt i64 %t4, 0
    branch %t5, ^unrolled_2, ^wide_tail_4

  block ^unrolled_2:
    %t6 = phi i64 [^unrolled_2: %t12, ^loop_preheader_1: 0]
    %t7 = phi i64 [^unrolled_2: %t11, ^loop_preheader_1: 0]
    copyobj 16x8 %q, $s
    %t8 = load typed i64 %p
    %t9 = binary add i64 %t7, %t8
    copyobj 16x8 %q, $s
    %t10 = load typed i64 %p
    %t11 = binary add i64 %t9, %t10
    %t12 = binary add nowrap i64 %t6, 2
    %t13 = cmp ne i64 %t4, %t12
    branch %t13, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t14 = cmp lt i64 %t12, %n
    branch %t14, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t15 = phi i64 [^loop_preheader_1: 0, ^loop_exit_3: %t12]
    %t16 = phi i64 [^loop_preheader_1: 0, ^loop_exit_3: %t11]
    jump ^loop

  block ^loop:
    %i = phi i64 [^wide_tail_4: %t15, ^loop: %next]
    %sum = phi i64 [^wide_tail_4: %t16, ^loop: %more]
    copyobj 16x8 %q, $s
    %limit = load typed i64 %p
    %more = binary add i64 %sum, %limit
    %next = binary add nowrap i64 %i, 1
    %again = cmp lt i64 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i64 [^entry: 0, ^loop: %more, ^loop_exit_3: %t11]
    return i64 %r
}
