global @table : ptr = 0

function @chain(%this : ptr, %out : ptr, %n : i64) -> void [binding=strong] {
  block ^entry:
    %t1 = load typed ptr @table
    %t2 = index i8 [projection=field] %this, 8
    %t3 = load typed i64 %t2
    %row = binary mul i64 %t3, 88
    %entry = index i8 %t1, %row
    %field = index i8 [projection=field] %entry, 28
    %stride = load typed i32 %field
    %wide = convert sext i64 i32 %stride
    %t9 = binary and i64 %n, -4
    %t10 = cmp gt i64 %t9, 0
    branch %t10, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t11 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t21]
    %t12 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t20]
    %t13 = index f64 %out, %t11
    store typed f64 1, %t13
    %t14 = binary add i64 %wide, %t11
    %t15 = index f64 %out, %t14
    store typed f64 1, %t15
    %t16 = binary add i64 %wide, %t14
    %t17 = index f64 %out, %t16
    store typed f64 1, %t17
    %t18 = binary add i64 %wide, %t16
    %t19 = index f64 %out, %t18
    store typed f64 1, %t19
    %t20 = binary add nowrap i64 %t12, 4
    %t21 = binary add i64 %wide, %t18
    %t22 = cmp ne i64 %t9, %t20
    branch %t22, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t23 = cmp lt i64 %t20, %n
    branch %t23, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t24 = phi i64 [^entry: 0, ^loop_exit_3: %t21]
    %t25 = phi i64 [^entry: 0, ^loop_exit_3: %t20]
    jump ^body

  block ^body:
    %t26 = phi i64 [^wide_tail_4: %t24, ^body: %t30]
    %i = phi i64 [^wide_tail_4: %t25, ^body: %next]
    %slot = index f64 %out, %t26
    store typed f64 1, %slot
    %next = binary add nowrap i64 %i, 1
    %t30 = binary add i64 %wide, %t26
    %more = cmp lt i64 %next, %n
    branch %more, ^body, ^done

  block ^done:
    return void
}
function @past_branch(%this : ptr, %out : ptr, %n : i64, %c : i64) -> void [binding=strong] {
  block ^entry:
    %at = index i8 [projection=field] %this, 8
    %base = load typed ptr %at
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^join: %next]
    %odd = binary and i64 %c, %i
    branch %odd, ^then, ^join

  block ^then:
    %slot = index f64 %out, %i
    store typed f64 2, %slot
    jump ^join

  block ^join:
    %cell = index f64 %base, %i
    store typed f64 3, %cell
    %next = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %next, %n
    branch %more, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
