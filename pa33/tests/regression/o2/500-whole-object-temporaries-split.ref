declare function @slow(%a : f64, %b : f64) -> i128 [unwind=no, result_classes=integer_integer]

function @square_add(%re : f64, %im : f64, %c : f64, %retry : i1) -> f64 [binding=strong] {
  block ^entry:
    branch %retry, ^again, ^merge

  block ^again:
    %value = call i128 @slow(%re, %im)
    %t2 = convert trunc i64 i128 %value
    %t3 = binary ushr i128 %value, 64
    %t4 = convert trunc i64 i128 %t3
    %t5 = copy f64 %t2
    %t6 = copy f64 %t4
    jump ^merge

  block ^merge:
    %t7 = phi f64 [^entry: %im, ^again: %t6]
    %t8 = phi f64 [^entry: %re, ^again: %t5]
    %sum = binary add f64 %t7, %t8
    %out = binary add f64 %c, %sum
    %square = binary mul f64 %re, %re
    %total = binary add f64 %square, %out
    return f64 %total
}
