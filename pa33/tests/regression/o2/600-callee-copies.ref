global @data : obj<32x8> = {
  i64 5
  i64 3
  i64 8
  i64 1
}

function @less(%a : i64, %b : i64) -> i64 [binding=internal] {
  block ^entry:
    %c = cmp lt i64 %a, %b
    return i64 %c
}
function @more(%a : i64, %b : i64) -> i64 [binding=internal] {
  block ^entry:
    %c = cmp gt i64 %a, %b
    return i64 %c
}
function @count(%p : ptr, %n : i64, %f : ptr) -> i64 [binding=strong] {
  block ^0:
    jump ^entry

  block ^entry:
    %t1 = phi i64 [^0: 0, ^step: %t10]
    %t2 = phi i64 [^0: %n, ^step: %m]
    %t3 = phi ptr [^0: %p, ^step: %q]
    %more = cmp gt i64 %t2, 1
    branch %more, ^step, ^none

  block ^step:
    %a = load typed i64 %t3
    %q = index i8 %t3, 8
    %b = load typed i64 %q
    %x = call i64 %f(%a, %b) as (%l : i64, %r : i64) -> i64
    %m = binary sub i64 %t2, 1
    %t10 = binary add i64 %x, %t1
    jump ^entry

  block ^none:
    return i64 %t1
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %t1 = load typed i64 @data
    %t2 = index i8 @data, 8
    %t3 = load typed i64 %t2
    %t4 = cmp lt i64 %t1, %t3
    %t5 = index i8 @data, 16
    %t6 = load typed i64 %t5
    %t7 = cmp lt i64 %t3, %t6
    %t8 = binary add i64 %t4, %t7
    %t9 = index i8 @data, 24
    %t10 = load typed i64 %t9
    %t11 = cmp lt i64 %t6, %t10
    %t12 = binary add i64 %t8, %t11
    %pick = load volatile i64 @data
    %up = cmp gt i64 %pick, 4
    %which = select ptr %up, @more, @less
    %t16 = call i64 %which(%t1, %t3) as (%l : i64, %r : i64) -> i64
    %t17 = load typed i64 %t2
    %t18 = load typed i64 %t5
    %t19 = call i64 %which(%t17, %t18) as (%l : i64, %r : i64) -> i64
    %t20 = binary add i64 %t16, %t19
    %t21 = load typed i64 %t5
    %t22 = load typed i64 %t9
    %t23 = call i64 %which(%t21, %t22) as (%l : i64, %r : i64) -> i64
    %t24 = binary add i64 %t20, %t23
    %scaled = binary mul i64 %t12, 10
    %all = binary add i64 %scaled, %t24
    %r = convert trunc i32 i64 %all
    return i32 %r
}
