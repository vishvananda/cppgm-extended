global @take_work : i64 = 1
global @take_right : i64 = 0
global @result : i64 = 0

function @main() -> i64 [role=entry] {
  block ^entry:
    %work = load i64 @take_work
    branch %work, ^choose, ^split_2

  block ^choose:
    %right = load i64 @take_right
    %t3 = select i64 %right, 9, 7
    store i64 %t3, @result
    jump ^exit

  block ^split_2:
    %t4 = load i64 @result
    jump ^exit

  block ^exit:
    %answer = phi i64 [^split_2: %t4, ^choose: %t3]
    return i64 %answer
}
