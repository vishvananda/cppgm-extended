global @result : i64 = 0

function @strength_reduce() -> i64 [no_inline=yes] {
  block ^entry:
    store i64 24, @result
    return i64 24
}
function @remove_finite_empty_loop() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 7
}
function @keep_unproven_loop(%start : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = binary sub i64 7, %start
    %t2 = binary and i64 %t1, -16
    branch %t2, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t3 = binary add i64 %start, %t2
    jump ^unrolled_2

  block ^unrolled_2:
    %t4 = phi i64 [^loop_preheader_1: %start, ^unrolled_2: %t5]
    %t5 = binary add i64 %t4, 16
    %t6 = cmp ne i64 %t3, %t5
    branch %t6, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t7 = phi i64 [^entry: %start, ^unrolled_2: %t5]
    jump ^header

  block ^header:
    %i = phi i64 [^wide_tail_3: %t7, ^latch: %next]
    %more = cmp ne i64 %i, 7
    branch %more, ^latch, ^exit

  block ^latch:
    %next = binary add i64 %i, 2
    jump ^header

  block ^exit:
    return i64 0
}
function @remove_zero_trip_loop() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 9
}
function @remove_one_trip_loop() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 11
}
