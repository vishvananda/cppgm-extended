declare function @may_throw(%x : i64) -> i64

global @table : obj<64x8> = {
  zero 64
}

function @opaque(%x : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %r = binary add i64 %x, 1
    return i64 %r
}
function @chain(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %m = binary mul i64 %a, %b
    %q = binary add i64 %m, 7
    %t3 = binary and i64 %n, -8
    branch %t3, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t4 = phi i64 [^unrolled_1: %t14, ^entry: 0]
    %t5 = phi i64 [^unrolled_1: %t13, ^entry: 0]
    %t6 = binary add i64 %q, %t5
    %t7 = binary add i64 %q, %t6
    %t8 = binary add i64 %q, %t7
    %t9 = binary add i64 %q, %t8
    %t10 = binary add i64 %q, %t9
    %t11 = binary add i64 %q, %t10
    %t12 = binary add i64 %q, %t11
    %t13 = binary add i64 %q, %t12
    %t14 = binary add i64 %t4, 8
    %t15 = cmp ne i64 %t3, %t14
    branch %t15, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t16 = phi i64 [^entry: 0, ^unrolled_1: %t14]
    %t17 = phi i64 [^entry: 0, ^unrolled_1: %t13]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_2: %t16, ^body: %next]
    %s = phi i64 [^wide_tail_2: %t17, ^body: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    %t = binary add i64 %s, %q
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
function @varying(%n : i64, %a : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -8
    branch %t1, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t2 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t3 = phi i64 [^unrolled_1: %t20, ^entry: 0]
    %t4 = phi i64 [^unrolled_1: %t19, ^entry: 0]
    %t5 = binary add i64 %t2, %t4
    %t6 = binary add i64 %a, %t2
    %t7 = binary add i64 %t5, %t6
    %t8 = binary add i64 %a, %t6
    %t9 = binary add i64 %t7, %t8
    %t10 = binary add i64 %a, %t8
    %t11 = binary add i64 %t9, %t10
    %t12 = binary add i64 %a, %t10
    %t13 = binary add i64 %t11, %t12
    %t14 = binary add i64 %a, %t12
    %t15 = binary add i64 %t13, %t14
    %t16 = binary add i64 %a, %t14
    %t17 = binary add i64 %t15, %t16
    %t18 = binary add i64 %a, %t16
    %t19 = binary add i64 %t17, %t18
    %t20 = binary add i64 %t3, 8
    %t21 = binary add i64 %a, %t18
    %t22 = cmp ne i64 %t1, %t20
    branch %t22, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t23 = phi i64 [^entry: 0, ^unrolled_1: %t21]
    %t24 = phi i64 [^entry: 0, ^unrolled_1: %t20]
    %t25 = phi i64 [^entry: 0, ^unrolled_1: %t19]
    jump ^head

  block ^head:
    %t26 = phi i64 [^wide_tail_2: %t23, ^tail: %t32]
    %i = phi i64 [^wide_tail_2: %t24, ^tail: %next]
    %s = phi i64 [^wide_tail_2: %t25, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^tail, ^done

  block ^tail:
    %t = binary add i64 %s, %t26
    %next = binary add i64 %i, 1
    %t32 = binary add i64 %a, %t26
    jump ^head

  block ^done:
    return i64 %s
}
function @nested(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %m = binary mul i64 %a, %b
    jump ^outer

  block ^outer:
    %i = phi i64 [^entry: 0, ^outer_tail: %i_next]
    %s = phi i64 [^entry: 0, ^outer_tail: %u]
    %c = cmp ult i64 %i, %n
    branch %c, ^loop_preheader_2, ^done

  block ^loop_preheader_2:
    %t5 = binary and i64 %i, -8
    branch %t5, ^unrolled_3, ^wide_tail_4

  block ^unrolled_3:
    %t6 = phi i64 [^unrolled_3: %t16, ^loop_preheader_2: 0]
    %t7 = phi i64 [^unrolled_3: %t15, ^loop_preheader_2: %s]
    %t8 = binary add i64 %m, %t7
    %t9 = binary add i64 %m, %t8
    %t10 = binary add i64 %m, %t9
    %t11 = binary add i64 %m, %t10
    %t12 = binary add i64 %m, %t11
    %t13 = binary add i64 %m, %t12
    %t14 = binary add i64 %m, %t13
    %t15 = binary add i64 %m, %t14
    %t16 = binary add i64 %t6, 8
    %t17 = cmp ne i64 %t5, %t16
    branch %t17, ^unrolled_3, ^wide_tail_4

  block ^wide_tail_4:
    %t18 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t16]
    %t19 = phi i64 [^loop_preheader_2: %s, ^unrolled_3: %t15]
    jump ^inner

  block ^inner:
    %j = phi i64 [^inner_tail: %j_next, ^wide_tail_4: %t18]
    %u = phi i64 [^inner_tail: %v, ^wide_tail_4: %t19]
    %d = cmp ult i64 %j, %i
    branch %d, ^inner_tail, ^outer_tail

  block ^inner_tail:
    %v = binary add i64 %u, %m
    %j_next = binary add i64 %j, 1
    jump ^inner

  block ^outer_tail:
    %i_next = binary add i64 %i, 1
    jump ^outer

  block ^done:
    return i64 %s
}
function @entered_from_branch(%n : i64, %a : i64, %b : i64, %f : i64, %p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %z = cmp eq i64 %f, 0
    branch %z, ^loop_preheader_2, ^other

  block ^other:
    %r = call i64 @opaque(%a)
    %v = binary add i64 %b, %r
    return i64 %v

  block ^loop_preheader_2:
    %m = binary mul i64 %a, %b
    jump ^head

  block ^head:
    %i = phi i64 [^loop_preheader_2: 0, ^tail: %next]
    %s = phi i64 [^loop_preheader_2: 0, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    %y = cmp ugt i64 %i, %m
    branch %y, ^note, ^tail

  block ^note:
    store i64 %i, %p
    jump ^tail

  block ^tail:
    %t = binary add i64 %s, %m
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
function @chain_across_blocks(%n : i64, %a : i64, %b : i64, %f : i64, %p : ptr) -> void [no_inline=yes] {
  block ^entry:
    %m = binary mul i64 %a, %b
    %q = binary add i64 %m, 7
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^second: %next]
    %c = cmp ult i64 %i, %n
    branch %c, ^first, ^done

  block ^first:
    %z = cmp eq i64 %f, %i
    branch %z, ^done, ^second

  block ^second:
    store i64 %q, %p
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    %e = binary add i64 %a, %b
    %w = binary add i64 %m, %e
    store i64 %w, %p
    return void
}
function @nested_certain_division(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %q = binary div i64 %a, %b
    jump ^outer

  block ^outer:
    %i = phi i64 [^entry: 0, ^latch: %i_next]
    %s = phi i64 [^entry: 0, ^latch: %t25]
    %t4 = binary and i64 %i, -8
    branch %t4, ^unrolled_2, ^wide_tail_4

  block ^unrolled_2:
    %t5 = phi i64 [^unrolled_2: %t15, ^outer: 0]
    %t6 = phi i64 [^unrolled_2: %t14, ^outer: %s]
    %t7 = binary add i64 %q, %t6
    %t8 = binary add i64 %q, %t7
    %t9 = binary add i64 %q, %t8
    %t10 = binary add i64 %q, %t9
    %t11 = binary add i64 %q, %t10
    %t12 = binary add i64 %q, %t11
    %t13 = binary add i64 %q, %t12
    %t14 = binary add i64 %q, %t13
    %t15 = binary add i64 %t5, 8
    %t16 = cmp ne i64 %t4, %t15
    branch %t16, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = cmp ult i64 %t15, %i
    branch %t17, ^wide_tail_4, ^latch

  block ^wide_tail_4:
    %t18 = phi i64 [^outer: 0, ^loop_exit_3: %t15]
    %t19 = phi i64 [^outer: %s, ^loop_exit_3: %t14]
    jump ^inner

  block ^inner:
    %j = phi i64 [^wide_tail_4: %t18, ^inner: %j_next]
    %u = phi i64 [^wide_tail_4: %t19, ^inner: %t]
    %t = binary add i64 %u, %q
    %j_next = binary add i64 %j, 1
    %d = cmp ult i64 %j_next, %i
    branch %d, ^inner, ^latch

  block ^latch:
    %t25 = phi i64 [^inner: %t, ^loop_exit_3: %t14]
    %i_next = binary add i64 %i, 1
    %c = cmp ult i64 %i_next, %n
    branch %c, ^outer, ^done

  block ^done:
    return i64 %t25
}
function @guarded_division(%n : i64, %a : i64, %b : i64, %f : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %q5 = binary div i64 %a, 3
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %s = phi i64 [^entry: 0, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    %z = cmp eq i64 %f, %i
    branch %z, ^divide, ^tail

  block ^divide:
    %q1 = binary div i64 %a, %b
    %q2 = binary udiv i64 %a, %b
    %t8 = binary mul i64 %b, %q1
    %q3 = binary sub i64 %a, %t8
    %t10 = binary mul i64 %b, %q2
    %q4 = binary sub i64 %a, %t10
    %q6 = binary div i64 %a, -1
    %q7 = binary udiv i64 %a, 0
    %t14 = binary mul i64 %q6, -1
    %q8 = binary sub i64 %a, %t14
    %x1 = binary add i64 %q1, %q2
    %x2 = binary add i64 %q3, %x1
    %x3 = binary add i64 %q4, %x2
    %x4 = binary add i64 %q5, %x3
    %x5 = binary add i64 %q6, %x4
    %x6 = binary add i64 %q7, %x5
    %x7 = binary add i64 %q8, %x6
    jump ^tail

  block ^tail:
    %t = phi i64 [^body: %s, ^divide: %x7]
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
function @certain_division(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %q = binary div i64 %a, %b
    %t2 = binary and i64 %n, -8
    branch %t2, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t13, ^entry: 0]
    %t4 = phi i64 [^unrolled_1: %t12, ^entry: 0]
    %t5 = binary add i64 %q, %t4
    %t6 = binary add i64 %q, %t5
    %t7 = binary add i64 %q, %t6
    %t8 = binary add i64 %q, %t7
    %t9 = binary add i64 %q, %t8
    %t10 = binary add i64 %q, %t9
    %t11 = binary add i64 %q, %t10
    %t12 = binary add i64 %q, %t11
    %t13 = binary add i64 %t3, 8
    %t14 = cmp ne i64 %t2, %t13
    branch %t14, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t15 = cmp ult i64 %t13, %n
    branch %t15, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t16 = phi i64 [^entry: 0, ^loop_exit_2: %t13]
    %t17 = phi i64 [^entry: 0, ^loop_exit_2: %t12]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_3: %t16, ^head: %next]
    %s = phi i64 [^wide_tail_3: %t17, ^head: %t]
    %t = binary add i64 %s, %q
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    %t23 = phi i64 [^head: %t, ^loop_exit_2: %t12]
    return i64 %t23
}
function @division_after_call(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %s = phi i64 [^entry: 0, ^head: %t]
    %r = call i64 @opaque(%i)
    %q = binary div i64 %a, %b
    %w = binary add i64 %r, %q
    %t = binary add i64 %s, %w
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return i64 %t
}
function @costly_across_calls(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %m = binary mul i64 %a, %b
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %s = phi i64 [^entry: 0, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^tail, ^done

  block ^tail:
    %r = call i64 @opaque(%i)
    %p = binary add i64 %a, %b
    %x = binary add i64 %m, %p
    %y = binary add i64 %r, %x
    %t = binary add i64 %s, %y
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
function @addresses(%n : i64, %p : ptr, %k : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %q = index i8 %p, %k
    %t2 = binary and i64 %n, -4
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t17, ^entry: 0]
    %t4 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t5 = index i8 @table, 8
    store i64 %t3, %t5
    %t6 = load i64 %q
    %t7 = binary add i64 %t4, %t6
    %t8 = binary add i64 %t3, 1
    store i64 %t8, %t5
    %t9 = load i64 %q
    %t10 = binary add i64 %t7, %t9
    %t11 = binary add i64 %t3, 2
    store i64 %t11, %t5
    %t12 = load i64 %q
    %t13 = binary add i64 %t10, %t12
    %t14 = binary add i64 %t3, 3
    store i64 %t14, %t5
    %t15 = load i64 %q
    %t16 = binary add i64 %t13, %t15
    %t17 = binary add i64 %t3, 4
    %t18 = cmp ne i64 %t2, %t17
    branch %t18, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t19 = phi i64 [^entry: 0, ^unrolled_1: %t17]
    %t20 = phi i64 [^entry: 0, ^unrolled_1: %t16]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_2: %t19, ^tail: %next]
    %s = phi i64 [^wide_tail_2: %t20, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^tail, ^done

  block ^tail:
    %g = index i8 @table, 8
    store i64 %i, %g
    %w = load i64 %q
    %t = binary add i64 %s, %w
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
function @slot_addresses(%n : i64) -> i64 [no_inline=yes] {
  slot $v : obj<64x8>
  slot $w : obj<64x8>
  slot $s : obj<64x8>

  block ^entry:
    %q = addr $v
    %r = addr $w
    %f = index i8 %r, 8
    %t4 = binary and i64 %n, -2
    branch %t4, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t5 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t6 = addr $s
    store volatile i64 %t5, %t6
    %t7 = binary and i64 %t5, 7
    %t8 = index i64 %q, %t7
    store volatile i64 %t5, %t8
    %t9 = binary and i64 %t5, 3
    %t10 = index i64 %f, %t9
    store volatile i64 %t5, %t10
    %t11 = binary add i64 %t5, 1
    store volatile i64 %t11, %t6
    %t12 = binary and i64 %t11, 7
    %t13 = index i64 %q, %t12
    store volatile i64 %t11, %t13
    %t14 = binary and i64 %t11, 3
    %t15 = index i64 %f, %t14
    store volatile i64 %t11, %t15
    %t16 = binary add i64 %t5, 2
    %t17 = cmp ne i64 %t4, %t16
    branch %t17, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t18 = phi i64 [^entry: 0, ^unrolled_1: %t16]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_2: %t18, ^tail: %next]
    %c = cmp ult i64 %i, %n
    branch %c, ^tail, ^done

  block ^tail:
    %p = addr $s
    store volatile i64 %i, %p
    %e = binary and i64 %i, 7
    %x = index i64 %q, %e
    store volatile i64 %i, %x
    %g = binary and i64 %i, 3
    %y = index i64 %f, %g
    store volatile i64 %i, %y
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %i
}
function @extended(%n : i64, %a : f64, %b : f64) -> f64 [no_inline=yes] {
  block ^entry:
    %x = convert fpext f80 f64 %a
    %y = convert fpext f80 f64 %b
    %t3 = binary and i64 %n, -4
    branch %t3, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t4 = phi i64 [^unrolled_1: %t12, ^entry: 0]
    %t5 = phi f64 [^unrolled_1: %t11, ^entry: 0]
    %t6 = binary mul f80 %x, %y
    %t7 = convert fptrunc f64 f80 %t6
    %t8 = binary add f64 %t5, %t7
    %t9 = binary add f64 %t7, %t8
    %t10 = binary add f64 %t7, %t9
    %t11 = binary add f64 %t7, %t10
    %t12 = binary add i64 %t4, 4
    %t13 = cmp ne i64 %t3, %t12
    branch %t13, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t14 = phi i64 [^entry: 0, ^unrolled_1: %t12]
    %t15 = phi f64 [^entry: 0, ^unrolled_1: %t11]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_2: %t14, ^tail: %next]
    %s = phi f64 [^wide_tail_2: %t15, ^tail: %t]
    %c = cmp ult i64 %i, %n
    branch %c, ^tail, ^done

  block ^tail:
    %m = binary mul f80 %x, %y
    %u = convert fptrunc f64 f80 %m
    %t = binary add f64 %s, %u
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return f64 %s
}
function @handler_stays(%n : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %s = phi i64 [^entry: 0, ^tail: %u]
    %c = cmp ult i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    eh_try ^caught
    %r = call i64 @may_throw(%i)
    eh_end
    jump ^tail

  block ^caught:
    %m = binary mul i64 %a, %b
    jump ^tail

  block ^tail:
    %t = phi i64 [^body: %r, ^caught: %m]
    %u = binary add i64 %s, %t
    %next = binary add i64 %i, 1
    jump ^head

  block ^done:
    return i64 %s
}
