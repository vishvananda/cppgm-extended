    branch %t25, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t26 = cmp lt i64 %t24, %n
    branch %t26, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t27 = phi i64 [^entry: 0, ^loop_exit_3: %t24]
    %t28 = phi i64 [^entry: 0, ^loop_exit_3: %t23]
    jump ^body

  block ^body:
    %i = phi i64 [^wide_tail_4: %t27, ^body: %next]
    %s = phi i64 [^wide_tail_4: %t28, ^body: %sum]
    %m = binary mul i64 %i, 9
