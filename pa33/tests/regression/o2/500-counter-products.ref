    %t19 = index i8 %t16, %t15
    %t20 = load i64 %t19
    %t21 = binary add i64 %t20, %t18
    %t22 = binary add nowrap i64 %t7, 4
    %t23 = binary add i64 %t6, 656
    %t24 = cmp ne i64 %t5, %t22
    branch %t24, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t25 = cmp lt i64 %t22, %n
    branch %t25, ^wide_tail_5, ^done

  block ^wide_tail_5:
    %t26 = phi i64 [^entry: 164, ^loop_exit_4: %t23, ^loop_preheader_1: 164]
    %t27 = phi i64 [^entry: 1, ^loop_exit_4: %t22, ^loop_preheader_1: 1]
    %t28 = phi i64 [^entry: 0, ^loop_exit_4: %t21, ^loop_preheader_1: 0]
    jump ^body

  block ^body:
    %t29 = phi i64 [^wide_tail_5: %t26, ^body: %t39]
    %i = phi i64 [^wide_tail_5: %t27, ^body: %next]
    %s = phi i64 [^wide_tail_5: %t28, ^body: %sum]
    %p = index i8 %a, %t29
    %v = load i64 %p
    %x = binary add i64 %s, %v
    %q = index i8 %p, %t29
    %w = load i64 %q
    %sum = binary add i64 %w, %x
    %next = binary add i64 %i, 2
    %t39 = binary add i64 %t29, 328
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

