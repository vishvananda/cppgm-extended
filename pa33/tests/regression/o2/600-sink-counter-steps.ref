function @reader_after_step(%p : ptr, %n : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -4
    %t2 = cmp gt i64 %t1, 0
    branch %t2, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t17, ^entry: 0]
    %t4 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t5 = index i64 %p, %t3
    %t6 = load i64 %t5
    %t7 = binary add i64 %t4, %t6
    %t8 = index i64 %t5, 1
    %t9 = load i64 %t8
    %t10 = binary add i64 %t7, %t9
    %t11 = index i64 %t5, 2
    %t12 = load i64 %t11
    %t13 = binary add i64 %t10, %t12
    %t14 = index i64 %t5, 3
    %t15 = load i64 %t14
    %t16 = binary add i64 %t13, %t15
    %t17 = binary add nowrap i64 %t3, 4
    %t18 = cmp ne i64 %t1, %t17
    branch %t18, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t19 = cmp lt i64 %t17, %n
    branch %t19, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t20 = phi i64 [^entry: 0, ^loop_exit_2: %t17]
    %t21 = phi i64 [^entry: 0, ^loop_exit_2: %t16]
    jump ^loop

  block ^loop:
    %i = phi i64 [^wide_tail_3: %t20, ^loop: %next]
    %sum = phi i64 [^wide_tail_3: %t21, ^loop: %total]
    %q = index i64 %p, %i
    %v = load i64 %q
    %total = binary add i64 %sum, %v
    %next = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %next, %n
    branch %more, ^loop, ^done

  block ^done:
    %t29 = phi i64 [^loop: %total, ^loop_exit_2: %t16]
    return i64 %t29
}
function @compare_read_twice(%p : ptr, %n : i64) -> i1 [binding=strong, no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %i = phi i64 [^entry: 0, ^loop: %next]
    %next = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %next, %n
    %q = index i64 %p, %i
    %w = convert zext i64 i1 %more
    store i64 %w, %q
    branch %more, ^loop, ^done

  block ^done:
    return i1 0
}
function @step_read_early(%p : ptr, %n : i64) -> void [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -8
    %t2 = cmp gt i64 %t1, 0
    branch %t2, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t18, ^entry: 0]
    %t4 = binary add nowrap i64 %t3, 1
    %t5 = index i64 %p, %t4
    store i64 %t3, %t5
    %t6 = binary add nowrap i64 %t3, 2
    %t7 = index i64 %p, %t6
    store i64 %t4, %t7
    %t8 = binary add nowrap i64 %t3, 3
    %t9 = index i64 %p, %t8
    store i64 %t6, %t9
    %t10 = binary add nowrap i64 %t3, 4
    %t11 = index i64 %p, %t10
    store i64 %t8, %t11
    %t12 = binary add nowrap i64 %t3, 5
    %t13 = index i64 %p, %t12
    store i64 %t10, %t13
    %t14 = binary add nowrap i64 %t3, 6
    %t15 = index i64 %p, %t14
    store i64 %t12, %t15
    %t16 = binary add nowrap i64 %t3, 7
    %t17 = index i64 %p, %t16
    store i64 %t14, %t17
    %t18 = binary add nowrap i64 %t3, 8
    %t19 = index i64 %p, %t18
    store i64 %t16, %t19
    %t20 = cmp ne i64 %t1, %t18
    branch %t20, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t21 = cmp lt i64 %t18, %n
    branch %t21, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t22 = phi i64 [^entry: 0, ^loop_exit_2: %t18]
    jump ^loop

  block ^loop:
    %i = phi i64 [^wide_tail_3: %t22, ^loop: %next]
    %next = binary add nowrap i64 %i, 1
    %q = index i64 %p, %next
    store i64 %i, %q
    %more = cmp lt i64 %next, %n
    branch %more, ^loop, ^done

  block ^done:
    return void
}
function @branch_reads_the_phi(%n : i32) -> void [no_inline=yes] {
  block ^entry:
    %t1 = binary sub i32 %n, -1
    %t2 = binary and i32 %t1, -8
    branch %t2, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    %t3 = binary sub i32 %n, %t2
    jump ^unrolled_2

  block ^unrolled_2:
    %t4 = phi i32 [^loop_preheader_1: %n, ^unrolled_2: %t5]
    %t5 = binary sub nowrap i32 %t4, 8
    %t6 = cmp ne i32 %t3, %t5
    branch %t6, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t7 = binary sub nowrap i32 %t4, 7
    branch %t7, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t8 = phi i32 [^entry: %n, ^loop_exit_3: %t5]
    jump ^loop

  block ^loop:
    %i = phi i32 [^wide_tail_4: %t8, ^loop: %next]
    %next = binary sub nowrap i32 %i, 1
    branch %i, ^loop, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
