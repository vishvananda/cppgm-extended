function @hash_bytes(%text : ptr, %first : i64, %count : i64) -> i64 {
  block ^entry:
    %end = binary add i64 %first, %count
    %data_short = index i8 %text, 1
    jump ^cond

  block ^cond:
    %i = phi i64 [^entry: %first, ^join: %i1]
    %h = phi i64 [^entry: 1469598103934665603, ^join: %h1]
    %more = cmp ult i64 %i, %end
    branch %more, ^body, ^done

  block ^body:
    %flag = load u8 %text
    %long_bit = binary and u8 %flag, 1
    branch %long_bit, ^long, ^short

  block ^long:
    %long_slot = index i8 %text, 16
    %data_long = load ptr %long_slot
    jump ^join

  block ^short:
    jump ^join

  block ^join:
    %data = phi ptr [^long: %data_long, ^short: %data_short]
    %at = index i8 %data, %i
    %byte = load u8 %at
    %wide = convert zext i64 u8 %byte
    %mixed = binary xor i64 %h, %wide
    %h1 = binary mul i64 %mixed, 1099511628211
    %i1 = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return i64 %h
}
function @sum_kept_with_store(%values : ptr, %n : i64, %out : ptr) -> i64 {
  block ^entry:
    %t1 = binary and i64 %n, -2
    branch %t1, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t2 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t15]
    %t3 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t14]
    %t4 = load ptr %values
    %t5 = binary shl i64 %t2, 3
    %t6 = index i8 %t4, %t5
    %t7 = load i64 %t6
    %t8 = binary add i64 %t3, %t7
    store i64 %t8, %out
    %t9 = binary add i64 %t2, 1
    %t10 = load ptr %values
    %t11 = binary shl i64 %t9, 3
    %t12 = index i8 %t10, %t11
    %t13 = load i64 %t12
    %t14 = binary add i64 %t8, %t13
    store i64 %t14, %out
    %t15 = binary add i64 %t2, 2
    %t16 = cmp ne i64 %t1, %t15
    branch %t16, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t17 = phi i64 [^entry: 0, ^unrolled_2: %t15]
    %t18 = phi i64 [^entry: 0, ^unrolled_2: %t14]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_3: %t17, ^body: %i1]
    %s = phi i64 [^wide_tail_3: %t18, ^body: %s1]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %base = load ptr %values
    %offset = binary shl i64 %i, 3
    %at = index i8 %base, %offset
    %v = load i64 %at
    %s1 = binary add i64 %s, %v
    store i64 %s1, %out
    %i1 = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return i64 %s
}
