    %t25 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t22]
    %t26 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t20]
    %t27 = convert sext i64 i32 %t25
    jump ^loop

  block ^loop:
    %t28 = phi i64 [^loop: %t33, ^wide_tail_5: %t27]
    %sum = phi i64 [^loop: %more, ^wide_tail_5: %t26]
    %at = index i64 %p, %t28
