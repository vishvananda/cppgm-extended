function @pick(%c : i64, %a : i64, %b : i64) -> i128 {
  block ^entry:
    branch %c, ^low, ^high

  block ^low:
    %x = convert zext i128 i64 %a
    return i128 %x

  block ^high:
    %y = convert zext i128 i64 %b
    %z = binary shl i128 %y, 64
    return i128 %z
}
function @words(%c : i64, %a : i64, %b : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %c, ^inline_cont_2, ^high_1

  block ^high_1:
    %y_1 = convert zext i128 i64 %b
    %z_2 = binary shl i128 %y_1, 64
    %t3 = convert trunc i64 i128 %z_2
    jump ^inline_cont_2

  block ^inline_cont_2:
    %t4 = phi i64 [^high_1: %t3, ^entry: %a]
    %t5 = phi i64 [^high_1: %b, ^entry: 0]
    %scaled = binary mul i64 %t5, 10
    %sum = binary add i64 %scaled, %t4
    return i64 %sum
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %low = call i64 @words(1, 5, 9)
    %high = call i64 @words(0, 5, 9)
    %t3 = cmp eq i64 %low, 5
    %low_bit = select i32 %t3, 0, 1
    %t5 = cmp eq i64 %high, 90
    %high_bit = select i32 %t5, 0, 2
    %status = binary or i32 %low_bit, %high_bit
    return i32 %status
}
