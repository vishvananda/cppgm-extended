function @choose(%x : i64) -> i64 [unwind=no, prefer_local=yes] {
  block ^entry:
    %t1 = cmp eq i64 %x, 0
    %t3 = select i64 %t1, 10, 20
    return i64 %t3
}
function @caller(%x : i64) -> i64 {
  block ^entry:
    %t1_1 = cmp eq i64 %x, 0
    %t3 = select i64 %t1_1, 10, 20
    %t2 = binary add i64 %t3, 1
    return i64 %t2
}
