function @leaf(%cond : i1, %p : ptr) -> i64 {
  block ^entry:
    %t1 = copy i64 %p
    %t2 = select i64 %cond, %t1, 0
    return i64 %t2
}
function @caller(%cond : i1, %p : ptr, %out : ptr) -> void {
  block ^entry:
    %t2 = select ptr %cond, %p, 0
    %t1 = copy i64 %t2
    store i64 %t1, %out
    return void
}
