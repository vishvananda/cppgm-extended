global @__switch_results_0 : obj<4x1> [storage=readonly, binding=internal] = {
  i8 1
  i8 2
  i8 1
  i8 2
}

function @in_run(%k : u16) -> u8 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = binary sub u16 %k, 420
    %t2 = cmp ult u16 %t1, 6
    %t3 = convert trunc u8 i64 %t2
    return u8 %t3
}
function @two_results(%k : u16) -> u8 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = convert zext i64 u16 %k
    %t2 = binary sub i64 %t1, 420
    %t3 = cmp ult i64 %t2, 4
    branch %t3, ^switch_case_2, ^no

  block ^no:
    return u8 0

  block ^switch_case_2:
    %t4 = index i8 @__switch_results_0, %t2
    %t5 = load u8 %t4
    return u8 %t5
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call u8 @in_run(419)
    %b = call u8 @in_run(420)
    %c = call u8 @in_run(425)
    %d = call u8 @in_run(426)
    %e = call u8 @two_results(421)
    %f = call u8 @two_results(422)
    %g = call u8 @two_results(7)
    %ok0 = cmp eq u8 %a, 0
    %ok1 = cmp eq u8 %b, 1
    %ok2 = cmp eq u8 %c, 1
    %ok3 = cmp eq u8 %d, 0
    %ok4 = cmp eq u8 %e, 2
    %ok5 = cmp eq u8 %f, 1
    %ok6 = cmp eq u8 %g, 0
    %a0 = binary and i64 %ok0, %ok1
    %a1 = binary and i64 %ok2, %a0
    %a2 = binary and i64 %ok3, %a1
    %a3 = binary and i64 %ok4, %a2
    %a4 = binary and i64 %ok5, %a3
    %a5 = binary and i64 %ok6, %a4
    %r = convert trunc i32 i64 %a5
    %code = binary sub i32 1, %r
    return i32 %code
}
