machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %n -> rdi : i64
    param %rounds -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rdi
    mov r9, 0
    mov rax, 0

  block ^head
    cmp.i64 r8, 0
    je ^zero

  block ^body
    lea rdi, [r8-1]
    add rax, r8
    mov r8, rdi

  block ^latch
    add r9, 1
    cmp.i64 r9, rsi
    jl ^latch~head
    ret rax

  block ^latch~head
    cmp.i64 r8, 0
    jne ^body

  block ^zero
    add rax, 100
    mov r8, 1
    add r9, 1
    cmp.i64 r9, rsi
    jl ^body
    ret rax

  block ^out
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 5
    mov rsi, 40
    call @walk [args=(rsi,rdi)]
    sext.i32 r8, rax
    mov r11, 2190262207
    mov rax, r8
    imul rax, r11
    sar rax, 39
    mov rdx, r8
    sar rdx, 63
    sub rax, rdx
    imul rax, 251
    mov rdx, r8
    sub rdx, rax
    mov rax, rdx
    ret rax
