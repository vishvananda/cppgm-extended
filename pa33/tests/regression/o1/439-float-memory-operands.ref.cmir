machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @add_left
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fadd.f64 xmm0, [rdi], xmm0
    ret xmm0

function @sub_right
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fsub.f64 xmm0, xmm0, [rdi]
    ret xmm0

function @sub_left
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm1, [rdi]
    fsub.f64 xmm1, xmm1, xmm0
    ret xmm1

function @divide
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f32
    return f32 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fdiv.f32 xmm0, xmm0, [rdi]
    ret xmm0

function @both
  abi
    param %p -> rdi : ptr
    param %q -> rsi : ptr
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmul.f64 xmm0, [rdi], [rsi]
    ret xmm0

function @less
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fcmp.f64 xmm0, [rdi]
    jbe ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 2
    ret rax

function @more
  abi
    param %p -> rdi : ptr
    param %x -> xmm0 : f64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fcmp.f64 xmm0, [rdi]
    jbe ^no

  block ^yes
    mov rax, 3
    ret rax

  block ^no
    mov rax, 4
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1>
    slot $a -> [rbp-<off0>] : obj<16x8>
    temp %b -> [rbp-<off1>] : f64
    temp %c -> [rbp-<off2>] : f64
    temp %d -> [rbp-<off3>] : f64

  block ^entry
    fmov.f64 [rbp-<off0>], 6.0
    fmov.f64 [rbp-<off4>], 2.0
    lea rdi, [rbp-<off0>]
    fmov.f64 xmm0, 1.0
    call @add_left [args=(rdi,xmm0)]
    fmov.f64 xmm14, xmm0
    fmov.f64 [rbp-<off1>], xmm14
    lea rdi, [rbp-<off0>]
    fmov.f64 xmm0, 1e+01
    call @sub_right [args=(rdi,xmm0)]
    fmov.f64 xmm14, xmm0
    fmov.f64 [rbp-<off2>], xmm14
    lea rdi, [rbp-<off4>]
    fmov.f64 xmm0, 1e+01
    call @sub_left [args=(rdi,xmm0)]
    fmov.f64 xmm14, xmm0
    fmov.f64 [rbp-<off3>], xmm14
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off4>]
    call @both [args=(rsi,rdi)]
    fadd.f64 xmm1, [rbp-<off1>], [rbp-<off2>]
    fadd.f64 xmm0, [rbp-<off3>], xmm0
    fadd.f64 xmm1, xmm1, xmm0
    fptosi.f64.i32 <gpr0>, xmm1
    sext.i32 <gpr0>
    lea rdi, [rbp-<off0>]
    fmov.f64 xmm0, 7.0
    call @less [args=(rdi,xmm0)]
    mov <gpr1>, rax
    lea rdi, [rbp-<off0>]
    fmov.f64 xmm0, 5.0
    call @more [args=(rdi,xmm0)]
    imul <gpr1>, 10
    add <gpr1>, rax
    add <gpr1>, <gpr0>
    sext.i32 <gpr1>
    ret <gpr1>
