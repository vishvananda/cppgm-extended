machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item zero 256

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %v14 -> [rbp-<off0>] : f64
    temp %v15 -> [rbp-<off1>] : f64
    temp %v13 -> [rbp-<off2>] : f64

  block ^entry
    fmov.f64 xmm0, @data
    fmov.f64 xmm1, @data+8
    fmov.f64 <xmm0>, @data+16
    fmov.f64 <xmm1>, @data+24
    fmov.f64 <xmm2>, @data+32
    fmov.f64 <xmm3>, @data+40
    fmov.f64 <xmm4>, @data+48
    fmov.f64 <xmm5>, @data+56
    fmov.f64 xmm8, @data+64
    fmov.f64 xmm9, @data+72
    fmov.f64 xmm10, @data+80
    fmov.f64 xmm11, @data+88
    fmov.f64 xmm12, @data+96
    fmov.f64 xmm13, @data+104
    fmov.f64 xmm14, @data+112
    fmov.f64 [rbp-<off0>], xmm14
    fmov.f64 xmm14, @data+120
    fmov.f64 [rbp-<off1>], xmm14
    fmov.f64 [rbp-<off2>], xmm13
    fmul.f64 xmm13, xmm0, xmm1
    fadd.f64 xmm13, xmm13, xmm1
    fmul.f64 xmm13, xmm13, <xmm0>
    fadd.f64 xmm13, xmm13, <xmm0>
    fmul.f64 xmm13, xmm13, <xmm1>
    fadd.f64 xmm13, xmm13, <xmm1>
    fmul.f64 xmm13, xmm13, <xmm2>
    fadd.f64 xmm13, xmm13, <xmm2>
    fmul.f64 xmm13, xmm13, <xmm3>
    fadd.f64 xmm13, xmm13, <xmm3>
    fmul.f64 xmm13, xmm13, <xmm4>
    fadd.f64 xmm13, xmm13, <xmm4>
    fmul.f64 xmm13, xmm13, <xmm5>
    fadd.f64 xmm13, xmm13, <xmm5>
    fmul.f64 xmm13, xmm13, xmm8
    fadd.f64 xmm13, xmm13, xmm8
    fmul.f64 xmm13, xmm13, xmm9
    fadd.f64 xmm13, xmm13, xmm9
    fmul.f64 xmm13, xmm13, xmm10
    fadd.f64 xmm13, xmm13, xmm10
    fmul.f64 xmm13, xmm13, xmm11
    fadd.f64 xmm13, xmm13, xmm11
    fmul.f64 xmm13, xmm13, xmm12
    fadd.f64 xmm13, xmm13, xmm12
    fmul.f64 xmm13, xmm13, [rbp-<off2>]
    fadd.f64 xmm13, xmm13, [rbp-<off2>]
    fmul.f64 xmm13, xmm13, [rbp-<off0>]
    fadd.f64 xmm13, xmm13, [rbp-<off0>]
    fmul.f64 xmm13, xmm13, [rbp-<off1>]
    fadd.f64 xmm13, xmm13, [rbp-<off1>]
    fmov.f64 @data, xmm0
    fmov.f64 @data+8, xmm1
    fmov.f64 @data+16, <xmm0>
    fmov.f64 @data+24, <xmm1>
    fmov.f64 @data+32, <xmm2>
    fmov.f64 @data+40, <xmm3>
    fmov.f64 @data+48, <xmm4>
    fmov.f64 @data+56, <xmm5>
    fmov.f64 @data+64, xmm8
    fmov.f64 @data+72, xmm9
    fmov.f64 @data+80, xmm10
    fmov.f64 @data+88, xmm11
    fmov.f64 @data+96, xmm12
    fmov.f64 @data+104, [rbp-<off2>]
    fmov.f64 @data+112, [rbp-<off0>]
    fmov.f64 @data+120, [rbp-<off1>]
    fmov.f64 @data, xmm13
    mov rax, 0
    ret rax
