function @bump(%a : ptr) -> i64 [binding=internal] {
  block ^entry:
    %r = atomic_add_fetch i64 %a, 1, 5
    return i64 %r
}
function @count(%a : ptr) -> i64 {
  block ^entry:
    %x = call i64 @bump(%a)
    %r_2 = atomic_load i64 %a, 5
    %z = binary add i64 %x, %r_2
    return i64 %z
}
function @count_again(%a : ptr, %b : ptr) -> i64 {
  block ^entry:
    %x = call i64 @bump(%b)
    %r_2 = atomic_load i64 %a, 5
    %z = binary sub i64 %x, %r_2
    return i64 %z
}
function @product(%a : f80, %b : f80) -> f80 {
  block ^entry:
    %m_1 = binary mul f80 %a, %b
    %r_2 = binary add f80 %a, %m_1
    %m_3 = binary mul f80 %b, %r_2
    %r_4 = binary add f80 %r_2, %m_3
    return f80 %r_4
}
function @reset(%p : ptr, %q : ptr) -> void {
  block ^entry:
    zeroinit 256x8 %p
    zeroinit 256x8 %q
    return void
}
