machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_quotient
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rax
    ret rax

function @signed_remainder
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rdx
    ret rdx

function @unsigned_quotient
  abi
    param %a -> rdi : u32
    param %b -> rsi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, 0
    div.i32 rsi
    ret rax

function @unsigned_remainder
  abi
    param %a -> rdi : u32
    param %b -> rsi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, 0
    div.i32 rsi
    ret rdx

function @signed_memory
  abi
    param %a -> rdi : i32
    param %p -> rsi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rsi, [rsi]
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rdx
    ret rdx

function @wide
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo
    idiv rsi
    ret rax

function @negative_one
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r11, -1
    mov rax, rdi
    cqo
    idiv r11
    sext.i32 rax
    ret rax

function @narrow
  abi
    param %a -> rdi : i16
    param %b -> rsi : i16
    return i16 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo
    idiv rsi
    sext.i16 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $divisor -> [rbp-8] : i32
    temp %f -> [rbp-16] : i64
    temp %g -> [rbp-24] : i32

  block ^entry
    store.i32 [rbp-8], -3
    mov rdi, -2147483647
    mov rsi, -7
    call @signed_quotient [args=(rsi,rdi)]
    mov rbx, rax
    mov rdi, -2147483647
    mov rsi, 7
    call @signed_remainder [args=(rsi,rdi)]
    mov r12, rax
    mov rdi, 4294967289
    mov rsi, 7
    call @unsigned_quotient [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, 4294967289
    mov rsi, 10
    call @unsigned_remainder [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, -11
    lea rsi, [rbp-8]
    call @signed_memory [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, -77
    mov rsi, 7
    call @wide [args=(rsi,rdi)]
    mov r10, rax
    store.i64 [rbp-16], r10
    mov rdi, -2147483648
    call @negative_one [args=(rdi)]
    mov r10, rax
    store.i32 [rbp-24], r10
    mov rdi, -32768
    mov rsi, 3
    call @narrow [args=(rsi,rdi)]
    cmp.i32 rbx, 306783378
    setne rbx
    movzx rbx, rbx
    cmp.i32 r12, -1
    setne r12
    movzx r12, r12
    cmp.u32 r13, 613566755
    setne r13
    movzx r13, r13
    cmp.u32 r14, 9
    setne r14
    movzx r14, r14
    cmp.i32 r15, -2
    setne r15
    movzx r15, r15
    cmp.i64 [rbp-16], -11
    setne r8
    movzx r8, r8
    cmp.i32 [rbp-24], -2147483648
    setne r9
    movzx r9, r9
    cmp.i16 rax, -10922
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, r13
    or rbx, r14
    or rbx, r15
    or rbx, r8
    or rbx, r9
    or rbx, rax
    ret rbx
