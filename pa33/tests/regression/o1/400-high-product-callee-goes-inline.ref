function @high4(%a : i64, %b : i64, %c : i64, %d : i64, %e : i64) -> i64 [binding=strong] {
  block ^entry:
    %xa = convert zext i128 i64 %a
    %xb = convert zext i128 i64 %b
    %m1 = binary mul i128 %xa, %xb
    %s1 = binary ushr i128 %m1, 64
    %h1 = convert trunc i64 i128 %s1
    %x1 = convert zext i128 i64 %h1
    %xc = convert zext i128 i64 %c
    %m2 = binary mul i128 %x1, %xc
    %s2 = binary ushr i128 %m2, 64
    %h2 = convert trunc i64 i128 %s2
    %x2 = convert zext i128 i64 %h2
    %xd = convert zext i128 i64 %d
    %m3 = binary mul i128 %x2, %xd
    %s3 = binary ushr i128 %m3, 64
    %h3 = convert trunc i64 i128 %s3
    %x3 = convert zext i128 i64 %h3
    %xe = convert zext i128 i64 %e
    %m4 = binary mul i128 %x3, %xe
    %s4 = binary ushr i128 %m4, 64
    %h4 = convert trunc i64 i128 %s4
    return i64 %h4
}
function @use(%a : i64, %b : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %xa_1 = convert zext i128 i64 %a
    %xb_2 = convert zext i128 i64 %b
    %m1_3 = binary mul i128 %xa_1, %xb_2
    %s1_4 = binary ushr i128 %m1_3, 64
    %h1_5 = convert trunc i64 i128 %s1_4
    %x1_6 = convert zext i128 i64 %h1_5
    %xc_7 = convert zext i128 i64 %b
    %m2_8 = binary mul i128 %x1_6, %xc_7
    %s2_9 = binary ushr i128 %m2_8, 64
    %h2_10 = convert trunc i64 i128 %s2_9
    %x2_11 = convert zext i128 i64 %h2_10
    %xd_12 = convert zext i128 i64 %b
    %m3_13 = binary mul i128 %x2_11, %xd_12
    %s3_14 = binary ushr i128 %m3_13, 64
    %h3_15 = convert trunc i64 i128 %s3_14
    %x3_16 = convert zext i128 i64 %h3_15
    %xe_17 = convert zext i128 i64 %b
    %m4_18 = binary mul i128 %x3_16, %xe_17
    %s4_19 = binary ushr i128 %m4_18, 64
    %h4_20 = convert trunc i64 i128 %s4_19
    %xa_21 = convert zext i128 i64 %b
    %xb_22 = convert zext i128 i64 %a
    %m1_23 = binary mul i128 %xa_21, %xb_22
    %s1_24 = binary ushr i128 %m1_23, 64
    %h1_25 = convert trunc i64 i128 %s1_24
    %x1_26 = convert zext i128 i64 %h1_25
    %xc_27 = convert zext i128 i64 %a
    %m2_28 = binary mul i128 %x1_26, %xc_27
    %s2_29 = binary ushr i128 %m2_28, 64
    %h2_30 = convert trunc i64 i128 %s2_29
    %x2_31 = convert zext i128 i64 %h2_30
    %xd_32 = convert zext i128 i64 %a
    %m3_33 = binary mul i128 %x2_31, %xd_32
    %s3_34 = binary ushr i128 %m3_33, 64
    %h3_35 = convert trunc i64 i128 %s3_34
    %x3_36 = convert zext i128 i64 %h3_35
    %xe_37 = convert zext i128 i64 %a
    %m4_38 = binary mul i128 %x3_36, %xe_37
    %s4_39 = binary ushr i128 %m4_38, 64
    %h4_40 = convert trunc i64 i128 %s4_39
    %r = binary add i64 %h4_20, %h4_40
    return i64 %r
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %r = call i64 @use(-1, 4294967296)
    %ok = cmp eq i64 %r, 4294967292
    %t = convert trunc i32 i64 %ok
    %code = binary sub i32 1, %t
    return i32 %code
}
