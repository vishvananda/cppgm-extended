global @sink : i64 = 0

function @split_entry_edge(%choose : i64, %left : i64, %right : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %choose, ^unrolled_1, ^bypass

  block ^unrolled_1:
    %t1 = binary sub i64 %left, %right
    store i64 %t1, @sink
    return i64 0

  block ^bypass:
    return i64 1
}
