machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @both
  abi
    param %x -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm1, xmm0
    vector.sqrtsd xmm1, xmm1, xmm1
    fadd.f64 xmm0, xmm1, xmm0
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm0, 4.0
    call @both [args=(xmm0)]
    fptosi.f64.i32 rax, xmm0
    sext.i32 rax
    sub.i32 rax, 6
    ret rax
