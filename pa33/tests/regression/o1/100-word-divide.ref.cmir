machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_quotient
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rax
    ret rax

function @signed_remainder
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rdx
    ret rdx

function @unsigned_quotient
  abi
    param %a -> rdi : u32
    param %b -> rsi : u32
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, 0
    div.i32 rsi
    ret rax

function @unsigned_remainder
  abi
    param %a -> rdi : u32
    param %b -> rsi : u32
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, 0
    div.i32 rsi
    ret rdx

function @signed_memory
  abi
    param %a -> rdi : i32
    param %p -> rsi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rsi, [rsi]
    mov rax, rdi
    cqo.i32
    idiv.i32 rsi
    sext.i32 rdx
    ret rdx

function @wide
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo
    idiv rsi
    ret rax

function @negative_one
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov <gpr0>, -1
    mov rax, rdi
    cqo
    idiv <gpr0>
    sext.i32 rax
    ret rax

function @narrow
  abi
    param %a -> rdi : i16
    param %b -> rsi : i16
    return i16 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    cqo
    idiv rsi
    sext.i16 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2> <gpr3> <gpr4> <gpr5>
    slot $divisor -> [rbp-<off0>] : i32
    temp %f -> [rbp-<off1>] : i64
    temp %g -> [rbp-<off2>] : i32

  block ^entry
    store.i32 [rbp-<off0>], -3
    mov rdi, -2147483647
    mov rsi, -7
    call @signed_quotient [args=(rsi,rdi)]
    mov <gpr1>, rax
    mov rdi, -2147483647
    mov rsi, 7
    call @signed_remainder [args=(rsi,rdi)]
    mov <gpr2>, rax
    mov rdi, 4294967289
    mov rsi, 7
    call @unsigned_quotient [args=(rsi,rdi)]
    mov <gpr3>, rax
    mov rdi, 4294967289
    mov rsi, 10
    call @unsigned_remainder [args=(rsi,rdi)]
    mov <gpr4>, rax
    mov rdi, -11
    lea rsi, [rbp-<off0>]
    call @signed_memory [args=(rsi,rdi)]
    mov <gpr5>, rax
    mov rdi, -77
    mov rsi, 7
    call @wide [args=(rsi,rdi)]
    mov <gpr6>, rax
    store.i64 [rbp-<off1>], <gpr6>
    mov rdi, -2147483648
    call @negative_one [args=(rdi)]
    mov <gpr6>, rax
    store.i32 [rbp-<off2>], <gpr6>
    mov rdi, -32768
    mov rsi, 3
    call @narrow [args=(rsi,rdi)]
    cmp.i32 <gpr1>, 306783378
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i32 <gpr2>, -1
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.u32 <gpr3>, 613566755
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    cmp.u32 <gpr4>, 9
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    cmp.i32 <gpr5>, -2
    setne <gpr5>
    movzx <gpr5>, <gpr5>
    cmp.i64 [rbp-<off1>], -11
    setne r8
    movzx r8, r8
    cmp.i32 [rbp-<off2>], -2147483648
    setne r9
    movzx r9, r9
    cmp.i16 rax, -10922
    setne rax
    movzx rax, rax
    or <gpr1>, <gpr2>
    or <gpr1>, <gpr3>
    or <gpr1>, <gpr4>
    or <gpr1>, <gpr5>
    or <gpr1>, r8
    or <gpr1>, r9
    or <gpr1>, rax
    ret <gpr1>
