machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @negate
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    neg rax
    ret rax

function @larger
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    mov rax, rsi
    cmovg rax, rdi
    ret rax

function @below
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return u8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    setl rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 5
    call @negate [args=(rdi)]
    sext.i32 rax
    cmp.i64 rax, -5
    je ^next

  block ^bad
    mov rax, 1
    ret rax

  block ^next
    mov rdi, -7
    mov rsi, 3
    call @larger [args=(rsi,rdi)]
    sext.i32 rax
    cmp.i64 rax, 3
    jne ^bad

  block ^last
    mov rdi, -7
    mov rsi, 3
    call @below [args=(rsi,rdi)]
    zext.i8 rax
    cmp.i64 rax, 1
    jne ^bad

  block ^good
    mov rax, 0
    ret rax
