global @word_storage = {
  zero 16
}

function @both_fields(%p : ptr, %bw : u32) -> u8 [binding=strong, no_inline=yes] {
  block ^entry:
    %at = index inbounds i8 %p, 8
    %w = load i32 %at
    %t3 = load u8 %at
    %is = cmp eq u8 %t3, 12
    %field = binary ushr i32 %w, 8
    %u = copy u32 %field
    %same = cmp eq u32 %bw, %u
    %t8 = select i64 %is, %same, 0
    %out = convert trunc u8 i64 %t8
    return u8 %out
}
function @renamed(%x : i32, %y : i32) -> i32 [binding=strong, no_inline=yes] {
  block ^entry:
    %big = cmp gt i32 %x, 100
    %ux = copy u32 %x
    %m = binary mul u32 %ux, 3
    %sm = copy i32 %m
    %s = binary add i32 %y, %sm
    %t6 = select i32 %big, %s, %y
    return i32 %t6
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %at = index inbounds i8 @word_storage, 8
    store i32 8204, %at
    %a = call u8 @both_fields(@word_storage, 32)
    %b = call u8 @both_fields(@word_storage, 33)
    store i32 8205, %at
    %c = call u8 @both_fields(@word_storage, 32)
    %d = call i32 @renamed(200, 7)
    %e = call i32 @renamed(2, 7)
    %ok0 = cmp eq u8 %a, 1
    %ok1 = cmp eq u8 %b, 0
    %ok2 = cmp eq u8 %c, 0
    %ok3 = cmp eq i32 %d, 607
    %ok4 = cmp eq i32 %e, 7
    %a0 = binary and i64 %ok0, %ok1
    %a1 = binary and i64 %ok2, %a0
    %a2 = binary and i64 %ok3, %a1
    %a3 = binary and i64 %ok4, %a2
    %r = convert trunc i32 i64 %a3
    %code = binary sub i32 1, %r
    return i32 %code
}
