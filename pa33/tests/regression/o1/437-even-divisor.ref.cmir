machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @billions
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    shr rax, 9
    mov <gpr0>, 19342813113834067
    mul <gpr0>
    shr rdx, 11
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2>

  block ^entry
    mov rdi, -1
    call @billions [args=(rdi)]
    mov <gpr1>, rax
    mov rdi, 999999999
    call @billions [args=(rdi)]
    mov <gpr2>, rax
    mov rdi, 1000000000
    call @billions [args=(rdi)]
    add <gpr2>, rax
    mov rax, <gpr1>
    mov <gpr0>, -6067343680855748867
    mul <gpr0>
    shr rdx, 26
    add rdx, <gpr2>
    sext.i32 rdx
    ret rdx
