function @choose(%condition : i64) -> i64 {
  block ^entry:
    %t1 = select i64 %condition, 11, 22
    return i64 %t1
}
function @caller(%use_call : i64, %condition : i64) -> i64 [binding=strong] {
  block ^entry:
    %t1 = select i64 %condition, 11, 22
    %t2 = select i64 %use_call, %t1, 33
    return i64 %t2
}
