function @min_of(%a : i64, %b : i64) -> i64 {
  block ^entry:
    %less = cmp ult i64 %b, %a
    %t2 = select i64 %less, %b, %a
    return i64 %t2
}
function @min_kept_after_store(%a : i64, %b : i64, %out : ptr) -> i64 {
  block ^entry:
    %less = cmp ult i64 %b, %a
    branch %less, ^then, ^end

  block ^then:
    store i64 7, %out
    jump ^end

  block ^end:
    %v = phi i64 [^entry: %a, ^then: %b]
    return i64 %v
}
function @min_of_fields(%q : ptr) -> i64 {
  block ^entry:
    %y = index i8 %q, 8
    %vx = load i64 %q
    %vy = load i64 %y
    %less = cmp ult i64 %vy, %vx
    %t5 = select i64 %less, %vy, %vx
    return i64 %t5
}
