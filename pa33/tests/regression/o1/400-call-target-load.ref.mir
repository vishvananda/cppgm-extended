machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @one
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea rax, [rdi+1]
    ret rax

function @through
  abi
    param %x -> rdi : i64
    param %cell -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call *[rsi] [args=(rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $cell -> [rbp-8] : obj<8x8>

  block ^entry
    mov r11, @one
    store.ptr [rbp-8], r11
    mov rdi, 41
    lea rsi, [rbp-8]
    call @through [args=(rsi,rdi)]
    sext.i32 rax
    ret rax
