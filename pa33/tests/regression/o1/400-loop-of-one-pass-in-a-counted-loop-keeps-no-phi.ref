function @nest(%p : ptr) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    store i64 5, %p
    %t1 = index i64 %p, 1
    store i64 6, %t1
    return i64 13
}
function @main() -> i32 [role=entry] {
  slot $a : obj<16x8>

  block ^entry:
    %p = addr $a
    store i64 0, %p
    %q = index i64 %p, 1
    store i64 0, %q
    %r = call i64 @nest(%p)
    %first = load i64 %p
    %second = load i64 %q
    %ok0 = cmp eq i64 %r, 13
    %ok1 = cmp eq i64 %first, 5
    %ok2 = cmp eq i64 %second, 6
    %a0 = binary and i64 %ok0, %ok1
    %a1 = binary and i64 %ok2, %a0
    %t = convert trunc i32 i64 %a1
    %code = binary sub i32 1, %t
    return i32 %code
}
