declare function @observe(%value : i64) -> void [unwind=no]
declare function @risky() -> void
declare function @more() -> i64 [unwind=no]

global @bang_type : i8 = 0

function @fold_through_jump_and_unrelated_branch(%flag : i64, %other : i64) -> i64 {
  block ^entry:
    branch %flag, ^taken, ^skipped

  block ^taken:
    call void @observe(1)
    branch %other, ^again, ^known

  block ^again:
    call void @observe(2)
    return i64 5

  block ^known:
    return i64 7

  block ^skipped:
    return i64 3
}
function @keep_when_chain_merges(%flag : i64, %other : i64) -> i64 {
  block ^entry:
    branch %flag, ^taken, ^skipped

  block ^taken:
    call void @observe(1)
    jump ^merge

  block ^skipped:
    call void @observe(2)
    jump ^merge

  block ^merge:
    call void @observe(3)
    %t1 = select i64 %flag, 7, 3
    return i64 %t1
}
function @keep_across_landing_pad(%flag : i64) -> i64 {
  block ^entry:
    branch %flag, ^taken, ^skipped

  block ^taken:
    eh_try ^catch_dispatch
    call void @risky()
    eh_end
    return i64 1

  block ^catch_dispatch:
    eh_catch @bang_type, 1
    %selector = exception_selector i32
    %matched = cmp eq i32 %selector, 1
    branch %matched, ^left, ^catch_next

  block ^left:
    return i64 7

  block ^catch_next:
    resume

  block ^skipped:
    return i64 3
}
function @keep_entry_back_edge(%p : i64) -> i64 {
  block ^entry:
    branch %p, ^exit, ^body

  block ^body:
    call void @observe(1)
    return i64 3

  block ^exit:
    return i64 7
}
function @keep_entry_branch_from_latch(%p : i64) -> i64 {
  block ^entry:
    branch %p, ^left, ^right

  block ^left:
    call void @observe(1)
    jump ^latch

  block ^right:
    call void @observe(2)
    jump ^latch

  block ^latch:
    %again = call i64 @more()
    branch %again, ^check, ^out

  block ^check:
    branch %p, ^entry, ^out

  block ^out:
    return i64 3
}
