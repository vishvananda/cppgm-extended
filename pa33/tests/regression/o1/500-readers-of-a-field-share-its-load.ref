global @seen : i64 = 0
global @odd_word : obj<4x4> = {
  i32 20743
}
global @even_word : obj<4x4> = {
  i32 8201
}

function @note(%v : i64) -> void [binding=strong, no_inline=yes] {
  block ^entry:
    %old = load i64 @seen
    %new = binary add i64 %v, %old
    store i64 %new, @seen
    return void
}
function @visit(%p : ptr) -> void [binding=strong, no_inline=yes] {
  block ^entry:
    %w = load i32 %p
    %t2 = load u8 %p
    %up = binary ushr i32 %w, 12
    %t4 = binary and i32 %w, 4096
    branch %t4, ^odd, ^even

  block ^odd:
    %kind_here = convert zext i32 u8 %t2
    %sum = binary add i32 %up, %kind_here
    %wide_sum = convert zext i64 i32 %sum
    call void @note(%wide_sum)
    jump ^done

  block ^even:
    %kind_there = convert zext i32 u8 %t2
    %product = binary mul i32 %kind_there, 3
    %wide_product = convert zext i64 i32 %product
    call void @note(%wide_product)
    call void @note(1000)
    jump ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    call void @visit(@odd_word)
    call void @visit(@even_word)
    %total = load i64 @seen
    %ok = cmp eq i64 %total, 1039
    %status = select i32 %ok, 0, 1
    return i32 %status
}
