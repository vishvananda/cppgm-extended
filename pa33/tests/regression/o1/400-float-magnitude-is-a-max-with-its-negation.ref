function @magnitude(%x : f32) -> f32 [binding=strong, no_inline=yes] {
  block ^entry:
    %n = unary neg f32 %x
    %t2 = vector fromf32 %n
    %t3 = vector fromf32 %x
    %t4 = vector maxps %t2, %t3
    %t5 = vector tof32 %t4
    return f32 %t5
}
function @positive_or_negated(%x : f64) -> f64 [binding=strong, no_inline=yes] {
  block ^entry:
    %n = unary neg f64 %x
    %t2 = vector fromf64 %x
    %t3 = vector fromf64 %n
    %t4 = vector maxpd %t2, %t3
    %t5 = vector tof64 %t4
    return f64 %t5
}
function @negative_magnitude(%x : f64) -> f64 [binding=strong, no_inline=yes] {
  block ^entry:
    %n = unary neg f64 %x
    %t2 = vector fromf64 %x
    %t3 = vector fromf64 %n
    %t4 = vector minpd %t2, %t3
    %t5 = vector tof64 %t4
    return f64 %t5
}
function @zero_first(%x : f64) -> f64 [binding=strong, no_inline=yes] {
  block ^entry:
    %n = unary neg f64 %x
    %t2 = vector fromf64 %n
    %t3 = vector fromf64 %x
    %t4 = vector maxpd %t2, %t3
    %t5 = vector tof64 %t4
    return f64 %t5
}
function @not_strict(%x : f64) -> f64 [binding=strong, no_inline=yes] {
  block ^entry:
    %c = cmp le f64 %x, 0
    branch %c, ^negate, ^out

  block ^negate:
    %n = unary neg f64 %x
    jump ^out

  block ^out:
    %r = phi f64 [^negate: %n, ^entry: %x]
    return f64 %r
}
function @below(%x : f64, %p : ptr) -> i32 [binding=strong, no_inline=yes] {
  block ^entry:
    return i32 0
}
function @main() -> i32 [role=entry] {
  slot $seen : i32

  block ^entry:
    %s = addr $seen
    store i32 0, %s
    %j = call i32 @below(-2.0, %s)
    %a = call f32 @magnitude(-3f)
    %b = call f32 @magnitude(2f)
    %c = call f64 @positive_or_negated(-5.0)
    %d = call f64 @positive_or_negated(4.0)
    %e = call f64 @negative_magnitude(-6.0)
    %f = call f64 @negative_magnitude(7.0)
    %g = call f64 @zero_first(-8.0)
    %h = call f64 @zero_first(9.0)
    %i = call f64 @not_strict(-1.0)
    %ok0 = cmp eq f32 %a, 3f
    %ok1 = cmp eq f32 %b, 2f
    %ok2 = cmp eq f64 %c, 5
    %ok3 = cmp eq f64 %d, 4
    %ok4 = cmp eq f64 %e, -6
    %ok5 = cmp eq f64 %f, -7
    %ok6 = cmp eq f64 %g, 8
    %ok7 = cmp eq f64 %h, 9
    %ok8 = cmp eq f64 %i, 1
    %ok9 = cmp eq i32 %j, 0
    %a0 = binary and i64 %ok0, %ok1
    %a1 = binary and i64 %ok2, %a0
    %a2 = binary and i64 %ok3, %a1
    %a3 = binary and i64 %ok4, %a2
    %a4 = binary and i64 %ok5, %a3
    %a5 = binary and i64 %ok6, %a4
    %a6 = binary and i64 %ok7, %a5
    %a7 = binary and i64 %ok8, %a6
    %a8 = binary and i64 %ok9, %a7
    %r = convert trunc i32 i64 %a8
    %code = binary sub i32 1, %r
    return i32 %code
}
