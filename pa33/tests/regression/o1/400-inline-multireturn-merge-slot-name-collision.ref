function @callee(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    %t2 = binary add i64 %x, 1
    %t3 = select i64 %take_x, %x, %t2
    return i64 %t3
}
function @caller(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    %t2_1 = binary add i64 %x, 1
    %t2 = select i64 %take_x, %x, %t2_1
    return i64 %t2
}
function @object_callee(%p : ptr, %take_p : u8) -> i64 {
  block ^entry:
    %t1 = copy i64 %p
    %t2 = select i64 %take_p, %t1, 0
    return i64 %t2
}
function @object_caller(%p : ptr, %take_p : u8, %out : ptr) -> void {
  block ^entry:
    %t2 = select ptr %take_p, %p, 0
    %t1 = copy i64 %t2
    store i64 %t1, %out
    return void
}
