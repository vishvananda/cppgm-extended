function @callee(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    branch %take_x, ^take_x, ^increment

  block ^take_x:
    return i64 %x

  block ^increment:
    %t2 = binary add i64 %x, 1
    return i64 %t2
}
function @caller(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    %t2_1 = binary add i64 %x, 1
    %t2 = select i64 %take_x, %x, %t2_1
    return i64 %t2
}
function @object_callee(%p : ptr, %take_p : u8) -> i64 {
  block ^entry:
    branch %take_p, ^take_p, ^take_null

  block ^take_p:
    %t1 = copy i64 %p
    return i64 %t1

  block ^take_null:
    return i64 0
}
function @object_caller(%p : ptr, %take_p : u8, %out : ptr) -> void {
  block ^entry:
    %t2 = select ptr %take_p, %p, 0
    %t1 = copy i64 %t2
    store i64 %t1, %out
    return void
}
