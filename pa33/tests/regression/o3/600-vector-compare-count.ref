function @count(%p : ptr) -> i32 [no_inline=yes] {
  block ^entry:
    jump ^unrolled_1

  block ^unrolled_1:
    %t1 = phi i32 [^unrolled_1: %t22, ^entry: 0]
    %t2 = phi i64 [^unrolled_1: %t23, ^entry: 0]
    %t3 = index i32 %p, %t2
    %t4 = load typed i32 %t3
    %t5 = cmp ne i32 %t4, 0
    %t6 = convert trunc i32 i64 %t5
    %t7 = binary add nowrap i32 %t1, %t6
    %t8 = index i32 %t3, 1
    %t9 = load typed i32 %t8
    %t10 = cmp ne i32 %t9, 0
    %t11 = convert trunc i32 i64 %t10
    %t12 = binary add nowrap i32 %t7, %t11
    %t13 = index i32 %t3, 2
    %t14 = load typed i32 %t13
    %t15 = cmp ne i32 %t14, 0
    %t16 = convert trunc i32 i64 %t15
    %t17 = binary add nowrap i32 %t12, %t16
    %t18 = index i32 %t3, 3
    %t19 = load typed i32 %t18
    %t20 = cmp ne i32 %t19, 0
    %t21 = convert trunc i32 i64 %t20
    %t22 = binary add nowrap i32 %t17, %t21
    %t23 = binary add nowrap i64 %t2, 4
    %t24 = cmp ne i64 %t23, 256
    branch %t24, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    return i32 %t22
}
function @main() -> i32 [role=entry] {
  slot $a : obj<1024x16>

  block ^entry:
    %p = addr $a
    zeroinit 1024x16 %p
    %q = index i32 %p, 7
    store typed i32 3, %q
    %r = index i32 %p, 200
    store typed i32 -1, %r
    %n = call i32 @count(%p)
    return i32 %n
}
