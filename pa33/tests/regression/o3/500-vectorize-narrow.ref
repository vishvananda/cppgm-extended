    %t7 = cmp ule ptr %t5, %x
    %t8 = binary or i64 %t6, %t7
    %t9 = index i8 %y, %n
    %t10 = cmp ule ptr %t9, %d
    %t11 = cmp ule ptr %t5, %y
    %t12 = binary or i64 %t10, %t11
    %t13 = binary and i64 %t8, %t12
    branch %t13, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t14 = binary add i64 %n, -16
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t15 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t22]
    %t16 = index u8 %x, %t15
    %t17 = load v128 %t16
    %t18 = index u8 %y, %t15
    %t19 = load v128 %t18
    %t20 = vector paddb %t17, %t19
    %t21 = index u8 %d, %t15
    store v128 %t20, %t21
    %t22 = binary add nowrap i64 %t15, 16
    %t23 = cmp le i64 %t22, %t14
    branch %t23, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t24 = cmp lt i64 %t22, %n
    branch %t24, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t25 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^loop_exit_4: %t22]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t25, ^body: %next]
    %p = index u8 %x, %i
    %a = load u8 %p
    %q = index u8 %y, %i
    %b = load u8 %q
    %t = binary add u8 %a, %b
    %o = index u8 %d, %i
    store u8 %t, %o
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
