global @seen : obj<8x8> = {
  zero 8
}

function @keep(%p : ptr) -> void [no_inline=yes] {
  block ^entry:
    store ptr %p, @seen
    return void
}
function @entered_from_branch(%c : i32, %k : i64) -> i64 [no_inline=yes] {
  slot $s : obj<8x8>

  block ^entry:
    %p = addr $s
    call void @keep(%p)
    store i64 0, %p
    branch %c, ^unrolled_1, ^exit

  block ^unrolled_1:
    %t2 = binary mul i64 %k, %k
    %t3 = binary sub i64 %t2, %k
    %t4 = binary mul i64 %k, %t3
