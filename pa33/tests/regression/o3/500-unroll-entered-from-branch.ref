    %t174 = binary mul i64 %k, %t173
    %t175 = binary sub i64 %t174, %k
    %t176 = binary mul i64 %k, %t175
    %t177 = binary sub i64 %t176, %k
    %t178 = binary mul i64 %k, %t177
    %t179 = binary sub i64 %t178, %k
    %t180 = binary mul i64 %k, %t179
    %t181 = binary sub i64 %t180, %k
    jump ^exit

  block ^exit:
    %last = phi i64 [^entry: 0, ^unrolled_1: %t145]
    %r = phi i64 [^entry: 1, ^unrolled_1: %t181]
    %sum = binary add i64 %r, %last
    return i64 %sum
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call i64 @entered_from_branch(1, 2)
    %b = call i64 @entered_from_branch(0, 2)
    %s = binary add i64 %a, %b
    %out = convert trunc i32 i64 %s
    return i32 %out
}
