    %t145 = binary sub i64 %t144, %k
    store i64 %t145, %p
    %t146 = binary mul i64 %k, %t145
    %t147 = binary sub i64 %t146, %k
    %t148 = binary mul i64 %k, %t147
    %t149 = binary sub i64 %t148, %k
