global @values : obj<40x8> = {
  i64 2
  i64 4
  i64 6
  i64 8
  i64 10
}
global @probes : i64 = 0

function @search(%wanted : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %base = addr @values
    %t2 = load volatile i64 @probes
    %t3 = binary add i64 %t2, 1
    store volatile i64 %t3, @probes
    %t4 = load i64 %base
    %t5 = cmp eq i64 %wanted, %t4
    branch %t5, ^done, ^unrolled_1

  block ^unrolled_1:
    %t6 = index i64 %base, 1
    %t7 = load volatile i64 @probes
    %t8 = binary add i64 %t7, 1
    store volatile i64 %t8, @probes
    %t9 = load i64 %t6
    %t10 = cmp eq i64 %wanted, %t9
    branch %t10, ^split_2, ^unrolled_3

  block ^split_2:
    %t11 = index i64 %base, 1
    jump ^done

  block ^unrolled_3:
    %t12 = index i8 %base, 16
    %t13 = load volatile i64 @probes
    %t14 = binary add i64 %t13, 1
    store volatile i64 %t14, @probes
    %t15 = load i64 %t12
    %t16 = cmp eq i64 %wanted, %t15
    branch %t16, ^split_4, ^unrolled_5

  block ^split_4:
    %t17 = index i8 %base, 16
    jump ^done

  block ^unrolled_5:
    %t18 = index i8 %base, 24
    %t19 = load volatile i64 @probes
    %t20 = binary add i64 %t19, 1
    store volatile i64 %t20, @probes
    %t21 = load i64 %t18
    %t22 = index i8 %base, 32
    %t23 = cmp eq i64 %wanted, %t21
    %t24 = select ptr %t23, %t18, %t22
    jump ^done

  block ^done:
    %result = phi ptr [^entry: %base, ^split_2: %t11, ^split_4: %t17, ^unrolled_5: %t24]
    %bytes = binary sub ptr %result, %base
    return i64 %bytes
}
function @backward(%wanted : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %base = addr @values
    %begin = index i64 %base, 4
    %t3 = load i64 %begin
    %t4 = cmp eq i64 %wanted, %t3
    branch %t4, ^split_1, ^unrolled_2

  block ^split_1:
    %t5 = index i64 %base, 4
    jump ^done

  block ^unrolled_2:
    %t6 = index i8 %base, 24
    %t7 = load i64 %t6
    %t8 = cmp eq i64 %wanted, %t7
    branch %t8, ^split_3, ^unrolled_4

  block ^split_3:
    %t9 = index i8 %base, 24
    jump ^done

  block ^unrolled_4:
    %t10 = index i8 %base, 16
    %t11 = load i64 %t10
    %t12 = cmp eq i64 %wanted, %t11
    branch %t12, ^split_5, ^unrolled_6

  block ^split_5:
    %t13 = index i8 %base, 16
    jump ^done

  block ^unrolled_6:
    %t14 = index i8 %base, 8
    %t15 = load i64 %t14
    %t16 = cmp eq i64 %wanted, %t15
    %t17 = select ptr %t16, %t14, %base
    jump ^done

  block ^done:
    %result = phi ptr [^split_1: %t5, ^split_3: %t9, ^split_5: %t13, ^unrolled_6: %t17]
    %bytes = binary sub ptr %result, %base
    return i64 %bytes
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call i64 @search(2)
    %count_a = load volatile i64 @probes
    %b = call i64 @search(8)
    %count_b = load volatile i64 @probes
    %c = call i64 @search(10)
    %count_c = load volatile i64 @probes
    %d = call i64 @backward(10)
    %e = call i64 @backward(4)
    %f = call i64 @backward(2)
    %aa = cmp eq i64 %a, 0
    %bb = cmp eq i64 %b, 24
    %cc = cmp eq i64 %c, 32
    %dd = cmp eq i64 %d, 32
    %ee = cmp eq i64 %e, 8
    %ff = cmp eq i64 %f, 0
    %ca = cmp eq i64 %count_a, 1
    %cb = cmp eq i64 %count_b, 5
    %ccount = cmp eq i64 %count_c, 9
    %ab = binary and i1 %aa, %bb
    %cd = binary and i1 %cc, %dd
    %ef = binary and i1 %ee, %ff
    %abcd = binary and i1 %ab, %cd
    %indices = binary and i1 %ef, %abcd
    %cab = binary and i1 %ca, %cb
    %counts = binary and i1 %ccount, %cab
    %ok = binary and i1 %indices, %counts
    %r = select i32 %ok, 0, 1
    return i32 %r
}
