    %p = index i32 %a, %j
    %v = load typed i32 %p
    %r = binary add i32 %v, 1
    %o = index i32 %a, %i
    store typed i32 %r, %o
    %c = cmp lt i64 %j, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
