function @pick(%node : ptr, %depth : i64) -> i64 [binding=strong] {
  block ^entry:
    branch %depth, ^down, ^done

  block ^down:
    %link = index i8 %node, 16
    %child = load ptr %link
    %less = binary sub i64 %depth, 1
    %r = call i64 @gate(%child, %less)
    return i64 %r

  block ^done:
    return i64 0
}
function @route(%node : ptr, %depth : i64) -> i64 [binding=strong] {
  block ^entry:
    %kind = load i64 %node
    %at = index i8 %node, 8
    %value = load i64 %at
    branch %kind, ^inline_entry_1, ^leaf

  block ^inline_entry_1:
    branch %depth, ^down_2, ^inline_cont_3

  block ^down_2:
    %link_4 = index i8 %node, 16
    %child_5 = load ptr %link_4
    %less_6 = binary sub i64 %depth, 1
    %r_7 = call i64 @gate(%child_5, %less_6)
    jump ^inline_cont_3

  block ^inline_cont_3:
    %below = phi i64 [^down_2: %r_7, ^inline_entry_1: 0]
    %sum = binary add i64 %value, %below
    return i64 %sum

  block ^leaf:
    return i64 %value
}
function @walk(%first : ptr, %depth : i64) -> i64 [binding=strong] {
  block ^entry:
    %live = cmp ne ptr %first, 0
    branch %live, ^inline_entry_1, ^done

  block ^inline_entry_1:
    %t2 = phi i64 [^inline_cont_5: %more, ^entry: 0]
    %t3 = phi ptr [^inline_cont_5: %next, ^entry: %first]
    %kind_4 = load i64 %t3
    %at_5 = index i8 %t3, 8
    %value_6 = load i64 %at_5
    branch %kind_4, ^inline_entry_2, ^inline_cont_5

  block ^inline_entry_2:
    branch %depth, ^inline_copy_3, ^inline_cont_4

  block ^inline_copy_3:
    %link_7 = index i8 %t3, 16
    %child_8 = load ptr %link_7
    %less_9 = binary sub i64 %depth, 1
    %r_10 = call i64 @gate(%child_8, %less_9)
    jump ^inline_cont_4

  block ^inline_cont_4:
    %below_11 = phi i64 [^inline_copy_3: %r_10, ^inline_entry_2: 0]
    %sum_12 = binary add i64 %value_6, %below_11
    jump ^inline_cont_5

  block ^inline_cont_5:
    %one = phi i64 [^inline_cont_4: %sum_12, ^inline_entry_1: %value_6]
    %more = binary add i64 %one, %t2
    %link = index i8 %t3, 24
    %next = load ptr %link
    %t17 = cmp ne ptr %next, 0
    branch %t17, ^inline_entry_1, ^done

  block ^done:
    %t18 = phi i64 [^entry: 0, ^inline_cont_5: %more]
    return i64 %t18
}
function @gate(%node : ptr, %depth : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %r = call i64 @walk(%node, %depth)
    return i64 %r
}
function @pong(%n : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %r = call i64 @ping(%n)
    %s = binary add i64 %r, 1
    return i64 %s
}
function @ping(%n : i64) -> i64 [binding=strong] {
  block ^0:
    branch %n, ^more, ^done

  block ^more:
    %t1 = phi i64 [^more: %half, ^0: %n]
    %t2 = phi i64 [^more: %t6, ^0: 0]
    %less = binary sub i64 %t1, 1
    %a = call i64 @pong(%less)
    %half = binary ushr i64 %less, 1
    %t6 = binary add i64 %a, %t2
    branch %half, ^more, ^done

  block ^done:
    %t7 = phi i64 [^0: 0, ^more: %t6]
    %t8 = binary add i64 %t7, 1
    return i64 %t8
}
function @outside(%node : ptr, %depth : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %kind_1 = load i64 %node
    %at_2 = index i8 %node, 8
    %value_3 = load i64 %at_2
    branch %kind_1, ^inline_entry_1, ^inline_cont_4

  block ^inline_entry_1:
    branch %depth, ^inline_copy_2, ^inline_cont_3

  block ^inline_copy_2:
    %link_4 = index i8 %node, 16
    %child_5 = load ptr %link_4
    %less_6 = binary sub i64 %depth, 1
    %r_7 = call i64 @gate(%child_5, %less_6)
    jump ^inline_cont_3

  block ^inline_cont_3:
    %below_8 = phi i64 [^inline_copy_2: %r_7, ^inline_entry_1: 0]
    %sum_9 = binary add i64 %value_3, %below_8
    jump ^inline_cont_4

  block ^inline_cont_4:
    %r = phi i64 [^inline_cont_3: %sum_9, ^entry: %value_3]
    %p = call i64 @ping(%depth)
    %s = binary add i64 %r, %p
    return i64 %s
}
function @main() -> i32 [role=entry] {
  slot $leaf_node : obj<32x8>
  slot $root_node : obj<32x8>

  block ^entry:
    %leaf = addr $leaf_node
    %root = addr $root_node
    store i64 0, %leaf
    %leaf_value = index i8 %leaf, 8
    store i64 5, %leaf_value
    %leaf_child = index i8 %leaf, 16
    store ptr 0, %leaf_child
    %leaf_next = index i8 %leaf, 24
    store ptr 0, %leaf_next
    store i64 1, %root
    %root_value = index i8 %root, 8
    store i64 7, %root_value
    %root_child = index i8 %root, 16
    store ptr %leaf, %root_child
    %root_next = index i8 %root, 24
    store ptr %leaf, %root_next
    %r = call i64 @outside(%root, 3)
    %t = convert trunc i32 i64 %r
    return i32 %t
}
