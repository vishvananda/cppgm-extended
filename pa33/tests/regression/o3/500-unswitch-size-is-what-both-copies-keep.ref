    %a25 = binary xor i64 %a24, %t2
    %a26 = binary add i64 %v, %a25
    %a27 = binary ushr i64 %a26, 7
    %a28 = binary mul i64 %a27, 3
    %a29 = binary xor i64 %a28, %t2
    %a30 = binary add i64 %v, %a29
    %a31 = binary ushr i64 %a30, 7
    %a32 = binary mul i64 %a31, 3
    %a33 = binary xor i64 %a32, %t2
    %a34 = binary add i64 %v, %a33
    %a35 = binary ushr i64 %a34, 7
    %a36 = binary mul i64 %a35, 3
    %a37 = binary xor i64 %a36, %t2
    %a38 = binary add i64 %v, %a37
    %a39 = binary ushr i64 %a38, 7
    %a40 = binary mul i64 %a39, 3
    %a41 = binary xor i64 %a40, %t2
    %a42 = binary add i64 %v, %a41
    %a43 = binary ushr i64 %a42, 7
    %a44 = binary mul i64 %a43, 3
    %a45 = binary xor i64 %a44, %t2
    %a46 = binary add i64 %v, %a45
    %a47 = binary ushr i64 %a46, 7
    %a48 = binary mul i64 %a47, 3
    %a49 = binary xor i64 %a48, %t2
    %a50 = binary add i64 %v, %a49
    %a51 = binary ushr i64 %a50, 7
    %a52 = binary mul i64 %a51, 3
    %a53 = binary xor i64 %a52, %t2
    %a54 = binary add i64 %v, %a53
    %a55 = binary ushr i64 %a54, 7
    %a56 = binary mul i64 %a55, 3
    %a57 = binary xor i64 %a56, %t2
    %a58 = binary add i64 %v, %a57
    %a59 = binary ushr i64 %a58, 7
    %a60 = binary mul i64 %a59, 3
    %a61 = binary xor i64 %a60, %t2
    %a62 = binary add i64 %v, %a61
    %a63 = binary ushr i64 %a62, 7
    %a64 = binary mul i64 %a63, 3
    %a65 = binary xor i64 %a64, %t2
    %a66 = binary add i64 %v, %a65
    %a67 = binary ushr i64 %a66, 7
    %a68 = binary mul i64 %a67, 3
    %a69 = binary xor i64 %a68, %t2
    %a70 = binary add i64 %v, %a69
    %a71 = binary ushr i64 %a70, 7
    store typed i64 %a71, %at
    %next = binary add nowrap i64 %t2, 1
    %t78 = cmp lt i64 %next, %n
    branch %t78, ^body, ^exit

  block ^loop_preheader_3:
    %t79 = phi i64 [^loop_preheader_3: %t82, ^loop_preheader_1: 0]
    %t80 = index i64 %p, %t79
    %t81 = load typed i64 %t80
    call void @touch(%t81)
    %t82 = binary add nowrap i64 %t79, 1
    %t83 = cmp lt i64 %t82, %n
    branch %t83, ^loop_preheader_3, ^exit

  block ^exit:
    return void
}
function @long_join(%flag : i64, %p : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^body, ^exit

  block ^body:
    %t2 = phi i64 [^join: %next, ^entry: 0]
    %at = index i64 %p, %t2
    %v = load typed i64 %at
    branch %flag, ^left, ^right

  block ^left:
    call void @touch(%v)
    jump ^join

  block ^right:
    call void @touch(%t2)
