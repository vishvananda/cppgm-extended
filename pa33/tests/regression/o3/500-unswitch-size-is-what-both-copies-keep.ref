declare function @touch(%v : i64) -> void [unwind=no, linkage=c, binding=strong, object=touch]

function @long_path(%flag : i64, %p : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    branch %flag, ^body, ^loop_preheader_3

  block ^body:
    %t2 = phi i64 [^body: %next, ^loop_preheader_1: 0]
    %at = index i64 %p, %t2
    %v = load typed i64 %at
    %a0 = binary mul i64 %v, 3
    %a1 = binary xor i64 %a0, %t2
    %a2 = binary add i64 %v, %a1
    %a3 = binary ushr i64 %a2, 7
    %a4 = binary mul i64 %a3, 3
    %a5 = binary xor i64 %a4, %t2
    %a6 = binary add i64 %v, %a5
    %a7 = binary ushr i64 %a6, 7
