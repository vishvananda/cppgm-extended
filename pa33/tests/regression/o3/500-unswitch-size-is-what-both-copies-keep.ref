    %b48 = binary mul i64 %b47, 3
    %b49 = binary xor i64 %b48, %t2
    %b50 = binary add i64 %v, %b49
    %b51 = binary ushr i64 %b50, 7
    %b52 = binary mul i64 %b51, 3
    %b53 = binary xor i64 %b52, %t2
    %b54 = binary add i64 %v, %b53
    %b55 = binary ushr i64 %b54, 7
    %b56 = binary mul i64 %b55, 3
    %b57 = binary xor i64 %b56, %t2
    %b58 = binary add i64 %v, %b57
    %b59 = binary ushr i64 %b58, 7
    %b60 = binary mul i64 %b59, 3
    %b61 = binary xor i64 %b60, %t2
    %b62 = binary add i64 %v, %b61
    %b63 = binary ushr i64 %b62, 7
    %b64 = binary mul i64 %b63, 3
    %b65 = binary xor i64 %b64, %t2
    %b66 = binary add i64 %v, %b65
