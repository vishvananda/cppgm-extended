    %a9 = binary xor i64 %a8, %t2
    %a10 = binary add i64 %v, %a9
    %a11 = binary ushr i64 %a10, 7
    %a12 = binary mul i64 %a11, 3
    %a13 = binary xor i64 %a12, %t2
    %a14 = binary add i64 %v, %a13
    %a15 = binary ushr i64 %a14, 7
    %a16 = binary mul i64 %a15, 3
    %a17 = binary xor i64 %a16, %t2
    %a18 = binary add i64 %v, %a17
    %a19 = binary ushr i64 %a18, 7
    %a20 = binary mul i64 %a19, 3
    %a21 = binary xor i64 %a20, %t2
    %a22 = binary add i64 %v, %a21
    %a23 = binary ushr i64 %a22, 7
