function @fill_both(%n : i64, %m : i64, %p : ptr, %q : ptr) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^split_7

  block ^loop_preheader_1:
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %more, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    %t6 = vector fromi64 1
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector paddq %t5, %t7
    %t9 = vector fromi64 2
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t11 = phi v128 [^loop_preheader_2: %t8, ^wide_loop_3: %t15]
    %t12 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t14]
    %t13 = index i64 %p, %t12
    store v128 %t11, %t13
    %t14 = binary add nowrap i64 %t12, 2
    %t15 = vector paddq %t11, %t10
    %t16 = cmp le i64 %t14, %t4
    branch %t16, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t17 = cmp lt i64 %t14, %n
    branch %t17, ^loop_preheader_5, ^split_7

  block ^loop_preheader_5:
    %t18 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t14]
    jump ^first_body

  block ^first_body:
    %t19 = phi i64 [^first_body: %a_next, ^loop_preheader_5: %t18]
    %at = index i64 %p, %t19
    store i64 %t19, %at
    %a_next = binary add nowrap i64 %t19, 1
    %t22 = cmp lt i64 %a_next, %n
    branch %t22, ^first_body, ^split_7

  block ^split_7:
    %again = cmp gt i64 %m, 0
    branch %again, ^loop_preheader_8, ^done

  block ^loop_preheader_8:
    %t24 = cmp uge i64 %m, 2
    %t25 = binary and i64 %again, %t24
    branch %t25, ^loop_preheader_9, ^loop_preheader_12

  block ^loop_preheader_9:
    %t26 = binary add i64 %m, -2
    %t27 = vector fromi64 %m
    %t28 = vector pshufd %t27, 68
    jump ^wide_loop_10

  block ^wide_loop_10:
    %t29 = phi i64 [^loop_preheader_9: 0, ^wide_loop_10: %t31]
    %t30 = index i64 %q, %t29
    store v128 %t28, %t30
    %t31 = binary add nowrap i64 %t29, 2
    %t32 = cmp le i64 %t31, %t26
    branch %t32, ^wide_loop_10, ^loop_exit_11

  block ^loop_exit_11:
    %t33 = cmp lt i64 %t31, %m
    branch %t33, ^loop_preheader_12, ^done

  block ^loop_preheader_12:
    %t34 = phi i64 [^loop_preheader_8: 0, ^loop_exit_11: %t31]
    jump ^second_body

  block ^second_body:
    %t35 = phi i64 [^second_body: %b_next, ^loop_preheader_12: %t34]
    %to = index i64 %q, %t35
    store i64 %m, %to
    %b_next = binary add nowrap i64 %t35, 1
    %t38 = cmp lt i64 %b_next, %m
    branch %t38, ^second_body, ^done

  block ^done:
    return void
}
function @go_on(%n : i64, %m : i64, %p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^split_7

  block ^loop_preheader_1:
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %more, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    %t6 = vector fromi64 1
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector paddq %t5, %t7
    %t9 = vector fromi64 2
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t11 = phi v128 [^loop_preheader_2: %t8, ^wide_loop_3: %t15]
    %t12 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t14]
    %t13 = index i64 %p, %t12
    store v128 %t11, %t13
    %t14 = binary add nowrap i64 %t12, 2
    %t15 = vector paddq %t11, %t10
    %t16 = cmp le i64 %t14, %t4
    branch %t16, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t17 = cmp lt i64 %t14, %n
    branch %t17, ^loop_preheader_5, ^split_7

  block ^loop_preheader_5:
    %t18 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t14]
    jump ^first_body

  block ^first_body:
    %t19 = phi i64 [^first_body: %a_next, ^loop_preheader_5: %t18]
    %at = index i64 %p, %t19
    store i64 %t19, %at
    %a_next = binary add nowrap i64 %t19, 1
    %t22 = cmp lt i64 %a_next, %n
    branch %t22, ^first_body, ^split_7

  block ^split_7:
    %t23 = phi i64 [^entry: 0, ^first_body: %a_next, ^loop_exit_4: %t14]
    %again = cmp lt i64 %t23, %m
    branch %again, ^loop_preheader_8, ^done

  block ^loop_preheader_8:
    %t25 = binary sub i64 %m, %t23
    %t26 = cmp uge i64 %t25, 2
    %t27 = binary and i64 %again, %t26
    branch %t27, ^loop_preheader_9, ^loop_preheader_12

  block ^loop_preheader_9:
    %t28 = binary add i64 %m, -2
    %t29 = vector fromi64 %m
    %t30 = vector pshufd %t29, 68
    jump ^wide_loop_10

  block ^wide_loop_10:
    %t31 = phi i64 [^loop_preheader_9: %t23, ^wide_loop_10: %t33]
    %t32 = index i64 %p, %t31
    store v128 %t30, %t32
    %t33 = binary add nowrap i64 %t31, 2
    %t34 = cmp le i64 %t33, %t28
    branch %t34, ^wide_loop_10, ^loop_exit_11

  block ^loop_exit_11:
    %t35 = cmp lt i64 %t33, %m
    branch %t35, ^loop_preheader_12, ^done

  block ^loop_preheader_12:
    %t36 = phi i64 [^loop_preheader_8: %t23, ^loop_exit_11: %t33]
    jump ^second_body

  block ^second_body:
    %t37 = phi i64 [^second_body: %b_next, ^loop_preheader_12: %t36]
    %to = index i64 %p, %t37
    store i64 %m, %to
    %b_next = binary add nowrap i64 %t37, 1
    %t40 = cmp lt i64 %b_next, %m
    branch %t40, ^second_body, ^done

  block ^done:
    %t41 = phi i64 [^split_7: %t23, ^second_body: %b_next, ^loop_exit_11: %t33]
    return i64 %t41
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
