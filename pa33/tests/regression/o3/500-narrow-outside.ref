function @byte_of_extension(%first : ptr, %count : i32, %v : i8) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp ugt i32 %count, 16
    %t3 = binary and i64 %more, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i32 %count, -16
    %t5 = vector pzero
    %t6 = convert zext i32 i8 %v
    %t7 = binary mul i32 %t6, 257
    %t8 = vector fromi32 %t7
    %t9 = vector pshuflw %t8, 0
    %t10 = vector pshufd %t9, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t11 = phi v128 [^loop_preheader_2: %t5, ^wide_loop_3: %t16]
    %t12 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t17]
    %t13 = index i8 %first, %t12
    %t14 = load v128 %t13
    %t15 = vector paddb %t10, %t14
    %t16 = vector paddb %t15, %t11
    %t17 = binary add nowrap i64 %t12, 16
    %t18 = convert trunc exact i32 i64 %t17
    %t19 = cmp lt i32 %t18, %t4
    branch %t19, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t20 = vector pshufd %t16, 78
    %t21 = vector paddb %t16, %t20
    %t22 = vector pshufd %t21, 177
    %t23 = vector paddb %t21, %t22
    %t24 = vector psrldi %t23, 16
    %t25 = vector paddb %t23, %t24
    %t26 = vector psrlwi %t25, 8
    %t27 = vector paddb %t25, %t26
    %t28 = vector toi32 %t27
    %t29 = convert trunc i8 i32 %t28
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t30 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t29]
    %t31 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t18]
    %t32 = convert sext i64 i32 %t31
    jump ^loop

  block ^loop:
    %sum = phi i8 [^loop_preheader_5: %t30, ^loop: %t38]
    %t34 = phi i64 [^loop_preheader_5: %t32, ^loop: %t39]
    %p = index i8 %first, %t34
    %x = load i8 %p
    %t37 = binary add i8 %v, %x
    %t38 = binary add i8 %sum, %t37
    %t39 = binary add nowrap i64 %t34, 1
    %next = convert trunc exact i32 i64 %t39
    %again = cmp lt i32 %next, %count
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %t38]
    return i8 %r
}
function @byte_of_parameter(%first : ptr, %count : i32, %v : i32) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp ugt i32 %count, 16
    %t3 = binary and i64 %more, %t2
    %t4 = convert trunc i8 i32 %v
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t5 = binary add i32 %count, -16
    %t6 = vector pzero
    %t7 = convert zext i32 i8 %t4
    %t8 = binary mul i32 %t7, 257
    %t9 = vector fromi32 %t8
    %t10 = vector pshuflw %t9, 0
    %t11 = vector pshufd %t10, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t12 = phi v128 [^loop_preheader_2: %t6, ^wide_loop_3: %t17]
    %t13 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t18]
    %t14 = index i8 %first, %t13
    %t15 = load v128 %t14
    %t16 = vector paddb %t11, %t15
    %t17 = vector paddb %t16, %t12
    %t18 = binary add nowrap i64 %t13, 16
    %t19 = convert trunc exact i32 i64 %t18
    %t20 = cmp lt i32 %t19, %t5
    branch %t20, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t21 = vector pshufd %t17, 78
    %t22 = vector paddb %t17, %t21
    %t23 = vector pshufd %t22, 177
    %t24 = vector paddb %t22, %t23
    %t25 = vector psrldi %t24, 16
    %t26 = vector paddb %t24, %t25
    %t27 = vector psrlwi %t26, 8
    %t28 = vector paddb %t26, %t27
    %t29 = vector toi32 %t28
    %t30 = convert trunc i8 i32 %t29
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t31 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t30]
    %t32 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t19]
    %t33 = convert sext i64 i32 %t32
    jump ^loop

  block ^loop:
    %sum = phi i8 [^loop_preheader_5: %t31, ^loop: %t39]
    %t35 = phi i64 [^loop_preheader_5: %t33, ^loop: %t40]
    %p = index i8 %first, %t35
    %x = load i8 %p
    %t38 = binary add i8 %x, %t4
    %t39 = binary add i8 %sum, %t38
    %t40 = binary add nowrap i64 %t35, 1
    %next = convert trunc exact i32 i64 %t40
    %again = cmp lt i32 %next, %count
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %t39]
    return i8 %r
}
function @short_of_phi(%first : ptr, %count : i32, %c : i1, %v : i32, %w : i32) -> i16 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i32 %count, 0
    branch %t1, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp ugt i32 %count, 8
    %t3 = binary and i64 %t1, %t2
    %v2 = binary add i32 %v, 3
    %t5 = select i32 %c, %v2, %w
    %t6 = convert trunc i16 i32 %t5
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t7 = binary add i32 %count, -8
    %t8 = vector pzero
    %t9 = convert zext i32 i16 %t6
    %t10 = vector fromi32 %t9
    %t11 = vector pshuflw %t10, 0
    %t12 = vector pshufd %t11, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t13 = phi v128 [^loop_preheader_2: %t8, ^wide_loop_3: %t18]
    %t14 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t19]
    %t15 = index i16 %first, %t14
    %t16 = load v128 %t15
    %t17 = vector pmullw %t12, %t16
    %t18 = vector paddw %t17, %t13
    %t19 = binary add nowrap i64 %t14, 8
    %t20 = convert trunc exact i32 i64 %t19
    %t21 = cmp lt i32 %t20, %t7
    branch %t21, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t22 = vector pshufd %t18, 78
    %t23 = vector paddw %t18, %t22
    %t24 = vector pshufd %t23, 177
    %t25 = vector paddw %t23, %t24
    %t26 = vector psrldi %t25, 16
    %t27 = vector paddw %t25, %t26
    %t28 = vector toi32 %t27
    %t29 = convert trunc i16 i32 %t28
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t30 = phi i16 [^loop_preheader_1: 0, ^loop_exit_4: %t29]
    %t31 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t20]
    %t32 = convert sext i64 i32 %t31
    jump ^loop

  block ^loop:
    %sum = phi i16 [^loop_preheader_5: %t30, ^loop: %t38]
    %t34 = phi i64 [^loop_preheader_5: %t32, ^loop: %t39]
    %p = index i16 %first, %t34
    %x = load typed i16 %p
    %t37 = binary mul i16 %x, %t6
    %t38 = binary add i16 %sum, %t37
    %t39 = binary add nowrap i64 %t34, 1
    %next = convert trunc exact i32 i64 %t39
    %again = cmp lt i32 %next, %count
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i16 [^entry: 0, ^loop: %t38]
    return i16 %r
}
function @byte_shift_stays(%first : ptr, %count : i32, %v : i32) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = binary and i32 %count, -2
    %t3 = cmp gt i32 %t2, 0
    branch %t3, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    jump ^unrolled_3

  block ^unrolled_3:
    %t4 = phi i8 [^loop_preheader_2: 0, ^unrolled_3: %t20]
    %t5 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t21]
    %t6 = index i8 %first, %t5
    %t7 = load i8 %t6
    %t8 = convert sext i32 i8 %t7
    %t9 = binary shr i32 %t8, %v
    %t10 = convert sext i32 i8 %t4
    %t11 = binary add nowrap i32 %t9, %t10
    %t12 = convert trunc i8 i32 %t11
    %t13 = convert sext i32 i8 %t12
    %t14 = index i8 %first, %t5
    %t15 = index i8 %t14, 1
    %t16 = load i8 %t15
    %t17 = convert sext i32 i8 %t16
    %t18 = binary shr i32 %t17, %v
    %t19 = binary add nowrap i32 %t18, %t13
    %t20 = convert trunc i8 i32 %t19
    %t21 = binary add nowrap i64 %t5, 2
    %t22 = convert trunc exact i32 i64 %t21
    %t23 = cmp ne i32 %t2, %t22
    branch %t23, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t24 = cmp lt i32 %t22, %count
    branch %t24, ^wide_tail_5, ^done

  block ^wide_tail_5:
    %t25 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t20]
    %t26 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t22]
    %t27 = convert sext i64 i32 %t26
    jump ^loop

  block ^loop:
    %sum = phi i8 [^wide_tail_5: %t25, ^loop: %next_sum]
    %t29 = phi i64 [^wide_tail_5: %t27, ^loop: %t37]
    %p = index i8 %first, %t29
    %x = load i8 %p
    %ex = convert sext i32 i8 %x
    %a = binary shr i32 %ex, %v
    %es = convert sext i32 i8 %sum
    %b = binary add nowrap i32 %a, %es
    %next_sum = convert trunc i8 i32 %b
    %t37 = binary add nowrap i64 %t29, 1
    %next = convert trunc exact i32 i64 %t37
    %again = cmp lt i32 %next, %count
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %next_sum, ^loop_exit_4: %t20]
    return i8 %r
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
