    %t15 = phi v128 [^unrolled_4: %t32, ^loop_preheader_3: %t8]
    %t16 = phi i64 [^unrolled_4: %t33, ^loop_preheader_3: 0]
    %t17 = index i16 %first, %t16
    %t18 = load v128 %t17
