    %t24 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t19]
    %t25 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t21]
    %t26 = convert sext i64 i32 %t25
    jump ^loop

  block ^loop:
    %sum = phi i8 [^wide_tail_5: %t24, ^loop: %next_sum]
    %t28 = phi i64 [^wide_tail_5: %t26, ^loop: %t36]
