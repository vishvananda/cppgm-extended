    %t31 = binary add nowrap i64 %t14, 64
    %t32 = convert trunc exact i32 i64 %t31
    %t33 = cmp ne i32 %t11, %t32
    branch %t33, ^unrolled_4, ^loop_exit_5

  block ^loop_exit_5:
    %t34 = cmp lt i32 %t32, %t4
    branch %t34, ^wide_tail_6, ^loop_exit_8

  block ^wide_tail_6:
    %t35 = phi v128 [^loop_preheader_2: %t5, ^loop_exit_5: %t30]
    %t36 = phi i32 [^loop_preheader_2: 0, ^loop_exit_5: %t32]
    %t37 = convert sext i64 i32 %t36
    jump ^wide_loop_7

  block ^wide_loop_7:
    %t38 = phi v128 [^wide_tail_6: %t35, ^wide_loop_7: %t43]
    %t39 = phi i64 [^wide_tail_6: %t37, ^wide_loop_7: %t44]
    %t40 = index i8 %first, %t39
