function @sum(%x : ptr, %n : i64) -> u32 [no_inline=yes] {
  block ^entry:
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t1 = cmp uge i64 %n, 4
    branch %t1, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t2 = binary add i64 %n, -4
    %t3 = vector pzero
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t4 = phi v128 [^loop_preheader_2: %t3, ^wide_loop_3: %t8]
    %t5 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t9]
    %t6 = index u32 %x, %t5
    %t7 = load v128 %t6
    %t8 = vector paddd %t4, %t7
    %t9 = binary add nowrap i64 %t5, 4
    %t10 = cmp ule i64 %t9, %t2
    branch %t10, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t11 = vector pshufd %t8, 78
    %t12 = vector paddd %t8, %t11
    %t13 = vector pshufd %t12, 177
    %t14 = vector paddd %t12, %t13
    %t15 = vector toi32 %t14
    %t16 = copy u32 %t15
    %t17 = cmp ult i64 %t9, %n
    branch %t17, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t18 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t15]
    %t19 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t9]
    %t20 = copy u32 %t18
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t19, ^body: %next]
    %s = phi u32 [^loop_preheader_5: %t20, ^body: %t]
    %p = index u32 %x, %i
    %v = load typed u32 %p
    %t = binary add u32 %s, %v
    %next = binary add i64 %i, 1
    %more = cmp ult i64 %next, %n
    branch %more, ^body, ^done

  block ^done:
    %r = phi u32 [^entry: 0, ^body: %t, ^loop_exit_4: %t16]
    return u32 %r
}
function @sum_and_count(%x : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = cmp ne i64 %n, 0
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -2
    %t5 = vector fromi64 7
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t6 = phi v128 [^loop_preheader_1: %t5, ^wide_loop_2: %t10]
    %t7 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t11]
    %t8 = index i64 %x, %t7
    %t9 = load v128 %t8
    %t10 = vector paddq %t6, %t9
    %t11 = binary add nowrap i64 %t7, 2
    %t12 = cmp ule i64 %t11, %t4
    branch %t12, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t13 = vector pshufd %t10, 78
    %t14 = vector paddq %t10, %t13
    %t15 = vector toi64 %t14
    %t16 = cmp ult i64 %t11, %n
    branch %t16, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t17 = phi i64 [^entry: 7, ^loop_exit_3: %t15]
    %t18 = phi i64 [^entry: 0, ^loop_exit_3: %t11]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t18, ^body: %next]
    %s = phi i64 [^loop_preheader_4: %t17, ^body: %t]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %t = binary add i64 %s, %v
    %next = binary add i64 %i, 1
    %more = cmp ult i64 %next, %n
    branch %more, ^body, ^done

  block ^done:
    %t26 = phi i64 [^body: %t, ^loop_exit_3: %t15]
    %t27 = phi i64 [^body: %next, ^loop_exit_3: %t11]
    %scaled = binary mul i64 %t27, 3
    %r = binary add i64 %scaled, %t26
    return i64 %r
}
function @backward(%x : ptr, %n : i64) -> u32 [no_inline=yes] {
  block ^entry:
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = vector fromi32 11
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t5 = phi v128 [^loop_preheader_2: %t4, ^wide_loop_3: %t11]
    %t6 = phi i64 [^loop_preheader_2: %n, ^wide_loop_3: %t12]
    %t7 = binary sub i64 %t6, 1
    %t8 = index u32 %x, %t7
    %t9 = index i8 %t8, -12
    %t10 = load v128 %t9
    %t11 = vector paddd %t5, %t10
    %t12 = binary add nowrap i64 %t6, -4
    %t13 = cmp ge i64 %t12, 4
    branch %t13, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t14 = vector pshufd %t11, 78
    %t15 = vector paddd %t11, %t14
    %t16 = vector pshufd %t15, 177
    %t17 = vector paddd %t15, %t16
    %t18 = vector toi32 %t17
    %t19 = copy u32 %t18
    %t20 = cmp gt i64 %t12, 0
    branch %t20, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t21 = phi u32 [^loop_preheader_1: 11, ^loop_exit_4: %t19]
    %t22 = phi i64 [^loop_preheader_1: %n, ^loop_exit_4: %t12]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t22, ^body: %next]
    %s = phi u32 [^loop_preheader_5: %t21, ^body: %t]
    %next = binary sub i64 %i, 1
    %p = index u32 %x, %next
    %v = load typed u32 %p
    %t = binary add u32 %s, %v
    branch %next, ^body, ^done

  block ^done:
    %r = phi u32 [^entry: 11, ^body: %t, ^loop_exit_4: %t19]
    return u32 %r
}
function @last(%x : ptr, %n : i64) -> u32 [no_inline=yes] {
  block ^entry:
    %t1 = cmp ne i64 %n, 0
    %t2 = cmp ugt i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_7

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -4
    %t5 = vector pzero
    %t6 = vector fromi32 5
    %t7 = vector pshufd %t6, 0
    %t8 = vector psrlqi %t7, 32
    %t9 = binary and i64 %t4, -8
    branch %t9, ^unrolled_2, ^wide_tail_4

  block ^unrolled_2:
    %t10 = phi v128 [^unrolled_2: %t29, ^loop_preheader_1: %t5]
    %t11 = phi i64 [^unrolled_2: %t30, ^loop_preheader_1: 0]
    %t12 = index u32 %x, %t11
    %t13 = load v128 %t12
    %t14 = vector pmuludq %t13, %t7
    %t15 = vector psrlqi %t13, 32
    %t16 = vector pmuludq %t15, %t8
    %t17 = vector pshufd %t14, 8
    %t18 = vector pshufd %t16, 8
    %t19 = vector punpckldq %t17, %t18
    %t20 = vector paddd %t10, %t19
    %t21 = index u32 %t12, 4
    %t22 = load v128 %t21
    %t23 = vector pmuludq %t22, %t7
    %t24 = vector psrlqi %t22, 32
    %t25 = vector pmuludq %t24, %t8
    %t26 = vector pshufd %t23, 8
    %t27 = vector pshufd %t25, 8
    %t28 = vector punpckldq %t26, %t27
    %t29 = vector paddd %t20, %t28
    %t30 = binary add nowrap i64 %t11, 8
    %t31 = cmp ne i64 %t9, %t30
    branch %t31, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t32 = cmp ult i64 %t30, %t4
    branch %t32, ^wide_tail_4, ^loop_exit_6

  block ^wide_tail_4:
    %t33 = phi v128 [^loop_preheader_1: %t5, ^loop_exit_3: %t29]
    %t34 = phi i64 [^loop_preheader_1: 0, ^loop_exit_3: %t30]
    jump ^wide_loop_5

  block ^wide_loop_5:
    %t35 = phi v128 [^wide_tail_4: %t33, ^wide_loop_5: %t45]
    %t36 = phi i64 [^wide_tail_4: %t34, ^wide_loop_5: %t46]
    %t37 = index u32 %x, %t36
    %t38 = load v128 %t37
    %t39 = vector pmuludq %t38, %t7
    %t40 = vector psrlqi %t38, 32
    %t41 = vector pmuludq %t40, %t8
    %t42 = vector pshufd %t39, 8
    %t43 = vector pshufd %t41, 8
    %t44 = vector punpckldq %t42, %t43
    %t45 = vector paddd %t35, %t44
    %t46 = binary add nowrap i64 %t36, 4
    %t47 = cmp ult i64 %t46, %t4
    branch %t47, ^wide_loop_5, ^loop_exit_6

  block ^loop_exit_6:
    %t48 = phi v128 [^wide_loop_5: %t45, ^loop_exit_3: %t29]
    %t49 = phi i64 [^wide_loop_5: %t46, ^loop_exit_3: %t30]
    %t50 = vector pshufd %t48, 78
    %t51 = vector paddd %t48, %t50
    %t52 = vector pshufd %t51, 177
    %t53 = vector paddd %t51, %t52
    %t54 = vector toi32 %t53
    jump ^loop_preheader_7

  block ^loop_preheader_7:
    %t55 = phi i32 [^entry: 0, ^loop_exit_6: %t54]
    %t56 = phi i64 [^entry: 0, ^loop_exit_6: %t49]
    %t57 = copy u32 %t55
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_7: %t56, ^body: %next]
    %s = phi u32 [^loop_preheader_7: %t57, ^body: %t]
    %p = index u32 %x, %i
    %v = load typed u32 %p
    %w = binary mul u32 %v, 5
    %t = binary add u32 %s, %w
    %next = binary add i64 %i, 1
    %more = cmp ult i64 %next, %n
    branch %more, ^body, ^done

  block ^done:
    %r = binary xor u32 %w, %t
    return u32 %r
}
function @rounds(%x : ptr) -> u32 [no_inline=yes] {
  block ^entry:
    %t1 = vector fromi32 5
    jump ^unrolled_1

  block ^unrolled_1:
    %t2 = phi v128 [^unrolled_1: %t15, ^entry: %t1]
    %t3 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t4 = index u32 %x, %t3
    %t5 = load v128 %t4
    %t6 = vector pxor %t2, %t5
    %t7 = index u32 %t4, 4
    %t8 = load v128 %t7
    %t9 = vector pxor %t6, %t8
    %t10 = index u32 %t4, 8
    %t11 = load v128 %t10
    %t12 = vector pxor %t9, %t11
    %t13 = index u32 %t4, 12
    %t14 = load v128 %t13
    %t15 = vector pxor %t12, %t14
    %t16 = binary add nowrap i64 %t3, 16
    %t17 = cmp ne i64 %t16, 64
    branch %t17, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t18 = vector pshufd %t15, 78
    %t19 = vector pxor %t15, %t18
    %t20 = vector pshufd %t19, 177
    %t21 = vector pxor %t19, %t20
    %t22 = vector toi32 %t21
    %t23 = copy u32 %t22
    return u32 %t23
}
function @not_rounds(%x : ptr) -> u32 [no_inline=yes] {
  block ^entry:
    %t1 = vector fromi32 5
    jump ^unrolled_1

  block ^unrolled_1:
    %t2 = phi v128 [^unrolled_1: %t15, ^entry: %t1]
    %t3 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t4 = index u32 %x, %t3
    %t5 = load v128 %t4
    %t6 = vector pxor %t2, %t5
    %t7 = index u32 %t4, 4
    %t8 = load v128 %t7
    %t9 = vector pxor %t6, %t8
    %t10 = index u32 %t4, 8
    %t11 = load v128 %t10
    %t12 = vector pxor %t9, %t11
    %t13 = index u32 %t4, 12
    %t14 = load v128 %t13
    %t15 = vector pxor %t12, %t14
    %t16 = binary add nowrap i64 %t3, 16
    %t17 = cmp ne i64 %t16, 48
    branch %t17, ^unrolled_1, ^wide_loop_2

  block ^wide_loop_2:
    %t18 = phi v128 [^wide_loop_2: %t22, ^unrolled_1: %t15]
    %t19 = phi i64 [^wide_loop_2: %t23, ^unrolled_1: %t16]
    %t20 = index u32 %x, %t19
    %t21 = load v128 %t20
    %t22 = vector pxor %t18, %t21
    %t23 = binary add nowrap i64 %t19, 4
    %t24 = cmp ult i64 %t23, 62
    branch %t24, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t25 = phi v128 [^wide_loop_2: %t22]
    %t26 = phi i64 [^wide_loop_2: %t23]
    %t27 = vector pshufd %t25, 78
    %t28 = vector pxor %t25, %t27
    %t29 = vector pshufd %t28, 177
    %t30 = vector pxor %t28, %t29
    %t31 = vector toi32 %t30
    %t32 = copy u32 %t31
    jump ^body

  block ^body:
    %i = phi i64 [^loop_exit_3: %t26, ^body: %next]
    %s = phi u32 [^loop_exit_3: %t32, ^body: %t]
    %p = index u32 %x, %i
    %v = load typed u32 %p
    %t = binary xor u32 %s, %v
    %next = binary add i64 %i, 1
    %more = cmp ult i64 %next, 66
    branch %more, ^body, ^done

  block ^done:
    return u32 %t
}
function @nested(%x : ptr, %rows : i64) -> u32 [no_inline=yes] {
  block ^entry:
    jump ^outer

  block ^outer:
    %t1 = phi i64 [^entry: 0, ^loop_exit_3: %t24]
    %r = phi i64 [^entry: 0, ^loop_exit_3: %r_next]
    %acc = phi u32 [^entry: 0, ^loop_exit_3: %mixed]
    %row = copy i64 %t1
    %base = index u32 %x, %row
    %t6 = copy i32 %acc
    %t7 = vector fromi32 %t6
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t8 = phi v128 [^outer: %t7, ^wide_loop_2: %t12]
    %t9 = phi i64 [^outer: 0, ^wide_loop_2: %t13]
    %t10 = index u32 %base, %t9
    %t11 = load v128 %t10
    %t12 = vector paddd %t8, %t11
    %t13 = binary add nowrap i64 %t9, 4
    %t14 = cmp ule i64 %t13, 28
    branch %t14, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t15 = vector pshufd %t12, 78
    %t16 = vector paddd %t12, %t15
    %t17 = vector pshufd %t16, 177
    %t18 = vector paddd %t16, %t17
    %t19 = vector toi32 %t18
    %t20 = copy u32 %t19
    %rot = binary shl u32 %t20, 3
    %mixed = binary xor u32 %rot, %t20
    %r_next = binary add i64 %r, 1
    %t24 = binary add i64 %t1, 32
    %again = cmp ult i64 %r_next, %rows
    branch %again, ^outer, ^done

  block ^done:
    return u32 %mixed
}
