    %ai = index i8 %a, %row
    %t7 = vector fromf64 0
    %t8 = vector pshufd %t7, 68
    jump ^unrolled_1

  block ^unrolled_1:
    %t9 = phi i64 [^unrolled_1: %t18, ^entry: 0]
