    %t16 = index f64 %t10, 12
    store v128 %t8, %t16
    %t17 = index f64 %t10, 14
    store v128 %t8, %t17
    %t18 = binary add nowrap i64 %t9, 16
    %t19 = cmp ne i64 %t18, 32
    branch %t19, ^unrolled_1, ^terms

  block ^terms:
    %t20 = phi i64 [^next: %t43, ^unrolled_1: 0]
    %k = phi i64 [^next: %k1, ^unrolled_1: 0]
    %p = index f64 %ai, %k
    %rowk = index i8 %b, %t20
    %v = load typed f64 %p
    %t25 = vector fromf64 %v
    %t26 = vector pshufd %t25, 68
    jump ^unrolled_3

  block ^unrolled_3:
    %t27 = phi i64 [^terms: 0, ^unrolled_3: %t40]
    %t28 = index f64 %ri, %t27
    %t29 = load v128 %t28
    %t30 = index f64 %rowk, %t27
    %t31 = load v128 %t30
    %t32 = vector mulpd %t26, %t31
    %t33 = vector addpd %t29, %t32
    store v128 %t33, %t28
    %t34 = index f64 %t28, 2
    %t35 = load v128 %t34
    %t36 = index f64 %t30, 2
    %t37 = load v128 %t36
    %t38 = vector mulpd %t26, %t37
    %t39 = vector addpd %t35, %t38
    store v128 %t39, %t34
    %t40 = binary add nowrap i64 %t27, 4
    %t41 = cmp ne i64 %t40, 32
    branch %t41, ^unrolled_3, ^next

  block ^next:
    %k1 = binary add nowrap i64 %k, 1
    %t43 = binary add i64 %t20, 256
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^done

  block ^done:
