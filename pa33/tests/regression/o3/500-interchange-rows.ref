    %t15 = load typed f64 %t14
    %t16 = binary add f64 %t11, %t15
    %t17 = binary add i64 %t5, 512
    %t18 = index i8 %b, %t17
    %t19 = index f64 %t18, %twice
    %t20 = load typed f64 %t19
    %t21 = binary add f64 %t16, %t20
    %t22 = binary add i64 %t5, 768
    %t23 = index i8 %b, %t22
    %t24 = index f64 %t23, %twice
    %t25 = load typed f64 %t24
    %t26 = binary add f64 %t21, %t25
    %t27 = binary add nowrap i64 %t6, 4
    %t28 = binary add i64 %t5, 1024
    %t29 = cmp ne i64 %t27, 32
    branch %t29, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    branch 0, ^wide_tail_5, ^next

  block ^wide_tail_5:
    %t30 = phi i64 [^columns: 0, ^loop_exit_4: %t28]
    %t31 = phi i64 [^columns: 0, ^loop_exit_4: %t27]
    %t32 = phi f64 [^columns: 0, ^loop_exit_4: %t26]
    jump ^terms

  block ^terms:
    %t33 = phi i64 [^wide_tail_5: %t30, ^terms: %t41]
    %k = phi i64 [^wide_tail_5: %t31, ^terms: %k1]
    %s = phi f64 [^wide_tail_5: %t32, ^terms: %sum]
    %rowk = index i8 %b, %t33
    %q = index f64 %rowk, %twice
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add nowrap i64 %k, 1
    %t41 = binary add i64 %t33, 256
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %t43 = phi f64 [^terms: %sum, ^loop_exit_4: %t26]
    %cell = index f64 %r, %j
    store typed f64 %t43, %cell
    %j1 = binary add nowrap i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @wide_cell() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    branch 1, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    jump ^unrolled_3

  block ^unrolled_3:
    %t4 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t27]
    %t5 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t26]
    %t6 = phi f64 [^loop_preheader_2: 0, ^unrolled_3: %t25]
    %t7 = index i8 %b, %t4
    %t8 = index f64 %t7, %j
    %t9 = load typed f64 %t8
    %t10 = binary add f64 %t6, %t9
    %t11 = binary add i64 %t4, 256
    %t12 = index i8 %b, %t11
    %t13 = index f64 %t12, %j
    %t14 = load typed f64 %t13
    %t15 = binary add f64 %t10, %t14
    %t16 = binary add i64 %t4, 512
    %t17 = index i8 %b, %t16
    %t18 = index f64 %t17, %j
    %t19 = load typed f64 %t18
    %t20 = binary add f64 %t15, %t19
    %t21 = binary add i64 %t4, 768
    %t22 = index i8 %b, %t21
    %t23 = index f64 %t22, %j
    %t24 = load typed f64 %t23
    %t25 = binary add f64 %t20, %t24
    %t26 = binary add nowrap i64 %t5, 4
    %t27 = binary add i64 %t4, 1024
    %t28 = cmp ne i64 %t26, 32
    branch %t28, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    branch 0, ^wide_tail_5, ^next

  block ^wide_tail_5:
    %t29 = phi i64 [^columns: 0, ^loop_exit_4: %t27]
    %t30 = phi i64 [^columns: 0, ^loop_exit_4: %t26]
    %t31 = phi f64 [^columns: 0, ^loop_exit_4: %t25]
    jump ^terms

  block ^terms:
    %t32 = phi i64 [^wide_tail_5: %t29, ^terms: %t40]
    %k = phi i64 [^wide_tail_5: %t30, ^terms: %k1]
    %s = phi f64 [^wide_tail_5: %t31, ^terms: %sum]
    %rowk = index i8 %b, %t32
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add nowrap i64 %k, 1
    %t40 = binary add i64 %t32, 256
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %t42 = phi f64 [^terms: %sum, ^loop_exit_4: %t25]
    %twice = binary mul i64 %j, 2
    %cell = index f64 %r, %twice
    store typed f64 %t42, %cell
    %j1 = binary add nowrap i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
