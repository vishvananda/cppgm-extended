function @triangle() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %t4 = phi i64 [^columns: 0, ^terms: %t13]
    %k = phi i64 [^columns: 0, ^terms: %k1]
