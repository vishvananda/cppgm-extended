function @product(%i : i64) -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %row = binary mul i64 %i, 256
    %ri = index i8 %r, %row
    %t4 = vector fromf64 0
    %t5 = vector pshufd %t4, 68
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t6 = phi i64 [^entry: 0, ^wide_loop_1: %t8]
    %t7 = index f64 %ri, %t6
    store v128 %t5, %t7
    %t8 = binary add nowrap i64 %t6, 2
    %t9 = cmp le i64 %t8, 30
    branch %t9, ^wide_loop_1, ^loop_preheader_2

  block ^loop_preheader_2:
    %a = addr @left
    %b = addr @right
    %ai = index i8 %a, %row
    jump ^terms

  block ^terms:
    %t13 = phi i64 [^loop_preheader_2: 0, ^next: %t31]
    %k = phi i64 [^next: %k1, ^loop_preheader_2: 0]
    %p = index f64 %ai, %k
    %scaled = copy i64 %t13
    %rowk = index i8 %b, %scaled
    %v = load typed f64 %p
    %t19 = vector fromf64 %v
    %t20 = vector pshufd %t19, 68
    jump ^wide_loop_4

  block ^wide_loop_4:
    %t21 = phi i64 [^terms: 0, ^wide_loop_4: %t28]
    %t22 = index f64 %ri, %t21
    %t23 = load v128 %t22
    %t24 = index f64 %rowk, %t21
    %t25 = load v128 %t24
    %t26 = vector mulpd %t20, %t25
    %t27 = vector addpd %t23, %t26
    store v128 %t27, %t22
    %t28 = binary add nowrap i64 %t21, 2
    %t29 = cmp le i64 %t28, 30
    branch %t29, ^wide_loop_4, ^next

  block ^next:
    %k1 = binary add nowrap i64 %k, 1
    %t31 = binary add i64 %t13, 256
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^done

  block ^done:
    return void
}
function @started() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @counts
    %t2 = vector fromi32 5
    %t3 = vector pshufd %t2, 0
