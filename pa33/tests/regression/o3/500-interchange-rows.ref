    branch %t20, ^wide_loop_4, ^next

  block ^next:
    %k1 = binary add nowrap i64 %k, 1
    %t22 = binary add i64 %t9, 128
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^done

  block ^done:
    return void
}
function @reads_cell() -> void [no_inline=yes] {
