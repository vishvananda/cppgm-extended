    %scaled = copy i64 %t4
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %t13 = binary add i64 %t4, 256
    %c = cmp le i64 %k1, %j
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add nowrap i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
