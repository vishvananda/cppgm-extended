function @sum_and_store(%x : ptr, %d : ptr, %n : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    %t2 = binary and i64 %n, -4
    %t3 = cmp gt i64 %t2, 0
    branch %t3, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    jump ^unrolled_3

  block ^unrolled_3:
    %t4 = phi f64 [^loop_preheader_2: 0, ^unrolled_3: %t24]
    %t5 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t25]
    %t6 = index f64 %x, %t5
    %t7 = load typed f64 %t6
    %t8 = index f64 %d, %t5
    store typed f64 0.25, %t8
    %t9 = binary add f64 %t4, %t7
    %t10 = binary add nowrap i64 %t5, 1
    %t11 = index f64 %x, %t10
    %t12 = load typed f64 %t11
    %t13 = index f64 %d, %t10
    store typed f64 0.25, %t13
    %t14 = binary add f64 %t9, %t12
    %t15 = binary add nowrap i64 %t5, 2
    %t16 = index f64 %x, %t15
    %t17 = load typed f64 %t16
    %t18 = index f64 %d, %t15
    store typed f64 0.25, %t18
    %t19 = binary add f64 %t14, %t17
    %t20 = binary add nowrap i64 %t5, 3
    %t21 = index f64 %x, %t20
    %t22 = load typed f64 %t21
    %t23 = index f64 %d, %t20
    store typed f64 0.25, %t23
    %t24 = binary add f64 %t19, %t22
    %t25 = binary add nowrap i64 %t5, 4
    %t26 = cmp ne i64 %t2, %t25
    branch %t26, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t27 = cmp lt i64 %t25, %n
    branch %t27, ^wide_tail_5, ^exit

  block ^wide_tail_5:
    %t28 = phi f64 [^loop_preheader_1: 0, ^loop_exit_4: %t24]
    %t29 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t25]
    jump ^latch

  block ^latch:
    %t30 = phi f64 [^latch: %sum, ^wide_tail_5: %t28]
    %t31 = phi i64 [^latch: %next, ^wide_tail_5: %t29]
    %at = index f64 %x, %t31
    %v = load typed f64 %at
    %to = index f64 %d, %t31
    store typed f64 0.25, %to
    %sum = binary add f64 %v, %t30
    %next = binary add nowrap i64 %t31, 1
    %t37 = cmp lt i64 %next, %n
    branch %t37, ^latch, ^exit

  block ^exit:
    %t38 = phi f64 [^entry: 0, ^latch: %sum, ^loop_exit_4: %t24]
    return f64 %t38
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
