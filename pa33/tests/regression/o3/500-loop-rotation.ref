declare function @touch(%value : i64) -> void [unwind=no]

global @last : i64 = 0

function @count_down(%n : i32) -> void [no_inline=yes] {
  block ^entry:
    branch %n, ^split_1, ^done

  block ^split_1:
    %t1 = load typed i64 @last
    %t2 = binary and i32 %n, -8
    %next = binary sub nowrap i32 %n, 1
    branch %t2, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    %t4 = binary sub i32 %next, %t2
    jump ^unrolled_3

  block ^unrolled_3:
    %t5 = phi i64 [^loop_preheader_2: %t1, ^unrolled_3: %t7]
    %t6 = phi i32 [^loop_preheader_2: %next, ^unrolled_3: %t8]
    %t7 = binary mul i64 %t5, 6561
    %t8 = binary sub nowrap i32 %t6, 8
    %t9 = cmp ne i32 %t4, %t8
    branch %t9, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t10 = binary sub nowrap i32 %t6, 7
    branch %t10, ^wide_tail_5, ^loop_exit_7

  block ^wide_tail_5:
    %t11 = phi i64 [^split_1: %t1, ^loop_exit_4: %t7]
    %t12 = phi i32 [^split_1: %next, ^loop_exit_4: %t8]
    jump ^body

  block ^body:
    %v = phi i64 [^wide_tail_5: %t11, ^body: %w]
    %t14 = phi i32 [^body: %t16, ^wide_tail_5: %t12]
    %w = binary mul i64 %v, 3
    %t16 = binary sub nowrap i32 %t14, 1
    branch %t14, ^body, ^loop_exit_7

  block ^loop_exit_7:
    %t17 = phi i64 [^body: %w, ^loop_exit_4: %t7]
    store typed i64 %t17, @last
    jump ^done

  block ^done:
    return void
}
function @only_calls(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    %c = cmp gt i64 %n, 0
    branch %c, ^body, ^done

  block ^body:
    %t2 = phi i64 [^body: %next, ^entry: 0]
    call void @touch(%t2)
    %next = binary add nowrap i64 %t2, 1
    %t4 = cmp lt i64 %next, %n
    branch %t4, ^body, ^done

  block ^done:
    return void
}
function @literal_guard(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = vector pzero
    jump ^unrolled_1

  block ^unrolled_1:
    %t2 = phi v128 [^unrolled_1: %t15, ^entry: %t1]
    %t3 = phi i64 [^unrolled_1: %t16, ^entry: 0]
    %t4 = index i64 %p, %t3
    %t5 = load v128 %t4
    %t6 = vector paddq %t5, %t2
    %t7 = index i64 %t4, 2
    %t8 = load v128 %t7
    %t9 = vector paddq %t8, %t6
    %t10 = index i64 %t4, 4
    %t11 = load v128 %t10
    %t12 = vector paddq %t11, %t9
    %t13 = index i64 %t4, 6
    %t14 = load v128 %t13
    %t15 = vector paddq %t14, %t12
    %t16 = binary add nowrap i64 %t3, 8
    %t17 = cmp ne i64 %t16, 1000
    branch %t17, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t18 = vector pshufd %t15, 78
    %t19 = vector paddq %t15, %t18
    %t20 = vector toi64 %t19
    return i64 %t20
}
function @swap(%n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^header

  block ^header:
    %a = phi i64 [^entry: 1, ^body: %b]
    %b = phi i64 [^entry: 2, ^body: %a]
    %i = phi i64 [^entry: 0, ^body: %next]
    %c = cmp lt i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    call void @touch(%a)
    %next = binary add nowrap i64 %i, 1
    jump ^header

  block ^done:
    return i64 %b
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
