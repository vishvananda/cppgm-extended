global @state : i32 [binding=internal] = 42

function @capped(%n : i32, %p : ptr) -> i32 [no_inline=yes] {
  block ^entry:
    %big = cmp gt i32 %n, 60
    %t2 = select i32 %big, 60, %n
    %t3 = load typed i32 @state
    %t4 = binary and i32 %t2, -4
    %t5 = cmp gt i32 %t4, 0
    branch %t5, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t6 = convert sext i64 i32 %t3
    jump ^unrolled_2

  block ^unrolled_2:
    %t7 = phi i64 [^unrolled_2: %t19, ^loop_preheader_1: %t6]
    %t8 = phi i64 [^unrolled_2: %t22, ^loop_preheader_1: 0]
    %t9 = convert trunc exact i32 i64 %t7
    %t10 = binary add nowrap i32 %t9, 3
    store typed i32 %t10, @state
    %t11 = binary add i64 %t7, 3
    %t12 = index i64 %p, %t8
    store typed i64 %t11, %t12
    %t13 = binary add nowrap i32 %t9, 6
    store typed i32 %t13, @state
    %t14 = binary add i64 %t7, 6
    %t15 = index i64 %t12, 1
    store typed i64 %t14, %t15
    %t16 = binary add nowrap i32 %t9, 9
    store typed i32 %t16, @state
    %t17 = binary add i64 %t7, 9
    %t18 = index i64 %t12, 2
    store typed i64 %t17, %t18
    %t19 = binary add nowrap i64 %t7, 12
    %t20 = convert trunc exact i32 i64 %t19
    store typed i32 %t20, @state
    %t21 = index i64 %t12, 3
    store typed i64 %t19, %t21
    %t22 = binary add nowrap i64 %t8, 4
    %t23 = convert trunc exact i32 i64 %t22
    %t24 = cmp ne i32 %t4, %t23
    branch %t24, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t25 = phi i32 [^entry: %t3, ^unrolled_2: %t20]
    %t26 = phi i32 [^entry: 0, ^unrolled_2: %t23]
    %t27 = convert sext i64 i32 %t25
    %t28 = convert sext i64 i32 %t26
    jump ^loop

  block ^loop:
    %t29 = phi i64 [^wide_tail_3: %t27, ^body: %t33]
    %t30 = phi i64 [^wide_tail_3: %t28, ^body: %t36]
    %i = convert trunc exact i32 i64 %t30
    %more = cmp lt i32 %i, %t2
    branch %more, ^body, ^done

  block ^body:
    %t33 = binary add nowrap i64 %t29, 3
    %new = convert trunc exact i32 i64 %t33
    store typed i32 %new, @state
    %at = index i64 %p, %t30
    store typed i64 %t33, %at
    %t36 = binary add nowrap i64 %t30, 1
    jump ^loop

  block ^done:
    return i32 %t2
}
