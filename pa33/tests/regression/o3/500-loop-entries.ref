global @state : i32 [binding=internal] = 42

function @capped(%n : i32, %p : ptr) -> i32 [no_inline=yes] {
  block ^entry:
    %big = cmp gt i32 %n, 60
    %t2 = select i32 %big, 60, %n
    %t3 = cmp gt i32 %n, 60
    %t4 = select i32 %t3, 0, 0
    %t5 = load typed i32 @state
    %t6 = convert sext i64 i32 %t5
    %t7 = convert sext i64 i32 %t4
    jump ^loop

  block ^loop:
    %t8 = phi i64 [^entry: %t6, ^body: %t12]
    %t9 = phi i64 [^entry: %t7, ^body: %t16]
    %i = convert trunc exact i32 i64 %t9
    %more = cmp lt i32 %i, %t2
    branch %more, ^body, ^done

  block ^body:
    %t12 = binary add nowrap i64 %t8, 3
    %new = convert trunc exact i32 i64 %t12
    store typed i32 %new, @state
    %wide = copy i64 %t12
    %at = index i64 %p, %t9
    store typed i64 %wide, %at
    %t16 = binary add nowrap i64 %t9, 1
    jump ^loop

  block ^done:
    return i32 %t2
}
