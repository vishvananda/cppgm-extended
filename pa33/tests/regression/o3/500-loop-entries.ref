global @state : i32 [binding=internal] = 42

function @capped(%n : i32, %p : ptr) -> i32 [no_inline=yes] {
  block ^entry:
    %big = cmp gt i32 %n, 60
    %t2 = select i32 %big, 60, %n
    %t3 = cmp gt i32 %n, 60
    %t4 = select i32 %t3, 0, 0
    %t5 = load typed i32 @state
    %t6 = cmp lt i32 %t4, %t2
    branch %t6, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    %t7 = binary sub i32 %t2, %t4
    %t8 = binary and i32 %t7, -4
    %t9 = cmp gt i32 %t8, 0
    branch %t9, ^loop_preheader_2, ^wide_tail_4

  block ^loop_preheader_2:
    %t10 = binary add i32 %t4, %t8
    %t11 = convert sext i64 i32 %t5
    %t12 = convert sext i64 i32 %t4
    jump ^unrolled_3

  block ^unrolled_3:
    %t13 = phi i64 [^loop_preheader_2: %t11, ^unrolled_3: %t30]
    %t14 = phi i64 [^loop_preheader_2: %t12, ^unrolled_3: %t35]
    %t15 = convert trunc exact i32 i64 %t13
    %t16 = binary add nowrap i32 %t15, 3
    store typed i32 %t16, @state
    %t17 = binary add i64 %t13, 3
    %t18 = copy i64 %t17
    %t19 = index i64 %p, %t14
    store typed i64 %t18, %t19
    %t20 = binary add nowrap i32 %t15, 6
    store typed i32 %t20, @state
    %t21 = binary add i64 %t13, 6
    %t22 = copy i64 %t21
    %t23 = index i64 %p, %t14
    %t24 = index i64 %t23, 1
    store typed i64 %t22, %t24
    %t25 = binary add nowrap i32 %t15, 9
    store typed i32 %t25, @state
    %t26 = binary add i64 %t13, 9
    %t27 = copy i64 %t26
    %t28 = index i64 %p, %t14
    %t29 = index i64 %t28, 2
    store typed i64 %t27, %t29
    %t30 = binary add nowrap i64 %t13, 12
    %t31 = convert trunc exact i32 i64 %t30
    store typed i32 %t31, @state
    %t32 = copy i64 %t30
    %t33 = index i64 %p, %t14
    %t34 = index i64 %t33, 3
    store typed i64 %t32, %t34
    %t35 = binary add nowrap i64 %t14, 4
    %t36 = convert trunc exact i32 i64 %t35
    %t37 = cmp ne i32 %t10, %t36
    branch %t37, ^unrolled_3, ^wide_tail_4

  block ^wide_tail_4:
    %t38 = phi i32 [^entry: %t5, ^unrolled_3: %t31, ^loop_preheader_1: %t5]
    %t39 = phi i32 [^entry: %t4, ^unrolled_3: %t36, ^loop_preheader_1: %t4]
    %t40 = convert sext i64 i32 %t38
    %t41 = convert sext i64 i32 %t39
    jump ^loop

  block ^loop:
    %t42 = phi i64 [^wide_tail_4: %t40, ^body: %t46]
    %t43 = phi i64 [^wide_tail_4: %t41, ^body: %t50]
    %i = convert trunc exact i32 i64 %t43
    %more = cmp lt i32 %i, %t2
    branch %more, ^body, ^done

  block ^body:
    %t46 = binary add nowrap i64 %t42, 3
    %new = convert trunc exact i32 i64 %t46
    store typed i32 %new, @state
    %wide = copy i64 %t46
    %at = index i64 %p, %t43
    store typed i64 %wide, %at
    %t50 = binary add nowrap i64 %t43, 1
    jump ^loop

  block ^done:
    return i32 %t2
}
