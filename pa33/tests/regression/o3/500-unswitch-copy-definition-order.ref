global @values : obj<32x8> = {
  i64 1
  i64 2
  i64 3
  i64 4
}
global @odd : obj<8x8> = {
  i64 0
}
global @even : obj<8x8> = {
  i64 0
}

function @shape(%flag : i64, %p : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %flag, ^header, ^loop_preheader_1

  block ^loop_preheader_1:
    %t1 = phi i64 [^loop_preheader_4: %t8, ^entry: 0]
    %t2 = phi i64 [^loop_preheader_4: %t7, ^entry: 0]
    %t3 = index i64 %p, %t1
    %t4 = load i64 %t3
    %t5 = binary and i64 %t4, 1
    branch %t5, ^loop_preheader_3, ^loop_preheader_2

  block ^loop_preheader_2:
    store i64 %t1, @even
    jump ^loop_preheader_4

  block ^loop_preheader_3:
    store i64 %t4, @odd
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t6 = binary mul i64 %t4, 3
    store i64 %t1, @even
    %t7 = binary add i64 %t2, %t6
    %t8 = binary add nowrap i64 %t1, 1
    %t9 = cmp lt i64 %t8, %n
    branch %t9, ^loop_preheader_1, ^exit

  block ^header:
    %i = phi i64 [^mid: %next, ^entry: 0]
    %sum = phi i64 [^mid: %total, ^entry: 0]
    %at = index i64 %p, %i
    %v = load i64 %at
    %low = binary and i64 %v, 1
    branch %low, ^left, ^right

  block ^right:
    store i64 %i, @even
    jump ^mid

  block ^left:
    store i64 %v, @odd
    jump ^mid

  block ^mid:
    %t15 = index i64 %p, %i
    %scaled = binary mul i64 %v, 3
    store i64 %scaled, %t15
    %total = binary add i64 %sum, %scaled
    %next = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %next, %n
    branch %more, ^header, ^exit

  block ^exit:
    %t20 = phi i64 [^mid: %total, ^loop_preheader_4: %t7]
    return i64 %t20
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %kept = call i64 @shape(0, @values, 4)
    %stored = call i64 @shape(1, @values, 4)
    %again = call i64 @shape(0, @values, 4)
    %t4 = cmp eq i64 %kept, 30
    %kept_bit = select i32 %t4, 0, 1
    %t6 = cmp eq i64 %stored, 30
    %stored_bit = select i32 %t6, 0, 2
    %t8 = cmp eq i64 %again, 90
    %again_bit = select i32 %t8, 0, 4
    %some = binary or i32 %kept_bit, %stored_bit
    %status = binary or i32 %again_bit, %some
    return i32 %status
}
