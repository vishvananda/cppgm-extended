function @opaque(%x : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %r = binary add i64 %x, 1
    return i64 %r
}
function @read(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %f = index i8 %p, 8
    %v = load i64 %f
    return i64 %v
}
function @reduction(%n : i64, %p : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    %t2 = binary and i64 %n, -4
    branch %t2, ^loop_preheader_1, ^wide_tail_4

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t3 = phi i64 [^loop_preheader_1: %t1, ^unrolled_2: %t23]
    %t4 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t24]
    %t5 = index i64 %p, %t4
    %t6 = load typed i32 %t5
    %t7 = convert sext i64 i32 %t6
    %t8 = binary add i64 %t3, %t7
    %t9 = binary add i64 %t4, 1
    %t10 = index i64 %p, %t9
    %t11 = load typed i32 %t10
    %t12 = convert sext i64 i32 %t11
    %t13 = binary add i64 %t8, %t12
    %t14 = binary add i64 %t4, 2
    %t15 = index i64 %p, %t14
    %t16 = load typed i32 %t15
    %t17 = convert sext i64 i32 %t16
    %t18 = binary add i64 %t13, %t17
    %t19 = binary add i64 %t4, 3
    %t20 = index i64 %p, %t19
    %t21 = load typed i32 %t20
    %t22 = convert sext i64 i32 %t21
    %t23 = binary add i64 %t18, %t22
    %t24 = binary add i64 %t4, 4
    %t25 = cmp ne i64 %t2, %t24
    branch %t25, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t26 = cmp ult i64 %t24, %n
    branch %t26, ^wide_tail_4, ^loop_exit_6

  block ^wide_tail_4:
    %t27 = phi i64 [^entry: %t1, ^loop_exit_3: %t23]
    %t28 = phi i64 [^entry: 0, ^loop_exit_3: %t24]
    jump ^head

  block ^head:
    %t = phi i64 [^wide_tail_4: %t27, ^head: %u]
    %i = phi i64 [^wide_tail_4: %t28, ^head: %next]
    %at = index i64 %p, %i
    %v = load typed i32 %at
    %x = convert sext i64 i32 %v
    %u = binary add i64 %t, %x
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_6

  block ^loop_exit_6:
    %t37 = phi i64 [^head: %u, ^loop_exit_3: %t23]
    store typed i64 %t37, @total
    return void
}
function @two_exits(%n : i64, %p : ptr, %f : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    %t2 = load i64 @other
    jump ^head

  block ^head:
    %t3 = phi i64 [^entry: %t2, ^tail: %w]
    %t = phi i64 [^entry: %t1, ^tail: %u]
    %i = phi i64 [^entry: 0, ^tail: %next]
    %at = index i32 %p, %i
    %v = load typed i32 %at
    %x = convert sext i64 i32 %v
    %u = binary add i64 %t, %x
    %w = binary xor i64 %x, %t3
    %e = cmp eq i64 %f, %x
    branch %e, ^loop_exit_3, ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_4

  block ^loop_exit_3:
    store typed i64 %w, @other
    store typed i64 %u, @total
    return i64 1

  block ^loop_exit_4:
    store typed i64 %w, @other
    store typed i64 %u, @total
    return i64 0
}
function @through_pointer(%n : i64, %s : ptr, %q : ptr, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 %s, 8
    %t2 = load i64 %t1
    %t3 = cmp ne i64 %n, 0
    %t4 = cmp ugt i64 %n, 2
