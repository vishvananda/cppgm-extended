    store f80 %e, %t5
    store f80 %e, %t5
    store f80 %e, %t5
    store f80 %e, %t5
    store f80 %e, %t5
    store f80 %e, %t5
    store f80 %e, %t5
    %t6 = binary add i64 %t4, 8
    %t7 = cmp ne i64 %t3, %t6
    branch %t7, ^unrolled_2, ^loop_exit_3

