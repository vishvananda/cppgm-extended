    %t15 = load i32 @pair
    %t16 = convert sext i64 i32 %t15
    %t17 = binary add i64 %t14, %t16
    store i64 %t17, @pair
    %t18 = binary add i64 %t2, 4
    %t19 = cmp ne i64 %t1, %t18
    branch %t19, ^unrolled_2, ^loop_exit_3

  block ^loop_exit_3:
    %t20 = cmp ult i64 %t18, %n
    branch %t20, ^wide_tail_4, ^done

  block ^wide_tail_4:
    %t21 = phi i64 [^entry: 0, ^loop_exit_3: %t18]
    jump ^head

  block ^head:
    %i = phi i64 [^wide_tail_4: %t21, ^head: %next]
    %a = load i32 @pair
    %x = convert sext i64 i32 %a
    %u = binary add i64 %i, %x
    store i64 %u, @pair
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
