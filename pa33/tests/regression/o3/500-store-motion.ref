    store i64 %u, %t31
    %r = call i64 @read(%p)
    return i64 %r
}
function @some_passes(%n : i64, %f : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %e = cmp eq i64 %f, %i
    branch %e, ^write, ^tail

  block ^write:
    store typed i64 %i, @total
    jump ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
