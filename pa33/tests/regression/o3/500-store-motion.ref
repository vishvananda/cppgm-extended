    %a = index i8 @pair, 0
    store f80 %e, %a
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @through_unknown_step(%row : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 2
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t6 = phi v128 [^loop_preheader_1: %t5, ^wide_loop_2: %t10]
    %t7 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t11]
    %t8 = index i64 @values, %t7
    %t9 = load v128 %t8
    %t10 = vector paddq %t6, %t9
    %t11 = binary add nowrap i64 %t7, 2
    %t12 = cmp lt i64 %t11, %t4
    branch %t12, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t13 = vector pshufd %t10, 78
    %t14 = vector paddq %t10, %t13
    %t15 = vector toi64 %t14
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t16 = phi i64 [^entry: 0, ^loop_exit_3: %t15]
    %t17 = phi i64 [^entry: 0, ^loop_exit_3: %t11]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t17, ^body: %next]
    %s = phi i64 [^loop_preheader_4: %t16, ^body: %t]
    %q = index i64 @values, %i
    %v = load typed i64 %q
    %t = binary add i64 %s, %v
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^loop_exit_6

  block ^loop_exit_6:
    %p = index i64 @table, %row
    store typed i64 %t, %p
    return void
}
function @changing_step(%n : i64) -> void [no_inline=yes] {
