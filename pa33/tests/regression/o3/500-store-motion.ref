    store v128 %t8, %t16
    %t17 = binary add nowrap i64 %t10, 6
    %t18 = index f64 %q, %t17
    store v128 %t8, %t18
    %t19 = binary add nowrap i64 %t11, 8
    %t20 = binary add nowrap i64 %t10, 8
    %t21 = cmp ne i64 %t9, %t20
    branch %t21, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t22 = cmp ult i64 %t20, %t6
    branch %t22, ^wide_tail_5, ^loop_preheader_7

  block ^wide_tail_5:
    %t23 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t20]
    %t24 = phi i64 [^loop_preheader_1: %t2, ^loop_exit_4: %t19]
    jump ^wide_loop_6

  block ^wide_loop_6:
    %t25 = phi i64 [^wide_tail_5: %t23, ^wide_loop_6: %t29]
    %t26 = phi i64 [^wide_tail_5: %t24, ^wide_loop_6: %t28]
    %t27 = index f64 %q, %t25
    store v128 %t8, %t27
    %t28 = binary add nowrap i64 %t26, 2
    %t29 = binary add nowrap i64 %t25, 2
    %t30 = cmp ult i64 %t29, %t6
    branch %t30, ^wide_loop_6, ^loop_preheader_7

  block ^loop_preheader_7:
    %t31 = phi i64 [^entry: 0, ^wide_loop_6: %t29, ^loop_exit_4: %t20]
    %t32 = phi i64 [^entry: %t2, ^wide_loop_6: %t28, ^loop_exit_4: %t19]
    jump ^head

  block ^head:
    %t33 = phi i64 [^loop_preheader_7: %t32, ^head: %u]
    %i = phi i64 [^loop_preheader_7: %t31, ^head: %next]
    %at = index f64 %q, %i
    store typed f64 %v, %at
    %u = binary add i64 %t33, 1
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_9

  block ^loop_exit_9:
    %t39 = index i8 %s, 8
    store typed i64 %u, %t39
    return void
}
function @nested(%n : i64, %m : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    %t2 = cmp ne i64 %m, 0
    %t3 = cmp ugt i64 %m, 2
    %t4 = binary and i64 %t2, %t3
    %t5 = binary add i64 %m, -2
    %t6 = vector pzero
    %t7 = vector fromi64 1
    %t8 = vector punpcklqdq %t6, %t7
    %t9 = vector paddq %t6, %t8
    %t10 = vector fromi64 2
    %t11 = vector pshufd %t10, 68
    jump ^outer

  block ^outer:
    %t12 = phi i64 [^entry: %t1, ^latch: %u]
    %i = phi i64 [^entry: 0, ^latch: %i_next]
    branch %t4, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t14 = vector fromi64 %t12
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t15 = phi v128 [^loop_preheader_2: %t14, ^wide_loop_3: %t18]
    %t16 = phi v128 [^loop_preheader_2: %t9, ^wide_loop_3: %t20]
    %t17 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t19]
    %t18 = vector paddq %t15, %t16
    %t19 = binary add nowrap i64 %t17, 2
    %t20 = vector paddq %t16, %t11
    %t21 = cmp ult i64 %t19, %t5
    branch %t21, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t22 = vector pshufd %t18, 78
    %t23 = vector paddq %t18, %t22
    %t24 = vector toi64 %t23
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t25 = phi i64 [^outer: %t12, ^loop_exit_4: %t24]
    %t26 = phi i64 [^outer: 0, ^loop_exit_4: %t19]
    jump ^inner

  block ^inner:
    %t = phi i64 [^loop_preheader_5: %t25, ^inner: %u]
    %j = phi i64 [^loop_preheader_5: %t26, ^inner: %j_next]
    %u = binary add i64 %t, %j
    %j_next = binary add i64 %j, 1
    %d = cmp ult i64 %j_next, %m
    branch %d, ^inner, ^latch

  block ^latch:
    %i_next = binary add i64 %i, 1
    %c = cmp ult i64 %i_next, %n
    branch %c, ^outer, ^loop_exit_8

  block ^loop_exit_8:
    store typed i64 %u, @total
    return void
