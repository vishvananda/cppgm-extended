function @large_values(%n : i64, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %e = convert fpext f80 f64 %v
    %q = call i64 @opaque(%n)
    %t3 = binary and i64 %n, -8
    branch %t3, ^loop_preheader_1, ^wide_tail_4

