function @strides(%e : ptr, %d : ptr, %k : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed ptr %e
    %row = index i8 %t1, %k
    %field = index i8 %row, 24
    %s = load typed i32 %field
    %w = convert sext i64 i32 %s
    %t6 = binary and i64 %n, -4
    %t7 = cmp gt i64 %t6, 0
    branch %t7, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t8 = phi i64 [^unrolled_1: %t18, ^entry: 0]
    %t9 = phi i64 [^unrolled_1: %t17, ^entry: 0]
    %t10 = index f64 %d, %t8
    store typed f64 1, %t10
    %t11 = binary add i64 %w, %t8
    %t12 = index f64 %d, %t11
    store typed f64 1, %t12
    %t13 = binary add i64 %w, %t11
    %t14 = index f64 %d, %t13
    store typed f64 1, %t14
    %t15 = binary add i64 %w, %t13
    %t16 = index f64 %d, %t15
    store typed f64 1, %t16
    %t17 = binary add nowrap i64 %t9, 4
    %t18 = binary add i64 %w, %t15
    %t19 = cmp ne i64 %t6, %t17
    branch %t19, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t20 = cmp lt i64 %t17, %n
    branch %t20, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t21 = phi i64 [^entry: 0, ^loop_exit_2: %t18]
    %t22 = phi i64 [^entry: 0, ^loop_exit_2: %t17]
    jump ^body

  block ^body:
    %t23 = phi i64 [^wide_tail_3: %t21, ^body: %t27]
    %i = phi i64 [^wide_tail_3: %t22, ^body: %next]
    %p = index f64 %d, %t23
    store typed f64 1, %p
    %next = binary add nowrap i64 %i, 1
    %t27 = binary add i64 %w, %t23
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @same_type(%e : ptr, %d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -4
    %t2 = cmp gt i64 %t1, 0
    branch %t2, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t13, ^entry: 0]
    %t4 = index i8 %e, 24
    %t5 = load typed i32 %t4
    %t6 = index i32 %d, %t3
    store typed i32 %t5, %t6
    %t7 = load typed i32 %t4
    %t8 = index i32 %t6, 1
    store typed i32 %t7, %t8
    %t9 = load typed i32 %t4
    %t10 = index i32 %t6, 2
    store typed i32 %t9, %t10
    %t11 = load typed i32 %t4
    %t12 = index i32 %t6, 3
    store typed i32 %t11, %t12
    %t13 = binary add nowrap i64 %t3, 4
    %t14 = cmp ne i64 %t1, %t13
    branch %t14, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t15 = cmp lt i64 %t13, %n
    branch %t15, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t16 = phi i64 [^entry: 0, ^loop_exit_2: %t13]
    jump ^body

  block ^body:
    %i = phi i64 [^wide_tail_3: %t16, ^body: %next]
    %f = index i8 %e, 24
    %s = load typed i32 %f
    %p = index i32 %d, %i
    store typed i32 %s, %p
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
