global @seen : obj<8x8> = {
  zero 8
}

function @keep(%p : ptr) -> void [no_inline=yes] {
  block ^entry:
    store ptr %p, @seen
    return void
}
function @opaque(%v : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %r = binary add i64 %v, 3
    return i64 %r
}
function @eight_passes(%k : i64) -> i64 [no_inline=yes] {
  slot $s : obj<8x8>

  block ^entry:
    %p = addr $s
    call void @keep(%p)
    %t2 = binary mul i64 %k, %k
    %t3 = binary sub i64 %t2, %k
    %t4 = binary mul i64 %k, %t3
    %t5 = binary add i64 %t4, 1
    %t6 = binary mul i64 %k, %t5
    %t7 = binary sub i64 %t6, %k
    %t8 = binary mul i64 %k, %t7
    %t9 = binary add i64 %t8, 1
    %t10 = binary mul i64 %k, %t9
    %t11 = binary sub i64 %t10, %k
    %t12 = binary mul i64 %k, %t11
    %t13 = binary add i64 %t12, 1
    %t14 = binary mul i64 %k, %t13
    %t15 = binary sub i64 %t14, %k
    %t16 = binary mul i64 %k, %t15
    %t17 = binary add i64 %t16, 1
    %t18 = binary mul i64 %k, %t17
    %t19 = binary sub i64 %t18, %k
    %t20 = binary mul i64 %k, %t19
    %t21 = binary add i64 %t20, 1
    %t22 = binary mul i64 %k, %t21
    %t23 = binary sub i64 %t22, %k
    %t24 = binary mul i64 %k, %t23
    %t25 = binary add i64 %t24, 1
    %t26 = binary mul i64 %k, %t25
    %t27 = binary sub i64 %t26, %k
    %t28 = binary mul i64 %k, %t27
    %t29 = binary add i64 %t28, 1
    store i64 %t29, %p
    %t30 = binary mul i64 %k, %t29
    %t31 = binary sub i64 %t30, %k
    %t32 = binary mul i64 %k, %t31
    %t33 = binary add i64 %t32, 1
    %r = binary add i64 %t29, %t33
    return i64 %r
}
function @nine_passes(%k : i64) -> i64 [no_inline=yes] {
  slot $s : obj<8x8>

  block ^entry:
    %p = addr $s
    call void @keep(%p)
    jump ^body

  block ^body:
    %t2 = phi i64 [^body: %out, ^entry: %k]
    %t3 = phi i64 [^body: %next, ^entry: 0]
    %v0 = binary mul i64 %k, %t2
    %v1 = binary sub i64 %v0, %k
    %v2 = binary mul i64 %k, %v1
    %out = binary add i64 %v2, 1
    %next = binary add nowrap i64 %t3, 1
    %t9 = cmp lt i64 %next, 9
    branch %t9, ^body, ^loop_exit_2

  block ^loop_exit_2:
    store i64 %t2, %p
    %r = binary add i64 %out, %t2
    return i64 %r
}
