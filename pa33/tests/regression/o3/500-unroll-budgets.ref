function @four_passes_with_call(%k : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = call i64 @opaque(%k)
    %t2 = call i64 @opaque(%t1)
    %t3 = call i64 @opaque(%t2)
    %t4 = call i64 @opaque(%t3)
    return i64 %t4
}
function @five_passes_with_call(%k : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %t1 = phi i64 [^body: %out, ^entry: %k]
    %t2 = phi i64 [^body: %next, ^entry: 0]
    %out = call i64 @opaque(%t1)
    %next = binary add nowrap i64 %t2, 1
    %t5 = cmp lt i64 %next, 5
    branch %t5, ^body, ^exit

  block ^exit:
    %t6 = phi i64 [^body: %out]
    return i64 %t6
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call i64 @eight_passes(1)
    %b = call i64 @nine_passes(1)
    %c = call i64 @five_passes_within_size(1)
    %d = call i64 @five_passes_over_size(1)
    %e = call i64 @four_passes_with_call(1)
    %f = call i64 @five_passes_with_call(1)
    %s1 = binary add i64 %a, %b
    %s2 = binary add i64 %c, %s1
    %s3 = binary add i64 %d, %s2
    %s4 = binary add i64 %e, %s3
    %s5 = binary add i64 %f, %s4
    %out = convert trunc i32 i64 %s5
    return i32 %out
}
