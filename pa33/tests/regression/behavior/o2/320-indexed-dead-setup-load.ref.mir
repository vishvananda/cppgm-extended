machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 11
  item i64 22
  item i64 33

function @read_value
  abi
    param %element -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    imul rdi, 8
    mov r8, @values
    add r8, rdi
    load.i64 rax, [r8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues direct

  block ^entry
    mov rdi, 2
    call @read_value [args=(rdi)]
    mov rdx, 33
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
