machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @global_value
  storage scalar i64
  init i64 11

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @copy_and_store_address
  abi
    param %condition -> rdi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve rbx
    slot $value -> [rbp-8] : i64
    slot $saved -> [rbp-16] : ptr

  block ^entry
    mov rbx, rdi
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    test.i64 rbx, rbx
    je ^direct

  block ^copy
    lea rax, [rbp-8]
    store.ptr [rbp-16], rax
    jmp ^done

  block ^direct
    lea rax, [rbp-8]
    store.ptr [rbp-16], rax

  block ^done
    load.ptr r9, [rbp-16]
    test.ptr r9, r9
    sete rax
    movzx rax, rax
    ret rax

function @return_slot_address
  abi
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $value -> [rbp-8] : i64

  block ^entry
    mov rdi, 9
    call @identity [args=(rdi), unwind=no]
    lea rax, [rbp-8]
    ret rax

function @integer_copy_arithmetic
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $value -> [rbp-8] : i64

  block ^entry
    lea r9, [rbp-8]
    lea r8, [rbp-7]
    sub r8, 1
    cmp.i64 r8, r9
    setne rax
    movzx rax, rax
    ret rax

function @copy_and_store_global_address
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $saved -> [rbp-8] : ptr

  block ^entry
    mov rdi, 13
    call @identity [args=(rdi), unwind=no]
    mov rax, @global_value
    store.ptr [rbp-8], rax
    load.ptr r9, [rbp-8]
    test.ptr r9, r9
    sete rax
    movzx rax, rax
    ret rax

function @return_global_address
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    mov rdi, 15
    call @identity [args=(rdi), unwind=no]
    mov rax, @global_value
    ret rax

function @global_integer_arithmetic
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    mov r9, @global_value
    lea r8, [r9+1]
    sub r8, 1
    cmp.i64 r8, r9
    setne rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve rbx r12 r13 r14 r15
    temp %global_copy_bad -> [rbp-8] : i64

  block ^entry
    mov rdi, 1
    call @copy_and_store_address [args=(rdi), unwind=no]
    mov rbx, rax
    mov rdi, 0
    call @copy_and_store_address [args=(rdi), unwind=no]
    mov r12, rax
    call @return_slot_address [args=(), unwind=no]
    mov rdx, 0
    cmp.ptr rax, rdx
    sete r13
    movzx r13, r13
    call @integer_copy_arithmetic [args=(), unwind=no]
    mov r14, rax
    call @copy_and_store_global_address [args=(), unwind=no]
    mov r15, rax
    call @return_global_address [args=(), unwind=no]
    store.i64 [rbp-8], r15
    mov rdx, 0
    cmp.ptr rax, rdx
    sete r15
    movzx r15, r15
    call @global_integer_arithmetic [args=(), unwind=no]
    or rbx, r12
    or rbx, r13
    or rbx, r14
    or rbx, [rbp-8]
    or rbx, r15
    or rbx, rax
    ret rbx
