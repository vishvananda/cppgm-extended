// The spellings Clang's headers use where GCC's differ, called directly:
// lanes of the other signedness, palignr's byte count on __v16qi, whole-register
// shifts on __v16qi, the generic elementwise forms, a result uncast on other
// lanes, the nontemporal builtins and the functions they only declare.
#include <stdio.h>
#include <string.h>
typedef char v16qi __attribute__((vector_size(16)));
typedef signed char v16qs __attribute__((vector_size(16)));
typedef unsigned char v16qu __attribute__((vector_size(16)));
typedef short v8hi __attribute__((vector_size(16)));
typedef unsigned short v8hu __attribute__((vector_size(16)));
typedef int v4si __attribute__((vector_size(16)));
typedef long long v2di __attribute__((vector_size(16)));
typedef float v4sf __attribute__((vector_size(16)));
typedef double v2df __attribute__((vector_size(16)));
extern "C" void _mm_mfence(void);
extern "C" void _mm_lfence(void);
extern "C" void _mm_sfence(void);
extern "C" void _mm_pause(void);
extern "C" void _mm_clflush(void const*);

static void show(const char* name, const void* value)
{
	unsigned char bytes[16];
	memcpy(bytes, value, 16);
	printf("%s", name);
	for (int i = 0; i < 16; ++i)
		printf(" %02x", bytes[i]);
	printf("\n");
}

static v2di whole_register(v2df value)
{
	return __builtin_ia32_cvtpd2dq(value);
}

int main()
{
	v16qu ramp;
	for (int i = 0; i < 16; ++i)
		ramp[i] = (unsigned char)(i * 17 + 3);
	v16qu top = ramp;
	for (int i = 0; i < 16; ++i)
		top[i] = (unsigned char)(255 - i);
	v8hu words = (v8hu)ramp;
	v8hu other = (v8hu)top;
	v8hu high = (v8hu)__builtin_ia32_pmulhuw128(words, other);
	show("pmulhuw", &high);
	v16qi first = (v16qi)ramp, second = (v16qi)top;
	v2di aligned = (v2di)__builtin_ia32_palignr128(first, second, 3);
	show("palignr-bytes", &aligned);
	v2di bits = (v2di)__builtin_ia32_palignr128((v2di)ramp, (v2di)top, 24);
	show("palignr-bits", &bits);
	v2di left = (v2di)__builtin_ia32_pslldqi128_byteshift(first, 5);
	v2di right = (v2di)__builtin_ia32_psrldqi128_byteshift(first, 5);
	show("shift-left", &left);
	show("shift-right", &right);
	v16qs add = __builtin_elementwise_add_sat((v16qs)ramp, (v16qs)top);
	v16qu addu = __builtin_elementwise_add_sat(ramp, top);
	v16qs sub = __builtin_elementwise_sub_sat((v16qs)ramp, (v16qs)top);
	v16qu subu = __builtin_elementwise_sub_sat(ramp, top);
	v8hi addw = __builtin_elementwise_add_sat((v8hi)ramp, (v8hi)top);
	v8hu subw = __builtin_elementwise_sub_sat(words, other);
	show("add-sat", &add);
	show("add-sat-u", &addu);
	show("sub-sat", &sub);
	show("sub-sat-u", &subu);
	show("add-sat-w", &addw);
	show("sub-sat-wu", &subw);
	v16qs absolute = __builtin_elementwise_abs((v16qs)top);
	v4si absolute_word = __builtin_elementwise_abs((v4si)top);
	show("abs", &absolute);
	show("abs-w", &absolute_word);
	v2df half = { 1.5, -2.5 };
	v2di rounded = whole_register(half);
	show("cvtpd2dq", &rounded);
	v2di memory[2] __attribute__((aligned(16)));
	__builtin_nontemporal_store((v2di)ramp, &memory[0]);
	_mm_sfence();
	v2di loaded = __builtin_nontemporal_load((const v2di*)&memory[0]);
	show("nontemporal", &loaded);
	_mm_mfence();
	_mm_lfence();
	_mm_pause();
	_mm_clflush(&memory[1]);
	return 0;
}
