#include <cstdio>

// Each round of the optimizer's loop passes rewrites the loops that do not
// touch one another: adjacent loops, loops that read the last one's result in
// their test, and loops around them.
#define SUM(k) \
	for (int i = 0; i < n; ++i) \
		s += a[i] + m * (k);
#define TEST(k) \
	for (int i = 0; i < n + (s & 1); ++i) \
		s += a[i] ^ (k);
#define CELL(k) \
	for (int i = 0; i < n; ++i) \
	{ \
		a[i] += (k); \
		cell += i; \
	}
#define NEST(k) \
	for (int i = 0; i < 3; ++i) \
		for (int j = 0; j < n; ++j) \
			s -= a[j] * (m + (k) + i);
#define FOUR(X, k) X(k) X((k) + 1) X((k) + 2) X((k) + 3)
#define SIXTEEN(X, k) FOUR(X, k) FOUR(X, (k) + 4) FOUR(X, (k) + 8) FOUR(X, (k) + 12)

static int cell;

__attribute__((noinline)) static int many(int* a, int n, int m)
{
	int s = 0;
	SIXTEEN(SUM, 1)
	SIXTEEN(SUM, 17)
	SIXTEEN(SUM, 33)
	std::printf("%d\n", s);
	SIXTEEN(TEST, 1)
	std::printf("%d\n", s);
	SIXTEEN(CELL, 1)
	SIXTEEN(CELL, 17)
	std::printf("%d %d\n", s, cell);
	SIXTEEN(NEST, 1)
	return s;
}

int main()
{
	int a[64];
	for (int n = 0; n < 64; n += 7)
	{
		for (int i = 0; i < 64; ++i)
			a[i] = i * 3 + n;
		std::printf("%d\n", many(a, n, n + 5));
		int sum = 0;
		for (int i = 0; i < 64; ++i)
			sum ^= a[i];
		std::printf("%d\n", sum);
	}
	return 0;
}
