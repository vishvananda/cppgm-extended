#include <limits.h>
#include <stdio.h>

static long data[64];

__attribute__((noinline)) unsigned long plus_k(const long* p, int from, int to, int k)
{
	unsigned long sum = 0;
	for (int i = from; i < to; ++i)
		sum = sum * 3 + p[i + k] - p[i + 1 + k] + p[i - 1 + k];
	return sum;
}

// `i` itself sits near INT_MAX; the base brings the index back into the array.
__attribute__((noinline)) long high_counter(const long* p, int n)
{
	long sum = 0;
	for (int i = INT_MAX - n; i < INT_MAX; ++i)
		sum += p[i - (INT_MAX - n)] * (i % 7);
	return sum;
}

// Index below zero of the pointer passed.
__attribute__((noinline)) unsigned long below_zero(const long* p, int n)
{
	unsigned long sum = 0;
	for (int i = -n; i < 0; ++i)
		sum = sum * 5 + p[i];
	return sum;
}

__attribute__((noinline)) unsigned long downward(const long* p, int n, int k)
{
	unsigned long sum = 0;
	for (int i = n; i >= 0; i -= 2)
		sum = sum * 7 + p[i + k];
	return sum;
}

__attribute__((noinline)) unsigned long unsigned_counter(const long* p, unsigned n)
{
	unsigned long sum = 0;
	for (unsigned i = 1; i < n; i += 3)
		sum = sum * 11 + p[i];
	return sum;
}

// The counter's narrow value is read after the loop.
__attribute__((noinline)) int after_loop(const long* p, int n, long limit)
{
	int i;
	long sum = 0;
	for (i = 0; i < n; ++i)
	{
		sum += p[i];
		if (sum > limit)
			break;
	}
	return i * 10 + (sum & 7);
}

__attribute__((noinline)) long nested(const long* p, int n, int m)
{
	long sum = 0;
	for (int i = 0; i < n; ++i)
		for (int j = i; j < m; ++j)
			sum += p[i * 4 + j] - p[j + 1];
	return sum;
}

__attribute__((noinline)) long as_short(const long* p, int n)
{
	long sum = 0;
	for (int i = 0; i < n; ++i)
		sum += p[i] + (short)(i * 20000) + (unsigned)i;
	return sum;
}

struct Pair
{
	int a, b;
};

__attribute__((noinline)) Pair make_pair_of(int a, int b)
{
	Pair p;
	p.a = a;
	p.b = b;
	return p;
}

__attribute__((noinline)) long packed(const long* p, int n)
{
	long sum = 0;
	for (int i = 0; i < n; ++i)
	{
		Pair q = { i, n - i };
		Pair r = q;
		sum += p[r.a] * r.b;
	}
	return sum;
}

int main()
{
	for (int i = 0; i < 64; ++i)
		data[i] = i * i - 40 * i + 7;
	printf("%lu\n", plus_k(data, 1, 40, 5));
	printf("%lu\n", plus_k(data + 20, 0, 30, -9));
	printf("%ld\n", high_counter(data, 50));
	printf("%lu\n", below_zero(data + 40, 30));
	printf("%lu\n", downward(data, 40, 3));
	printf("%lu\n", unsigned_counter(data, 60));
	printf("%d\n", after_loop(data, 50, -300));
	printf("%d\n", after_loop(data, 3, 1000000));
	printf("%ld\n", nested(data, 8, 30));
	printf("%ld\n", as_short(data, 60));
	printf("%ld\n", packed(data, 40));
	Pair p = make_pair_of(3, -4);
	printf("%d %d\n", p.a, p.b);
	return 0;
}
