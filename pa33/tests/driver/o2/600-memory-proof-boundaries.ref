function @allocated(%existing : ptr, %v : i32) -> i32 [binding=strong, object=_Z9allocatedPii, no_inline=yes] {
  block ^entry:
    %t1 = call ptr @malloc(4)
    %t2 = cmp eq ptr %t1, 0
    branch %t2, ^if_then_1, ^if_end_2

  block ^if_then_1:
    %t3 = load typed i32 %existing
    return i32 %t3

  block ^if_end_2:
    store typed i32 91, %t1
    %t4 = load typed i32 %existing
    call void @free(%t1)
    return i32 %t4
}
function @zero_trip(%p : ptr, %n : u32) -> i32 [binding=strong, object=_Z9zero_tripPKij, no_inline=yes] {
  block ^entry:
    %t1 = binary and u32 %n, 4294967288
    branch %t1, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t2 = phi u32 [^loop_preheader_1: 0, ^unrolled_2: %t20]
    %t3 = phi i32 [^loop_preheader_1: 0, ^unrolled_2: %t19]
    %t4 = load typed i32 %p
    %t5 = binary add nowrap i32 %t3, %t4
    %t6 = load typed i32 %p
    %t7 = binary add nowrap i32 %t5, %t6
    %t8 = load typed i32 %p
    %t9 = binary add nowrap i32 %t7, %t8
    %t10 = load typed i32 %p
    %t11 = binary add nowrap i32 %t9, %t10
    %t12 = load typed i32 %p
    %t13 = binary add nowrap i32 %t11, %t12
    %t14 = load typed i32 %p
    %t15 = binary add nowrap i32 %t13, %t14
    %t16 = load typed i32 %p
    %t17 = binary add nowrap i32 %t15, %t16
    %t18 = load typed i32 %p
    %t19 = binary add nowrap i32 %t17, %t18
    %t20 = binary add nowrap u32 %t2, 8
    %t21 = cmp ne u32 %t1, %t20
    branch %t21, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t22 = phi u32 [^entry: 0, ^unrolled_2: %t20]
    %t23 = phi i32 [^entry: 0, ^unrolled_2: %t19]
    jump ^for_cond_4

  block ^for_cond_4:
    %t24 = phi u32 [^wide_tail_3: %t22, ^for_body_5: %t29]
    %t25 = phi i32 [^wide_tail_3: %t23, ^for_body_5: %t28]
    %t26 = cmp ult u32 %t24, %n
    branch %t26, ^for_body_5, ^for_end_6

  block ^for_body_5:
    %t27 = load typed i32 %p
    %t28 = binary add nowrap i32 %t25, %t27
    %t29 = binary add u32 %t24, 1
    jump ^for_cond_4

  block ^for_end_6:
    return i32 %t25
