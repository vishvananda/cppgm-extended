    return i32 3

  block ^if_end_9:
    %t22 = load volatile i32 $input
    store typed i32 %t22, $x
    %t23 = addr $y
    %t24 = call i32 @aliases(%t17, %t23)
    %t25 = cmp ne i32 %t24, 14
    branch %t25, ^if_then_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t26 = load typed i32 $y
