declare function @malloc(%arg0 : i64) -> ptr [linkage=c, binding=strong]
declare function @free(%arg0 : ptr) -> void [linkage=c, binding=strong]

global @escaped : ptr [binding=internal, object=_ZL7escaped] = zero

function @fields(%a : ptr, %b : ptr) -> i32 [binding=strong, object=_Z6fieldsP4CellS0_, no_inline=yes] {
  block ^entry:
    %t1 = load typed i32 %a
    %t2 = binary add nowrap i32 %t1, 3
    %t3 = index i8 [projection=field] %b, 4
    store typed i32 %t2, %t3
    %t4 = load typed i32 %a
    %t5 = binary add nowrap i32 %t1, %t4
    return i32 %t5
}
function @aliases(%a : ptr, %b : ptr) -> i32 [binding=strong, object=_Z7aliasesPiS_, no_inline=yes] {
  block ^entry:
    %t1 = load typed i32 %a
    %t2 = binary add nowrap i32 %t1, 3
    store typed i32 %t2, %b
    %t3 = load typed i32 %a
    %t4 = binary add nowrap i32 %t1, %t3
    return i32 %t4
}
function @bytes(%p : ptr, %q : ptr) -> u32 [binding=strong, object=_Z5bytesPjPh, no_inline=yes] {
  block ^entry:
    %t1 = load typed u32 %p
    store u8 0, %q
    %t2 = load typed u32 %p
    %t3 = binary xor u32 %t1, %t2
    return u32 %t3
}
function @change() -> void [binding=strong, object=_Z6changev, no_inline=yes] {
  block ^entry:
    %t1 = load typed ptr @escaped
    store typed i32 11, %t1
    return void
}
function @call_path(%v : i32) -> i32 [binding=strong, object=_Z9call_pathi, no_inline=yes] {
  slot $local : i32

  block ^entry:
    store typed i32 %v, $local
    %t1 = addr $local
    store typed ptr %t1, @escaped
    call void @change()
    store typed ptr 0, @escaped
    %t2 = load typed i32 $local
    return i32 %t2
}
function @private_slot(%out : ptr, %v : i32) -> i32 [binding=strong, object=_Z12private_slotPii, no_inline=yes] {
  block ^entry:
    store typed i32 9, %out
    return i32 %v
}
function @allocated(%existing : ptr, %v : i32) -> i32 [binding=strong, object=_Z9allocatedPii, no_inline=yes] {
  block ^entry:
    %t1 = call ptr @malloc(4)
    %t2 = cmp eq ptr %t1, 0
    branch %t2, ^if_then_1, ^if_end_2

  block ^if_then_1:
    %t3 = load typed i32 %existing
    return i32 %t3

  block ^if_end_2:
    store typed i32 91, %t1
    %t4 = load typed i32 %existing
    call void @free(%t1)
    return i32 %t4
}
function @zero_trip(%p : ptr, %n : u32) -> i32 [binding=strong, object=_Z9zero_tripPKij, no_inline=yes] {
  block ^entry:
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = phi u32 [^entry: 0, ^for_body_2: %t6]
    %t2 = phi i32 [^entry: 0, ^for_body_2: %t5]
    %t3 = cmp ult u32 %t1, %n
    branch %t3, ^for_body_2, ^for_end_3

  block ^for_body_2:
    %t4 = load typed i32 %p
    %t5 = binary add nowrap i32 %t4, %t2
    %t6 = binary add u32 %t1, 1
    jump ^for_cond_1

  block ^for_end_3:
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $input : i32
  slot $c : obj<8x4>
  slot $d : obj<8x4>
  slot $x : i32
  slot $y : i32
  slot $bits : u32

  block ^entry:
    store volatile i32 7, $input
    %t1 = addr $c
    %t2 = load volatile i32 $input
    store typed i32 %t2, %t1
    %t3 = index i8 [projection=field] %t1, 4
    store typed i32 0, %t3
    %t4 = addr $d
    store typed i32 0, %t4
    %t5 = index i8 [projection=field] %t4, 4
    store typed i32 0, %t5
    %t6 = call i32 @fields(%t1, %t1)
    %t7 = cmp ne i32 %t6, 14
    branch %t7, ^if_then_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t8 = load typed i32 %t3
    %t9 = cmp ne i32 %t8, 10
    branch %t9, ^if_then_2, ^if_end_3

  block ^if_then_2:
    return i32 1

  block ^if_end_3:
    %t10 = call i32 @fields(%t1, %t4)
    %t11 = cmp ne i32 %t10, 14
    branch %t11, ^if_then_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t12 = load typed i32 %t5
    %t13 = cmp ne i32 %t12, 10
    branch %t13, ^if_then_5, ^if_end_6

  block ^if_then_5:
    return i32 2

  block ^if_end_6:
    %t14 = load volatile i32 $input
    store typed i32 %t14, $x
    store typed i32 1, $y
    %t15 = addr $x
    %t16 = call i32 @aliases(%t15, %t15)
    %t17 = cmp ne i32 %t16, 17
    branch %t17, ^if_then_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t18 = load typed i32 $x
    %t19 = cmp ne i32 %t18, 10
    branch %t19, ^if_then_8, ^if_end_9

  block ^if_then_8:
    return i32 3

  block ^if_end_9:
    %t20 = load volatile i32 $input
    store typed i32 %t20, $x
    %t21 = addr $y
    %t22 = call i32 @aliases(%t15, %t21)
    %t23 = cmp ne i32 %t22, 14
    branch %t23, ^if_then_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t24 = load typed i32 $y
    %t25 = cmp ne i32 %t24, 10
    branch %t25, ^if_then_11, ^if_end_12

  block ^if_then_11:
    return i32 4

  block ^if_end_12:
    store typed u32 305419896, $bits
    %t26 = addr $bits
    %t27 = call u32 @bytes(%t26, %t26)
    %t28 = cmp ne u32 %t27, 120
    branch %t28, ^if_then_13, ^if_else_14

  block ^if_then_13:
    return i32 5

  block ^if_else_14:
    %t29 = load volatile i32 $input
    %t30 = call i32 @call_path(%t29)
    %t31 = cmp ne i32 %t30, 11
    branch %t31, ^if_then_16, ^lor_rhs_15

  block ^lor_rhs_15:
    %t32 = load volatile i32 $input
    %t33 = call i32 @private_slot(%t15, %t32)
    %t34 = cmp ne i32 %t33, 7
    branch %t34, ^if_then_16, ^if_end_17

  block ^if_then_16:
    return i32 6

  block ^if_end_17:
    %t35 = load volatile i32 $input
    %t36 = call i32 @allocated(%t21, %t35)
    %t37 = cmp ne i32 %t36, 10
    branch %t37, ^if_then_18, ^if_else_19

  block ^if_then_18:
    return i32 7

  block ^if_else_19:
    %t38 = call i32 @zero_trip(0, 0)
    branch %t38, ^if_then_21, ^lor_rhs_20

  block ^lor_rhs_20:
    %t39 = call i32 @zero_trip(%t15, 3)
    %t40 = cmp ne i32 %t39, 27
    branch %t40, ^if_then_21, ^if_end_22

  block ^if_then_21:
    return i32 8

  block ^if_end_22:
    return i32 0
}
