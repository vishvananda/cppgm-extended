function @bytes(%p : ptr, %q : ptr) -> u32 [binding=strong, object=_Z5bytesPjPh, no_inline=yes] {
  block ^entry:
    %t1 = load typed u32 %p
    store u8 0, %q
    %t2 = load typed u32 %p
    %t3 = binary xor u32 %t1, %t2
