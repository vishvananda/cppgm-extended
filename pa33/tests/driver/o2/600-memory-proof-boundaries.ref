    %t13 = index inbounds i8 [projection=field] %t4, 4
    %t14 = load typed i32 %t13
    %t15 = cmp ne i32 %t14, 10
    branch %t15, ^if_then_5, ^if_end_6

  block ^if_then_5:
    return i32 2

