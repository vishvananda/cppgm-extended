function @expose(%out : ptr, %from : ptr, %seed : u32) -> void [binding=strong, object=_Z6exposeP4FourPPjj, no_inline=yes] {
  block ^entry:
    store typed u32 %seed, %out
    %t1 = binary add u32 %seed, 3
