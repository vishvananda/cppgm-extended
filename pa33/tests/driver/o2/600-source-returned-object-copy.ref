    %t3 = load typed ptr $from
    %t4 = load typed u32 %t3
    %t5 = index i8 [projection=field] %t1, 4
    store typed u32 %t4, %t5
    %t6 = index inbounds u32 [projection=array_element] %t3, 1
    %t7 = load typed u32 %t6
