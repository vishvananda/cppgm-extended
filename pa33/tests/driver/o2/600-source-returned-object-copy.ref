    %t11 = index i8 [projection=field] %t1, 12
    store typed u32 %t10, %t11
    %t12 = load i64 %t1
    %t13 = load i64 %t8
    %t14 = convert zext i128 i64 %t12
    %t15 = convert zext i128 i64 %t13
    %t16 = binary shl i128 %t15, 64
    %t17 = binary or i128 %t14, %t16
