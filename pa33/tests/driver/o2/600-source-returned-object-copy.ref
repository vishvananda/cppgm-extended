    store typed u32 %t3, %t4
    %t5 = binary add u32 %seed, 7
    %t6 = index i8 [projection=field] %out, 12
    store typed u32 %t5, %t6
    store typed ptr %out, %from
    return void
}
function @captured(%seed : u32) -> i128 [result_classes=integer_integer, binding=strong, object=_Z8capturedj, no_inline=yes] {
