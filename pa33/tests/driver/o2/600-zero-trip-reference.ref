function @first_or(%p : ptr, %n : i32, %r : i32) -> i32 [binding=strong, object=_Z8first_orPKiii, no_inline=yes] {
  block ^entry:
    %t1 = binary and i32 %n, -4
    %t2 = cmp gt i32 %t1, 0
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i32 [^unrolled_1: %t20, ^entry: 0]
    %t4 = phi i32 [^unrolled_1: %t19, ^entry: %r]
    %t5 = load typed i32 %p
    %t6 = binary add nowrap i32 %t3, %t5
    %t7 = binary add nowrap i32 %t4, %t6
    %t8 = binary add nowrap i32 %t3, 1
    %t9 = load typed i32 %p
    %t10 = binary add nowrap i32 %t8, %t9
    %t11 = binary add nowrap i32 %t7, %t10
    %t12 = binary add nowrap i32 %t3, 2
    %t13 = load typed i32 %p
    %t14 = binary add nowrap i32 %t12, %t13
    %t15 = binary add nowrap i32 %t11, %t14
    %t16 = binary add nowrap i32 %t3, 3
    %t17 = load typed i32 %p
    %t18 = binary add nowrap i32 %t16, %t17
    %t19 = binary add nowrap i32 %t15, %t18
    %t20 = binary add nowrap i32 %t3, 4
    %t21 = cmp ne i32 %t1, %t20
    branch %t21, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t22 = phi i32 [^entry: 0, ^unrolled_1: %t20]
    %t23 = phi i32 [^entry: %r, ^unrolled_1: %t19]
    jump ^for_cond_3

  block ^for_cond_3:
    %t24 = phi i32 [^wide_tail_2: %t22, ^for_body_4: %t30]
    %t25 = phi i32 [^wide_tail_2: %t23, ^for_body_4: %t29]
    %t26 = cmp lt i32 %t24, %n
    branch %t26, ^for_body_4, ^for_end_5

  block ^for_body_4:
    %t27 = load typed i32 %p
    %t28 = binary add nowrap i32 %t24, %t27
    %t29 = binary add nowrap i32 %t25, %t28
    %t30 = binary add nowrap i32 %t24, 1
    jump ^for_cond_3

  block ^for_end_5:
    return i32 %t25
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @first_or(0, 0, 7)
    %t2 = cmp eq i32 %t1, 7
    %t3 = select i32 %t2, 0, 1
    return i32 %t3
}
