declare function @malloc(%arg0 : i64) -> ptr [unwind=no, noalias_result=yes, linkage=c, binding=strong]
declare function @free(%arg0 : ptr) -> void [unwind=no, linkage=c, binding=strong]

global @published : ptr [binding=strong] = zero

function @capture(%p : ptr) -> void [binding=strong, object=_Z7capturePi, no_inline=yes] {
  block ^entry:
    store typed ptr %p, @published
    return void
}
function @scan(%holder : ptr, %publish : i32) -> i32 [binding=strong, object=_Z4scanPPii, no_inline=yes] {
  block ^entry:
    %t1 = call ptr @malloc(16)
    %t2 = cmp eq ptr %t1, 0
    branch %t2, ^if_then_1, ^if_end_2

  block ^if_then_1:
    return i32 -1

  block ^if_end_2:
    %t3 = cmp eq i32 %publish, 1
    branch %t3, ^if_then_3, ^if_end_4

  block ^if_then_3:
    store typed ptr %t1, @published
    jump ^if_end_6

  block ^if_end_4:
    %t4 = cmp eq i32 %publish, 2
    branch %t4, ^if_then_5, ^if_end_6

  block ^if_then_5:
    call void @capture(%t1)
    jump ^if_end_6

  block ^if_end_6:
    store typed i32 7, %t1
    %t5 = load typed ptr %holder
    %t6 = load typed i32 %t5
    store typed i32 0, %t1
    %t7 = load typed i32 %t5
    %t8 = binary add nowrap i32 %t6, %t7
    %t9 = index inbounds i32 [projection=array_element] %t1, 1
    store typed i32 1, %t9
    %t10 = load typed i32 %t5
    %t11 = binary add nowrap i32 %t8, %t10
    %t12 = index inbounds i32 [projection=array_element] %t1, 2
    store typed i32 2, %t12
    %t13 = load typed i32 %t5
    %t14 = binary add nowrap i32 %t11, %t13
    %t15 = index inbounds i32 [projection=array_element] %t1, 3
    store typed i32 3, %t15
    %t16 = index inbounds i8 %t1, 12
    %t17 = load volatile i32 %t16
    call void @free(%t1)
    %t18 = binary add nowrap i32 %t17, %t14
    return i32 %t18
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $source : ptr

  block ^entry:
    store typed i32 9, $value
    %t1 = addr $value
    store typed ptr %t1, $source
    %t2 = addr $source
    %t3 = call i32 @scan(%t2, 0)
    %t4 = cmp ne i32 %t3, 39
    branch %t4, ^if_then_1, ^if_end_2

  block ^if_then_1:
    return i32 1

  block ^if_end_2:
    %t5 = addr @published
    %t6 = call i32 @scan(%t5, 1)
    %t7 = cmp ne i32 %t6, 10
    branch %t7, ^if_then_3, ^if_else_4

  block ^if_then_3:
    return i32 2

  block ^if_else_4:
    %t8 = call i32 @scan(%t5, 2)
    %t9 = cmp ne i32 %t8, 10
    %t10 = select i32 %t9, 3, 0
    return i32 %t10
}
