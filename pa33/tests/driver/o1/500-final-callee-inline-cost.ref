    %t28 = binary ushr i64 %t27, 11
    %t29 = binary xor i64 %t27, %t28
    %t30 = binary add i64 %t29, 601
    return i64 %t30
}
function @run(%x : i64, %count : u32) -> i64 [binding=strong, object=_Z3runmj, no_inline=yes] {
  block ^entry:
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = phi u32 [^entry: 0, ^for_body_2: %t18]
    %t2 = phi i64 [^entry: %x, ^for_body_2: %t17]
    %t3 = cmp ne u32 %count, %t1
    branch %t3, ^for_body_2, ^for_end_3

  block ^for_body_2:
    %t4 = call i64 @expanded(%t2)
    %t5 = convert zext i64 u32 %t1
    %t6 = binary add i64 %t4, %t5
    %t7 = convert zext i64 u32 %count
    %t8 = binary xor i64 %t6, %t7
    %t9 = call i64 @expanded(%t8)
    %t10 = binary shl i64 %t9, 11
    %t11 = binary xor i64 %t9, %t10
    %t12 = binary add i64 %t7, %t11
    %t13 = binary ushr i64 %t12, 17
    %t14 = binary xor i64 %t12, %t13
    %t15 = binary mul i64 %t14, 37
    %t16 = binary ushr i64 %t15, 19
    %t17 = binary xor i64 %t15, %t16
    %t18 = binary add u32 %t1, 1
    jump ^for_cond_1

  block ^for_end_3:
    return i64 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = load volatile i64 @initial
    %t2 = load volatile u32 @iterations
    %t3 = call i64 @run(%t1, %t2)
    %t4 = cmp ne i64 %t3, 7210775075916949423
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
