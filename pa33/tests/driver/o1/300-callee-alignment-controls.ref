global @ticks : i64 [binding=strong] = 0

function @align_value(%selector : u32) -> u32 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = load volatile i64 @ticks
    %t2 = binary add i64 %t1, 1
    store volatile i64 %t2, @ticks
    %t3 = binary umod u32 %selector, 7
    switch %t3, ^switch_default_7, 0:^switch_case_1, 1:^switch_case_2, 2:^switch_case_3, 3:^switch_case_4, 4:^switch_case_5, 5:^switch_case_6

  block ^switch_case_1:
    return u32 1

  block ^switch_case_2:
    return u32 2

  block ^switch_case_3:
    return u32 4

  block ^switch_case_4:
    return u32 8

  block ^switch_case_5:
    %t4 = binary and u32 %selector, 32
    %t5 = select i32 %t4, 16, 32
    %t6 = copy u32 %t5
    return u32 %t6

  block ^switch_case_6:
    return u32 64

  block ^switch_default_7:
    return u32 128
}
function @sometimes_nonpower(%selector : u32) -> u32 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = cmp eq u32 %selector, 2
    %t2 = select i32 %t1, 3, 4
    %t3 = copy u32 %t2
    return u32 %t3
}
function @sometimes_zero(%selector : u32) -> u32 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = cmp eq u32 %selector, 7
    %t2 = select i32 %t1, 0, 4
    %t3 = copy u32 %t2
    return u32 %t3
}
function @weak_alignment(%selector : u32) -> u32 [linkage=c, binding=weak, replaceable=yes, no_inline=yes] {
  block ^entry:
    return u32 4
}
function @signed_alignment(%selector : u32) -> i8 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = binary and u32 %selector, 1
    %t2 = select i32 %t1, -128, 2
    %t3 = convert trunc i8 i32 %t2
    return i8 %t3
}
function @round_up(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @align_value(%selector)
    %t2 = convert zext i64 u32 %t1
    branch %x, ^cond_then_1, ^cond_end_2

  block ^cond_then_1:
    %t3 = binary sub i64 %x, 1
    %t4 = unary ctz i64 %t2
    %t5 = binary ushr i64 %t3, %t4
    %t6 = binary add i64 %t5, 1
    %t7 = binary mul i64 %t2, %t6
    jump ^cond_end_2

  block ^cond_end_2:
    %t8 = phi i64 [^cond_then_1: %t7, ^entry: 0]
    return i64 %t8
}
function @divide_value(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @align_value(%selector)
    %t2 = convert zext i64 u32 %t1
    %t3 = unary ctz i64 %t2
    %t4 = binary ushr i64 %x, %t3
    return i64 %t4
}
function @modulo_value(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @align_value(%selector)
    %t2 = convert zext i64 u32 %t1
    %t3 = binary sub i64 %t2, 1
    %t4 = binary and i64 %x, %t3
    return i64 %t4
}
function @divide_nonpower(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @sometimes_nonpower(%selector)
    %t2 = convert zext i64 u32 %t1
    %t3 = binary udiv i64 %x, %t2
    return i64 %t3
}
function @divide_maybe_zero(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @sometimes_zero(%selector)
    %t2 = convert zext i64 u32 %t1
    %t3 = binary udiv i64 %x, %t2
    return i64 %t3
}
function @divide_weak(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call u32 @weak_alignment(%selector)
    %t2 = convert zext i64 u32 %t1
    %t3 = binary udiv i64 %x, %t2
    return i64 %t3
}
function @divide_signed_byte(%x : i64, %selector : u32) -> i64 [linkage=c, binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = call i8 @signed_alignment(%selector)
    %t2 = convert sext i64 i8 %t1
    %t3 = binary udiv i64 %x, %t2
    return i64 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = phi u32 [^entry: 0, ^cond_end_6: %t38]
    %t2 = phi i64 [^entry: 1, ^cond_end_6: %t6]
    %t3 = phi i64 [^entry: 0, ^cond_end_6: %t37]
    %t4 = cmp ult u32 %t1, 65536
    branch %t4, ^for_body_2, ^for_end_7

  block ^for_body_2:
    %t5 = binary mul i64 %t2, 6364136223846793005
    %t6 = binary add i64 %t5, 1
    %t7 = cmp ult u32 %t1, 4
    branch %t7, ^cond_then_3, ^cond_end_6

  block ^cond_then_3:
    %t8 = cmp eq u32 %t1, 0
    branch %t8, ^cond_end_5, ^cond_else_4

  block ^cond_else_4:
    %t9 = cmp eq u32 %t1, 1
    %t10 = cmp eq u32 %t1, 2
    %t11 = select i64 %t10, -1, -9223372036854775808
    %t12 = select i64 %t9, 1, %t11
    jump ^cond_end_5

  block ^cond_end_5:
    %t13 = phi i64 [^cond_else_4: %t12, ^cond_then_3: 0]
    jump ^cond_end_6

  block ^cond_end_6:
    %t14 = phi i64 [^cond_end_5: %t13, ^for_body_2: %t6]
    %t15 = binary mul i64 %t3, 31
    %t16 = call i64 @round_up(%t14, %t1)
    %t17 = binary add i64 %t15, %t16
    %t18 = binary mul i64 %t17, 31
    %t19 = call i64 @divide_value(%t14, %t1)
    %t20 = binary add i64 %t18, %t19
    %t21 = binary mul i64 %t20, 31
    %t22 = call i64 @modulo_value(%t14, %t1)
    %t23 = binary add i64 %t21, %t22
    %t24 = binary mul i64 %t23, 31
    %t25 = binary umod u32 %t1, 6
    %t26 = call i64 @divide_nonpower(%t14, %t25)
    %t27 = binary add i64 %t24, %t26
    %t28 = binary mul i64 %t27, 31
    %t29 = binary umod u32 %t1, 7
    %t30 = call i64 @divide_maybe_zero(%t14, %t29)
    %t31 = binary add i64 %t28, %t30
    %t32 = binary mul i64 %t31, 31
    %t33 = call i64 @divide_weak(%t14, %t1)
    %t34 = binary add i64 %t32, %t33
    %t35 = binary mul i64 %t34, 31
    %t36 = call i64 @divide_signed_byte(%t14, %t1)
    %t37 = binary add i64 %t35, %t36
    %t38 = binary add u32 %t1, 1
    jump ^for_cond_1

  block ^for_end_7:
    %t39 = cmp ne i64 %t3, 6345242704293526140
    branch %t39, ^lor_end_9, ^lor_rhs_8

  block ^lor_rhs_8:
    %t40 = load volatile i64 @ticks
    %t41 = cmp ne i64 %t40, 196608
    jump ^lor_end_9

  block ^lor_end_9:
    %t42 = phi i64 [^lor_rhs_8: %t41, ^for_end_7: 1]
    %t43 = convert trunc i32 i64 %t42
    return i32 %t43
}
