function @scan(%selector : i32) -> i32 [binding=strong, object=_Z4scani, no_inline=yes] {
  block ^entry:
    %t1 = cmp ult i32 %selector, 2
    branch %t1, ^switch_case_1, ^switch_default_2

  block ^switch_case_1:
    return i32 0

  block ^switch_default_2:
    %t2 = binary add nowrap i32 %selector, 1
    %t3 = cmp ult i32 %t2, 2
    branch %t3, ^switch_case_3, ^switch_default_4

  block ^switch_case_3:
    return i32 1

  block ^switch_default_4:
    %t4 = binary add nowrap i32 %selector, 2
    %t5 = cmp ult i32 %t4, 2
    branch %t5, ^switch_case_5, ^switch_default_6

  block ^switch_case_5:
    return i32 2

  block ^switch_default_6:
    %t6 = binary add nowrap i32 %selector, 3
    %t7 = cmp ult i32 %t6, 2
    branch %t7, ^switch_case_7, ^switch_default_8

  block ^switch_case_7:
    return i32 3

  block ^switch_default_8:
    return i32 4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @scan(-1)
    %t2 = cmp eq i32 %t1, 1
    branch %t2, ^land_rhs_1, ^cond_else_4

  block ^land_rhs_1:
    %t3 = call i32 @scan(0)
    %t4 = cmp eq i32 %t3, 0
    branch %t4, ^land_rhs_2, ^cond_else_4

  block ^land_rhs_2:
    %t5 = call i32 @scan(1)
    %t6 = cmp eq i32 %t5, 0
    branch %t6, ^land_rhs_3, ^cond_else_4

  block ^land_rhs_3:
    %t7 = call i32 @scan(2)
    %t8 = cmp eq i32 %t7, 4
    branch %t8, ^cond_end_5, ^cond_else_4

  block ^cond_else_4:
    jump ^cond_end_5

  block ^cond_end_5:
    %t9 = phi i32 [^cond_else_4: 1, ^land_rhs_3: 0]
    return i32 %t9
}
