function @main(%outer : i64, %inner : i64) -> i64 [role=entry] {
  block ^entry:
    %is_zero_1 = cmp eq i64 %outer, 0
    %is_zero_2 = cmp eq i64 %inner, 0
    %t3 = select i64 %is_zero_2, 10, 20
    %t4 = select i64 %is_zero_1, %t3, %outer
    %adjusted = binary add i64 %t4, 1
    return i64 %adjusted
}
function @wrapper(%outer : i64, %inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %outer, 0
    %is_zero_2 = cmp eq i64 %inner, 0
    %t3 = select i64 %is_zero_2, 10, 20
    %t4 = select i64 %is_zero, %t3, %outer
    return i64 %t4
}
function @leaf(%inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %inner, 0
    %t2 = select i64 %is_zero, 10, 20
    return i64 %t2
}
