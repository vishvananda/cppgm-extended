function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 7
    call @rotate [args=(rdi)]
    cmp.i32 rax, 1960
    je ^pass

  block ^fail
    mov rax, 1
    ret rax

  block ^pass
    mov rax, 0
    ret rax
