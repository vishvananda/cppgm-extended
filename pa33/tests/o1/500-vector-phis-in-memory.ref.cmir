    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-<off27>]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub rsi, rdi
    sext.i32 rsi
    imul r9, 16
    sext.i32 r9
    add r8, r9
    sext.i32 r8
    add r8, rsi
    sext.i32 r8
    fmov.v128 xmm15, [rbp-<off28>]
