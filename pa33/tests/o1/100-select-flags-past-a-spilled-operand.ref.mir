    temp %c10 -> [rbp-16] : i32
    temp %d11 -> [rbp-248] : i32
    temp %l11 -> [rbp-256] : i32
    temp %c11 -> [rbp-24] : i32
    temp %d12 -> [rbp-264] : i32
    temp %l12 -> [rbp-272] : i32
    temp %c12 -> [rbp-32] : i32
    temp %d13 -> [rbp-280] : i32
    temp %l13 -> [rbp-288] : i32
    temp %c13 -> [rbp-40] : i32
    temp %d14 -> [rbp-296] : i32
    temp %l14 -> [rbp-304] : i32
    temp %c14 -> [rbp-312] : i32

  block ^entry
    load.i32 r8, [rdi]
    load.i32 r9, [rsi]
