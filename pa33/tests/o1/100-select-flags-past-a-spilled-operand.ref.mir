    movzx r15, r15
    add r8, r15
    cmp.i32 r9, 0
    setne r9
    movzx r9, r9
    add r8, r9
    cmp.i32 rax, 0
    setne rax
    movzx rax, rax
    add r8, rax
    cmp.i32 r12, 0
    setne r12
    movzx r12, r12
    add r8, r12
    cmp.i32 r14, 0
    setne r14
    movzx r14, r14
    add r8, r14
    cmp.i32 [rbp-8], 0
    setne r9
    movzx r9, r9
    add r8, r9
    cmp.i32 [rbp-16], 0
    setne r9
