    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    store.i32 [rbp-8], r10
    load.i32 r10, [rbp-136]
    sub.i32 r10, [rbp-144]
    sext.i32 r10
    cmp.i32 r10, 0
    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    store.i32 [rbp-16], r10
    load.i32 r10, [rbp-152]
    sub.i32 r10, [rbp-160]
    sext.i32 r10
    cmp.i32 r10, 0
    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    store.i32 [rbp-24], r10
    load.i32 r10, [rbp-168]
    sub.i32 r10, [rbp-176]
    sext.i32 r10
    cmp.i32 r10, 0
    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    store.i32 [rbp-32], r10
    load.i32 r10, [rbp-184]
    sub.i32 r10, [rbp-192]
    sext.i32 r10
    cmp.i32 r10, 0
    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    store.i32 [rbp-40], r10
    load.i32 r10, [rbp-200]
    sub.i32 r10, [rbp-208]
    sext.i32 r10
    cmp.i32 r10, 0
    mov r11, 0
    sext.i32 r10, r10
    cmovl r10, r11
    cmp.i32 r10, 255
    mov r11, 255
    sext.i32 r10, r10
    cmovg r10, r11
    sub rdi, rsi
    sext.i32 rdi
    cmp.i32 rdi, 0
    mov r11, 0
    cmovl rdi, r11
    cmp.i32 rdi, 255
    mov r11, 255
    cmovg rdi, r11
    store.i32 [rdx], r8
    store.i32 [rdx+4], rcx
    store.i32 [rdx+8], rbx
    store.i32 [rdx+12], r13
    store.i32 [rdx+16], r15
    store.i32 [rdx+20], r9
    store.i32 [rdx+24], rax
    store.i32 [rdx+28], r12
    store.i32 [rdx+32], r14
    load.i32 r11, [rbp-8]
    store.i32 [rdx+36], r11
    load.i32 r11, [rbp-16]
    store.i32 [rdx+40], r11
    load.i32 r11, [rbp-24]
    store.i32 [rdx+44], r11
    load.i32 r11, [rbp-32]
    store.i32 [rdx+48], r11
    load.i32 r11, [rbp-40]
    store.i32 [rdx+52], r11
    sext.i32 r11, r10
    store.i32 [rdx+56], r11
    store.i32 [rdx+60], rdi
    cmp.i32 r8, 0
    setne r8
    movzx r8, r8
    add r8, 0
    cmp.i32 rcx, 0
    setne rcx
    movzx rcx, rcx
    add r8, rcx
    cmp.i32 rbx, 0
    setne rbx
    movzx rbx, rbx
    add r8, rbx
    cmp.i32 r13, 0
    setne r13
    movzx r13, r13
