    sub rcx, rax
    sext.i32 rcx
    cmp.i32 rcx, 0
    mov r11, 0
    cmovl rcx, r11
    cmp.i32 rcx, 255
    mov r11, 255
    cmovg rcx, r11
    sub rbx, r12
    sext.i32 rbx
    cmp.i32 rbx, 0
    mov r11, 0
    cmovl rbx, r11
    cmp.i32 rbx, 255
    mov r11, 255
    cmovg rbx, r11
    sub r13, r14
    sext.i32 r13
    cmp.i32 r13, 0
    mov r11, 0
    cmovl r13, r11
    cmp.i32 r13, 255
    mov r11, 255
    cmovg r13, r11
    sub.i32 r15, [rbp-48]
    sext.i32 r15
    cmp.i32 r15, 0
    mov r11, 0
    cmovl r15, r11
    cmp.i32 r15, 255
    mov r11, 255
    cmovg r15, r11
    load.i32 r9, [rbp-56]
    sub.i32 r9, [rbp-64]
    sext.i32 r9
    cmp.i32 r9, 0
    mov r11, 0
    cmovl r9, r11
    cmp.i32 r9, 255
    mov r11, 255
    cmovg r9, r11
    load.i32 rax, [rbp-72]
    sub.i32 rax, [rbp-80]
    sext.i32 rax
    cmp.i32 rax, 0
    mov r11, 0
    cmovl rax, r11
    cmp.i32 rax, 255
    mov r11, 255
    cmovg rax, r11
    load.i32 r12, [rbp-88]
    sub.i32 r12, [rbp-96]
    sext.i32 r12
    cmp.i32 r12, 0
    mov r11, 0
    cmovl r12, r11
    cmp.i32 r12, 255
    mov r11, 255
    cmovg r12, r11
    load.i32 r14, [rbp-104]
    sub.i32 r14, [rbp-112]
    sext.i32 r14
