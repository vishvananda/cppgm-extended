    add r8, r9
    cmp.i32 [rbp-40], 0
    setne r9
    movzx r9, r9
    add r8, r9
    cmp.i32 r10, 0
    setne r9
    movzx r9, r9
    add r8, r9
    cmp.i32 rdi, 0
    setne rdi
    movzx rdi, rdi
    add r8, rdi
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 192
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $a -> [rbp-64] : obj<64x4>
    slot $b -> [rbp-128] : obj<64x4>
    slot $out -> [rbp-192] : obj<64x4>

  block ^entry
    store.i32 [rbp-64], 1
    store.i32 [rbp-128], 100
    store.i32 [rbp-60], 2
    store.i32 [rbp-124], 103
    store.i32 [rbp-56], 3
    store.i32 [rbp-120], 106
    store.i32 [rbp-52], 4
    store.i32 [rbp-116], 109
    store.i32 [rbp-48], 5
    store.i32 [rbp-112], 112
    store.i32 [rbp-44], 6
    store.i32 [rbp-108], 115
    store.i32 [rbp-40], 7
    store.i32 [rbp-104], 118
    store.i32 [rbp-36], 8
    store.i32 [rbp-100], 121
    store.i32 [rbp-32], 9
    store.i32 [rbp-96], 124
    store.i32 [rbp-28], 10
    store.i32 [rbp-92], 127
    store.i32 [rbp-24], 11
    store.i32 [rbp-88], 130
    store.i32 [rbp-20], 12
    store.i32 [rbp-84], 133
    store.i32 [rbp-16], 13
    store.i32 [rbp-80], 136
    store.i32 [rbp-12], 14
    store.i32 [rbp-76], 139
    store.i32 [rbp-8], 15
    store.i32 [rbp-72], 142
    store.i32 [rbp-4], 16
    store.i32 [rbp-68], 145
    lea rdi, [rbp-64]
    lea rsi, [rbp-128]
    lea rdx, [rbp-192]
    call @clamp [args=(rdx,rsi,rdi)]
    ret rax
