    store.i32 [rbp-144], r10
    load.i32 r10, [rdi+44]
    store.i32 [rbp-152], r10
    load.i32 r10, [rsi+44]
    store.i32 [rbp-160], r10
    load.i32 r10, [rdi+48]
    store.i32 [rbp-168], r10
    load.i32 r10, [rsi+48]
    store.i32 [rbp-176], r10
    load.i32 r10, [rdi+52]
    store.i32 [rbp-184], r10
    load.i32 r10, [rsi+52]
    store.i32 [rbp-192], r10
    load.i32 r10, [rdi+56]
    store.i32 [rbp-200], r10
    load.i32 r10, [rsi+56]
    store.i32 [rbp-208], r10
    load.i32 rdi, [rdi+60]
    load.i32 rsi, [rsi+60]
