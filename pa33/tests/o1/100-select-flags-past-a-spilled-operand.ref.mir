machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @clamp
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %out -> rdx : ptr
    return i32 -> rax
  frame
    stack_size 352
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    temp %y4 -> [rbp-48] : i32
    temp %x5 -> [rbp-56] : i32
    temp %y5 -> [rbp-64] : i32
    temp %x6 -> [rbp-72] : i32
    temp %y6 -> [rbp-80] : i32
