function @identity(%value : i64) -> i64 [unwind=no, no_inline=yes] {
  block ^entry:
    return i64 %value
}
function @mutate(%address : ptr [pass=by_address]) -> void [unwind=no, no_inline=yes] {
  block ^entry:
    store i64 29, %address
    return void
}
function @main() -> i64 [role=entry] {
  slot $source : i64

  block ^entry:
    store i64 23, $source
    %called = call i64 @identity(23)
    call void @mutate($source)
    %t2 = load i64 $source
    %changed = call i64 @identity(%t2)
    %bad_call = cmp ne i64 %called, 23
    %bad_change = cmp ne i64 %changed, 29
    %bad_select = cmp ne i64 %t2, 29
    %bad3 = binary or i64 %bad_call, %bad_change
    %bad9 = binary or i64 %bad_select, %bad3
    switch %t2, ^wrong, 29:^done

  block ^done:
    return i64 %bad9

  block ^wrong:
    return i64 1
}
