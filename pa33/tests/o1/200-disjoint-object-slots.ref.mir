machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @observe
  abi
    param %object -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    load.i32 rax, [rdi]
    ret rax

function @probe
  abi
    param %choice -> rdi : i32
    return i32 -> rax
  frame
    stack_size 1600
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $left -> [rbp-1600] : obj<1600x4>
    slot $right -> [rbp-1600] : obj<1600x4>

  block ^entry
    test.i64 rdi, rdi
    je ^right

  block ^left
    store.i32 [rbp-1600], 7
    lea rdi, [rbp-1600]
    call @observe [args=(rdi)]
    ret rax

  block ^right
    store.i32 [rbp-1600], 9
    lea rdi, [rbp-1600]
    call @observe [args=(rdi)]
    ret rax

function @loop_overlap
  abi
    return i32 -> rax
  frame
    stack_size 3216
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $first -> [rbp-1600] : obj<1600x4>
    slot $second -> [rbp-3200] : obj<1600x4>
    slot $saved -> [rbp-3208] : ptr
    slot $iteration -> [rbp-3212] : i32

  block ^entry
    store.i32 [rbp-3212], 0

  block ^dispatch
    load.i32 r9, [rbp-3212]
    test.i64 r9, r9
    jne ^second

  block ^first
    store.i32 [rbp-1600], 7
    lea rax, [rbp-1600]
    store.ptr [rbp-3208], rax
    store.i32 [rbp-3212], 1
    jmp ^dispatch

  block ^second
    store.i32 [rbp-3200], 9
    load.ptr r8, [rbp-3208]
    load.i32 r9, [r8]
    cmp.i32 r9, 7
    setne rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve rbx

  block ^entry
    mov rdi, 1
    call @probe [args=(rdi)]
    mov rbx, rax
    sext.i32 rbx
    mov rdi, 0
    call @probe [args=(rdi)]
    mov r8, rax
    sext.i32 r8
    mov rdx, 7
    cmp.i32 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 9
    cmp.i32 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, r8
    sext.i32 rbx
    call @loop_overlap [args=()]
    sext.i32 rax
    or rbx, rax
    sext.i32 rbx
    ret rbx
