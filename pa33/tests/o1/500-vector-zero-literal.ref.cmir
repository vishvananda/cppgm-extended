machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @memory
  storage data
  item i64 -1
  item i64 -1

function @chosen
  abi
    param %flag -> rdi : i32
    return v128 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 0
    je ^entry~join

  block ^five
    mov <gpr0>, 5
    vector.fromi32 xmm0, <gpr0>
    ret xmm0

  block ^join
    ret xmm0

  block ^entry~join
    vector.pzero xmm0
    ret xmm0

function @nothing
  abi
    return v128 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    vector.pzero xmm0
    ret xmm0

function @sum
  abi
    param %a -> xmm0 : v128
    param %b -> xmm1 : v128
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    vector.paddd xmm0, xmm0, xmm1
    vector.toi32 rax, xmm0
    sext.i32 rax
    ret rax

function @ninth
  abi
    param %a -> xmm0 : v128
    param %b -> xmm1 : v128
    param %c -> <xmm0> : v128
    param %d -> <xmm1> : v128
    param %e -> <xmm2> : v128
    param %f -> <xmm3> : v128
    param %g -> <xmm4> : v128
    param %h -> <xmm5> : v128
    param %i -> [rbp+<off0>] : v128
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.v128 xmm15, [rbp+<off0>]
    vector.toi32 rax, xmm15
    sext.i32 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1>
    temp %seven -> [rbp-<off0>] : v128
    temp %off -> [rbp-<off1>] : v128

  block ^entry
    vector.pzero xmm15
    fmov.v128 @memory, xmm15
    load.i64 r8, @memory
    or r8, @memory+8
    je ^returned

  block ^bad_store
    mov rax, 1
    ret rax

  block ^returned
    call @nothing [args=()]
    vector.toi64 r8, xmm0
    cmp.i64 r8, 0
    je ^passed

  block ^bad_return
    mov rax, 2
    ret rax

  block ^passed
    mov <gpr0>, 7
    vector.fromi32 xmm14, <gpr0>
    fmov.v128 [rbp-<off0>], xmm14
    vector.pzero xmm0
    fmov.v128 xmm1, [rbp-<off0>]
    call @sum [args=(xmm0,xmm1)]
    mov <gpr1>, rax
    fmov.v128 xmm0, [rbp-<off0>]
    vector.pzero xmm1
    call @sum [args=(xmm0,xmm1)]
    add <gpr1>, rax
    sext.i32 <gpr1>
    cmp.i32 <gpr1>, 14
    je ^joined

  block ^bad_argument
    mov rax, 3
    ret rax

  block ^joined
    mov rdi, 0
    call @chosen [args=(rdi)]
    fmov.v128 xmm14, xmm0
    fmov.v128 [rbp-<off1>], xmm14
    mov rdi, 1
    call @chosen [args=(rdi)]
    fmov.v128 xmm15, [rbp-<off1>]
    vector.toi32 r8, xmm15
    sext.i32 r8
    vector.toi32 r9, xmm0
    sext.i32 r9
    add r8, r9
    sext.i32 r8
    cmp.i32 r8, 5
    jne ^bad_join

  block ^operand
    vector.pzero xmm15
    vector.paddd xmm0, [rbp-<off0>], xmm15
    vector.toi32 r8, xmm0
    sext.i32 r8
    cmp.i32 r8, 7
    je ^stacked

  block ^bad_operand
    mov rax, 5
    ret rax

  block ^bad_join
    mov rax, 4
    ret rax

  block ^stacked
    sub rsp, 16
    fmov.v128 xmm0, [rbp-<off0>]
    fmov.v128 xmm1, [rbp-<off0>]
    fmov.v128 <xmm0>, [rbp-<off0>]
    fmov.v128 <xmm1>, [rbp-<off0>]
    fmov.v128 <xmm2>, [rbp-<off0>]
    fmov.v128 <xmm3>, [rbp-<off0>]
    fmov.v128 <xmm4>, [rbp-<off0>]
    fmov.v128 <xmm5>, [rbp-<off0>]
    mov <gpr2>, 0
    store.v128 [rsp], <gpr2>
    call @ninth [args=(xmm0,xmm1,<xmm0>,<xmm1>,<xmm2>,<xmm3>,<xmm4>,<xmm5>), stack=16]
    add rsp, 16
    mov <gpr1>, rax
    sub rsp, 16
    fmov.v128 xmm15, [rbp-<off0>]
    fmov.v128 [rsp], xmm15
    vector.pzero xmm0
    vector.pzero xmm1
    vector.pzero <xmm0>
    vector.pzero <xmm1>
    vector.pzero <xmm2>
    vector.pzero <xmm3>
    vector.pzero <xmm4>
    vector.pzero <xmm5>
    call @ninth [args=(xmm0,xmm1,<xmm0>,<xmm1>,<xmm2>,<xmm3>,<xmm4>,<xmm5>), stack=16]
    add rsp, 16
    sub rax, 7
    sext.i32 rax
    or <gpr1>, rax
    cmp.i32 <gpr1>, 0
    je ^done

  block ^bad_stack
    mov rax, 6
    ret rax

  block ^done
    mov rax, 0
    ret rax
