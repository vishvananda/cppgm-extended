function @leaf(%cond : i1, %p : ptr) -> i64 {
  block ^entry:
    branch %cond, ^then, ^else

  block ^then:
    %t1 = copy i64 %p
    return i64 %t1

  block ^else:
    return i64 0
}
function @caller(%cond : i1, %p : ptr, %out : ptr) -> void {
  block ^entry:
    %t1 = copy i64 %p
    %t2 = select i64 %cond, %t1, 0
    store i64 %t2, %out
    return void
}
