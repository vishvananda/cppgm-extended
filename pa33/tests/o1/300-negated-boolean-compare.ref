function @negated_trunc(%left : i64, %right : i64) -> i64 {
  block ^entry:
    %test = cmp uge i64 %left, %right
    %t2 = select i64 %test, 1, 2
    return i64 %t2
}
function @negated_direct(%left : i64, %right : i64) -> i64 {
  block ^entry:
    %test = cmp ne i64 %left, %right
    %t2 = select i64 %test, 3, 4
    return i64 %t2
}
function @negated_float(%left : f64, %right : f64) -> i64 {
  block ^entry:
    %test = cmp uge f64 %left, %right
    %t2 = select i64 %test, 5, 6
    return i64 %t2
}
