machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @add
  abi
    param %wide -> rdi : i64
    param %other -> rsi : i32
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sext.i32 rdi
    add rdi, rsi
    ret rdi

function @sub
  abi
    param %wide -> rdi : i64
    param %other -> rsi : i32
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sext.i32 rdi
    sub rdi, rsi
    ret rdi

function @mul
  abi
    param %wide -> rdi : i64
    param %other -> rsi : i32
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sext.i32 rdi
    imul rdi, rsi
    ret rdi

function @element
  abi
    param %base -> rdi : ptr
    param %wide -> rsi : i64
    param %other -> rdx : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sext.i32 rsi
    add rsi, rdx
    load.i32 rax, [rdi+rsi*4]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2>
    slot $values -> [rbp-<off0>] : obj<12x4>

  block ^entry
    store.i32 [rbp-<off0>], 10
    store.i32 [rbp-<off1>], 20
    store.i32 [rbp-<off2>], 30
    mov rdi, 4294967297
    mov rsi, 2
    call @add [args=(rsi,rdi)]
    mov <gpr0>, rax
    mov rdi, 8589934597
    mov rsi, 7
    call @sub [args=(rsi,rdi)]
    mov <gpr1>, rax
    mov rdi, -4294967293
    mov rsi, -5
    call @mul [args=(rsi,rdi)]
    mov <gpr2>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 4294967297
    mov rdx, 1
    call @element [args=(rdx,rsi,rdi)]
    cmp.i64 <gpr0>, 3
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, -2
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 <gpr2>, -15
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.i32 rax, 30
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr2>, rax
    or <gpr0>, <gpr2>
    ret <gpr0>
