function @accessor(%p : ptr) -> i64 [prefer_local=yes] {
  block ^entry:
    %t5 = load i8 %p
    %t6 = binary and i8 %t5, 1
    branch %t6, ^long, ^short

  block ^long:
    %t10 = index i8 [projection=field] %p, 8
    %t11 = load i64 %t10
    jump ^end

  block ^short:
    %t18 = binary ushr i8 %t5, 1
    %t8 = convert sext i64 i8 %t18
    jump ^end

  block ^end:
    %t9 = phi i64 [^long: %t11, ^short: %t8]
    return i64 %t9
}
function @caller(%p : ptr) -> i64 {
  block ^entry:
    %t5_1 = load i8 %p
    %t6_3 = binary and i8 %t5_1, 1
    branch %t6_3, ^long_1, ^short_2

  block ^long_1:
    %t10_4 = index i8 [projection=field] %p, 8
    %t11_5 = load i64 %t10_4
    jump ^end_3

  block ^short_2:
    %t18_6 = binary ushr i8 %t5_1, 1
    %t7 = convert sext i64 i8 %t18_6
    jump ^end_3

  block ^end_3:
    %t8 = phi i64 [^long_1: %t11_5, ^short_2: %t7]
    %t2 = binary add i64 %t8, 1
    return i64 %t2
}
