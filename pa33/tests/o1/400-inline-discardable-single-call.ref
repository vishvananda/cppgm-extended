global @sink : i64 = 0

function @addressed(%value : i64) -> i64 [unwind=no, binding=weak] {
  block ^entry:
    store i64 %value, @sink
    return i64 %value
}
function @main(%value : i64) -> i64 [role=entry] {
  block ^entry:
    store i64 %value, @sink
    %address = addr @addressed
    %indirect_result = call i64 %address(%value) as (%arg0 : i64) -> i64 [unwind=no]
    return i64 %indirect_result
}
