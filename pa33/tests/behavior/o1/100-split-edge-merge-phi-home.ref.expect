# budget generated by scripts/make_ir_expect.pl from fx.mir at 10% tolerance
instructions <= 114
blocks <= 15
count(call) <= 5
mem <= 52
count(push) <= 1
instructions <= 8 in @need_rehash
stack_size <= 64 in @need_rehash
instructions <= 4 in @rehash
stack_size <= 48 in @rehash
instructions <= 89 in @insert
stack_size <= 96 in @insert
instructions <= 17 in @main
stack_size <= 32 in @main
