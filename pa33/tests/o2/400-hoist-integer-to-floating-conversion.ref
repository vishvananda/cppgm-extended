function @signed_scale(%p : ptr, %n : i64, %k : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %scale = convert sitofp f64 i64 %k
    %t2 = binary and i64 %n, -4
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t4 = phi f64 [^unrolled_1: %t20, ^entry: 0]
    %t5 = index f64 %p, %t3
    %t6 = load f64 %t5
    %t7 = binary mul f64 %scale, %t6
    %t8 = binary add f64 %t4, %t7
    %t9 = index f64 %t5, 1
    %t10 = load f64 %t9
    %t11 = binary mul f64 %scale, %t10
    %t12 = binary add f64 %t8, %t11
    %t13 = index f64 %t5, 2
    %t14 = load f64 %t13
    %t15 = binary mul f64 %scale, %t14
    %t16 = binary add f64 %t12, %t15
    %t17 = index f64 %t5, 3
    %t18 = load f64 %t17
    %t19 = binary mul f64 %scale, %t18
    %t20 = binary add f64 %t16, %t19
    %t21 = binary add i64 %t3, 4
    %t22 = cmp ne i64 %t2, %t21
    branch %t22, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t23 = phi i64 [^entry: 0, ^unrolled_1: %t21]
    %t24 = phi f64 [^entry: 0, ^unrolled_1: %t20]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t23, ^body: %next]
    %sum = phi f64 [^wide_tail_2: %t24, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %at = index f64 %p, %i
    %x = load f64 %at
    %scaled = binary mul f64 %scale, %x
    %total = binary add f64 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f64 %sum
}
function @unsigned_scale(%p : ptr, %n : i64, %k : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %scale = convert uitofp f64 i64 %k
    %t2 = binary and i64 %n, -4
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t4 = phi f64 [^unrolled_1: %t20, ^entry: 0]
    %t5 = index f64 %p, %t3
    %t6 = load f64 %t5
    %t7 = binary mul f64 %scale, %t6
    %t8 = binary add f64 %t4, %t7
    %t9 = index f64 %t5, 1
    %t10 = load f64 %t9
    %t11 = binary mul f64 %scale, %t10
    %t12 = binary add f64 %t8, %t11
    %t13 = index f64 %t5, 2
    %t14 = load f64 %t13
    %t15 = binary mul f64 %scale, %t14
    %t16 = binary add f64 %t12, %t15
    %t17 = index f64 %t5, 3
    %t18 = load f64 %t17
    %t19 = binary mul f64 %scale, %t18
    %t20 = binary add f64 %t16, %t19
    %t21 = binary add i64 %t3, 4
    %t22 = cmp ne i64 %t2, %t21
    branch %t22, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t23 = phi i64 [^entry: 0, ^unrolled_1: %t21]
    %t24 = phi f64 [^entry: 0, ^unrolled_1: %t20]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t23, ^body: %next]
    %sum = phi f64 [^wide_tail_2: %t24, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %at = index f64 %p, %i
    %x = load f64 %at
    %scaled = binary mul f64 %scale, %x
    %total = binary add f64 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f64 %sum
}
function @narrow_scale(%p : ptr, %n : i64, %k : i32) -> f32 [no_inline=yes] {
  block ^entry:
    %scale = convert sitofp f32 i32 %k
    %t2 = binary and i64 %n, -4
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t4 = phi f32 [^unrolled_1: %t20, ^entry: 0f]
    %t5 = index f32 %p, %t3
    %t6 = load f32 %t5
    %t7 = binary mul f32 %scale, %t6
    %t8 = binary add f32 %t4, %t7
    %t9 = index f32 %t5, 1
    %t10 = load f32 %t9
    %t11 = binary mul f32 %scale, %t10
    %t12 = binary add f32 %t8, %t11
    %t13 = index f32 %t5, 2
    %t14 = load f32 %t13
    %t15 = binary mul f32 %scale, %t14
    %t16 = binary add f32 %t12, %t15
    %t17 = index f32 %t5, 3
    %t18 = load f32 %t17
    %t19 = binary mul f32 %scale, %t18
    %t20 = binary add f32 %t16, %t19
    %t21 = binary add i64 %t3, 4
    %t22 = cmp ne i64 %t2, %t21
    branch %t22, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t23 = phi i64 [^entry: 0, ^unrolled_1: %t21]
    %t24 = phi f32 [^entry: 0f, ^unrolled_1: %t20]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t23, ^body: %next]
    %sum = phi f32 [^wide_tail_2: %t24, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %at = index f32 %p, %i
    %x = load f32 %at
    %scaled = binary mul f32 %scale, %x
    %total = binary add f32 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f32 %sum
}
function @wide_source(%p : ptr, %n : i64, %k : i128) -> f64 [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -4
    branch %t1, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t2 = phi i64 [^unrolled_1: %t21, ^entry: 0]
    %t3 = phi f64 [^unrolled_1: %t20, ^entry: 0]
    %t4 = convert sitofp f64 i128 %k
    %t5 = index f64 %p, %t2
    %t6 = load f64 %t5
    %t7 = binary mul f64 %t4, %t6
    %t8 = binary add f64 %t3, %t7
    %t9 = index f64 %t5, 1
    %t10 = load f64 %t9
    %t11 = binary mul f64 %t4, %t10
    %t12 = binary add f64 %t8, %t11
    %t13 = index f64 %t5, 2
    %t14 = load f64 %t13
    %t15 = binary mul f64 %t4, %t14
    %t16 = binary add f64 %t12, %t15
    %t17 = index f64 %t5, 3
    %t18 = load f64 %t17
    %t19 = binary mul f64 %t4, %t18
    %t20 = binary add f64 %t16, %t19
    %t21 = binary add i64 %t2, 4
    %t22 = cmp ne i64 %t1, %t21
    branch %t22, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t23 = phi i64 [^entry: 0, ^unrolled_1: %t21]
    %t24 = phi f64 [^entry: 0, ^unrolled_1: %t20]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t23, ^body: %next]
    %sum = phi f64 [^wide_tail_2: %t24, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %scale = convert sitofp f64 i128 %k
    %at = index f64 %p, %i
    %x = load f64 %at
    %scaled = binary mul f64 %scale, %x
    %total = binary add f64 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f64 %sum
}
function @operand_read_again(%p : ptr, %n : i64, %k : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %scale = convert sitofp f64 i64 %k
    %t2 = binary and i64 %n, -4
    branch %t2, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t3 = phi i64 [^unrolled_1: %t28, ^entry: 0]
    %t4 = phi f64 [^unrolled_1: %t27, ^entry: 0]
    %t5 = binary add i64 %k, %t3
    %t6 = index f64 %p, %t5
    %t7 = load f64 %t6
    %t8 = binary mul f64 %scale, %t7
    %t9 = binary add f64 %t4, %t8
    %t10 = binary add i64 %t3, 1
    %t11 = binary add i64 %k, %t10
    %t12 = index f64 %p, %t11
    %t13 = load f64 %t12
    %t14 = binary mul f64 %scale, %t13
    %t15 = binary add f64 %t9, %t14
    %t16 = binary add i64 %t3, 2
    %t17 = binary add i64 %k, %t16
    %t18 = index f64 %p, %t17
    %t19 = load f64 %t18
    %t20 = binary mul f64 %scale, %t19
    %t21 = binary add f64 %t15, %t20
    %t22 = binary add i64 %t3, 3
    %t23 = binary add i64 %k, %t22
    %t24 = index f64 %p, %t23
    %t25 = load f64 %t24
    %t26 = binary mul f64 %scale, %t25
    %t27 = binary add f64 %t21, %t26
    %t28 = binary add i64 %t3, 4
    %t29 = cmp ne i64 %t2, %t28
    branch %t29, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t30 = phi i64 [^entry: 0, ^unrolled_1: %t28]
    %t31 = phi f64 [^entry: 0, ^unrolled_1: %t27]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t30, ^body: %next]
    %sum = phi f64 [^wide_tail_2: %t31, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %offset = binary add i64 %k, %i
    %at = index f64 %p, %offset
    %x = load f64 %at
    %scaled = binary mul f64 %scale, %x
    %total = binary add f64 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f64 %sum
}
function @varying_source(%p : ptr, %n : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %n, -4
    branch %t1, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t2 = phi i64 [^unrolled_1: %t27, ^entry: 0]
    %t3 = phi f64 [^unrolled_1: %t26, ^entry: 0]
    %t4 = convert uitofp f64 i64 %t2
    %t5 = index f64 %p, %t2
    %t6 = load f64 %t5
    %t7 = binary mul f64 %t4, %t6
    %t8 = binary add f64 %t3, %t7
    %t9 = binary add i64 %t2, 1
    %t10 = convert uitofp f64 i64 %t9
    %t11 = index f64 %t5, 1
    %t12 = load f64 %t11
    %t13 = binary mul f64 %t10, %t12
    %t14 = binary add f64 %t8, %t13
    %t15 = binary add i64 %t2, 2
    %t16 = convert uitofp f64 i64 %t15
    %t17 = index f64 %t5, 2
    %t18 = load f64 %t17
    %t19 = binary mul f64 %t16, %t18
    %t20 = binary add f64 %t14, %t19
    %t21 = binary add i64 %t2, 3
    %t22 = convert uitofp f64 i64 %t21
    %t23 = index f64 %t5, 3
    %t24 = load f64 %t23
    %t25 = binary mul f64 %t22, %t24
    %t26 = binary add f64 %t20, %t25
    %t27 = binary add i64 %t2, 4
    %t28 = cmp ne i64 %t1, %t27
    branch %t28, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t29 = phi i64 [^entry: 0, ^unrolled_1: %t27]
    %t30 = phi f64 [^entry: 0, ^unrolled_1: %t26]
    jump ^cond

  block ^cond:
    %i = phi i64 [^wide_tail_2: %t29, ^body: %next]
    %sum = phi f64 [^wide_tail_2: %t30, ^body: %total]
    %more = cmp ult i64 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %scale = convert uitofp f64 i64 %i
    %at = index f64 %p, %i
    %x = load f64 %at
    %scaled = binary mul f64 %scale, %x
    %total = binary add f64 %sum, %scaled
    %next = binary add i64 %i, 1
    jump ^cond

  block ^done:
    return f64 %sum
}
function @main() -> i64 [role=entry] {
  slot $doubles : obj<16x8>
  slot $floats : obj<8x4>

  block ^entry:
    %doubles = addr $doubles
    %second = index f64 %doubles, 1
    store f64 1.5, %doubles
    store f64 2.5, %second
    %floats = addr $floats
    %next_float = index f32 %floats, 1
    store f32 1.5f, %floats
    store f32 2.5f, %next_float
    %a = call f64 @signed_scale(%doubles, 2, -3)
    %bad_a = cmp ne f64 %a, -12
    %b = call f64 @signed_scale(%doubles, 0, -3)
    %bad_b = cmp ne f64 %b, 0
    %c = call f64 @unsigned_scale(%doubles, 2, 3)
    %bad_c = cmp ne f64 %c, 12
    %d = call f64 @unsigned_scale(%doubles, 2, -1)
    %bad_d = cmp ne f64 %d, 73786976294838206464
    %e = call f64 @unsigned_scale(%doubles, 2, -9223372036854775807)
    %bad_e = cmp ne f64 %e, 36893488147419103232
    %f = call f32 @narrow_scale(%floats, 2, -2)
    %bad_f = cmp ne f32 %f, -8f
    %g = call f64 @wide_source(%doubles, 2, -5)
    %bad_g = cmp ne f64 %g, -20
    %h = call f64 @operand_read_again(%doubles, 1, 1)
    %bad_h = cmp ne f64 %h, 2.5
    %i = call f64 @varying_source(%doubles, 2)
    %bad_i = cmp ne f64 %i, 2.5
    %ab = binary or i64 %bad_a, %bad_b
    %cd = binary or i64 %bad_c, %bad_d
    %ef = binary or i64 %bad_e, %bad_f
    %gh = binary or i64 %bad_g, %bad_h
    %first = binary or i64 %ab, %cd
    %second_half = binary or i64 %ef, %gh
    %all = binary or i64 %first, %second_half
    %failed = binary or i64 %bad_i, %all
    %status = convert trunc i32 i64 %failed
    return i64 %status
}
