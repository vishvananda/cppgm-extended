function @late_value(%p : ptr) -> i64 {
  block ^entry:
    branch %p, ^present, ^missing

  block ^present:
    %v = load i64 %p
    return i64 %v

  block ^missing:
    return i64 -99
}
function @readable_wrapper(%p : ptr [object_bytes=8]) -> i64 [force_inline=yes] {
  block ^entry:
    %v_1 = load i64 %p
    return i64 %v_1
}
function @path(%p : ptr, %active : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %active, ^yes, ^no

  block ^yes:
    %t1 = copy nonnull ptr %p
    %v_2 = load i64 %t1
    return i64 %v_2

  block ^no:
    %missing = cmp eq ptr %p, 0
    return i64 %missing
}
function @zero_trip(%p : ptr, %count : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = binary and i64 %count, -8
    branch %t1, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t2 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t20]
    %t3 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t19]
    %t4 = load i64 %p
    %t5 = binary add i64 %t3, %t4
    %t6 = load i64 %p
    %t7 = binary add i64 %t5, %t6
    %t8 = load i64 %p
    %t9 = binary add i64 %t7, %t8
    %t10 = load i64 %p
    %t11 = binary add i64 %t9, %t10
    %t12 = load i64 %p
    %t13 = binary add i64 %t11, %t12
    %t14 = load i64 %p
    %t15 = binary add i64 %t13, %t14
    %t16 = load i64 %p
    %t17 = binary add i64 %t15, %t16
    %t18 = load i64 %p
    %t19 = binary add i64 %t17, %t18
    %t20 = binary add i64 %t2, 8
    %t21 = cmp ne i64 %t1, %t20
    branch %t21, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t22 = phi i64 [^entry: 0, ^unrolled_2: %t20]
    %t23 = phi i64 [^entry: 0, ^unrolled_2: %t19]
    jump ^header

  block ^header:
    %i = phi i64 [^wide_tail_3: %t22, ^body: %inext]
    %sum = phi i64 [^wide_tail_3: %t23, ^body: %sum_next]
    %more = cmp ult i64 %i, %count
    branch %more, ^body, ^done

  block ^body:
    %v = load i64 %p
    %sum_next = binary add i64 %sum, %v
    %inext = binary add i64 %i, 1
    jump ^header

  block ^done:
    %missing = cmp eq ptr %p, 0
    %result = binary add i64 %sum, %missing
    return i64 %result
}
function @choice(%p : ptr, %take : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %q = copy ptr %p
    %t2 = select ptr %take, %q, 0
    %missing_input = cmp eq ptr %p, 0
    %missing_result = cmp eq ptr %t2, 0
    %r = binary add i64 %missing_input, %missing_result
    return i64 %r
}
function @main() -> i64 [role=entry] {
  slot $value : i64

  block ^entry:
    %p = addr $value
    store i64 7, $value
    %a = call i64 @path(%p, 1)
    %b = call i64 @path(%p, 0)
    %c = call i64 @path(0, 0)
    %z0 = call i64 @zero_trip(0, 0)
    %z3 = call i64 @zero_trip(%p, 3)
    %c0 = call i64 @choice(0, 0)
    %c1 = call i64 @choice(%p, 1)
    %bad_z0 = cmp ne i64 %z0, 1
    %bad_z3 = cmp ne i64 %z3, 21
    %bad_c0 = cmp ne i64 %c0, 2
    %zs = binary or i64 %bad_z0, %bad_z3
    %cs = binary or i64 %c1, %bad_c0
    %guards = binary or i64 %zs, %cs
    %bad_a = cmp ne i64 %a, 7
    %bad_c = cmp ne i64 %c, 1
    %ab = binary or i64 %b, %bad_a
    %abc = binary or i64 %bad_c, %ab
    %bad = binary or i64 %guards, %abc
    return i64 %bad
}
