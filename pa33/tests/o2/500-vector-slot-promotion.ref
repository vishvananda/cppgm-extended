function @pick(%a : v128, %b : v128, %which : i32) -> v128 {
  block ^entry:
    branch %which, ^done, ^right

  block ^right:
    jump ^done

  block ^done:
    %t1 = phi v128 [^right: %b, ^entry: %a]
    return v128 %t1
}
function @sum_of_lanes(%count : i32) -> f64 {
  block ^entry:
    %start = vector pzero
    %one = vector fromf64 1.5
    %step = vector unpcklpd %one, %one
    %t4 = binary and i32 %count, -8
    %t5 = cmp gt i32 %t4, 0
    branch %t5, ^unrolled_1, ^wide_tail_2

  block ^unrolled_1:
    %t6 = phi v128 [^unrolled_1: %t15, ^entry: %start]
    %t7 = phi i32 [^unrolled_1: %t16, ^entry: 0]
    %t8 = vector addpd %t6, %step
    %t9 = vector addpd %t8, %step
    %t10 = vector addpd %t9, %step
    %t11 = vector addpd %t10, %step
    %t12 = vector addpd %t11, %step
    %t13 = vector addpd %t12, %step
    %t14 = vector addpd %t13, %step
    %t15 = vector addpd %t14, %step
    %t16 = binary add nowrap i32 %t7, 8
    %t17 = cmp ne i32 %t4, %t16
    branch %t17, ^unrolled_1, ^wide_tail_2

  block ^wide_tail_2:
    %t18 = phi v128 [^entry: %start, ^unrolled_1: %t15]
    %t19 = phi i32 [^entry: 0, ^unrolled_1: %t16]
    jump ^loop

  block ^loop:
    %t20 = phi v128 [^wide_tail_2: %t18, ^body: %new]
    %i = phi i32 [^wide_tail_2: %t19, ^body: %next]
    %more = cmp lt i32 %i, %count
    branch %more, ^body, ^done

  block ^body:
    %new = vector addpd %t20, %step
    %next = binary add nowrap i32 %i, 1
    jump ^loop

  block ^done:
    %high = vector unpckhpd %t20, %t20
    %low = vector addsd %t20, %high
    %result = vector tof64 %low
    return f64 %result
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %start_1 = vector pzero
    %one_2 = vector fromf64 1.5
    %step_3 = vector unpcklpd %one_2, %one_2
    %t4 = vector addpd %start_1, %step_3
    %t5 = vector addpd %t4, %step_3
    %t6 = vector addpd %t5, %step_3
    %t7 = vector addpd %t6, %step_3
    %high_8 = vector unpckhpd %t7, %t7
    %low_9 = vector addsd %t7, %high_8
    %result_10 = vector tof64 %low_9
    %whole = convert fptosi i32 f64 %result_10
    %total = binary add i32 %whole, 18
    return i32 %total
}
