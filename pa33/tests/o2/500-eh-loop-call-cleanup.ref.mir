machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @eh_loop
  abi
    param %n -> rdi : i64
    param %cleanups -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve r12 r15 r14 rbx

  block ^entry
    mov r12, rdi
    mov rbx, rsi
    mov r15, 0
    mov r14, 0

  block ^for_cond_1
    cmp.i64 r14, r12
    jge ^for_end_4

  block ^for_body_2
    mov rdi, r14
    call @work [args=(rdi)]
    mov r8, rax
    shl r8, 1
    add r8, r14
    lea r9, [r15+r8]
    load.i64 r8, [rbx]
    add r8, 1
    store.i64 [rbx], r8
    add r14, 1
    mov r15, r9
    jmp ^for_cond_1

  block ^for_end_4
    ret r15

function @work
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    add rdi, 3
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues direct
    slot $cleanups -> [rbp-8] : i64
    temp %t9 -> [rbp-16] : i64
    temp %t0 -> [rbp-20] : i32

  block ^entry
    store.i64 [rbp-8], 0
    mov rdi, 4
    lea rsi, [rbp-8]
    call @eh_loop [args=(rsi,rdi)]
    cmp.i64 rax, 42
    jne ^land_short_5

  block ^land_rhs_4
    load.i64 r9, [rbp-8]
    mov rdx, 4
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    store.i64 [rbp-16], r9
    jmp ^land_end_6

  block ^land_short_5
    mov r11, 0
    store.i64 [rbp-16], r11

  block ^land_end_6
    load.i64 rax, [rbp-16]
    test.i64 rax, rax
    je ^cond_else_2

  block ^cond_then_1
    mov r11, 0
    store.i32 [rbp-20], r11
    jmp ^cond_end_3

  block ^cond_else_2
    mov r11, 1
    store.i32 [rbp-20], r11

  block ^cond_end_3
    load.i32 rax, [rbp-20]
    ret rax
