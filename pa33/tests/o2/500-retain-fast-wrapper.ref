function @shared_work(%x : i64) -> i64 [unwind=no, binding=strong, inline_hint=yes] {
  block ^entry:
    %w0 = binary mul i64 %x, 3
    %w1 = binary xor i64 %w0, 5
    %w2 = binary mul i64 %w1, 7
    %w3 = binary xor i64 %w2, 9
    %w4 = binary mul i64 %w3, 11
    %w5 = binary xor i64 %w4, 13
    %w6 = binary mul i64 %w5, 15
    %w7 = binary xor i64 %w6, 17
    %w8 = binary mul i64 %w7, 19
    %w9 = binary xor i64 %w8, 21
    %w10 = binary mul i64 %w9, 23
    %w11 = binary xor i64 %w10, 25
    %w12 = binary mul i64 %w11, 27
    %w13 = binary xor i64 %w12, 29
    %w14 = binary mul i64 %w13, 31
    %w15 = binary xor i64 %w14, 33
    %w16 = binary mul i64 %w15, 35
    %w17 = binary xor i64 %w16, 37
    %w18 = binary mul i64 %w17, 39
    %w19 = binary xor i64 %w18, 41
    %w20 = binary mul i64 %w19, 43
    %w21 = binary xor i64 %w20, 45
    %w22 = binary mul i64 %w21, 47
    %w23 = binary xor i64 %w22, 49
    %w24 = binary mul i64 %w23, 51
    %w25 = binary xor i64 %w24, 53
    %w26 = binary mul i64 %w25, 55
    %w27 = binary xor i64 %w26, 57
    %w28 = binary mul i64 %w27, 59
    %w29 = binary xor i64 %w28, 61
    %w30 = binary mul i64 %w29, 63
    %w31 = binary xor i64 %w30, 65
    %w32 = binary mul i64 %w31, 67
    %w33 = binary xor i64 %w32, 69
    %w34 = binary mul i64 %w33, 71
    %w35 = binary xor i64 %w34, 73
    %w36 = binary mul i64 %w35, 75
    %w37 = binary xor i64 %w36, 77
    %w38 = binary mul i64 %w37, 79
    %w39 = binary xor i64 %w38, 81
    %w40 = binary mul i64 %w39, 83
    %w41 = binary xor i64 %w40, 85
    %w42 = binary mul i64 %w41, 87
    %w43 = binary xor i64 %w42, 89
    %w44 = binary mul i64 %w43, 91
    %w45 = binary xor i64 %w44, 93
    %w46 = binary mul i64 %w45, 95
    %w47 = binary xor i64 %w46, 97
    return i64 %w47
}
function @wrapper(%fast : i32, %x : i64) -> i64 [unwind=no, binding=strong, no_inline=yes] {
  block ^entry:
    branch %fast, ^quick, ^slow

  block ^quick:
    return i64 %x

  block ^slow:
    %s0 = binary mul i64 %x, 5
    %s1 = binary xor i64 %s0, 7
    %s2 = binary mul i64 %s1, 9
    %s3 = binary xor i64 %s2, 11
    %s4 = binary mul i64 %s3, 13
    %s5 = binary xor i64 %s4, 15
    %s6 = binary mul i64 %s5, 17
    %s7 = binary xor i64 %s6, 19
    %s8 = binary mul i64 %s7, 21
    %s9 = binary xor i64 %s8, 23
    %s10 = binary mul i64 %s9, 25
    %s11 = binary xor i64 %s10, 27
    %s12 = binary mul i64 %s11, 29
    %s13 = binary xor i64 %s12, 31
    %s14 = binary mul i64 %s13, 33
    %s15 = binary xor i64 %s14, 35
    %s16 = binary mul i64 %s15, 37
    %s17 = binary xor i64 %s16, 39
    %s18 = binary mul i64 %s17, 41
    %s19 = binary xor i64 %s18, 43
    %s20 = binary mul i64 %s19, 45
    %s21 = binary xor i64 %s20, 47
    %s22 = binary mul i64 %s21, 49
    %s23 = binary xor i64 %s22, 51
    %s24 = binary mul i64 %s23, 53
    %s25 = binary xor i64 %s24, 55
    %s26 = binary mul i64 %s25, 57
    %s27 = binary xor i64 %s26, 59
    %s28 = binary mul i64 %s27, 61
    %s29 = binary xor i64 %s28, 63
    %s30 = binary mul i64 %s29, 65
    %s31 = binary xor i64 %s30, 67
    %s32 = binary mul i64 %s31, 69
    %s33 = binary xor i64 %s32, 71
    %s34 = binary mul i64 %s33, 73
    %s35 = binary xor i64 %s34, 75
    %w0_37 = binary mul i64 %s35, 3
    %w1_38 = binary xor i64 %w0_37, 5
    %w2_39 = binary mul i64 %w1_38, 7
    %w3_40 = binary xor i64 %w2_39, 9
    %w4_41 = binary mul i64 %w3_40, 11
    %w5_42 = binary xor i64 %w4_41, 13
    %w6_43 = binary mul i64 %w5_42, 15
    %w7_44 = binary xor i64 %w6_43, 17
    %w8_45 = binary mul i64 %w7_44, 19
    %w9_46 = binary xor i64 %w8_45, 21
    %w10_47 = binary mul i64 %w9_46, 23
    %w11_48 = binary xor i64 %w10_47, 25
    %w12_49 = binary mul i64 %w11_48, 27
    %w13_50 = binary xor i64 %w12_49, 29
    %w14_51 = binary mul i64 %w13_50, 31
    %w15_52 = binary xor i64 %w14_51, 33
    %w16_53 = binary mul i64 %w15_52, 35
    %w17_54 = binary xor i64 %w16_53, 37
    %w18_55 = binary mul i64 %w17_54, 39
    %w19_56 = binary xor i64 %w18_55, 41
    %w20_57 = binary mul i64 %w19_56, 43
    %w21_58 = binary xor i64 %w20_57, 45
    %w22_59 = binary mul i64 %w21_58, 47
    %w23_60 = binary xor i64 %w22_59, 49
    %w24_61 = binary mul i64 %w23_60, 51
    %w25_62 = binary xor i64 %w24_61, 53
    %w26_63 = binary mul i64 %w25_62, 55
    %w27_64 = binary xor i64 %w26_63, 57
    %w28_65 = binary mul i64 %w27_64, 59
    %w29_66 = binary xor i64 %w28_65, 61
    %w30_67 = binary mul i64 %w29_66, 63
    %w31_68 = binary xor i64 %w30_67, 65
    %w32_69 = binary mul i64 %w31_68, 67
    %w33_70 = binary xor i64 %w32_69, 69
    %w34_71 = binary mul i64 %w33_70, 71
    %w35_72 = binary xor i64 %w34_71, 73
    %w36_73 = binary mul i64 %w35_72, 75
    %w37_74 = binary xor i64 %w36_73, 77
    %w38_75 = binary mul i64 %w37_74, 79
    %w39_76 = binary xor i64 %w38_75, 81
    %w40_77 = binary mul i64 %w39_76, 83
    %w41_78 = binary xor i64 %w40_77, 85
    %w42_79 = binary mul i64 %w41_78, 87
    %w43_80 = binary xor i64 %w42_79, 89
    %w44_81 = binary mul i64 %w43_80, 91
    %w45_82 = binary xor i64 %w44_81, 93
    %w46_83 = binary mul i64 %w45_82, 95
    %w47_84 = binary xor i64 %w46_83, 97
    return i64 %w47_84
}
function @hot_loop(%n : i64, %x : i64) -> i64 [unwind=no, binding=strong, no_inline=yes] {
  block ^entry:
    %empty = cmp eq i64 %n, 0
    branch %empty, ^done, ^loop_preheader_1

  block ^loop_preheader_1:
    %w0_2 = binary mul i64 %x, 3
    %w1_3 = binary xor i64 %w0_2, 5
    %w2_4 = binary mul i64 %w1_3, 7
    %w3_5 = binary xor i64 %w2_4, 9
    %w4_6 = binary mul i64 %w3_5, 11
    %w5_7 = binary xor i64 %w4_6, 13
    %w6_8 = binary mul i64 %w5_7, 15
    %w7_9 = binary xor i64 %w6_8, 17
    %w8_10 = binary mul i64 %w7_9, 19
    %w9_11 = binary xor i64 %w8_10, 21
    %w10_12 = binary mul i64 %w9_11, 23
    %w11_13 = binary xor i64 %w10_12, 25
    %w12_14 = binary mul i64 %w11_13, 27
    %w13_15 = binary xor i64 %w12_14, 29
    %w14_16 = binary mul i64 %w13_15, 31
    %w15_17 = binary xor i64 %w14_16, 33
    %w16_18 = binary mul i64 %w15_17, 35
    %w17_19 = binary xor i64 %w16_18, 37
    %w18_20 = binary mul i64 %w17_19, 39
    %w19_21 = binary xor i64 %w18_20, 41
    %w20_22 = binary mul i64 %w19_21, 43
    %w21_23 = binary xor i64 %w20_22, 45
    %w22_24 = binary mul i64 %w21_23, 47
    %w23_25 = binary xor i64 %w22_24, 49
    %w24_26 = binary mul i64 %w23_25, 51
    %w25_27 = binary xor i64 %w24_26, 53
    %w26_28 = binary mul i64 %w25_27, 55
    %w27_29 = binary xor i64 %w26_28, 57
    %w28_30 = binary mul i64 %w27_29, 59
    %w29_31 = binary xor i64 %w28_30, 61
    %w30_32 = binary mul i64 %w29_31, 63
    %w31_33 = binary xor i64 %w30_32, 65
    %w32_34 = binary mul i64 %w31_33, 67
    %w33_35 = binary xor i64 %w32_34, 69
    %w34_36 = binary mul i64 %w33_35, 71
    %w35_37 = binary xor i64 %w34_36, 73
    %w36_38 = binary mul i64 %w35_37, 75
    %w37_39 = binary xor i64 %w36_38, 77
    %w38_40 = binary mul i64 %w37_39, 79
    %w39_41 = binary xor i64 %w38_40, 81
    %w40_42 = binary mul i64 %w39_41, 83
    %w41_43 = binary xor i64 %w40_42, 85
    %w42_44 = binary mul i64 %w41_43, 87
    %w43_45 = binary xor i64 %w42_44, 89
    %w44_46 = binary mul i64 %w43_45, 91
    %w45_47 = binary xor i64 %w44_46, 93
    %w46_48 = binary mul i64 %w45_47, 95
    %w47_49 = binary xor i64 %w46_48, 97
    %t50 = binary and i64 %n, -8
    branch %t50, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
    jump ^unrolled_3

  block ^unrolled_3:
    %t51 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t61]
    %t52 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t60]
    %t53 = binary add i64 %w47_49, %t52
    %t54 = binary add i64 %w47_49, %t53
    %t55 = binary add i64 %w47_49, %t54
    %t56 = binary add i64 %w47_49, %t55
    %t57 = binary add i64 %w47_49, %t56
    %t58 = binary add i64 %w47_49, %t57
    %t59 = binary add i64 %w47_49, %t58
    %t60 = binary add i64 %w47_49, %t59
    %t61 = binary add i64 %t51, 8
    %t62 = cmp ne i64 %t50, %t61
    branch %t62, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t63 = cmp ne i64 %n, %t61
    branch %t63, ^wide_tail_5, ^done

  block ^wide_tail_5:
    %t64 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t61]
    %t65 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t60]
    jump ^loop

  block ^loop:
    %i = phi i64 [^wide_tail_5: %t64, ^loop: %next]
    %sum = phi i64 [^wide_tail_5: %t65, ^loop: %added]
    %added = binary add i64 %sum, %w47_49
    %next = binary add i64 %i, 1
    %more = cmp ne i64 %n, %next
    branch %more, ^loop, ^done

  block ^done:
    %result = phi i64 [^entry: 0, ^loop: %added, ^loop_exit_4: %t60]
    return i64 %result
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %fast = call i64 @wrapper(1, 7)
    %slow = call i64 @wrapper(0, 7)
    %bad_fast = cmp ne i64 %fast, 7
    %bad_slow = cmp ne i64 %slow, 3880516842696001031
    %zero = call i64 @hot_loop(0, 7)
    %five = call i64 @hot_loop(5, 7)
    %bad_zero = cmp ne i64 %zero, 0
    %bad_five = cmp ne i64 %five, 4822489477394739995
    %bad_wrapper = binary or i32 %bad_fast, %bad_slow
    %bad_loop = binary or i32 %bad_zero, %bad_five
    %bad = binary or i32 %bad_wrapper, %bad_loop
    return i32 %bad
}
