function @scan(%n : i32, %bias : i32) -> i32 [no_inline=yes] {
  slot $current : obj<520x8>
  slot $snapshot : obj<520x8>

  block ^entry:
    %p = addr $current
    %payload = index i8 %p, 8
    %t3 = index i8 [projection=field] %p, 4
    zeroinit 516x1 %t3
    store i32 23, %payload
    %t4 = binary and i32 %n, -4
    %t5 = cmp gt i32 %t4, 0
    branch %t5, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t6 = phi i32 [^loop_preheader_1: 0, ^unrolled_2: %t20]
    %t7 = phi i32 [^loop_preheader_1: 0, ^unrolled_2: %t23]
    %t8 = binary add i32 %bias, %t6
    %t9 = binary and i32 %t7, 127
    %t10 = index i32 %payload, %t9
    store i32 %t7, %t10
    %t11 = binary add nowrap i32 %t7, 1
    %t12 = binary add i32 %bias, %t8
    %t13 = binary and i32 %t11, 127
    %t14 = index i32 %payload, %t13
    store i32 %t11, %t14
    %t15 = binary add nowrap i32 %t7, 2
    %t16 = binary add i32 %bias, %t12
    %t17 = binary and i32 %t15, 127
    %t18 = index i32 %payload, %t17
    store i32 %t15, %t18
    %t19 = binary add nowrap i32 %t7, 3
    %t20 = binary add i32 %bias, %t16
    %t21 = binary and i32 %t19, 127
    %t22 = index i32 %payload, %t21
    store i32 %t19, %t22
    %t23 = binary add nowrap i32 %t7, 4
    %t24 = cmp ne i32 %t4, %t23
    branch %t24, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t25 = phi i32 [^entry: 0, ^unrolled_2: %t20]
    %t26 = phi i32 [^entry: 0, ^unrolled_2: %t23]
    jump ^test

  block ^test:
    %t27 = phi i32 [^wide_tail_3: %t25, ^body: %sum]
    %i = phi i32 [^wide_tail_3: %t26, ^body: %next]
    %more = cmp lt i32 %i, %n
    branch %more, ^body, ^done

  block ^body:
    %sum = binary add i32 %bias, %t27
    %index = binary and i32 %i, 127
    %item = index i32 %payload, %index
    store i32 %i, %item
    %next = binary add nowrap i32 %i, 1
    jump ^test

  block ^done:
    %q = addr $snapshot
    store i32 %t27, %q
    %t35 = index i8 [projection=field] %q, 4
    copyobj 516x1 %t3, %t35
    store i32 -9, %payload
    %saved_data = index i8 %q, 8
    %head = load i32 %saved_data
    %subtotal = binary add i32 %t27, %head
    %last = binary sub i32 %n, 1
    %last_index = binary and i32 %last, 127
    %last_item = index i32 %saved_data, %last_index
    %tail = load i32 %last_item
    %result = binary add i32 %tail, %subtotal
    return i32 %result
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call i32 @scan(4, 3)
    %b = call i32 @scan(0, 5)
    %c = call i32 @scan(130, 3)
    %bad_a = cmp ne i32 %a, 15
    %bad_b = cmp ne i32 %b, 23
    %bad_c = cmp ne i32 %c, 647
    %ab = binary or i1 %bad_a, %bad_b
    %bad = binary or i1 %bad_c, %ab
    %out = convert zext i32 i1 %bad
    return i32 %out
}
