machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_prefix
  abi
    param %value -> rdi : i32
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u32 rdi, 3
    jbe ^case_0
    cmp.u32 rdi, 7
    jbe ^case_1
    cmp.u32 rdi, 15
    jbe ^case_2
    jmp ^default

  block ^case_0
    mov rax, 11
    ret rax

  block ^case_1
    mov rax, 22
    ret rax

  block ^case_2
    mov rax, 33
    ret rax

  block ^default
    mov rax, 99
    ret rax

function @gapped
  abi
    param %value -> rdi : i32
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rdi, 3
    jbe ^case_0
    lea r10, [rdi-8]
    cmp.i64 r10, 3
    jbe ^case_1
    jmp ^default

  block ^case_0
    mov rax, 11
    ret rax

  block ^case_1
    mov rax, 22
    ret rax

  block ^default
    mov rax, 99
    ret rax

function @signed_cases
  abi
    param %value -> rdi : i32
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea r10, [rdi+4]
    cmp.i64 r10, 3
    jbe ^case_0
    cmp.i64 rdi, 3
    jbe ^case_1
    jmp ^default

  block ^case_0
    mov rax, 11
    ret rax

  block ^case_1
    mov rax, 22
    ret rax

  block ^default
    mov rax, 99
    ret rax

