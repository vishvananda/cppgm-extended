declare function @malloc(%bytes : i64) -> ptr [unwind=no, linkage=c]
declare function @free(%p : ptr) -> void [unwind=no, linkage=c]
declare function @capture(%p : ptr) -> void [linkage=c]

global @published : ptr = 0

function @private_scan(%holder : ptr) -> i32 [no_inline=yes] {
  block ^entry:
    %buffer = call ptr @malloc(16)
    %t2 = load ptr %holder
    %t3 = load i32 %t2
    store i32 0, %buffer
    %t4 = index i32 %buffer, 1
    store i32 1, %t4
    %t5 = binary add i32 %t3, %t3
    %t6 = index i32 %buffer, 2
    store i32 2, %t6
    %t7 = binary add i32 %t3, %t5
    %t8 = index i32 %buffer, 3
    store i32 3, %t8
    %t9 = binary add i32 %t3, %t7
    %observed = load volatile i32 %t8
    call void @free(%buffer)
    %out = binary add i32 %observed, %t9
    return i32 %out
}
function @published_scan(%holder : ptr, %n : i32) -> i32 [no_inline=yes] {
  block ^entry:
    %buffer = call ptr @malloc(16)
    store ptr %buffer, @published
    store i32 7, %buffer
    %t2 = load ptr %holder
    %t3 = binary and i32 %n, -4
    %t4 = cmp gt i32 %t3, 0
    branch %t4, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t5 = phi i32 [^unrolled_1: %t18, ^entry: 0]
    %t6 = phi i32 [^unrolled_1: %t17, ^entry: 0]
    %t7 = load i32 %t2
    store i32 %t5, %buffer
    %t8 = binary add i32 %t6, %t7
    %t9 = binary add nowrap i32 %t5, 1
    %t10 = load i32 %t2
    store i32 %t9, %buffer
    %t11 = binary add i32 %t8, %t10
    %t12 = binary add nowrap i32 %t5, 2
    %t13 = load i32 %t2
    store i32 %t12, %buffer
    %t14 = binary add i32 %t11, %t13
    %t15 = binary add nowrap i32 %t5, 3
    %t16 = load i32 %t2
    store i32 %t15, %buffer
    %t17 = binary add i32 %t14, %t16
    %t18 = binary add nowrap i32 %t5, 4
    %t19 = cmp ne i32 %t3, %t18
    branch %t19, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t20 = cmp lt i32 %t18, %n
    branch %t20, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t21 = phi i32 [^entry: 0, ^loop_exit_2: %t18]
    %t22 = phi i32 [^entry: 0, ^loop_exit_2: %t17]
    jump ^loop

  block ^loop:
    %i = phi i32 [^wide_tail_3: %t21, ^loop: %next]
    %sum = phi i32 [^wide_tail_3: %t22, ^loop: %total]
    %value = load i32 %t2
    store i32 %i, %buffer
    %total = binary add i32 %sum, %value
    %next = binary add nowrap i32 %i, 1
    %more = cmp lt i32 %next, %n
    branch %more, ^loop, ^done

  block ^done:
    %t29 = phi i32 [^loop: %total, ^loop_exit_2: %t17]
    call void @free(%buffer)
    return i32 %t29
}
function @captured_scan(%holder : ptr, %n : i32) -> i32 [no_inline=yes] {
  block ^entry:
    %buffer = call ptr @malloc(16)
    call void @capture(%buffer)
    store i32 7, %buffer
    %t2 = load ptr %holder
    %t3 = binary and i32 %n, -4
    %t4 = cmp gt i32 %t3, 0
    branch %t4, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t5 = phi i32 [^unrolled_1: %t18, ^entry: 0]
    %t6 = phi i32 [^unrolled_1: %t17, ^entry: 0]
    %t7 = load i32 %t2
    store i32 %t5, %buffer
    %t8 = binary add i32 %t6, %t7
    %t9 = binary add nowrap i32 %t5, 1
    %t10 = load i32 %t2
    store i32 %t9, %buffer
    %t11 = binary add i32 %t8, %t10
    %t12 = binary add nowrap i32 %t5, 2
    %t13 = load i32 %t2
    store i32 %t12, %buffer
    %t14 = binary add i32 %t11, %t13
    %t15 = binary add nowrap i32 %t5, 3
    %t16 = load i32 %t2
    store i32 %t15, %buffer
    %t17 = binary add i32 %t14, %t16
    %t18 = binary add nowrap i32 %t5, 4
    %t19 = cmp ne i32 %t3, %t18
    branch %t19, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t20 = cmp lt i32 %t18, %n
    branch %t20, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t21 = phi i32 [^entry: 0, ^loop_exit_2: %t18]
    %t22 = phi i32 [^entry: 0, ^loop_exit_2: %t17]
    jump ^loop

  block ^loop:
    %i = phi i32 [^wide_tail_3: %t21, ^loop: %next]
    %sum = phi i32 [^wide_tail_3: %t22, ^loop: %total]
    %value = load i32 %t2
    store i32 %i, %buffer
    %total = binary add i32 %sum, %value
    %next = binary add nowrap i32 %i, 1
    %more = cmp lt i32 %next, %n
    branch %more, ^loop, ^done

  block ^done:
    %t29 = phi i32 [^loop: %total, ^loop_exit_2: %t17]
    call void @free(%buffer)
    return i32 %t29
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
