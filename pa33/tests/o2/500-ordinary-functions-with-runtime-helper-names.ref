global @calls : i64 = 0
global @copy_target = {
  i8 0
  i8 0
  i8 0
}
global @source [storage=readonly] = {
  i8 97
  i8 98
  i8 0
}
global @destination = {
  i8 9
  i8 0
  i8 0
}

function @cppgm_builtin_strlen(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %counter = addr @calls
    %old = load i64 %counter
    %next = binary add i64 %old, 1
    store i64 %next, %counter
    return i64 117
}
function @cppgm_builtin_memset(%p : ptr, %v : i32, %n : i64) -> ptr [no_inline=yes] {
  block ^entry:
    %counter = addr @calls
    %old = load i64 %counter
    %next = binary add i64 %old, 1
    store i64 %next, %counter
    return ptr %p
}
function @cppgm_builtin_memcpy(%p : ptr, %s : ptr, %n : i64) -> ptr [no_inline=yes] {
  block ^entry:
    %counter = addr @calls
    %old = load i64 %counter
    %next = binary add i64 %old, 1
    store i64 %next, %counter
    return ptr %p
}
function @cppgm_builtin_memcmp(%p : ptr, %s : ptr, %n : i64) -> i32 [no_inline=yes] {
  block ^entry:
    %counter = addr @calls
    %old = load i64 %counter
    %next = binary add i64 %old, 1
    store i64 %next, %counter
    return i32 9
}
function @__cppgm_builtin_memset(%p : ptr, %v : i32, %n : i64) -> ptr [no_inline=yes] {
  block ^entry:
    return ptr %p
}
function @fill_loop(%p : ptr, %end : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = copy i64 %p
    %t2 = copy i64 %end
    %t3 = binary sub i64 %t2, %t1
    %t4 = binary and i64 %t3, -8
    branch %t4, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t5 = binary add i64 %t1, %t4
    jump ^unrolled_2

  block ^unrolled_2:
    %t6 = phi ptr [^loop_preheader_1: %p, ^unrolled_2: %t14]
    store i8 7, %t6
    %t7 = index i8 %t6, 1
    store i8 7, %t7
    %t8 = index i8 %t6, 2
    store i8 7, %t8
    %t9 = index i8 %t6, 3
    store i8 7, %t9
    %t10 = index i8 %t6, 4
    store i8 7, %t10
    %t11 = index i8 %t6, 5
    store i8 7, %t11
    %t12 = index i8 %t6, 6
    store i8 7, %t12
    %t13 = index i8 %t6, 7
    store i8 7, %t13
    %t14 = index i8 %t6, 8
    %t15 = copy i64 %t14
    %t16 = cmp ne i64 %t5, %t15
    branch %t16, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t17 = phi ptr [^entry: %p, ^unrolled_2: %t14]
    jump ^test

  block ^test:
    %q = phi ptr [^wide_tail_3: %t17, ^more: %next]
    %done = cmp eq ptr %end, %q
    branch %done, ^return, ^more

  block ^more:
    store i8 7, %q
    %next = index i8 %q, 1
    jump ^test

  block ^return:
    return void
}
function @__cppgm_builtin_memmove(%p : ptr, %s : ptr, %n : i64) -> ptr [no_inline=yes] {
  block ^entry:
    return ptr %p
}
function @copy_loop(%to : ptr, %from : ptr, %end : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = copy i64 %from
    %t2 = copy i64 %end
    %t3 = binary sub i64 %t2, %t1
    %t4 = binary and i64 %t3, -8
    branch %t4, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    %t5 = binary add i64 %t1, %t4
    jump ^unrolled_2

  block ^unrolled_2:
    %t6 = phi ptr [^loop_preheader_1: %from, ^unrolled_2: %t30]
    %t7 = phi ptr [^loop_preheader_1: %to, ^unrolled_2: %t31]
    %t8 = load i8 %t6
    store i8 %t8, %t7
    %t9 = index i8 %t6, 1
    %t10 = index i8 %t7, 1
    %t11 = load i8 %t9
    store i8 %t11, %t10
    %t12 = index i8 %t6, 2
    %t13 = index i8 %t7, 2
    %t14 = load i8 %t12
    store i8 %t14, %t13
    %t15 = index i8 %t6, 3
    %t16 = index i8 %t7, 3
    %t17 = load i8 %t15
    store i8 %t17, %t16
    %t18 = index i8 %t6, 4
    %t19 = index i8 %t7, 4
    %t20 = load i8 %t18
    store i8 %t20, %t19
    %t21 = index i8 %t6, 5
    %t22 = index i8 %t7, 5
    %t23 = load i8 %t21
    store i8 %t23, %t22
    %t24 = index i8 %t6, 6
    %t25 = index i8 %t7, 6
    %t26 = load i8 %t24
    store i8 %t26, %t25
    %t27 = index i8 %t6, 7
    %t28 = index i8 %t7, 7
    %t29 = load i8 %t27
    store i8 %t29, %t28
    %t30 = index i8 %t6, 8
    %t31 = index i8 %t7, 8
    %t32 = copy i64 %t30
    %t33 = cmp ne i64 %t5, %t32
    branch %t33, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t34 = phi ptr [^entry: %from, ^unrolled_2: %t30]
    %t35 = phi ptr [^entry: %to, ^unrolled_2: %t31]
    jump ^test

  block ^test:
    %p = phi ptr [^wide_tail_3: %t34, ^more: %next_p]
    %q = phi ptr [^wide_tail_3: %t35, ^more: %next_q]
    %done = cmp eq ptr %end, %p
    branch %done, ^return, ^more

  block ^more:
    %v = load i8 %p
    store i8 %v, %q
    %next_p = index i8 %p, 1
    %next_q = index i8 %q, 1
    jump ^test

  block ^return:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %from = addr @source
    %to = addr @destination
    %end = index i8 %to, 3
    call void @fill_loop(%to, %end)
    %copy_to = addr @copy_target
    %copy_end = index i8 %from, 3
    call void @copy_loop(%copy_to, %from, %copy_end)
    %first = load i8 %copy_to
    %bad_copy = cmp ne i8 %first, 97
    branch %bad_copy, ^fail, ^length

  block ^length:
    %length = call i64 @cppgm_builtin_strlen(%from)
    %bad_length = cmp ne i64 %length, 117
    branch %bad_length, ^fail, ^fill

  block ^fill:
    %filled = call ptr @cppgm_builtin_memset(%to, 0, 1)
    %copied = call ptr @cppgm_builtin_memcpy(%to, %from, 1)
    %byte = load i8 %to
    %bad_byte = cmp ne i8 %byte, 7
    branch %bad_byte, ^fail, ^compare

  block ^compare:
    %compared = call i32 @cppgm_builtin_memcmp(%from, %from, 2)
    %is_zero = cmp eq i32 %compared, 0
    branch %is_zero, ^fail, ^count

  block ^count:
    %counter = addr @calls
    %total = load i64 %counter
    %bad_count = cmp ne i64 %total, 4
    branch %bad_count, ^fail, ^done

  block ^fail:
    return i32 1

  block ^done:
    return i32 0
}
