global @published : ptr = 0

function @capture(%p : ptr) -> void [no_inline=yes] {
  block ^entry:
    store ptr %p, @published
    return void
}
function @returned_value(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %a = load u32 %source
    %t2 = convert zext i64 u32 %a
    %next = index u32 %source, 1
    %b = load u32 %next
    %t5 = convert zext i64 u32 %b
    %t6 = binary shl i64 %t5, 32
    %t7 = binary or i64 %t2, %t6
    return i64 %t7
}
function @captured_value(%source : ptr) -> i64 [no_inline=yes] {
  slot $out : obj<8x4>

  block ^entry:
    %destination = addr $out
    call void @capture(%destination)
    %t2 = load i64 %source
    store i64 %t2, %destination
    %t3 = load i64 $out
    return i64 %t3
}
function @returned_address(%source : ptr) -> ptr [no_inline=yes] {
  slot $out : obj<8x4>

  block ^entry:
    %destination = addr $out
    %t2 = load i64 %source
    store i64 %t2, %destination
    return ptr %destination
}
function @volatile_value(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %a = load volatile u32 %source
    %next = index u32 %source, 1
    %b = load volatile u32 %next
    %t4 = convert zext i64 u32 %a
    %t5 = convert zext i64 u32 %b
    %t6 = binary shl i64 %t5, 32
    %t7 = binary or i64 %t4, %t6
    return i64 %t7
}
function @observed_frame(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %frame = frame_address
    call void @capture(%frame)
    %a = load u32 %source
    %t3 = convert zext i64 u32 %a
    %next = index u32 %source, 1
    %b = load u32 %next
    %t6 = convert zext i64 u32 %b
    %t7 = binary shl i64 %t6, 32
    %t8 = binary or i64 %t3, %t7
    return i64 %t8
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
