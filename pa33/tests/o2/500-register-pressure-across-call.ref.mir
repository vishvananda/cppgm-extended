machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve rbx r15 r14 r12 r13
    temp %t48 -> [rbp-8] : i64
    temp %t51 -> [rbp-16] : i64
    temp %t52 -> [rbp-24] : i64
    temp %t53 -> [rbp-32] : i64
    temp %t54 -> [rbp-40] : i64
    temp %t20 -> [rbp-48] : i64
    temp %t23 -> [rbp-56] : i64
    temp %t26 -> [rbp-64] : i64
    temp %t29 -> [rbp-72] : i64
    temp %t31 -> [rbp-80] : i64

  block ^entry
    mov rbx, rdi
    mov r15, 1
    mov r14, 2
    mov r11, 3
    store.i64 [rbp-8], r11
    mov r12, 4
    mov r13, 5
    mov r11, 6
    store.i64 [rbp-16], r11
    mov r11, 7
    store.i64 [rbp-24], r11
    mov r11, 8
    store.i64 [rbp-32], r11
    mov r11, 0
    store.i64 [rbp-40], r11

  block ^for_cond_1
    cmp.i64 [rbp-40], rbx
    jge ^for_end_4

  block ^for_body_2
    load.i64 rdi, [rbp-40]
    call @step [args=(rdi)]
    lea r9, [r15+rax]
    lea r8, [r14+r9]
    load.i64 rdi, [rbp-8]
    add rdi, r8
    lea rsi, [r12+rdi]
    lea rax, [r13+rsi]
    store.i64 [rbp-48], rax
    load.i64 rax, [rbp-16]
    add rax, [rbp-48]
    store.i64 [rbp-56], rax
    load.i64 rax, [rbp-24]
    add rax, [rbp-56]
    store.i64 [rbp-64], rax
    load.i64 rax, [rbp-32]
    add rax, [rbp-64]
    store.i64 [rbp-72], rax
    load.i64 rax, [rbp-40]
    add rax, 1
    store.i64 [rbp-80], rax
    mov r15, r9
    mov r14, r8
    store.i64 [rbp-8], rdi
    mov r12, rsi
    load.i64 r13, [rbp-48]
    load.i64 r11, [rbp-56]
    store.i64 [rbp-16], r11
    load.i64 r11, [rbp-64]
    store.i64 [rbp-24], r11
    load.i64 r11, [rbp-72]
    store.i64 [rbp-32], r11
    load.i64 r11, [rbp-80]
    store.i64 [rbp-40], r11
    jmp ^for_cond_1

  block ^for_end_4
    lea r9, [r15+r14]
    add r9, [rbp-8]
    add r9, r12
    add r9, r13
    add r9, [rbp-16]
    add r9, [rbp-24]
    add r9, [rbp-32]
    ret r9

function @step
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    add rdi, 1
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues direct
    temp %t0 -> [rbp-4] : i32

  block ^entry
    mov rdi, 3
    call @pressure [args=(rdi)]
    cmp.i64 rax, 1008
    jne ^cond_else_2

  block ^cond_then_1
    mov r11, 0
    store.i32 [rbp-4], r11
    jmp ^cond_end_3

  block ^cond_else_2
    mov r11, 1
    store.i32 [rbp-4], r11

  block ^cond_end_3
    load.i32 rax, [rbp-4]
    ret rax
