function @disjoint_state(%index : u8, %other : u8, %count : u32) -> u32 [unwind=no, no_inline=yes] {
  slot $state : obj<264x8>

  block ^entry:
    %base = addr $state
    %selected = index u8 %base, %index
    %read = index u8 %base, %other
    store u8 3, %read
    %t4 = binary and u32 %count, 4294967292
    branch %t4, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t5 = phi u32 [^loop_preheader_1: 7, ^unrolled_2: %t29]
    %t6 = phi u32 [^loop_preheader_1: 0, ^unrolled_2: %t30]
    %t7 = convert trunc u8 u32 %t6
    store u8 %t7, %selected
    %t8 = load u8 %read
    %t9 = convert zext u32 u8 %t8
    %t10 = binary add u32 %t6, %t9
    %t11 = binary add u32 %t5, %t10
    %t12 = binary add nowrap u32 %t6, 1
    %t13 = convert trunc u8 u32 %t12
    store u8 %t13, %selected
    %t14 = load u8 %read
    %t15 = convert zext u32 u8 %t14
    %t16 = binary add u32 %t12, %t15
    %t17 = binary add u32 %t11, %t16
    %t18 = binary add nowrap u32 %t6, 2
    %t19 = convert trunc u8 u32 %t18
    store u8 %t19, %selected
    %t20 = load u8 %read
    %t21 = convert zext u32 u8 %t20
    %t22 = binary add u32 %t18, %t21
    %t23 = binary add u32 %t17, %t22
    %t24 = binary add nowrap u32 %t6, 3
    %t25 = convert trunc u8 u32 %t24
    store u8 %t25, %selected
    %t26 = load u8 %read
    %t27 = convert zext u32 u8 %t26
    %t28 = binary add u32 %t24, %t27
    %t29 = binary add u32 %t23, %t28
    %t30 = binary add nowrap u32 %t6, 4
    %t31 = cmp ne u32 %t4, %t30
    branch %t31, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t32 = phi u32 [^entry: 7, ^unrolled_2: %t29]
    %t33 = phi u32 [^entry: 0, ^unrolled_2: %t30]
    jump ^loop

  block ^loop:
    %t34 = phi u32 [^wide_tail_3: %t32, ^body: %sum]
    %i = phi u32 [^wide_tail_3: %t33, ^body: %next]
    %more = cmp ult u32 %i, %count
    branch %more, ^body, ^end

  block ^body:
    %byte = convert trunc u8 u32 %i
    store u8 %byte, %selected
    %read_byte = load u8 %read
    %amount = convert zext u32 u8 %read_byte
    %step = binary add u32 %i, %amount
    %sum = binary add u32 %t34, %step
    %next = binary add u32 %i, 1
    jump ^loop

  block ^end:
    return u32 %t34
}
function @overlap_chain(%index : u8) -> i64 [unwind=no, no_inline=yes] {
  slot $state : obj<272x8>

  block ^entry:
    %base = addr $state
    %wide = index i8 %base, 252
    %field = index i8 %base, 256
    %selected = index u8 %base, %index
    store i64 0, %wide
    store u32 305419896, %field
    store u8 153, %selected
    %all = load i64 %wide
    %result = binary add i64 %all, 17
    return i64 %result
}
function @unknown_index(%index : i64) -> u32 [unwind=no, no_inline=yes] {
  slot $state : obj<264x8>

  block ^entry:
    %base = addr $state
    %field = index i8 %base, 256
    %selected = index i8 %base, %index
    store u32 0, %field
    store u8 255, %selected
    %result = load u32 %field
    return u32 %result
}
function @whole_zero(%index : u8) -> u32 [unwind=no, no_inline=yes] {
  slot $state : obj<264x8>

  block ^entry:
    %base = addr $state
    %field = index i8 %base, 256
    %selected = index u8 %base, %index
    store u32 9, %field
    zeroinit 264x8 %base
    store u8 255, %selected
    %result = load u32 %field
    return u32 %result
}
function @volatile_field(%index : u8) -> u32 [unwind=no, no_inline=yes] {
  slot $state : obj<264x8>

  block ^entry:
    %base = addr $state
    %field = index i8 %base, 256
    %selected = index u8 %base, %index
    store volatile u32 19, %field
    store u8 255, %selected
    %result = load volatile u32 %field
    return u32 %result
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %a = call u32 @disjoint_state(0, 255, 5)
    %a_ok = cmp eq u32 %a, 32
    %b = call u32 @disjoint_state(129, 129, 5)
    %b_ok = cmp eq u32 %b, 27
    %c = call i64 @overlap_chain(255)
    %c_ok = cmp eq i64 %c, 1311768467434635281
    %d = call u32 @unknown_index(256)
    %d_ok = cmp eq u32 %d, 255
    %e = call u32 @whole_zero(255)
    %e_ok = cmp eq u32 %e, 0
    %f = call u32 @volatile_field(0)
    %f_ok = cmp eq u32 %f, 19
    %ab = binary and i64 %a_ok, %b_ok
    %cd = binary and i64 %c_ok, %d_ok
    %ef = binary and i64 %e_ok, %f_ok
    %abcd = binary and i64 %ab, %cd
    %all = binary and i64 %ef, %abcd
    %t18 = select i32 %all, 0, 1
    return i32 %t18
}
