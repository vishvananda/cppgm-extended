declare function @unknown_effects() -> void

global @stable : i64 = 7
global @changed : i64 = 1
global @other : i64 = 0

function @hoist_disjoint_global(%limit : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %value = load i64 @stable
    %t2 = binary and i64 %limit, -8
    %t3 = cmp gt i64 %t2, 0
    branch %t3, ^loop_preheader_1, ^wide_tail_3

  block ^loop_preheader_1:
    jump ^unrolled_2

  block ^unrolled_2:
    %t4 = phi i64 [^loop_preheader_1: 0, ^unrolled_2: %t5]
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    store i64 %value, @other
    %t5 = binary add nowrap i64 %t4, 8
    %t6 = cmp ne i64 %t2, %t5
    branch %t6, ^unrolled_2, ^wide_tail_3

  block ^wide_tail_3:
    %t7 = phi i64 [^entry: 0, ^unrolled_2: %t5]
    jump ^header

  block ^header:
    %i = phi i64 [^wide_tail_3: %t7, ^body: %next]
    %more = cmp lt i64 %i, %limit
    branch %more, ^body, ^exit

  block ^body:
    store i64 %value, @other
    %next = binary add nowrap i64 %i, 1
    jump ^header

  block ^exit:
    return i64 0
}
function @keep_aliased_global(%limit : i64) -> i64 [no_inline=yes] {
  block ^entry:
    return i64 0
}
function @keep_across_unknown_call(%limit : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^header

  block ^header:
    %i = phi i64 [^entry: 0, ^body: %next]
    %more = cmp lt i64 %i, %limit
    branch %more, ^body, ^exit

  block ^body:
    %value = load i64 @stable
    call void @unknown_effects()
    store i64 %value, @other
    %next = binary add nowrap i64 %i, 1
    jump ^header

  block ^exit:
    return i64 0
}
function @keep_across_atomic(%limit : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %address = addr @stable
    jump ^header

  block ^header:
    %i = phi i64 [^entry: 0, ^body: %next]
    %more = cmp lt i64 %i, %limit
    branch %more, ^body, ^exit

  block ^body:
    %value = load i64 @stable
    atomic_store i64 %i, %address, 0
    store i64 %value, @other
    %next = binary add nowrap i64 %i, 1
    jump ^header

  block ^exit:
    return i64 0
}
