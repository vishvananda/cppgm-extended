  block ^entry:
    %arg = convert trunc u32 i64 %x
    %expected = call i64 @oracle(%x, 2813935905, 4, 32, 5, 1, 0)
    %actual = call u32 @fold_u32_flip(%arg)
    %wide = convert zext i64 u32 %actual
    %bad = cmp ne i64 %wide, %expected
