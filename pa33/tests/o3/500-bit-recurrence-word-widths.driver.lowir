global @oracle_sum : i64 = 0

function @oracle(%x : i64, %p : i64, %count : i64, %width : i64, %flip : i64, %amount : i64, %arithmetic : i64) -> i64 {
  block ^entry:
    %remaining = binary sub i64 64, %width
    %mask = binary ushr i64 -1, %remaining
    %sign_index = binary sub i64 %width, 1
    %sign = binary shl i64 1, %sign_index
    %initial = binary and i64 %x, %mask
    jump ^header
  block ^header:
    %i = phi i64 [^entry: 0, ^body: %next_i]
    %value = phi i64 [^entry: %initial, ^body: %next]
    %total = phi i64 [^entry: 0, ^body: %next_total]
    %more = cmp ult i64 %i, %count
    branch %more, ^body, ^exit
  block ^body:
    %low = binary and i64 %value, 1
    %polarity = binary ushr i64 %flip, %i
    %invert = binary and i64 %polarity, 1
    %bit = binary xor i64 %low, %invert
    %all = binary sub i64 0, %bit
    %mix = binary and i64 %all, %p
    %toggle = binary xor i64 %value, %sign
    %signed = binary sub i64 %toggle, %sign
    %logical = binary ushr i64 %value, %amount
    %arithmetic_value = binary shr i64 %signed, %amount
    %shifted = select i64 %arithmetic, %arithmetic_value, %logical
    %combined = binary xor i64 %shifted, %mix
    %next = binary and i64 %combined, %mask
    %next_total = binary add i64 %total, %next
    %next_i = binary add i64 %i, 1
    jump ^header
  block ^exit:
    store i64 %total, @oracle_sum
    return i64 %value
}

function @check_fold_u8(%x : i64) -> i64 {
  block ^entry:
    %arg = convert trunc u8 i64 %x
    %expected = call i64 @oracle(%x, 184, 8, 8, 85, 1, 0)
    %actual = call u8 @fold_u8(%arg)
    %wide = convert zext i64 u8 %actual
    %bad = cmp ne i64 %wide, %expected
    %answer = select i64 %bad, 1, 0
    return i64 %answer
}

function @check_fold_i8(%x : i64) -> i64 {
  block ^entry:
    %arg = convert trunc i8 i64 %x
    %expected = call i64 @oracle(%x, 184, 8, 8, 85, 1, 0)
    %actual = call i8 @fold_i8(%arg)
    %wide = convert zext i64 i8 %actual
    %bad = cmp ne i64 %wide, %expected
    %answer = select i64 %bad, 1, 0
    return i64 %answer
}

