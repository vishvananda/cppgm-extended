  block ^entry:
    %arg = convert trunc u16 i64 %x
    %expected = call i64 @oracle(%x, 46081, 5, 16, 0, 1, 0)
    %actual = call u16 @fold_u16(%arg)
    %wide = convert zext i64 u16 %actual
    %bad = cmp ne i64 %wide, %expected
    %answer = select i64 %bad, 1, 0
