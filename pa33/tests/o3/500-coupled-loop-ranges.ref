function @header_search(%cut : i32) -> i32 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %t1 = phi i32 [^body: %t9, ^entry: 64]
    %t2 = phi i32 [^body: %t7, ^entry: 0]
    %sum = binary add i32 %t2, %t1
    %mid = binary ushr i32 %sum, 1
    %plus = binary add i32 %mid, 1
    %t6 = cmp lt i32 %mid, %cut
    %t7 = select i32 %t6, %plus, %t2
    %t8 = cmp lt i32 %mid, %cut
    %t9 = select i32 %t8, %t1, %mid
    %t10 = cmp lt i32 %t7, %t9
    branch %t10, ^body, ^done

  block ^done:
    %t11 = phi i32 [^body: %t9]
    return i32 %t11
}
function @latch_search(%cut : i32) -> i32 [no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %lo = phi i32 [^entry: 0, ^loop: %t7]
    %hi = phi i32 [^entry: 64, ^loop: %t9]
    %sum = binary add i32 %lo, %hi
    %mid = binary ushr i32 %sum, 1
    %plus = binary add i32 %mid, 1
    %t6 = cmp lt i32 %mid, %cut
    %t7 = select i32 %t6, %plus, %lo
    %t8 = cmp lt i32 %mid, %cut
    %t9 = select i32 %t8, %hi, %mid
    %stop = cmp le i32 %t9, %t7
    branch %stop, ^done, ^loop

  block ^done:
    return i32 %t9
}
function @search8(%cut : i8) -> i8 [no_inline=yes] {
  block ^entry:
