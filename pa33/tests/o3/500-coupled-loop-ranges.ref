  block ^unrolled_3:
    %t4 = phi i32 [^loop_preheader_2: 8, ^unrolled_3: %t14]
    %t5 = phi i32 [^loop_preheader_2: 40, ^unrolled_3: %t12]
    %t6 = phi i64 [^loop_preheader_2: 0, ^unrolled_3: %t15]
    %t7 = binary add i32 %t4, %t5
    %t8 = binary ushr i32 %t7, 1
    %t9 = binary add i32 %t4, %t8
    %t10 = binary ushr i32 %t9, 1
    %t11 = binary add i32 %t8, %t10
    %t12 = binary ushr i32 %t11, 1
    %t13 = binary add i32 %t10, %t12
    %t14 = binary ushr i32 %t13, 1
    %t15 = binary add nowrap i64 %t6, 4
    %t16 = cmp ne i64 %t2, %t15
    branch %t16, ^unrolled_3, ^loop_exit_4

  block ^loop_exit_4:
    %t17 = cmp lt i64 %t15, %count
    %t18 = binary and i32 %t13, 7
    %t19 = binary add i32 %t14, %t18
    branch %t17, ^wide_tail_5, ^done

  block ^wide_tail_5:
    %t20 = phi i32 [^loop_preheader_1: 8, ^loop_exit_4: %t14]
    %t21 = phi i32 [^loop_preheader_1: 40, ^loop_exit_4: %t12]
    %t22 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t15]
    jump ^body

  block ^body:
    %a = phi i32 [^wide_tail_5: %t20, ^body: %mid]
    %b = phi i32 [^wide_tail_5: %t21, ^body: %a]
    %i = phi i64 [^wide_tail_5: %t22, ^body: %inext]
    %sum = binary add i32 %a, %b
    %mid = binary ushr i32 %sum, 1
    %rem = binary and i32 %sum, 7
    %answer = binary add i32 %mid, %rem
    %inext = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %inext, %count
    branch %more, ^body, ^done

  block ^done:
    %t32 = phi i32 [^body: %answer, ^loop_exit_4: %t19]
    return i32 %t32

  block ^empty:
