function @coupled_quotient(%count : i64) -> i32 [no_inline=yes] {
  block ^entry:
    %enter = cmp gt i64 %count, 0
    branch %enter, ^loop_preheader_1, ^empty

  block ^loop_preheader_1:
    %t2 = binary and i64 %count, -4
    %t3 = cmp gt i64 %t2, 0
    branch %t3, ^loop_preheader_2, ^wide_tail_5

  block ^loop_preheader_2:
