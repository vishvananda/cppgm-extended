    %t10 = binary add i32 %t8, %t9
    %t11 = binary div i32 %t10, 2
    %t12 = binary sub i32 %t4, 2
    %t13 = binary add i32 %t11, %t12
    %t14 = binary div i32 %t13, 2
    %t15 = binary sub i32 %t4, 3
    %t16 = binary add i32 %t14, %t15
    %t17 = binary div i32 %t16, 2
    %t18 = binary sub i32 %t4, 4
    %t19 = binary add nowrap i64 %t6, 4
