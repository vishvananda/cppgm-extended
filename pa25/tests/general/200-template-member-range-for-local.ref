function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $b : obj<1x1>

  block ^entry:
    %t1 = addr $b
    %t2 = addr $b
    %t3 = call i32 @Box_int___f(%t2)
    return i32 %t3
}
function @Box_int___f(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN3BoxIiE1fEv, inline_hint=yes] {
  slot $this : ptr
  slot $xs : obj<8x4>
  slot $total : i32
  slot $__idx1 : i32
  slot $x : i32

  block ^entry:
    store ptr %this, $this
    %t1 = addr $xs
    store i32 1, %t1
    %t2 = index i8 %t1, 4
    store i32 2, %t2
    store i32 0, $total
    store i32 0, $__idx1
    jump ^for_cond_1

  block ^for_cond_1:
    %t3 = load i32 $__idx1
    %t4 = cmp lt i32 %t3, 2
    branch %t4, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t5 = addr $xs
    %t6 = load i32 $__idx1
    %t7 = index i32 [projection=array_element] %t5, %t6
    %t8 = load i32 %t7
    store i32 %t8, $x
    %t9 = load i32 $total
    %t10 = load i32 $x
    %t11 = binary add i32 %t9, %t10
    store i32 %t11, $total
    jump ^for_iter_3

  block ^for_iter_3:
    %t12 = load i32 $__idx1
    %t13 = binary add i32 %t12, 1
    store i32 %t13, $__idx1
    jump ^for_cond_1

  block ^for_end_4:
    %t14 = load i32 $total
    return i32 %t14
}
