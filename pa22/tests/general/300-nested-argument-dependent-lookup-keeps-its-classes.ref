function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : obj<4x4>
  slot $f : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $s
    %t2 = addr $s
    %t3 = index i8 [projection=field] %t2, 0
    store i32 0, %t3
    %t4 = addr $f
    %t5 = addr $f
    %t6 = index i8 [projection=field] %t5, 0
    store i32 4, %t6
    %t7 = addr $s
    %t8 = addr $f
    %t9 = call ptr @operator__(%t7, %t8)
    %t10 = addr $s
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load i32 %t11
    %t13 = cmp eq i32 %t12, 4
    branch %t13, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t14 = load i32 $cond__1
    return i32 %t14
}
function @operator__(%s : ptr [pass=by_address, object_bytes=4], %f : ptr [pass=by_address, object_bytes=4]) -> ptr [binding=weak, object=_ZlsR4sinkRK4fill, inline_hint=yes] {
  slot $s : ptr
  slot $f : ptr

  block ^entry:
    store ptr %s, $s
    store ptr %f, $f
    %t1 = load ptr $s
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = load ptr $f
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = binary add i32 %t3, %t6
    store i32 %t7, %t2
    %t8 = load ptr $s
    return ptr %t8
}
