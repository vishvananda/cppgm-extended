function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : u8
  slot $b : u8
  slot $c : u8
  slot $d : u8
  slot $e : u8
  slot $land__1 : i64
  slot $f : u8
  slot $lor__2 : i64
  slot $cond__3 : i32
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64
  slot $land__7 : i64
  slot $land__8 : i64

  block ^entry:
    store u8 1, $a
    store u8 0, $b
    store u8 1, $c
    store u8 0, $d
    branch 1, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t1 = cmp ne i64 1, 0
    store i64 %t1, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t2 = load i64 $land__1
    store u8 %t2, $e
    branch 0, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t3 = cmp ne i64 0, 0
    store i64 %t3, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t4 = load i64 $lor__2
    store u8 %t4, $f
    %t5 = load u8 $a
    branch %t5, ^land_rhs_22, ^land_short_23

  block ^land_rhs_22:
    %t6 = load u8 $b
    %t7 = cmp eq i64 %t6, 0
    %t8 = cmp ne i64 %t7, 0
    store i64 %t8, $land__8
    jump ^land_end_24

  block ^land_short_23:
    store i64 0, $land__8
    jump ^land_end_24

  block ^land_end_24:
    %t9 = load i64 $land__8
    branch %t9, ^land_rhs_19, ^land_short_20

  block ^land_rhs_19:
    %t10 = load u8 $c
    %t11 = cmp ne i64 %t10, 0
    store i64 %t11, $land__7
    jump ^land_end_21

  block ^land_short_20:
    store i64 0, $land__7
    jump ^land_end_21

  block ^land_end_21:
    %t12 = load i64 $land__7
    branch %t12, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t13 = load u8 $d
    %t14 = cmp eq i64 %t13, 0
    %t15 = cmp ne i64 %t14, 0
    store i64 %t15, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t16 = load i64 $land__6
    branch %t16, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t17 = load u8 $e
    %t18 = cmp ne i64 %t17, 0
    store i64 %t18, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t19 = load i64 $land__5
    branch %t19, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t20 = load u8 $f
    %t21 = cmp eq i64 %t20, 0
    %t22 = cmp ne i64 %t21, 0
    store i64 %t22, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t23 = load i64 $land__4
    branch %t23, ^cond_then_7, ^cond_else_8

  block ^cond_then_7:
    store i32 0, $cond__3
    jump ^cond_end_9

  block ^cond_else_8:
    store i32 1, $cond__3
    jump ^cond_end_9

  block ^cond_end_9:
    %t24 = load i32 $cond__3
    return i32 %t24
}
