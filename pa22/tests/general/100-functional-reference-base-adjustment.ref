function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $object : obj<12x4>
  slot $reference : ptr
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = addr $object
    %t2 = addr $object
    %t3 = index i8 %t2, 0
    %t4 = index i8 [projection=field] %t3, 0
    store typed i32 3, %t4
    %t5 = addr $object
    %t6 = index i8 %t5, 4
    %t7 = index i8 [projection=field] %t6, 0
    store typed i32 7, %t7
    %t8 = addr $object
    %t9 = index i8 %t8, 4
    store typed ptr %t9, $reference
    %t10 = load typed ptr $reference
    %t11 = index i8 [projection=field] %t10, 0
    store typed i32 9, %t11
    %t12 = load typed ptr $reference
    %t13 = addr $object
    %t14 = index i8 %t13, 4
    %t15 = cmp ne ptr %t12, %t14
    branch %t15, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t16 = addr $object
    %t17 = index i8 %t16, 4
    %t18 = index i8 [projection=field] %t17, 0
    %t19 = load typed i32 %t18
    %t20 = cmp ne i32 %t19, 9
    %t21 = cmp ne i64 %t20, 0
    store typed i64 %t21, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t22 = load typed i64 $lor__1
    branch %t22, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t23 = addr $object
    %t24 = index i8 %t23, 0
    %t25 = index i8 [projection=field] %t24, 0
    %t26 = load typed i32 %t25
    %t27 = cmp ne i32 %t26, 3
    %t28 = cmp ne i64 %t27, 0
    store typed i64 %t28, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t29 = load typed i64 $lor__2
    %t30 = convert trunc i32 i64 %t29
    return i32 %t30
}
