function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $status : i32

  block ^entry:
    store i32 0, $status
    %t1 = cmp ne i32 1, 1
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    store i32 1, $status
    jump ^if_end_3

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t2 = const i64 1
    %t3 = const i64 1
    %t4 = cmp ne i64 %t2, %t3
    branch %t4, ^if_then_4, ^if_else_5

  block ^if_then_4:
    store i32 2, $status
    jump ^if_end_6

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t5 = const i64 2
    %t6 = const i64 2
    %t7 = cmp ne i64 %t5, %t6
    branch %t7, ^if_then_7, ^if_else_8

  block ^if_then_7:
    store i32 3, $status
    jump ^if_end_9

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    %t8 = load i32 $status
    return i32 %t8
}
