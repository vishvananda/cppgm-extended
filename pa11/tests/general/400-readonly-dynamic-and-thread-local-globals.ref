global @scalar : i32 [storage=readonly, binding=internal, object=_ZL6scalar] = 3
global @dynamic_scalar : i32 [binding=internal, object=_ZL14dynamic_scalar] = zero
global @dynamic_table : obj<8x4> [binding=internal, object=_ZL13dynamic_table] = {
  zero 8
}
global @thread_scalar : i32 [storage=thread_local, binding=internal, object=_ZL13thread_scalar] = 11

function @seed() -> i32 [binding=strong, object=_Z4seedv] {
  block ^entry:
    return i32 1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $cond__1 : i32

  block ^entry:
    %t1 = load typed i32 @dynamic_scalar
    %t2 = binary add nowrap i32 3, %t1
    %t3 = addr @dynamic_table
    %t4 = index inbounds i32 [projection=array_element] %t3, 0
    %t5 = load typed i32 %t4
    %t6 = binary add nowrap i32 %t2, %t5
    %t7 = addr @dynamic_table
    %t8 = index inbounds i32 [projection=array_element] %t7, 1
    %t9 = load typed i32 %t8
    %t10 = binary add nowrap i32 %t6, %t9
    %t11 = binary add nowrap i32 %t10, 11
    store typed i32 %t11, $sum
    %t12 = load typed i32 $sum
    %t13 = binary add nowrap i32 3, 1
    %t14 = binary add nowrap i32 %t13, 1
    %t15 = binary add nowrap i32 %t14, 2
    %t16 = binary add nowrap i32 %t15, 11
    %t17 = cmp eq i32 %t12, %t16
    branch %t17, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t18 = load typed i32 $cond__1
    return i32 %t18
}
function @__cppgm_init() -> void [role=init, binding=internal] {
  block ^entry:
    %t1 = call i32 @seed()
    store typed i32 %t1, @dynamic_scalar
    %t2 = addr @dynamic_table
    %t3 = call i32 @seed()
    store typed i32 %t3, %t2
    %t4 = index i8 %t2, 4
    store typed i32 2, %t4
