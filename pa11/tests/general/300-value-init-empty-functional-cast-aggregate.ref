function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<32x8>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr $value
    zeroinit 32x8 %t1
    %t2 = addr $value
    %t3 = index inbounds i8 [projection=field] %t2, 0
    %t4 = load typed ptr %t3
    %t5 = cmp eq ptr %t4, 0
    branch %t5, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t6 = addr $value
    %t7 = index inbounds i8 [projection=field] %t6, 8
    %t8 = load typed u32 %t7
    %t9 = cmp eq u32 %t8, 0
    store typed i64 %t9, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t10 = load typed i64 $land__2
    branch %t10, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t11 = addr $value
    %t12 = index inbounds i8 [projection=field] %t11, 16
    %t13 = load typed ptr %t12
    %t14 = cmp eq ptr %t13, 0
    store typed i64 %t14, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t15 = load typed i64 $land__3
    branch %t15, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t16 = addr $value
    %t17 = index inbounds i8 [projection=field] %t16, 24
    %t18 = load typed i32 %t17
    %t19 = cmp eq i32 %t18, 0
    store typed i64 %t19, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t20 = load typed i64 $land__4
    branch %t20, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t21 = load typed i32 $cond__1
    return i32 %t21
}
