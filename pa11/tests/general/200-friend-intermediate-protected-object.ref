function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $object : obj<1x1>

  block ^entry:
    %t1 = addr $object
    %t2 = addr $object
    %t3 = call i32 @Friend__get(%t2)
    %t4 = cmp ne i32 %t3, 7
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
function @Friend__get(%object : ptr [pass=by_address, object_bytes=1]) -> i32 [binding=weak, object=_ZN6Friend3getER7Derived, inline_hint=yes] {
  slot $object : ptr

  block ^entry:
    store typed ptr %object, $object
    %t1 = load typed ptr $object
    %t2 = index i8 %t1, 0
    %t3 = call i32 @Base__value(%t2)
    return i32 %t3
}
function @Base__value(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZNK4Base5valueEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 7
}
