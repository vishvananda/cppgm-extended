global @calls : i32 [binding=strong] = zero
global @object [binding=strong] = {
  zero 1
}

function @get() -> ptr [binding=strong, object=_Z3getv] {
  block ^entry:
    %t1 = load typed i32 @calls
    %t2 = binary add nowrap i32 %t1, 1
    store typed i32 %t2, @calls
    %t3 = addr @object
    return ptr %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $first : i32
  slot $second : i32
  slot $third : i32
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr $value
    %t2 = call ptr @get()
    store typed i32 0, $first
    %t3 = addr $value
    store typed i32 1, $second
    store typed i32 7, $third
    %t4 = load typed i32 $first
    %t5 = cmp eq i32 %t4, 0
    branch %t5, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t6 = load typed i32 $second
    %t7 = cmp eq i32 %t6, 1
    store typed i64 %t7, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t8 = load typed i64 $land__2
    branch %t8, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t9 = load typed i32 $third
    %t10 = cmp eq i32 %t9, 7
    store typed i64 %t10, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t11 = load typed i64 $land__3
    branch %t11, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t12 = load typed i32 @calls
    %t13 = cmp eq i32 %t12, 1
    store typed i64 %t13, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t14 = load typed i64 $land__4
    branch %t14, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t15 = load typed i32 $cond__1
    return i32 %t15
}
