declare function @S__S(%arg0 : ptr [object_bytes=1], %arg1 : i32) -> void [binding=strong, object=_ZN1SC1Ei]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $buf : obj<8x1>
  slot $p : ptr

  block ^entry:
    %t1 = convert sext i64 i32 1
    %t2 = addr $buf
    call void @S__S(%t2, 7)
    store typed ptr %t2, $p
    %t3 = load typed ptr $p
    %t4 = cmp eq ptr %t3, 0
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
