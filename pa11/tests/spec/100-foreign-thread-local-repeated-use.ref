declare global @imported : i32 [storage=thread_local, binding=strong]

declare function @__cppgm_tls_init__imported() -> void [binding=weak, object=_ZTH8imported]

function @__cppgm_tls_wrapper__imported() -> ptr [binding=weak, object=_ZTW8imported, tls_for=@imported] {
  block ^entry:
    %t1 = cmp ne ptr @__cppgm_tls_init__imported, 0
    branch %t1, ^local_static_ctor_run_1, ^local_static_ctor_done_2

  block ^local_static_ctor_run_1:
    call void @__cppgm_tls_init__imported()
    jump ^local_static_ctor_done_2

  block ^local_static_ctor_done_2:
    %t2 = addr @imported
    return ptr %t2
}
