  block ^lor_rhs_4:
    %t10 = load typed ptr $first
    %t11 = load typed i32 %t10
    %t12 = cmp ne i32 %t11, 37
    %t13 = cmp ne i64 %t12, 0
    store typed i64 %t13, $lor__2
