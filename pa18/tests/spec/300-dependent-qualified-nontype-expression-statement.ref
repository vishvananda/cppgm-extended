function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $derived : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    store i32 4, $value
    %t1 = addr $derived
    %t2 = addr $derived
    %t3 = addr $value
    call void @Derived_int___run(%t2, %t3)
    %t4 = load i32 $value
    %t5 = cmp eq i32 %t4, 5
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load i32 $cond__1
    return i32 %t6
}
function @Derived_int___run(%this : ptr, %value : ptr [pass=reference]) -> void [binding=weak, object=_ZN7DerivedIiE3runERi] {
  slot $this : ptr
  slot $value : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %value, $value
    %t1 = load ptr $value
    call void @Base_int___touch(%t1)
    return void
}
function @Base_int___touch(%value : ptr [pass=reference]) -> void [binding=weak, object=_ZN4BaseIiE5touchERi] {
  slot $value : ptr

  block ^entry:
    store ptr %value, $value
    %t1 = load ptr $value
    %t2 = load i32 %t1
    %t3 = binary add i32 %t2, 1
    %t4 = load ptr $value
    store i32 %t3, %t4
    return void
}
