function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $table_value : obj<1x1>
  slot $value : i32
  slot $w : obj<16x8>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $table_value
    store i32 4, $value
    %t2 = addr $w
    %t3 = addr $table_value
    %t4 = addr $w
    %t5 = index i8 [projection=field] %t4, 0
    store ptr %t3, %t5
    %t6 = addr $value
    %t7 = addr $w
    %t8 = index i8 [projection=field] %t7, 8
    store ptr %t6, %t8
    %t9 = addr $w
    %t10 = call i32 @wrapper__call_it(%t9)
    %t11 = cmp eq i32 %t10, 5
    branch %t11, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t12 = load i32 $cond__1
    return i32 %t12
}
function @wrapper__call_it(%this : ptr) -> i32 [binding=weak, object=_ZN7wrapper7call_itIiEEiv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load ptr %t2
    %t4 = load ptr $this
    %t5 = index i8 [projection=field] %t4, 8
    %t6 = load ptr %t5
    %t7 = call i32 @table__call(%t3, %t6)
    return i32 %t7
}
function @table__call(%this : ptr, %value : ptr) -> i32 [binding=weak, object=_ZNK5table4callEPi] {
  slot $this : ptr
  slot $value : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %value, $value
    %t1 = load ptr $value
    %t2 = load i32 %t1
    %t3 = binary add i32 %t2, 1
    return i32 %t3
}
