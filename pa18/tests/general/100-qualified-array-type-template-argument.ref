function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @box_unsigned_int_4____size()
    %t2 = cmp eq i32 %t1, 16
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @box_unsigned_int_4____size() -> i32 [binding=weak, object=_ZN3boxIA4_jE4sizeEv] {
  block ^entry:
    %t1 = const i64 16
    %t2 = convert trunc i32 i64 %t1
    return i32 %t2
}
