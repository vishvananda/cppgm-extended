function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<1x1>

  block ^entry:
    %t1 = addr $x
    %t2 = addr $x
    call void @X_int___f(%t2, 0)
    return i32 0
}
function @X_int___f(%this : ptr, %x : i32) -> void [binding=weak, object=_ZN1XIiE1fEi] {
  slot $this : ptr
  slot $x : i32

  block ^entry:
    store ptr %this, $this
    store i32 %x, $x
    %t1 = load i32 $x
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return void

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    return void
}
