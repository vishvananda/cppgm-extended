function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $h : obj<1x1>
  slot $refarg__1 : i32

  block ^entry:
    %t1 = addr $h
    %t2 = addr $h
    store i32 0, $refarg__1
    %t3 = addr $refarg__1
    %t4 = call i32 @holder_int___same_size(%t2, %t3)
    return i32 %t4
}
function @holder_int___same_size(%this : ptr, %__param1 : ptr [pass=reference]) -> i32 [binding=weak, object=_ZNK6holderIiE9same_sizeIiEEiRKT_] {
  slot $this : ptr
  slot $__param1 : ptr
  slot $cond__1 : i32

  block ^entry:
    store ptr %this, $this
    store ptr %__param1, $__param1
    %t1 = const i64 4
    %t2 = const i64 4
    %t3 = cmp eq i64 %t1, %t2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load i32 $cond__1
    return i32 %t4
}
