  _mm_storeu_si128(reinterpret_cast<__m128i*>(out),_mm_packs_epi16(_mm_loadu_si128(reinterpret_cast<const __m128i*>(a)),_mm_loadu_si128(reinterpret_cast<const __m128i*>(b))));
