// The selected halves, zero masks and ignored bits are checked for every byte.
typedef long long Quad __attribute__((vector_size(32)));
typedef unsigned long long Word;
template<int Mask> __attribute__((target("avx2"))) bool one(Word seed) {
  Quad a{static_cast<long long>(seed), static_cast<long long>(seed ^ 0x84350601ULL),
         static_cast<long long>(seed + 0x79), static_cast<long long>(seed * 3)};
  Quad b{static_cast<long long>(seed ^ 0x02040806ULL), static_cast<long long>(~seed),
         static_cast<long long>(seed * 1337), static_cast<long long>(seed - 0x85)};
  Quad result = __builtin_ia32_permti256(a, b, Mask);
  for (unsigned i = 0; i < 4; ++i) {
    const unsigned selector = (Mask >> ((i / 2) * 4)) & 15;
    const unsigned lane = (selector & 1) * 2 + i % 2;
    const long long expected = (selector & 8) ? 0 : (selector & 2) ? b[lane] : a[lane];
    if (result[i] != expected) return false;
  }
  return true;
}
template<int Mask> bool all(Word seed) { return one<Mask>(seed) && all<Mask-1>(seed); }
template<> bool all<-1>(Word) { return true; }
bool supported() {
  unsigned a = 1, b, c = 0, d;
  asm volatile("cpuid" : "+a"(a), "=b"(b), "+c"(c), "=d"(d));
  if ((c & (3U << 26)) != (3U << 26)) return false;
  unsigned low, high;
  asm volatile("xgetbv" : "=a"(low), "=d"(high) : "c"(0));
  if ((low & 6) != 6) return false;
  a = 7; c = 0;
  asm volatile("cpuid" : "+a"(a), "=b"(b), "+c"(c), "=d"(d));
  return (b & 32) != 0;
}
int main() {
  if (!supported()) return 0;
  const Word seeds[] = {0, 1, ~0ULL, 0x87946abc12121212ULL};
  for (unsigned i = 0; i < 4; ++i) if (!all<255>(seeds[i])) return 1;
  return 0;
}
