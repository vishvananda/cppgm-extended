__attribute__((always_inline)) inline int sum(unsigned n) {
    if (n > 32) return -1;
    int *values = static_cast<int*>(__builtin_alloca(32 * sizeof(int)));
    for (unsigned i = 0; i < n; ++i) values[i] = i + 1;
    int result = 0;
    for (unsigned i = 0; i < n; ++i) result += values[i];
    return result;
}
int main() {
    for (unsigned n = 0; n <= 33; ++n)
        if (sum(n) != (n > 32 ? -1 : static_cast<int>(n * (n + 1) / 2))) return 1;
}
