machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_result
  storage data
  item i64 17

global @pair_result
  storage data
  item i64 0
  item i64 0

function @make_single
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-8]
    ret

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 29
    store.i64 [rbp-8], 31
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @make_single [args=()]
    mov r11, @single_result
    store.i64 [r11], rax
    call @make_pair [args=()]
    mov r11, @pair_result
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    load.i64 r8, @single_result
    load.i64 r9, @pair_result
    mov rdi, @pair_result
    lea rdi, [rdi+8]
    load.i64 rsi, [rdi]
    mov rdx, 23
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 29
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 31
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    or r9, rsi
    or r8, r9
    mov rax, r8
    sext.i32 rax
    ret rax
