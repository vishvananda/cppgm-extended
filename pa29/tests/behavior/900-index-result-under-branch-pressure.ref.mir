machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @byte
  storage scalar u8
  init u8 42

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @source
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @pressure
  abi
    param %high -> rdi : i64
    param %enter -> rsi : i64
    param %offset -> rdx : i64
    param %a -> rcx : i64
    param %b -> r8 : i64
    param %c -> r9 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %offset -> [rbp-8] : i64
    param-slot %a -> [rbp-16] : i64
    param-slot %b -> [rbp-24] : i64
    param-slot %c -> [rbp-32] : i64
    temp %sib_ab -> [rbp-40] : i64
    temp %sib_bc -> [rbp-48] : i64
    temp %q5 -> [rbp-40] : i64
    temp %q6 -> [rbp-48] : i64
    temp %q7 -> [rbp-56] : i64

  block ^entry
    store.i64 [rbp-8], rdx
    store.i64 [rbp-16], rcx
    store.i64 [rbp-24], r8
    store.i64 [rbp-32], r9
    cmp.i64 rdi, 0
    jne ^high_pressure
    jmp ^select

  block ^select
    cmp.i64 rsi, 0
    jne ^compute
    jmp ^sibling_setup

  block ^sibling_setup
    mov rbx, rcx
    add rbx, r8
    store.i64 [rbp-40], rbx
    mov rbx, r8
    add rbx, r9
    store.i64 [rbp-48], rbx
    jmp ^sibling_use

  block ^compute
    mov r8, rdx
    add r8, 0
    mov rbx, @byte
    add rbx, r8
    call @touch [args=()]
    load.i8 r8, [rbx]
    mov r9, r8
    zext.i8 r9
    load.i64 r8, [rbp-16]
    add r8, [rbp-24]
    add r8, [rbp-32]
    add r9, r8
    ret r9

  block ^sibling_use
    load.i64 r8, [rbp-40]
    add r8, [rbp-16]
    load.i64 r9, [rbp-48]
    add r9, [rbp-32]
    add r8, r9
    ret r8

  block ^high_pressure
    mov rdi, 1
    call @source [args=(rdi)]
    mov rbx, rax
    mov rdi, 2
    call @source [args=(rdi)]
    mov r12, rax
    mov rdi, 3
    call @source [args=(rdi)]
    mov r13, rax
    mov rdi, 4
    call @source [args=(rdi)]
    mov r14, rax
    mov rdi, 5
    call @source [args=(rdi)]
    mov r15, rax
    mov rdi, 6
    call @source [args=(rdi)]
    store.i64 [rbp-40], r15
    mov r15, rax
    mov rdi, 7
    call @source [args=(rdi)]
    store.i64 [rbp-48], r15
    mov r15, rax
    mov rdi, 8
    call @source [args=(rdi)]
    store.i64 [rbp-56], r15
    mov r15, rax
    call @touch [args=()]
    add rbx, r12
    add r13, r14
    load.i64 r8, [rbp-40]
    add r8, [rbp-48]
    load.i64 r9, [rbp-56]
    add r9, r15
    add rbx, r13
    add r8, r9
    add rbx, r8
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %actual -> [rbp-8] : i64

  block ^entry
    mov rdi, 0
    mov rsi, 1
    mov rdx, 0
    mov rcx, 1
    mov r8, 2
    mov r9, 3
    call @pressure [args=(rcx,rdx,rsi,rdi,r8,r9)]
    store.i64 [rbp-8], rax
    load.i64 r8, [rbp-8]
    mov rdx, 48
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
