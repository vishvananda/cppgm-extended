machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %gate -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13
    param-slot %c -> [rbp-8] : i64
    param-slot %d -> [rbp-16] : i64
    param-slot %gate -> [rbp-24] : i64
    slot $selected -> [rbp-32] : i64

  block ^entry
    store.i64 [rbp-8], rdx
    store.i64 [rbp-16], rcx
    load.i64 rax, [rbp+16]
    store.i64 [rbp-24], rax
    load.i64 rax, [rbp-24]
    cmp.i64 rax, 0
    jne ^compare
    jmp ^short

  block ^compare
    mov rbx, rdi
    and rbx, 7
    mov r12, 4
    cmp.i64 r12, rbx
    setbe r12
    movzx r12, r12
    store.i64 [rbp-32], r12
    jmp ^merge

  block ^short
    store.i64 [rbp-32], 0
    jmp ^merge

  block ^merge
    load.i64 rbx, [rbp-32]
    mov r12, rdi
    add r12, rsi
    mov r13, rdx
    add r13, rcx
    add r8, r9
    add r12, r13
    add r12, r8
    add r12, rbx
    ret r12

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %actual -> [rbp-8] : i64

  block ^entry
    sub rsp, 16
    mov rdi, 6
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 1
    store.i64 [rsp], r11
    call @pressure [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-8], rax
    load.i64 r8, [rbp-8]
    mov rdx, 27
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
