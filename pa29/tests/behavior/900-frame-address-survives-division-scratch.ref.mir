machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $bytes -> [rbp-8] : obj<8x1>

  block ^entry
    store.i8 [rbp-8], 65
    mov r8, 200
    mov rcx, 100
    mov rax, r8
    mov rdx, 0
    div rcx
    mov r8, rax
    mov r9, r8
    sext.i8 r9
    store.i8 [rbp-7], r9
    load.i8 r8, [rbp-7]
    mov r9, r8
    zext.i8 r9
    sext.i32 r9
    mov rdx, 2
    cmp.i32 r9, rdx
    sete r9
    movzx r9, r9
    cmp.i32 r9, 0
    sete rax
    movzx rax, rax
    ret rax
