machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @return_one
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @loop_sum
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14
    slot $storage -> [rbp-16] : obj<16x8>
    slot $current -> [rbp-24] : i64

  block ^entry
    mov r14, rdi
    mov r13, rsi
    mov r12, rdx
    mov rbx, rcx
    store.i64 [rbp-8], 7
    store.i64 [rbp-24], 0
    jmp ^loop_condition

  block ^loop_condition
    cmp.i64 [rbp-24], 3
    jl ^loop_body
    jmp ^loop_end

  block ^loop_body
    call @return_one [args=()]
    mov r8, rax
    cmp.i64 r8, 1
    je ^loop_step
    jmp ^failure

  block ^loop_step
    load.i64 r8, [rbp-24]
    add r8, 1
    store.i64 [rbp-24], r8
    jmp ^loop_condition

  block ^loop_end
    add r14, r13
    add r12, rbx
    mov r8, r14
    add r8, r12
    load.i64 r9, [rbp-8]
    add r8, r9
    ret r8

  block ^failure
    mov rax, -1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    call @loop_sum [args=(rcx,rdx,rsi,rdi)]
    mov rdx, 107
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
