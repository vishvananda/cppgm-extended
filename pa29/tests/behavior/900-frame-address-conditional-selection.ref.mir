machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dynamic_four
  abi
    param %seed -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 3
    ret rdi

function @select_smaller
  abi
    param %seed -> rdi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $left_value -> [rbp-8] : i64
    slot $right_value -> [rbp-16] : i64
    slot $selected_address -> [rbp-24] : ptr
    temp %left -> [rbp-32] : ptr

  block ^entry
    store.i64 [rbp-8], 8
    lea rbx, [rbp-8]
    store.ptr [rbp-32], rbx
    call @dynamic_four [args=(rdi)]
    store.i64 [rbp-16], rax
    lea r8, [rbp-16]
    load.i64 r9, [r8]
    load.ptr rcx, [rbp-32]
    cmp.i64 r9, [rcx]
    jb ^select_right
    jmp ^select_left

  block ^select_right
    store.ptr [rbp-24], r8
    jmp ^selected

  block ^select_left
    load.ptr rax, [rbp-32]
    store.ptr [rbp-24], rax
    jmp ^selected

  block ^selected
    load.ptr r8, [rbp-24]
    load.i64 rax, [r8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    call @select_smaller [args=(rdi)]
    mov rdx, 4
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
