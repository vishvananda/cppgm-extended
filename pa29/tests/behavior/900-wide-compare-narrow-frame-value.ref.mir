machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @check
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $attempt -> [rbp-8] : i64
    slot $byte -> [rbp-9] : u8
    temp %narrow -> [rbp-10] : u8

  block ^entry
    store.i64 [rbp-8], 256
    store.u8 [rbp-9], 0
    load.u8 r8, [rbp-9]
    store.u8 [rbp-10], r8
    jmp ^test

  block ^test
    load.u8 rax, [rbp-10]
    cmp.i64 rax, 0
    je ^good
    jmp ^retry

  block ^retry
    cmp.i64 [rbp-8], 256
    je ^again
    jmp ^bad

  block ^again
    store.i64 [rbp-8], 257
    jmp ^test

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @check [args=()]
    ret rax
