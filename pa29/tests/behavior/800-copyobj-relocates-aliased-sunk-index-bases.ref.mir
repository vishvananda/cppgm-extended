machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @pair
  storage data
  item i64 0
  item i64 0

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @mark_two
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    store.i64 [rsi], 77
    ret

function @copy_then_mark_two
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $this -> [rbp-8] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    load.ptr r8, [rbp-8]
    load.ptr r9, [rbp-8]
    lea r9, [r9+8]
    mov rdi, @dest
    mov rsi, @source
    copy_bytes 24x8, rdi, rsi
    mov rdi, r8
    mov rsi, r9
    call @mark_two [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @pair
    mov rdi, rbx
    call @copy_then_mark_two [args=(rdi)]
    load.i64 r8, @pair
    load.i64 r9, [rbx+8]
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 77
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
