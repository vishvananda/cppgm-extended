machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dispatch
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r13 r14 r15
    param-slot %d -> [rbp-8] : i64
    slot $selector_word -> [rbp-16] : i64
    slot $poison_word -> [rbp-24] : i64
    temp %poison -> [rbp-28] : u32
    temp %selector -> [rbp-32] : u32

  block ^entry
    store.i64 [rbp-8], rcx
    mov rbx, rdx
    mov r13, r8
    mov r14, r9
    mov r9, rsi
    mov r15, rdi
    store.i64 [rbp-16], 4294967335
    store.i64 [rbp-24], 1
    load.u32 r8, [rbp-24]
    store.u32 [rbp-28], r8
    load.u32 r8, [rbp-16]
    store.u32 [rbp-32], r8
    jmp ^dispatch

  block ^dispatch
    mov r8, r15
    add r8, r9
    mov r9, rbx
    add r9, [rbp-8]
    mov rdi, r13
    add rdi, r14
    add r8, r9
    add r8, rdi
    load.u32 rax, [rbp-32]
    mov rcx, 39
    cmp.i64 rax, rcx
    je ^success
    load.u32 rcx, [rbp-28]
    cmp.i64 rax, rcx
    je ^failure
    jmp ^retry

  block ^retry
    jmp ^dispatch

  block ^success
    ret r8

  block ^failure
    mov rax, -1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @dispatch [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rdx, 21
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
