machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @calc
  abi
    param %x -> rdi : i64
    param %y -> rsi : i64
    param %scale -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, rdx
    mov rcx, rsi
    mov rax, rdi
    cqo
    idiv rcx
    mov rdi, rax
    imul r8, rdi
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 20
    mov rsi, 4
    mov rdx, 7
    call @calc [args=(rdx,rsi,rdi)]
    mov rdx, 35
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
