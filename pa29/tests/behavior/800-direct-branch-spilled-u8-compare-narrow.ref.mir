machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @probe
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %d -> rcx : ptr
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @clobber
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 144
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $value -> [rbp-24] : obj<24x8>
    slot $ud_suffix -> [rbp-48] : obj<24x8>
    slot $literal_type -> [rbp-52] : i32
    slot $call__1 -> [rbp-53] : u8
    slot $k0 -> [rbp-64] : i64
    slot $k1 -> [rbp-72] : i64
    slot $k2 -> [rbp-80] : i64
    slot $k3 -> [rbp-88] : i64
    slot $k4 -> [rbp-96] : i64
    temp %a0 -> [rbp-104] : i64
    temp %a1 -> [rbp-112] : i64
    temp %a2 -> [rbp-120] : i64
    temp %a3 -> [rbp-128] : i64
    temp %a4 -> [rbp-136] : i64

  block ^entry
    store.i32 [rbp-52], 1
    store.i64 [rbp-64], 10
    store.i64 [rbp-72], 11
    store.i64 [rbp-80], 12
    store.i64 [rbp-88], 13
    store.i64 [rbp-96], 14
    lea rdi, [rbp-24]
    lea rsi, [rbp-48]
    lea rdx, [rbp-52]
    lea rcx, [rbp-48]
    call @probe [args=(rcx,rdx,rsi,rdi)]
    store.u8 [rbp-53], rax
    load.i64 rbx, [rbp-64]
    store.i64 [rbp-104], rbx
    load.i64 rbx, [rbp-72]
    store.i64 [rbp-112], rbx
    load.i64 rbx, [rbp-80]
    store.i64 [rbp-120], rbx
    load.i64 rbx, [rbp-88]
    store.i64 [rbp-128], rbx
    load.i64 rbx, [rbp-96]
    store.i64 [rbp-136], rbx
    load.u8 rbx, [rbp-53]
    call @clobber [args=()]
    cmp.i64 rbx, 0
    je ^then
    jmp ^else

  block ^then
    load.i64 r8, [rbp-104]
    add r8, [rbp-112]
    load.i64 r9, [rbp-120]
    add r9, [rbp-128]
    add r8, r9
    add r8, [rbp-136]
    ret r8

  block ^else
    mov rax, 0
    ret rax
