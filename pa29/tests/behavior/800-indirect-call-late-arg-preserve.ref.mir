machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @box
  storage scalar i8
  init i8 7

global @strlit
  storage data
  item i8 0

global @dispatch readonly
  storage data
  item ptr addr @sink

global @g_num
  storage scalar i64
  init i64 0

global @g_type
  storage scalar i32
  init i32 0

global @g_nbytes
  storage scalar i64
  init i64 0

function @data
  abi
    param %this -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @size
  abi
    param %this -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @sink
  abi
    param %this -> rdi : ptr
    param %src -> rsi : ptr
    param %num -> rdx : i64
    param %type -> rcx : i32
    param %data -> r8 : ptr
    param %nbytes -> r9 : i64
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %type -> [rbp-4] : i32

  block ^entry
    store.i32 [rbp-4], rcx
    store.i64 @g_num, rdx
    store.i32 @g_type, rcx
    store.i64 @g_nbytes, r9
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rbx, @box
    mov rdi, rbx
    call @data [args=(rdi)]
    mov r12, rax
    mov rdi, rbx
    call @size [args=(rdi)]
    mov r8, rax
    load.ptr r9, @dispatch
    mov r10, r9
    mov rdi, rbx
    mov rsi, @strlit
    mov rdx, 1
    mov rcx, 13
    mov r9, r8
    mov r8, r12
    call *r10 [args=(rcx,rdx,rsi,rdi,r8,r9)]
    cmp.i64 @g_num, 1
    je ^rhs
    jmp ^short

  block ^rhs
    load.i32 r8, @g_type
    mov rdx, 13
    cmp.i32 r8, rdx
    sete r8
    movzx r8, r8
    cmp.i64 r8, 0
    jne ^rhs2
    jmp ^short

  block ^rhs2
    load.i64 r8, @g_nbytes
    mov rdx, 1
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    cmp.i64 r8, 0
    setne rax
    movzx rax, rax
    ret rax

  block ^short
    mov rax, 0
    ret rax
