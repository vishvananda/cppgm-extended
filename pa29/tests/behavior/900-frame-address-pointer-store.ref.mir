machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $backing -> [rbp-16] : obj<16x8>
    slot $saved -> [rbp-24] : ptr

  block ^entry
    lea rbx, [rbp-16]
    store.i64 [rbx], 1
    call @touch [args=()]
    store.ptr [rbp-24], rbx
    load.ptr r8, [rbp-24]
    cmp.ptr r8, rbx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
