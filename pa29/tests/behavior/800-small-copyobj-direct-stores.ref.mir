machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @src24
  storage data
  item i64 11
  item i64 22
  item i64 33

global @dst24
  storage data
  item zero 24

global @src7
  storage data
  item i32 100
  item i16 200
  item i8 50

global @dst7
  storage data
  item zero 8

global @src33
  storage data
  item i64 1
  item i64 2
  item i64 3
  item i64 4
  item i8 5

global @dst33
  storage data
  item zero 33

function @copy_all
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @dst24
    mov rsi, @src24
    copy_bytes 24x8, rdi, rsi
    mov rdi, @dst7
    mov rsi, @src7
    copy_bytes 7x1, rdi, rsi
    mov rdi, @dst33
    mov rsi, @src33
    copy_bytes 33x1, rdi, rsi
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    call @copy_all [args=()]
    load.i64 r8, @dst24
    mov r9, @dst24
    lea r9, [r9+8]
    load.i64 rdi, [r9]
    mov r9, @dst24
    lea r9, [r9+16]
    load.i64 rsi, [r9]
    add r8, rdi
    add r8, rsi
    load.u32 r9, @dst7
    mov rdi, @dst7
    lea rdi, [rdi+4]
    load.u16 rsi, [rdi]
    mov rdi, @dst7
    lea rdi, [rdi+6]
    load.u8 rbx, [rdi]
    mov rdi, r9
    zext.i32 rdi
    mov r9, rsi
    zext.i16 r9
    mov rsi, rbx
    zext.i8 rsi
    add r8, rdi
    add r8, r9
    add r8, rsi
    load.i64 r9, @dst33
    mov rdi, @dst33
    lea rdi, [rdi+8]
    load.i64 rsi, [rdi]
    mov rdi, @dst33
    lea rdi, [rdi+16]
    load.i64 rbx, [rdi]
    mov rdi, @dst33
    lea rdi, [rdi+24]
    load.i64 r12, [rdi]
    mov rdi, @dst33
    lea rdi, [rdi+32]
    load.u8 r13, [rdi]
    mov rdi, r13
    zext.i8 rdi
    add r8, r9
    add r8, rsi
    add r8, rbx
    add r8, r12
    add r8, rdi
    cmp.i64 r8, 431
    setne rax
    movzx rax, rax
    ret rax
