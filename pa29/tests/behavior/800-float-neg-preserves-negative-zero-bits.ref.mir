machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $box -> [rbp-8] : f64

  block ^entry
    fmov.f64 xmm0, 0.0
    fneg.f64 xmm1, xmm0
    fmov.f64 [rbp-8], xmm1
    load.i64 r8, [rbp-8]
    mov rdx, -9223372036854775808
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
