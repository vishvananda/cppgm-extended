machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @increment
  abi
    param %cell -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i32 r8, [rdi]
    add r8, 1
    sext.i32 r8
    store.i32 [rdi], r8
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $counter -> [rbp-8] : obj<8x4>

  block ^entry
    store.i32 [rbp-8], 0
    jmp ^loop_condition

  block ^loop_condition
    load.i32 r8, [rbp-8]
    cmp.i32 r8, 5
    jge ^loop_end
    jmp ^loop_body

  block ^loop_body
    lea rdi, [rbp-8]
    call @increment [args=(rdi)]
    jmp ^loop_condition

  block ^loop_end
    load.i32 r8, [rbp-8]
    cmp.i32 r8, 5
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
