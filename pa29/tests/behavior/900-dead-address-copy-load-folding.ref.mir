machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 25

function @identity
  abi
    param %address -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @values
    lea r8, [r8+8]
    mov rdi, r8
    call @identity [args=(rdi)]
    load.i64 r8, [rax]
    load.i64 r9, @values
    add r9, r8
    mov rdx, 42
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rax, r9
    sext.i32 rax
    ret rax
