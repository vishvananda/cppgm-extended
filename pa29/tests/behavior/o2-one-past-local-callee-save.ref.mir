machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues direct
    slot $bytes -> [rbp-16] : obj<16x1>

  block ^entry
    call @noop [args=()]
    lea r9, [rbp-16]
    lea r8, [r9+16]
    sub r8, r9
    add r8, 7
    mov rdx, 23
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
