machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @good
  storage scalar i64
  init i64 0

function @mark
  abi
    param %target -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    ret

function @copy_then_mark
  abi
    param %target -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, rdi
    mov rdi, @dest
    mov rsi, @source
    copy_bytes 24x8, rdi, rsi
    mov rdi, r8
    call @mark [args=(rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rdi, @good
    call @copy_then_mark [args=(rdi)]
    load.i64 r8, @good
    load.i64 r9, @dest
    mov rdi, @dest
    lea rdi, [rdi+8]
    load.i64 rsi, [rdi]
    mov rdi, @dest
    lea rdi, [rdi+16]
    load.i64 rbx, [rdi]
    mov rdi, @dest
    lea rdi, [rdi+24]
    load.i64 r12, [rdi]
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 11
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 22
    cmp.i64 rsi, rdx
    sete rsi
    movzx rsi, rsi
    mov rdx, 33
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    mov rdx, 0
    cmp.i64 r12, rdx
    sete r12
    movzx r12, r12
    and r8, r9
    and rsi, rbx
    and r8, rsi
    and r8, r12
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
