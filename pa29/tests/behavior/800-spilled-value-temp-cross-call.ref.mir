machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 7

global @bad
  storage scalar i64
  init i64 13

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %wrong -> r8 : ptr
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @return_saved
  abi
    param %target -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    param %e -> r9 : i64
    param %f -> [rbp+16] : i64
    param %g -> [rbp+24] : i64
    param %h -> [rbp+32] : i64
    return ptr -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    param-slot %f -> [rbp-8] : i64
    param-slot %g -> [rbp-16] : i64
    param-slot %h -> [rbp-24] : i64
    slot $saved -> [rbp-32] : ptr

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-8], rax
    load.i64 rax, [rbp+24]
    store.i64 [rbp-16], rax
    load.i64 rax, [rbp+32]
    store.i64 [rbp-24], rax
    store.ptr [rbp-32], rdi
    jmp ^after

  block ^after
    load.ptr rbx, [rbp-32]
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, @bad
    call @clobber [args=(rcx,rdx,rsi,rdi,r8)]
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @good
    sub rsp, 32
    mov rdi, rbx
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    mov r11, 7
    store.i64 [rsp+8], r11
    mov r11, 8
    store.i64 [rsp+16], r11
    call @return_saved [args=(rcx,rdx,rsi,rdi,r8,r9), stack=32]
    add rsp, 32
    mov r8, rax
    mov r9, r8
    cmp.ptr r9, rbx
    sete r9
    movzx r9, r9
    load.i64 rdi, [r8]
    mov rdx, 7
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    and r9, rdi
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rax, r9
    sext.i32 rax
    ret rax
