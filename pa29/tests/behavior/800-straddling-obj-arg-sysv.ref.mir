machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @read_pair
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %pair -> [rbp+16] : i64
    param %pair -> [rbp+24] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64
    param-slot %pair -> [rbp-56] : obj<16x8>

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    load.i64 rax, [rbp+16]
    store.i64 [rbp-56], rax
    load.i64 rax, [rbp+24]
    store.i64 [rbp-48], rax
    load.i64 r8, [rbp-56]
    add r8, [rbp-48]
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $pair -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 100
    store.i64 [rbp-8], 23
    sub rsp, 16
    lea rdi, [rsp]
    lea rsi, [rbp-16]
    copy_bytes 16x8, rdi, rsi
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @read_pair [args=(rcx,rdx,rsi,rdi,r8), stack=16]
    add rsp, 16
    mov rdx, 123
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
