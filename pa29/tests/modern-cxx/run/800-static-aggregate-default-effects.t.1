// Nonconstant aggregate defaults run once in member/element order; explicit values suppress them.
int calls;
int next() { return ++calls; }
struct Data { int seed = next(); int value = seed + 10; };
Data rows[3] = {{20}, {}};
int main() {
 if (calls != 2) return 1;
 if (rows[0].seed != 20 || rows[0].value != 30) return 2;
 if (rows[1].seed != 1 || rows[1].value != 11 || rows[2].seed != 2 || rows[2].value != 12) return 3;
 return 0;
}
