declare function @malloc(%arg0 : i64) -> ptr [noalias_result=yes, linkage=c, binding=strong]
declare function @memcpy(%arg0 : ptr, %arg1 : ptr, %arg2 : i64) -> ptr [linkage=c, binding=strong]
declare function @free(%arg0 : ptr) -> void [linkage=c, binding=strong]

function @sum(%count : i32) -> i32 [arity=variadic, linkage=c, binding=internal] {
  slot $count : i32
  slot $args : obj<24x8>
  slot $result : i32

  block ^entry:
    store typed i32 %count, $count
    %t1 = addr $args
    va_start %t1
    store typed i32 0, $result
    jump ^while_cond_1

  block ^while_cond_1:
    %t2 = load typed i32 $count
    %t3 = binary sub nowrap i32 %t2, 1
    store typed i32 %t3, $count
    branch %t2, ^while_body_2, ^while_end_3

  block ^while_body_2:
    %t4 = addr $args
    %t5 = va_arg i32 %t4
    %t6 = load typed i32 $result
    %t7 = binary add nowrap i32 %t6, %t5
    store typed i32 %t7, $result
    jump ^while_cond_1

  block ^while_end_3:
    %t8 = addr $args
    %t9 = load typed i32 $result
    return i32 %t9
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $data : ptr
  slot $copy : obj<12x4>
  slot $okay : u8
  slot $land__1 : i64
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = const i64 4
    %t2 = convert sext i64 i32 3
    %t3 = binary mul i64 %t2, %t1
    %t4 = call ptr @malloc(%t3)
    store typed ptr %t4, $data
    %t5 = load typed ptr $data
    %t6 = cmp eq ptr %t5, 0
    %t7 = convert trunc i32 i64 %t6
    branch %t7, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t8 = load typed ptr $data
    %t9 = index inbounds u32 [projection=array_element] %t8, 0
    store typed u32 17, %t9
    %t10 = load typed ptr $data
    %t11 = index inbounds u32 [projection=array_element] %t10, 1
    store typed u32 29, %t11
    %t12 = load typed ptr $data
    %t13 = index inbounds u32 [projection=array_element] %t12, 2
    store typed u32 42, %t13
    %t14 = addr $copy
    %t15 = load typed ptr $data
    %t16 = const i64 12
    %t17 = call ptr @memcpy(%t14, %t15, %t16)
    %t18 = load typed ptr $data
    call void @free(%t18)
    %t19 = cmp ne i32 1, 0
    %t20 = convert trunc u8 i64 %t19
    store typed u8 %t20, $okay
    %t21 = load typed u8 $okay
    branch %t21, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t22 = addr $copy
    %t23 = index inbounds u32 [projection=array_element] %t22, 1
    %t24 = load typed u32 %t23
    %t25 = cmp eq u32 %t24, 29
    %t26 = convert trunc i32 i64 %t25
    %t27 = cmp ne i32 %t26, 0
    store typed i64 %t27, $land__1
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__1
    jump ^land_end_6

  block ^land_end_6:
    %t28 = load typed i64 $land__1
    branch %t28, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t29 = addr $copy
    %t30 = index inbounds u32 [projection=array_element] %t29, 2
    %t31 = load typed u32 %t30
    %t32 = cmp eq u32 %t31, 42
    %t33 = convert trunc i32 i64 %t32
    %t34 = cmp ne i32 %t33, 0
    store typed i64 %t34, $land__2
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__2
    jump ^land_end_9

  block ^land_end_9:
    %t35 = load typed i64 $land__2
    branch %t35, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t36 = convert sext i32 i8 1
    %t37 = convert sext i32 i16 2
    %t38 = call i32 @sum(3, %t36, %t37, 3)
    %t39 = cmp eq i32 %t38, 6
    %t40 = convert trunc i32 i64 %t39
    %t41 = cmp ne i32 %t40, 0
    store typed i64 %t41, $land__3
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__3
    jump ^land_end_12

  block ^land_end_12:
    %t42 = load typed i64 $land__3
    %t43 = convert trunc i32 i64 %t42
    %t44 = cmp eq i32 %t43, 0
    %t45 = convert trunc i32 i64 %t44
    return i32 %t45
}
