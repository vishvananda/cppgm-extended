global @zero : i32 [linkage=c, binding=strong] = zero
global @initialized : i32 [linkage=c, binding=strong] = 9
global @local : i32 [linkage=c, binding=internal] = zero
global @constant_zero : i32 [storage=readonly, linkage=c, binding=strong] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $unused : i32
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $lor__4 : i64

  block ^entry:
    %t1 = load typed i32 @zero
    branch %t1, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t2 = load typed i32 @initialized
    %t3 = cmp ne i32 %t2, 9
    %t4 = convert trunc i32 i64 %t3
    %t5 = cmp ne i32 %t4, 0
    store typed i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load typed i64 $lor__1
    branch %t6, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t7 = load typed i32 @local
    %t8 = cmp ne i32 %t7, 0
    store typed i64 %t8, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t9 = load typed i64 $lor__2
    branch %t9, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t10 = load typed i32 @constant_zero
    %t11 = cmp ne i32 %t10, 0
    store typed i64 %t11, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t12 = load typed i64 $lor__3
    branch %t12, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t13 = const i64 4
    %t14 = const i64 4
    %t15 = cmp ne i64 %t13, %t14
    %t16 = convert trunc i32 i64 %t15
    %t17 = cmp ne i32 %t16, 0
    store typed i64 %t17, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t18 = load typed i64 $lor__4
    %t19 = convert trunc i32 i64 %t18
    return i32 %t19
}
