global @Item : i32 [linkage=c, binding=strong] = 17
global @Color : i32 [linkage=c, binding=strong] = 9

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $second : obj<16x8>
  slot $first : obj<16x8>
  slot $color : i32
  slot $alias : obj<4x4>
  slot $bits : obj<4x4>
  slot $assigned : i32
  slot $stepped : i32
  slot $signed_value : i32
  slot $land__1 : i64
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64
  slot $land__7 : i64
  slot $land__8 : i64

  block ^entry:
    %t1 = addr $second
    %t2 = addr $second
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $second
    %t5 = index inbounds i8 [projection=field] %t4, 8
    store typed ptr 0, %t5
    %t6 = addr $first
    %t7 = addr $first
    %t8 = index inbounds i8 [projection=field] %t7, 0
    store typed i32 3, %t8
    %t9 = addr $second
    %t10 = addr $first
    %t11 = index inbounds i8 [projection=field] %t10, 8
    store typed ptr %t9, %t11
    store typed i32 1, $color
    %t12 = addr $alias
    %t13 = addr $alias
    %t14 = index inbounds i8 [projection=field] %t13, 0
    store typed i32 5, %t14
    %t15 = addr $bits
    %t16 = addr $bits
    %t17 = index inbounds i8 [projection=field] %t16, 0
    %t18 = binary and u32 7, 0
    store u32 %t18, %t17
    %t19 = addr $bits
    %t20 = index inbounds i8 [projection=field] %t19, 0
    %t21 = binary and i32 7, 0
    %t22 = binary shl i32 %t21, 3
    %t23 = load i32 %t20
    %t24 = binary and i32 %t23, -57
    %t25 = binary or i32 %t24, %t22
    store i32 %t25, %t20
    %t26 = addr $bits
    %t27 = index inbounds i8 [projection=field] %t26, 0
    %t28 = binary and i32 11, 7
    %t29 = copy u32 %t28
    %t30 = load i32 %t27
    %t31 = binary and i32 %t30, -8
    %t32 = binary or i32 %t31, %t28
    store i32 %t32, %t27
    %t33 = copy i32 %t29
    store typed i32 %t33, $assigned
    %t34 = addr $bits
    %t35 = index inbounds i8 [projection=field] %t34, 0
    %t36 = load i32 %t35
    %t37 = binary and i32 %t36, 7
    %t38 = copy u32 %t37
    %t39 = copy i32 %t38
    %t40 = binary add nowrap i32 %t39, 1
    %t41 = addr $bits
    %t42 = index inbounds i8 [projection=field] %t41, 0
    %t43 = binary and i32 %t40, 7
    %t44 = copy u32 %t43
    %t45 = load i32 %t42
    %t46 = binary and i32 %t45, -8
    %t47 = binary or i32 %t46, %t43
    store i32 %t47, %t42
    %t48 = copy i32 %t44
    store typed i32 %t48, $stepped
    %t49 = addr $bits
    %t50 = index inbounds i8 [projection=field] %t49, 0
    %t51 = unary neg i32 2
    %t52 = binary and i32 %t51, 7
    %t53 = binary shl i32 %t52, 29
    %t54 = binary shr i32 %t53, 29
    %t55 = binary shl i32 %t52, 3
    %t56 = load i32 %t50
    %t57 = binary and i32 %t56, -57
    %t58 = binary or i32 %t57, %t55
    store i32 %t58, %t50
    store typed i32 %t54, $signed_value
    %t59 = load typed i32 @Item
    %t60 = cmp eq i32 %t59, 17
    %t61 = convert trunc i32 i64 %t60
    branch %t61, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t62 = load typed i32 @Color
    %t63 = cmp eq i32 %t62, 9
    %t64 = convert trunc i32 i64 %t63
    %t65 = cmp ne i32 %t64, 0
    store typed i64 %t65, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t66 = load typed i64 $land__1
    branch %t66, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t67 = load typed i32 $color
    %t68 = cmp eq i32 %t67, 1
    %t69 = convert trunc i32 i64 %t68
    %t70 = cmp ne i32 %t69, 0
    store typed i64 %t70, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t71 = load typed i64 $land__2
    branch %t71, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t72 = addr $first
    %t73 = index inbounds i8 [projection=field] %t72, 8
    %t74 = load typed ptr %t73
    %t75 = index inbounds i8 [projection=field] %t74, 0
    %t76 = load typed i32 %t75
    %t77 = cmp eq i32 %t76, 7
    %t78 = convert trunc i32 i64 %t77
    %t79 = cmp ne i32 %t78, 0
    store typed i64 %t79, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t80 = load typed i64 $land__3
    branch %t80, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t81 = addr $alias
    %t82 = index inbounds i8 [projection=field] %t81, 0
    %t83 = load typed i32 %t82
    %t84 = cmp eq i32 %t83, 5
    %t85 = convert trunc i32 i64 %t84
    %t86 = cmp ne i32 %t85, 0
    store typed i64 %t86, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t87 = load typed i64 $land__4
    branch %t87, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t88 = load typed i32 $assigned
    %t89 = cmp eq i32 %t88, 3
    %t90 = convert trunc i32 i64 %t89
    %t91 = cmp ne i32 %t90, 0
    store typed i64 %t91, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store typed i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t92 = load typed i64 $land__5
    branch %t92, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t93 = load typed i32 $stepped
    %t94 = cmp eq i32 %t93, 4
    %t95 = convert trunc i32 i64 %t94
    %t96 = cmp ne i32 %t95, 0
    store typed i64 %t96, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store typed i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t97 = load typed i64 $land__6
    branch %t97, ^land_rhs_19, ^land_short_20

  block ^land_rhs_19:
    %t98 = addr $bits
    %t99 = index inbounds i8 [projection=field] %t98, 0
    %t100 = load i32 %t99
    %t101 = binary and i32 %t100, 7
    %t102 = copy u32 %t101
    %t103 = copy i32 %t102
    %t104 = cmp eq i32 %t103, 4
    %t105 = convert trunc i32 i64 %t104
    %t106 = cmp ne i32 %t105, 0
    store typed i64 %t106, $land__7
    jump ^land_end_21

  block ^land_short_20:
    store typed i64 0, $land__7
    jump ^land_end_21

  block ^land_end_21:
    %t107 = load typed i64 $land__7
    branch %t107, ^land_rhs_22, ^land_short_23

  block ^land_rhs_22:
    %t108 = load typed i32 $signed_value
    %t109 = unary neg i32 2
    %t110 = cmp eq i32 %t108, %t109
    %t111 = convert trunc i32 i64 %t110
    %t112 = cmp ne i32 %t111, 0
    store typed i64 %t112, $land__8
    jump ^land_end_24

  block ^land_short_23:
    store typed i64 0, $land__8
    jump ^land_end_24

  block ^land_end_24:
    %t113 = load typed i64 $land__8
    %t114 = convert trunc i32 i64 %t113
    %t115 = cmp eq i32 %t114, 0
    %t116 = convert trunc i32 i64 %t115
    return i32 %t116
}
