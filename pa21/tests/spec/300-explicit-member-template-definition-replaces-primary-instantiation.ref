  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
function @Owner_int___member(%this : ptr, %__param1 : i32) -> i32 [binding=weak, object=_ZN5OwnerIiE6memberIiEEiT_] {
