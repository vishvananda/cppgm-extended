global @instantiated [binding=strong, object=_Z12instantiated] = {
  zero 1
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $owner : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $owner
    %t2 = addr $owner
    %t3 = call i32 @Owner_int___member(%t2, 3)
    %t4 = cmp eq i32 %t3, 2
