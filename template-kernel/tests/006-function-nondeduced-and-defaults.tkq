template_kernel_v1

function_template same pair <type T> params (type T, type nondeduced<T>) return int
function_template wrap reuse_default <type T, type U = type T> params (type T, type nondeduced<U>) return int
function_template gate int_only <type T> params (type T) return int when same(T, int)

query deduce_call same args (type int, type int)
query deduce_call same args (type int, type char)
query deduce_call wrap args (type char, type char)
query deduce_call gate args (type int)
query deduce_call gate args (type char)
