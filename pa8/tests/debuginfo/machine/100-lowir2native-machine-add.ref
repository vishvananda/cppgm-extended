machine_ir x86_64 linux

startup
    call @main [args=(rdi)]
    mov rdi, rax
    exit

function @main
  abi
    param %value -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add.i32 rdi, 2 !dbg(tests/debuginfo/machine/100-lowir2native-machine-add.t, 3, 10)
    ret rdi
