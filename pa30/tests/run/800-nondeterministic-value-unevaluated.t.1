// The result is some value of the operand's type; a widening shuffle keeps
// the known lanes.
typedef long long Q2 __attribute__((vector_size(16)));
typedef long long Q4 __attribute__((vector_size(32)));

static int calls;

static int next() { return ++calls; }

static Q2 make()
{
	++calls;
	const Q2 q = {7, 8};
	return q;
}

int main()
{
	const int value = __builtin_nondeterministic_value(next());
	(void)value;
	const Q2 q = {5, 6};
	const Q4 wide = __builtin_shufflevector(q, __builtin_nondeterministic_value(make()), 0, 1, 2, 3);
	if (wide[0] != 5 || wide[1] != 6)
		return 1;
	return calls;
}
