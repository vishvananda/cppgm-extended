using V=int __attribute__((vector_size(16)));
V unary(V a,V m){return __builtin_shuffle(a,m);}
V paired(V a,V b,V m){return __builtin_shuffle(a,b,m);}
int main(){V a={1,2,3,4},b={5,6,7,8};for(int n=-128;n<128;++n){V m={n,n+1,n+7,n-3};V x=unary(a,m),y=paired(a,b,m);for(int i=0;i<4;++i){unsigned k=static_cast<unsigned>(m[i]);if(x[i]!=a[k&3])return 1;unsigned j=k&7;if(y[i]!=(j<4?a[j]:b[j-4]))return 2;}}return 0;}
