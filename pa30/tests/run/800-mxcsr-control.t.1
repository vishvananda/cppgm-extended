#include <xmmintrin.h>
extern "C" unsigned host_mxcsr();
int main() {
    const unsigned original = _mm_getcsr();
    int result = 0;
    for (unsigned mode = 0; mode != 4; ++mode) {
        const unsigned next = ((original ^ 0x8000u) & ~0x6000u) | (mode << 13);
        _mm_setcsr(next);
        if (_mm_getcsr() != next || host_mxcsr() != next) result = 1;
    }
    _mm_setcsr(original);
    return result || host_mxcsr() != original;
}
