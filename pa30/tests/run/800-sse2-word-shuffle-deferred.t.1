#include <emmintrin.h>
template<int N> __attribute__((always_inline))inline __m128i low(__m128i value){return _mm_shufflelo_epi16(value,N);}
template<int N> __attribute__((always_inline))inline __m128i high(__m128i value){return _mm_shufflehi_epi16(value,N);}
int main(){
 short data[8]={1,2,3,4,5,6,7,8},out[8];
 __m128i value=_mm_loadu_si128(reinterpret_cast<const __m128i*>(data));
 _mm_storeu_si128(reinterpret_cast<__m128i*>(out),high<0x1b>(low<0x1b>(value)));
 for(int i=0;i<8;++i)if(out[i]!=data[i<4?3-i:11-i])return 1;
 return 0;
}
