function @store_n(%p : ptr, %v : i32, %order : i32) -> void [binding=strong, object=_Z7store_nPiii] {
  slot $p : ptr
  slot $v : i32
  slot $order : i32

  block ^entry:
    store typed ptr %p, $p
    store typed i32 %v, $v
    store typed i32 %order, $order
    %t1 = load typed ptr $p
    %t2 = load typed i32 $v
    %t3 = load typed i32 $order
    %t4 = cmp ult i32 %t3, 5
    branch %t4, ^order_weak_1, ^order_seq_cst_2

  block ^order_weak_1:
    atomic_store i32 %t2, %t1, 3
    jump ^order_end_3

  block ^order_seq_cst_2:
    atomic_store i32 %t2, %t1, 5
    jump ^order_end_3

  block ^order_end_3:
    return void
}
function @store_generic(%p : ptr, %v : ptr, %order : i32) -> void [binding=strong, object=_Z13store_genericPlS_i] {
  slot $p : ptr
  slot $v : ptr
  slot $order : i32

  block ^entry:
    store typed ptr %p, $p
    store typed ptr %v, $v
    store typed i32 %order, $order
    %t1 = load typed ptr $p
