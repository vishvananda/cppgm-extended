global @destroyed : i32 [binding=strong, object=_Z9destroyed] = zero

function @destroy_const(%p : ptr) -> void [binding=strong, object=_Z13destroy_constPK5value] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    call void @value___value(%t1)
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    return i32 0
}
function @value___value(%this : ptr) -> void [binding=weak, object=_ZN5valueD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @destroyed
    %t2 = binary add i32 %t1, 3
    store i32 %t2, @destroyed
    return void
}
alias object _ZN5valueD2Ev = @value___value
