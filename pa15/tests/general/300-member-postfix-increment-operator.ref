    %t5 = index i8 [projection=field] %t4, 4
    store i32 3, %t5
    %t6 = addr $c
    %t7 = call i32 @Counter__operator__(%t6, 0)
    store i32 %t7, $old
    %t8 = load i32 $old
    %t9 = cmp eq i32 %t8, 7
    branch %t9, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t10 = addr $c
