  block ^land_end_9:
    %t15 = load i64 $land__3
    branch %t15, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t16 = addr $c
    %t17 = index i8 [projection=field] %t16, 4
    %t18 = load i32 %t17
    %t19 = cmp eq i32 %t18, 3
    %t20 = cmp ne i64 %t19, 0
    store i64 %t20, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t21 = load i64 $land__2
    branch %t21, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
