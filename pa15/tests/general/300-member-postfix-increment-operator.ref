    %t7 = load ptr $this
    %t8 = index i8 [projection=field] %t7, 4
    %t9 = load i32 %t8
    %t10 = binary add i32 %t6, %t9
    %t11 = load ptr $this
    %t12 = index i8 [projection=field] %t11, 0
