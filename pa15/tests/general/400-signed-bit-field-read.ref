function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $bits : obj<4x4>

  block ^entry:
    %t1 = addr $bits
    %t2 = unary neg i32 1
    %t3 = binary and i32 7, %t2
    %t4 = addr $bits
    %t5 = index i8 [projection=field] %t4, 0
    store i32 %t3, %t5
    %t6 = addr $bits
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load i32 %t7
    %t9 = binary and i32 %t8, 7
    return i32 %t9
}
