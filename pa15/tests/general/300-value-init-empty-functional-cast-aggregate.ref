function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<32x8>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr $value
    store i64 0, %t1
    %t2 = index i8 %t1, 8
    store i64 0, %t2
    %t3 = index i8 %t1, 16
    store i64 0, %t3
    %t4 = index i8 %t1, 24
    store i64 0, %t4
    %t5 = addr $value
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load ptr %t6
    %t8 = cmp eq ptr %t7, 0
    branch %t8, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t9 = addr $value
    %t10 = index i8 [projection=field] %t9, 8
    %t11 = load u32 %t10
    %t12 = cmp eq u32 %t11, 0
    %t13 = cmp ne i64 %t12, 0
    store i64 %t13, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t14 = load i64 $land__4
    branch %t14, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t15 = addr $value
    %t16 = index i8 [projection=field] %t15, 16
    %t17 = load ptr %t16
    %t18 = cmp eq ptr %t17, 0
    %t19 = cmp ne i64 %t18, 0
    store i64 %t19, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t20 = load i64 $land__3
    branch %t20, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t21 = addr $value
    %t22 = index i8 [projection=field] %t21, 24
    %t23 = load i32 %t22
    %t24 = cmp eq i32 %t23, 0
    %t25 = cmp ne i64 %t24, 0
    store i64 %t25, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t26 = load i64 $land__2
    branch %t26, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t27 = load i32 $cond__1
    return i32 %t27
}
