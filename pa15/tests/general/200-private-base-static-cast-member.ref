function @run(%value : ptr) -> ptr [binding=strong, object=_Z3runPK7derived] {
  slot $value : ptr

  block ^entry:
    store ptr %value, $value
    %t1 = load ptr $value
    %t2 = call ptr @derived__convert(%t1)
    return ptr %t2
}
function @derived__convert(%value : ptr) -> ptr [binding=weak, object=_ZN7derived7convertEPKS_] {
  slot $value : ptr

  block ^entry:
    store ptr %value, $value
    %t1 = load ptr $value
    %t2 = index i8 [projection=base_subobject] %t1, 0
    return ptr %t2
}
