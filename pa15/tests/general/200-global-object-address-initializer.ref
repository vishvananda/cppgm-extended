global @value : i32 [binding=strong, object=_Z5value] = 4
global @pointer : ptr [binding=strong, object=_Z7pointer] = addr @value

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = load ptr @pointer
    %t2 = load i32 %t1
    %t3 = binary sub i32 %t2, 4
    return i32 %t3
}
