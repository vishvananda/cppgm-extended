function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $b : obj<1x1>

  block ^entry:
    %t1 = addr $b
    %t2 = addr $b
    call void @block__unlink__ov2(%t2)
    return i32 0
}
function @block__unlink__ov2(%pb : ptr) -> void [binding=weak, object=_ZN5block6unlinkEPS_] {
  slot $pb : ptr

  block ^entry:
    store ptr %pb, $pb
    %t1 = load ptr $pb
    call void @block__unlink(%t1)
    return void
}
function @block__unlink(%this : ptr) -> void [binding=weak, object=_ZN5block6unlinkEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return void
}
