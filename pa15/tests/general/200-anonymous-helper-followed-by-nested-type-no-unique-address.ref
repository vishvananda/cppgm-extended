function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : obj<24x1>

  block ^entry:
    %t1 = addr $s
    %t2 = addr $s
    %t3 = index i8 [projection=field] %t2, 1
    %t4 = unary decay ptr %t3
    %t5 = index i8 [projection=array_element] %t4, 0
    store i8 120, %t5
    %t6 = const i64 24
    %t7 = convert trunc i32 i64 %t6
    return i32 %t7
}
