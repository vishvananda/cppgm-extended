function @Derived__run(%this : ptr) -> i32 [binding=strong, object=_ZN7Derived3runEv] {
  slot $this : ptr
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    store ptr %this, $this
    store ptr 0, $p
    %t1 = load ptr $p
    %t2 = cmp eq ptr %t1, 0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<1x1>

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = call i32 @Derived__run(%t2)
    return i32 %t3
}
