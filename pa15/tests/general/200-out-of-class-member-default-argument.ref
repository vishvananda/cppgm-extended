function @Text__take(%this : ptr, %out : ptr, %n : i64, %pos : i64) -> i32 [binding=strong, object=_ZN4Text4takeEPcmm] {
  slot $this : ptr
  slot $out : ptr
  slot $n : i64
  slot $pos : i64

  block ^entry:
    store ptr %this, $this
    store ptr %out, $out
    store i64 %n, $n
    store i64 %pos, $pos
    %t1 = load ptr $out
    %t2 = index i8 [projection=array_element] %t1, 0
    store i8 120, %t2
    %t3 = load i64 $n
    %t4 = load i64 $pos
    %t5 = binary add i64 %t3, %t4
    %t6 = convert trunc i32 i64 %t5
    return i32 %t6
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $text : obj<1x1>
  slot $out : obj<4x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $text
    %t2 = addr $out
    store i8 0, %t2
    %t3 = index i8 %t2, 1
    store i8 0, %t3
    %t4 = index i8 %t2, 2
    store i8 0, %t4
    %t5 = index i8 %t2, 3
    store i8 0, %t5
    %t6 = addr $text
    %t7 = addr $out
    %t8 = unary decay ptr %t7
    %t9 = convert sext i64 i32 3
    %t10 = convert sext i64 i32 0
    %t11 = call i32 @Text__take(%t6, %t8, %t9, %t10)
    %t12 = cmp eq i32 %t11, 3
    branch %t12, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load i32 $cond__1
    return i32 %t13
}
