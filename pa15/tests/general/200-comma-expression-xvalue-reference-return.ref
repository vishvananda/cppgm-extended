function @move_value(%value : ptr [pass=reference]) -> ptr [binding=strong, object=_Z10move_valueRi] {
  slot $value : ptr

  block ^entry:
    store ptr %value, $value
    %t1 = load ptr $value
    return ptr %t1
}
function @get(%value : ptr [pass=reference]) -> ptr [binding=strong, object=_Z3getRi] {
  slot $value : ptr

  block ^entry:
    store ptr %value, $value
    %t1 = load ptr $value
    %t2 = call ptr @move_value(%t1)
    return ptr %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    return i32 0
}
