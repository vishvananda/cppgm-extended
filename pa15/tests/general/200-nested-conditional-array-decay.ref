global @short_array [binding=strong, object=_Z11short_array] = {
  zero 3
}
global @first_array [binding=strong, object=_Z11first_array] = {
  zero 4
}
global @second_array [binding=strong, object=_Z12second_array] = {
  zero 4
}
global @third_array [binding=strong, object=_Z11third_array] = {
  zero 4
}

function @select_array(%index : i32) -> ptr [binding=strong, object=_Z12select_arrayi] {
  slot $index : i32
  slot $cond__1 : ptr
  slot $condaddr__2 : ptr
  slot $condaddr__3 : ptr

  block ^entry:
    store i32 %index, $index
    %t1 = load i32 $index
    %t2 = cmp eq i32 %t1, 0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t3 = addr @short_array
    store ptr %t3, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    %t4 = load i32 $index
    %t5 = cmp eq i32 %t4, 1
    branch %t5, ^condaddr_then_4, ^condaddr_else_5

  block ^condaddr_then_4:
    %t6 = addr @first_array
    store ptr %t6, $condaddr__2
    jump ^condaddr_end_6

  block ^condaddr_else_5:
    %t7 = load i32 $index
    %t8 = cmp eq i32 %t7, 2
    branch %t8, ^condaddr_then_7, ^condaddr_else_8

  block ^condaddr_then_7:
    %t9 = addr @second_array
    store ptr %t9, $condaddr__3
    jump ^condaddr_end_9

  block ^condaddr_else_8:
    %t10 = addr @third_array
    store ptr %t10, $condaddr__3
    jump ^condaddr_end_9

  block ^condaddr_end_9:
    %t11 = load ptr $condaddr__3
    store ptr %t11, $condaddr__2
    jump ^condaddr_end_6

  block ^condaddr_end_6:
    %t12 = load ptr $condaddr__2
    store ptr %t12, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t13 = load ptr $cond__1
    return ptr %t13
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call ptr @select_array(1)
    %t2 = addr @first_array
    %t3 = cmp eq ptr %t1, %t2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load i32 $cond__1
    return i32 %t4
}
