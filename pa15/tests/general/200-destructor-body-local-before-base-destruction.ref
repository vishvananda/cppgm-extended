global @order : i32 [binding=strong, object=_Z5order] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    call void @Derived___Derived(%t2)
    %t3 = load i32 @order
    %t4 = cmp eq i32 %t3, 312
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
function @Derived___Derived(%this : ptr) -> void [binding=weak, object=_ZN7DerivedD1Ev] {
  slot $this : ptr
  slot $guard : obj<1x1>

  block ^entry:
    store ptr %this, $this
    eh_cleanup ^destructor_cleanup_1
    %t1 = addr $guard
    %t2 = load i32 @order
    %t3 = binary mul i32 %t2, 10
    %t4 = binary add i32 %t3, 3
    store i32 %t4, @order
    %t5 = addr $guard
    call void @Guard___Guard(%t5)
    eh_end
    %t6 = load ptr $this
    %t7 = index i8 [projection=base_subobject] %t6, 0
    call void @Base___Base__base_entry(%t7)
    jump ^destructor_end_2

  block ^destructor_cleanup_1:
    %t8 = load ptr $this
    %t9 = index i8 [projection=base_subobject] %t8, 0
    call void @Base___Base__base_entry(%t9)
    eh_end
    resume

  block ^destructor_end_2:
    return void
}
function @Guard___Guard(%this : ptr) -> void [binding=weak, object=_ZN5GuardD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @order
    %t2 = binary mul i32 %t1, 10
    %t3 = binary add i32 %t2, 1
