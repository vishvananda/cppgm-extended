function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<12x4>

  block ^entry:
    %t1 = addr $values
    store i32 4, %t1
    %t2 = index i8 %t1, 4
    store i32 0, %t2
    %t3 = index i8 %t1, 8
    store i32 0, %t3
    %t4 = addr $values
    %t5 = index i32 [projection=array_element] %t4, 2
    %t6 = load i32 %t5
    return i32 %t6
}
