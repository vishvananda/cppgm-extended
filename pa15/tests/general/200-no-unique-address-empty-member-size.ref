function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : obj<24x1>

  block ^entry:
    %t1 = addr $s
    %t2 = addr $s
    %t3 = index i8 [projection=field] %t2, 0
    store u8 1, %t3
    %t4 = addr $s
    %t5 = index i8 [projection=field] %t4, 1
    %t6 = unary decay ptr %t5
    %t7 = index i8 [projection=array_element] %t6, 0
    store i8 120, %t7
    %t8 = const i64 24
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
