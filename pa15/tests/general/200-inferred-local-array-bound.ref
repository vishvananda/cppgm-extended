function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>

  block ^entry:
    %t1 = addr $values
    store i32 1, %t1
    %t2 = index i8 %t1, 4
    store i32 2, %t2
    %t3 = const i64 8
    %t4 = const i64 4
    %t5 = convert sext i64 i32 2
    %t6 = binary mul i64 %t5, %t4
    %t7 = binary sub i64 %t3, %t6
    %t8 = convert trunc i32 i64 %t7
    return i32 %t8
}
