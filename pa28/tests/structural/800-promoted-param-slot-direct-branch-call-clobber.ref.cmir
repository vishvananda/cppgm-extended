machine_ir x86_64 <host-target>

startup
    call @main
    mov rdi, rax
    exit

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    param-slot %a -> [rbp-<off0>] : i64
    param-slot %b -> [rbp-<off1>] : i64
    param-slot %c -> [rbp-<off2>] : i64
    param-slot %d -> [rbp-<off3>] : i64
    param-slot %f -> [rbp-<off4>] : i64

  block ^entry
    store.i64 [rbp-<off0>], rdi
    store.i64 [rbp-<off1>], rsi
    store.i64 [rbp-<off2>], rdx
    store.i64 [rbp-<off3>], rcx
    store.i64 [rbp-<off4>], r9
    mov rax, r8
    ret rax

function @size
  abi
    param %this -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    param-slot %this -> [rbp-<off0>] : ptr

  block ^entry
    store.ptr [rbp-<off0>], rdi
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    mov r8, 12345
    mov r9, 60
    call @clobber
    mov rax, 1
    ret rax

function @check
  abi
    param %this -> rdi : ptr
    param %index -> rsi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    preserve <gpr0> <gpr1> <gpr2>

  block ^entry
    mov r9, rdi
    mov r8, rsi
    mov <gpr0>, rsi
    call @size
    mov <gpr2>, rax
    cmp.i64 <gpr0>, <gpr2>
    jae ^bad
    jmp ^good

  block ^bad
    mov rax, 3
    ret rax

  block ^good
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rdi, 0
    mov rsi, 0
    call @check
    ret rax
