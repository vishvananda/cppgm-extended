global @g : i32 [binding=strong, object=_Z1g] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $w : obj<16x8>

  block ^entry:
    %t1 = addr $w
    %t2 = addr $w
    call void @Wrapper___Wrapper(%t2)
    return i32 0
}
function @Wrapper___Wrapper(%this : ptr) -> void [binding=weak, object=_ZN7WrapperD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    eh_cleanup ^destructor_cleanup_1
    eh_end
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 8
    call void @Sink___Sink(%t2)
    jump ^destructor_end_2

  block ^destructor_cleanup_1:
    %t3 = load ptr $this
    %t4 = index i8 [projection=field] %t3, 8
    call void @Sink___Sink(%t4)
    eh_end
    resume

  block ^destructor_end_2:
    return void
}
function @Sink___Sink(%this : ptr) -> void [binding=weak, object=_ZN4SinkD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    store i32 1, @g
    return void
}
alias object _ZN7WrapperD2Ev = @Wrapper___Wrapper
alias object _ZN4SinkD2Ev = @Sink___Sink
