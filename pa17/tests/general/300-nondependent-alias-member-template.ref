function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    %t1 = call i32 @fixed()
    %t2 = cmp ne i32 %t1, 1
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = call i32 @dependent()
    %t4 = cmp ne i32 %t3, 1
    store typed i64 %t4, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t5 = load typed i64 $lor__1
    branch %t5, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t6 = cmp lt i32 3, 4
    branch %t6, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t7 = cmp gt i32 3, 7
    store typed i64 %t7, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t8 = load typed i64 $lor__3
    %t9 = cmp eq i64 %t8, 0
    %t10 = cmp ne i64 %t9, 0
    store typed i64 %t10, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t11 = load typed i64 $lor__2
    %t12 = convert trunc i32 i64 %t11
    return i32 %t12
}
function @fixed() -> i32 [binding=weak, object=_Z5fixedIvEiv] {
  block ^entry:
    return i32 1
}
function @dependent() -> i32 [binding=weak, object=_Z9dependentIiEiv] {
  block ^entry:
    return i32 1
}
