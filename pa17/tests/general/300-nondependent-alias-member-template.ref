function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    %t1 = call i32 @fixed()
    %t2 = cmp ne i32 %t1, 1
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = call i32 @dependent()
    %t4 = cmp ne i32 %t3, 1
    %t5 = cmp ne i64 %t4, 0
    store typed i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load typed i64 $lor__1
    branch %t6, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t7 = cmp lt i32 3, 4
    branch %t7, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t8 = cmp gt i32 3, 7
    %t9 = cmp ne i64 %t8, 0
    store typed i64 %t9, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t10 = load typed i64 $lor__3
    %t11 = cmp eq i64 %t10, 0
    %t12 = cmp ne i64 %t11, 0
    store typed i64 %t12, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t13 = load typed i64 $lor__2
    %t14 = convert trunc i32 i64 %t13
    return i32 %t14
}
function @fixed() -> i32 [binding=weak, object=_Z5fixedIvEiv] {
  block ^entry:
    return i32 1
}
function @dependent() -> i32 [binding=weak, object=_Z9dependentIiEiv] {
  block ^entry:
    return i32 1
}
