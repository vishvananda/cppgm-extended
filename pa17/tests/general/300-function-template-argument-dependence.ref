function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    %t1 = const i64 1
    %t2 = const i64 1
    %t3 = cmp ne i64 %t1, %t2
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = const i64 1
    %t5 = const i64 1
    %t6 = cmp ne i64 %t4, %t5
    store typed i64 %t6, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t7 = load typed i64 $lor__1
    branch %t7, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t8 = const i64 4
    %t9 = const i64 4
    %t10 = cmp ne i64 %t8, %t9
    store typed i64 %t10, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t11 = load typed i64 $lor__2
    branch %t11, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t12 = const i64 1
    %t13 = const i64 1
    %t14 = cmp ne i64 %t12, %t13
    store typed i64 %t14, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t15 = load typed i64 $lor__3
    %t16 = convert trunc i32 i64 %t15
    return i32 %t16
}
