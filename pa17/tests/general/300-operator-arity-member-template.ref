    copyobj 4x4 %t2, %t1
    %t3 = load typed ptr $this
    %t4 = index i8 [projection=field] %t3, 0
    %t5 = load typed i32 %t4
    %t6 = binary add nowrap i32 %t5, 1
    store typed i32 %t6, %t4
    %t7 = addr $retobj__1
