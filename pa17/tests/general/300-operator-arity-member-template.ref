    jump ^lor_end_3

  block ^lor_end_3:
    %t21 = load typed i64 $lor__1
    branch %t21, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t22 = addr $b
    %t23 = index i8 [projection=field] %t22, 0
    %t24 = load typed i32 %t23
    %t25 = cmp ne i32 %t24, 4
    %t26 = cmp ne i64 %t25, 0
    store typed i64 %t26, $lor__2
