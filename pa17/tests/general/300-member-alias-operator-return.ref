function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<1x1>

  block ^entry:
    %t1 = addr $a
    %t2 = addr $a
    %t3 = call i32 @A__operator__(%t2)
    %t4 = cmp ne i32 %t3, 42
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
function @A__operator__(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN1AclEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 42
}
