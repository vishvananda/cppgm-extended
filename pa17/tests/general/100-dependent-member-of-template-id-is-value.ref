function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = cmp eq i32 6, 6
    branch %t1, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t2 = cmp eq i32 42, 42
    %t3 = cmp ne i64 %t2, 0
    store typed i64 %t3, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t4 = load typed i64 $land__2
    branch %t4, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t5 = cmp eq i32 24, 24
    %t6 = cmp ne i64 %t5, 0
    store typed i64 %t6, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t7 = load typed i64 $land__3
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load typed i32 $cond__1
    return i32 %t8
}
