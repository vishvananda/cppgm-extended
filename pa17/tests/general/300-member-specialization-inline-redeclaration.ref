function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $m : obj<1x1>

  block ^entry:
    %t1 = addr $m
    %t2 = addr $m
    %t3 = call i32 @Member__pick(%t2, 42)
    %t4 = cmp ne i32 %t3, 42
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
function @Member__pick(%this : ptr [object_bytes=1], %value : i32) -> i32 [binding=weak, object=_ZNK6Member4pickIiEEiT_, inline_hint=yes] {
  slot $this : ptr
  slot $value : i32

  block ^entry:
    store typed ptr %this, $this
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    return i32 %t1
}
