function @destroy(%pointer : ptr) -> void [binding=strong, object=_Z7destroyP4Item] {
  slot $pointer : ptr

  block ^entry:
    store ptr %pointer, $pointer
    %t1 = load ptr $pointer
    call void @Item___Item(%t1)
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $item : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $item
    %t2 = addr $item
    %t3 = index i8 [projection=field] %t2, 0
    store u32 7, %t3
    %t4 = addr $item
    call void @destroy(%t4)
    %t5 = addr $item
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load u32 %t6
    %t8 = cmp eq u32 %t7, 7
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t9 = load i32 $cond__1
    return i32 %t9
}
