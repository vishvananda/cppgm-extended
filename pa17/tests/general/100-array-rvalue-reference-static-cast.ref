global @__strlit__1 [binding=internal] = {
  i8 120
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr @__strlit__1
    store ptr %t1, $value
    %t2 = load ptr $value
    %t3 = unary decay ptr %t2
    %t4 = index i8 [projection=array_element] %t3, 0
    %t5 = load i8 %t4
    %t6 = convert sext i32 i8 %t5
    %t7 = cmp eq i32 %t6, 120
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
