start:
	move64 bp sp;
	call fn__main;
	syscall1 t64 60 x64;

fn__sum:
	isub64 sp sp 8;
	move64 [sp] bp;
	move64 bp sp;
	isub64 sp sp 136;
	move64 [bp-8] x64;
	move64 x64 y64;
	move64 z64 [x64];
	move64 [bp-16] z64;
fn__sum__entry:
	move64 y64 [bp-16];
	move64 x64 1;
	move64 z64 4;
	smul64 x64 x64 z64;
	iadd64 x64 y64 x64;
	move64 [bp-24] x64;
	move64 x64 [bp-16];
	move32 x32 [x64];
	move8 t8 32;
	lshift64 x64 x64 t8;
	srshift64 x64 x64 t8;
	move32 [bp-32] x32;
	move64 x64 [bp-24];
	move32 x32 [x64];
	move8 t8 32;
	lshift64 x64 x64 t8;
	srshift64 x64 x64 t8;
	move32 [bp-40] x32;
	move32 x32 [bp-32];
	move8 t8 32;
	lshift64 x64 x64 t8;
	srshift64 x64 x64 t8;
	move64 [bp-48] x64;
	move32 x32 [bp-40];
	move8 t8 32;
	lshift64 x64 x64 t8;
	srshift64 x64 x64 t8;
	move64 [bp-56] x64;
	move64 y64 [bp-48];
	move64 x64 [bp-56];
	iadd64 x64 y64 x64;
	move64 [bp-64] x64;
	move64 y64 [bp-8];
	move64 x64 [bp-64];
	iadd64 x64 y64 x64;
	move64 [bp-72] x64;
	move64 x64 [bp-72];
	jump fn__sum__epilogue;
fn__sum__epilogue:
	move64 sp bp;
	move64 bp [sp];
	iadd64 sp sp 8;
	ret;

fn__main:
	isub64 sp sp 8;
	move64 [sp] bp;
	move64 bp sp;
	isub64 sp sp 32;
fn__main__entry:
	isub64 x64 bp 8;
	move64 [bp-16] x64;
	move64 x64 4;
	move64 y64 [bp-16];
	move32 [y64] x32;
	move64 y64 [bp-16];
	move64 x64 1;
	move64 z64 4;
	smul64 x64 x64 z64;
	iadd64 x64 y64 x64;
	move64 [bp-24] x64;
	move64 x64 5;
	move64 y64 [bp-24];
	move32 [y64] x32;
	move64 x64 1;
	isub64 x64 bp 8;
	move64 y64 x64;
	call fn__sum;
	move64 [bp-32] x64;
	move64 x64 [bp-32];
	jump fn__main__epilogue;
fn__main__epilogue:
	move64 sp bp;
	move64 bp [sp];
	iadd64 sp sp 8;
