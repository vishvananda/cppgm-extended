function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    call void @local_use__run(%t2)
    return i32 0
}
function @local_use__run(%this : ptr) -> void [binding=weak, object=_ZN9local_use3runEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = const i64 1
    return void
}
