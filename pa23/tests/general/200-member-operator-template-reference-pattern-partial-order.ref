function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $key : obj<1x1>
  slot $default_visitor : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $key
    %t2 = addr $default_visitor
    %t3 = call i32 @nonconst_default_visitor___value()
    %t4 = cmp eq i32 %t3, 2
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
function @nonconst_default_visitor___value() -> i32 [binding=weak, object=_ZN16nonconst_defaultI7visitorE5valueEv] {
  block ^entry:
    return i32 2
}
