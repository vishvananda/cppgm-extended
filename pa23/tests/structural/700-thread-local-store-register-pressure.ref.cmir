machine_ir x86_64 <host-target>

startup
    call @main
    mov rdi, rax
    exit

global @g thread_local
  storage scalar i64
  init i64 0

function @f
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %x -> r9 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %t2 -> [rbp-<off0>] : i64
    temp %t3 -> [rbp-<off1>] : i64
    temp %t4 -> [rbp-<off2>] : i64
    temp %t5 -> [rbp-<off3>] : i64
    temp %z -> [rbp-<off4>] : i64

  block ^entry
    mov <gpr3>, rdi
    add <gpr3>, 1
    mov rax, rsi
    add rax, 2
    store.i64 [rbp-<off0>], rax
    mov rax, rdx
    add rax, 3
    store.i64 [rbp-<off1>], rax
    mov rax, rcx
    add rax, 4
    store.i64 [rbp-<off2>], rax
    mov rax, r8
    add rax, 5
    store.i64 [rbp-<off3>], rax
    mov rax, r9
    add rax, 1
    store.i64 [rbp-<off4>], rax
    load.i64 rax, [rbp-<off4>]
    store.i64 [rbp-<off5>], rax
    tls_addr <gpr5>, @g__tls_wrapper
    load.i64 rax, [rbp-<off5>]
    store.i64 [<gpr5>], rax
    load.i64 rdx, [rbp-<off0>]
    add <gpr3>, rdx
    load.i64 rdx, [rbp-<off1>]
    add <gpr3>, rdx
    load.i64 rdx, [rbp-<off2>]
    add <gpr3>, rdx
    load.i64 rdx, [rbp-<off3>]
    add <gpr3>, rdx
    load.i64 rdx, [rbp-<off4>]
    add <gpr3>, rdx
    mov rax, <gpr3>
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @f
    mov r9, rax
    sext.i32 r9
    mov rax, r9
    ret rax
