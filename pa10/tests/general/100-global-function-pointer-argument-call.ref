global @fp : ptr [binding=strong, object=_Z2fp] = addr @callee

function @callee(%x : i32) -> i32 [binding=strong, object=_Z6calleei] {
  slot $x : i32

  block ^entry:
    store i32 %x, $x
    %t1 = load i32 $x
    %t2 = binary add i32 %t1, 7
    return i32 %t2
}
function @invoke(%f : ptr, %x : i32) -> i32 [binding=strong, object=_Z6invokePFiiEi] {
  slot $f : ptr
  slot $x : i32

  block ^entry:
    store ptr %f, $f
    store i32 %x, $x
    %t1 = load i32 $x
    %t2 = load ptr $f
    %t3 = call i32 %t2(%t1) as (%arg0 : i32) -> i32
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = load ptr @fp
    %t2 = call i32 @invoke(%t1, 1)
    %t3 = cmp eq i32 %t2, 8
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load i32 $cond__1
    return i32 %t4
}
