declare function @chosen__target(%arg0 : i32) -> i32 [binding=strong, object=_ZN6chosen6targetEi]

function @chosen__inside__target(%n : i32) -> i32 [binding=internal, object=_ZN6chosen6insideL6targetEi] {
  slot $n : i32

  block ^entry:
    store typed i32 %n, $n
    %t1 = load typed i32 $n
    %t2 = binary add nowrap i32 %t1, 100
    return i32 %t2
}
function @chosen__invoke(%target : i32) -> i32 [binding=strong, object=_ZN6chosen6invokeEi] {
  slot $target : i32

  block ^entry:
    store typed i32 %target, $target
    %t1 = call i32 @chosen__target(4)
    return i32 %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @chosen__invoke(7)
    %t2 = cmp eq i32 %t1, 24
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i32 $cond__1
    return i32 %t3
}
