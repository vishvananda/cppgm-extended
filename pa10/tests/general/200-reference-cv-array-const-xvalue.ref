global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 1
  i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<8x4>
  slot $r : ptr
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr $a
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $a
    store ptr %t2, $r
    %t3 = load ptr $r
    %t4 = index i32 [projection=array_element] %t3, 0
    %t5 = addr $a
    %t6 = index i32 [projection=array_element] %t5, 0
    %t7 = cmp ne ptr %t4, %t6
    branch %t7, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t8 = load ptr $r
    %t9 = index i32 [projection=array_element] %t8, 1
    %t10 = load i32 %t9
    %t11 = cmp ne i32 %t10, 2
    %t12 = cmp ne i64 %t11, 0
    store i64 %t12, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t13 = load i64 $lor__1
    %t14 = convert trunc i32 i64 %t13
    return i32 %t14
}
