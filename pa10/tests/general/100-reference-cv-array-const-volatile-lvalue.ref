function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<8x4>
  slot $r : ptr
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr $a
    store volatile i32 1, %t1
    %t2 = index i8 %t1, 4
    store volatile i32 2, %t2
    %t3 = addr $a
    store ptr %t3, $r
    %t4 = load ptr $r
    %t5 = index i32 [projection=array_element] %t4, 0
    %t6 = addr $a
    %t7 = index i32 [projection=array_element] %t6, 0
    %t8 = cmp ne ptr %t5, %t7
    branch %t8, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t9 = load ptr $r
    %t10 = index i32 [projection=array_element] %t9, 1
    %t11 = load volatile i32 %t10
    %t12 = cmp ne i32 %t11, 2
    %t13 = cmp ne i64 %t12, 0
    store i64 %t13, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t14 = load i64 $lor__1
    %t15 = convert trunc i32 i64 %t14
    return i32 %t15
}
