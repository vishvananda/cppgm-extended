function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $p : ptr
  slot $pp : ptr
  slot $r : ptr

  block ^entry:
    store i32 3, $a
    %t1 = addr $a
    store ptr %t1, $p
    %t2 = addr $p
    store ptr %t2, $pp
    %t3 = addr $pp
    store ptr %t3, $r
    %t4 = load ptr $r
    %t5 = load ptr %t4
    %t6 = load ptr %t5
    %t7 = load i32 %t6
    %t8 = cmp ne i32 %t7, 3
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
