function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $r : ptr
  slot $lor__1 : i64

  block ^entry:
    store volatile i32 3, $a
    %t1 = addr $a
    store ptr %t1, $r
    %t2 = load ptr $r
    %t3 = addr $a
    %t4 = cmp ne ptr %t2, %t3
    branch %t4, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t5 = load ptr $r
    %t6 = load volatile i32 %t5
    %t7 = cmp ne i32 %t6, 3
    %t8 = cmp ne i64 %t7, 0
    store i64 %t8, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t9 = load i64 $lor__1
    %t10 = convert trunc i32 i64 %t9
    return i32 %t10
}
