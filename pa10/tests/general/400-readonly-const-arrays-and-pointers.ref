function @seed() -> i32 [binding=strong, object=_Z4seedv] {
  block ^entry:
    return i32 1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $cond__1 : i32
  slot $cond__2 : i32

  block ^entry:
    %t1 = load typed i32 @scalar
    %t2 = addr @table
    %t3 = index i32 [projection=array_element] %t2, 3
    %t4 = load typed i32 %t3
    %t5 = binary add nowrap i32 %t1, %t4
    %t6 = addr @matrix
    %t7 = binary mul i64 1, 8
    %t8 = index i8 [projection=array_element] %t6, %t7
    %t9 = index i32 [projection=array_element] %t8, 1
    %t10 = load typed i32 %t9
    %t11 = binary add nowrap i32 %t5, %t10
    %t12 = addr @names
    %t13 = index ptr [projection=array_element] %t12, 1
    %t14 = load typed ptr %t13
    %t15 = index i8 [projection=array_element] %t14, 1
    %t16 = load i8 %t15
    %t17 = convert sext i32 i8 %t16
    %t18 = binary add nowrap i32 %t11, %t17
    %t19 = load typed ptr @fixed_pointer
    branch %t19, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t20 = load typed i32 $cond__1
    %t21 = binary add nowrap i32 %t18, %t20
    %t22 = load typed ptr @movable_pointer
    %t23 = index i8 [projection=array_element] %t22, 0
    %t24 = load i8 %t23
    %t25 = convert sext i32 i8 %t24
    %t26 = binary add nowrap i32 %t21, %t25
    %t27 = load volatile i32 @volatile_scalar
    %t28 = binary add nowrap i32 %t26, %t27
    %t29 = addr @single_table
    %t30 = index i32 [projection=array_element] %t29, 0
    %t31 = load typed i32 %t30
    %t32 = binary add nowrap i32 %t28, %t31
    %t33 = load typed i32 @dynamic_scalar
    %t34 = binary add nowrap i32 %t32, %t33
    %t35 = addr @dynamic_table
    %t36 = index i32 [projection=array_element] %t35, 0
    %t37 = load typed i32 %t36
    %t38 = binary add nowrap i32 %t34, %t37
    %t39 = addr @thread_scalar
    %t40 = load typed i32 %t39
    %t41 = binary add nowrap i32 %t38, %t40
    %t42 = addr @writable_table
    %t43 = index i32 [projection=array_element] %t42, 1
    %t44 = load typed i32 %t43
    %t45 = binary add nowrap i32 %t41, %t44
    store typed i32 %t45, $sum
    %t46 = load typed i32 $sum
    %t47 = binary add nowrap i32 3, 4
    %t48 = binary add nowrap i32 %t47, 8
    %t49 = binary add nowrap i32 %t48, 99
    %t50 = binary add nowrap i32 %t49, 0
    %t51 = binary add nowrap i32 %t50, 100
    %t52 = binary add nowrap i32 %t51, 9
    %t53 = binary add nowrap i32 %t52, 10
    %t54 = binary add nowrap i32 %t53, 1
    %t55 = binary add nowrap i32 %t54, 1
    %t56 = binary add nowrap i32 %t55, 11
    %t57 = binary add nowrap i32 %t56, 13
    %t58 = cmp eq i32 %t46, %t57
    branch %t58, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store typed i32 0, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    store typed i32 1, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t59 = load typed i32 $cond__2
    return i32 %t59
}
function @__cppgm_init() -> void [role=init, binding=internal] {
  block ^entry:
    %t1 = call i32 @seed()
    store typed i32 %t1, @dynamic_scalar
    %t2 = addr @dynamic_table
    %t3 = call i32 @seed()
    store typed i32 %t3, %t2
    %t4 = index i8 %t2, 4
