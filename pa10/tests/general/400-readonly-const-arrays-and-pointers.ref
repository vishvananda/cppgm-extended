global @scalar : i32 [storage=readonly, binding=internal, object=_ZL6scalar] = 3
global @table [storage=readonly, binding=internal, object=_ZL5table] = {
  i32 1
  i32 2
  i32 3
  i32 4
}
global @matrix [storage=readonly, binding=internal, object=_ZL6matrix] = {
  i32 5
  i32 6
  i32 7
  i32 8
}
global @__strlit__1 [storage=readonly, binding=internal] = {
  i8 97
  i8 0
}
global @__strlit__2 [storage=readonly, binding=internal] = {
  i8 98
  i8 99
  i8 0
}
global @names [storage=readonly, binding=internal, object=_ZL5names] = {
  ptr addr @__strlit__1
  ptr addr @__strlit__2
}
global @fixed_pointer : ptr [storage=readonly, binding=internal, object=_ZL13fixed_pointer] = 0
global @__strlit__3 [storage=readonly, binding=internal] = {
  i8 100
  i8 0
}
global @movable_pointer : ptr [binding=strong] = addr @__strlit__3
global @volatile_scalar : i32 [binding=internal, object=_ZL15volatile_scalar] = 9
global @single_table [storage=readonly, binding=internal, object=_ZL12single_table] = {
  i32 10
}
global @writable_table [binding=strong] = {
  i32 12
  i32 13
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $cond__1 : i32
  slot $cond__2 : i32

  block ^entry:
    %t1 = addr @table
    %t2 = index i32 [projection=array_element] %t1, 3
    %t3 = load typed i32 %t2
    %t4 = binary add nowrap i32 3, %t3
    %t5 = addr @matrix
    %t6 = binary mul i64 1, 8
    %t7 = index i8 [projection=array_element] %t5, %t6
    %t8 = index i32 [projection=array_element] %t7, 1
    %t9 = load typed i32 %t8
    %t10 = binary add nowrap i32 %t4, %t9
    %t11 = addr @names
    %t12 = index ptr [projection=array_element] %t11, 1
    %t13 = load typed ptr %t12
    %t14 = index i8 [projection=array_element] %t13, 1
    %t15 = load i8 %t14
    %t16 = convert sext i32 i8 %t15
    %t17 = binary add nowrap i32 %t10, %t16
    %t18 = load typed ptr @fixed_pointer
    branch %t18, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t19 = load typed i32 $cond__1
    %t20 = binary add nowrap i32 %t17, %t19
    %t21 = load typed ptr @movable_pointer
    %t22 = index i8 [projection=array_element] %t21, 0
    %t23 = load i8 %t22
    %t24 = convert sext i32 i8 %t23
    %t25 = binary add nowrap i32 %t20, %t24
    %t26 = load volatile i32 @volatile_scalar
    %t27 = binary add nowrap i32 %t25, %t26
    %t28 = addr @single_table
    %t29 = index i32 [projection=array_element] %t28, 0
    %t30 = load typed i32 %t29
    %t31 = binary add nowrap i32 %t27, %t30
    %t32 = addr @writable_table
    %t33 = index i32 [projection=array_element] %t32, 1
    %t34 = load typed i32 %t33
    %t35 = binary add nowrap i32 %t31, %t34
    store typed i32 %t35, $sum
    %t36 = load typed i32 $sum
    %t37 = binary add nowrap i32 3, 4
    %t38 = binary add nowrap i32 %t37, 8
    %t39 = binary add nowrap i32 %t38, 99
    %t40 = binary add nowrap i32 %t39, 0
    %t41 = binary add nowrap i32 %t40, 100
    %t42 = binary add nowrap i32 %t41, 9
    %t43 = binary add nowrap i32 %t42, 10
    %t44 = binary add nowrap i32 %t43, 13
    %t45 = cmp eq i32 %t36, %t44
    branch %t45, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store typed i32 0, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    store typed i32 1, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t46 = load typed i32 $cond__2
    return i32 %t46
}
