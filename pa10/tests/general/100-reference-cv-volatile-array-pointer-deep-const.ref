global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 1
  i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<8x4>
  slot $p : ptr
  slot $q : ptr
  slot $r : ptr

  block ^entry:
    %t1 = addr $a
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $a
    store ptr %t2, $p
    %t3 = addr $p
    store ptr %t3, $q
    %t4 = load ptr $q
    store ptr %t4, $r
    %t5 = load ptr $r
    %t6 = load ptr %t5
    %t7 = index i32 [projection=array_element] %t6, 1
    store volatile i32 5, %t7
    %t8 = addr $a
    %t9 = index i32 [projection=array_element] %t8, 1
    %t10 = load i32 %t9
    %t11 = binary sub i32 %t10, 5
    return i32 %t11
}
