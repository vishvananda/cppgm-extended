global @N__later : i32 [binding=strong, object=_ZN1N5laterE] = 10
global @bias : i32 [binding=strong] = 7

function @N__first(%x : i32) -> i32 [binding=strong, object=_ZN1N5firstEi] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = load typed i32 @N__later
    %t3 = binary add nowrap i32 %t1, %t2
    return i32 %t3
}
function @twice(%x : i32) -> i32 [binding=strong, object=_Z5twicei] {
  slot $x : i32
  slot $value : i32

  block ^entry:
    store typed i32 %x, $x
    store typed i32 3, $value
    %t1 = load typed i32 $x
    %t2 = call i32 @helper(%t1)
    %t3 = load typed i32 $value
    %t4 = call i32 @local_function(%t3)
    %t5 = binary add nowrap i32 %t2, %t4
    return i32 %t5
}
function @address(%x : i32) -> i32 [binding=strong, object=_Z7addressi] {
  slot $x : i32
  slot $pointer : ptr

  block ^entry:
    store typed i32 %x, $x
    %t1 = addr @scale
    store typed ptr %t1, $pointer
    %t2 = load typed i32 $x
    %t3 = load typed ptr $pointer
    %t4 = call i32 %t3(%t2) as (%arg0 : i32) -> i32
    return i32 %t4
}
function @defined_after(%x : i32) -> i32 [binding=strong, object=_Z13defined_afteri] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = load typed i32 @bias
    %t3 = binary add nowrap i32 %t1, %t2
    return i32 %t3
}
function @helper(%x : i32) -> i32 [binding=strong, object=_Z6helperi] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary mul nowrap i32 %t1, 2
    return i32 %t2
}
function @local_function(%x : i32) -> i32 [binding=strong, object=_Z14local_functioni] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
function @scale(%x : i32) -> i32 [binding=strong, object=_Z5scalei] {
  slot $x : i32

  block ^entry:
    store typed i32 %x, $x
    %t1 = load typed i32 $x
    %t2 = binary mul nowrap i32 %t1, 3
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = call i32 @N__first(1)
    %t2 = cmp eq i32 %t1, 11
    branch %t2, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t3 = call i32 @twice(5)
    %t4 = cmp eq i32 %t3, 14
    store typed i64 %t4, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t5 = load typed i64 $land__2
    branch %t5, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t6 = call i32 @address(2)
    %t7 = cmp eq i32 %t6, 6
    store typed i64 %t7, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t8 = load typed i64 $land__3
    branch %t8, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t9 = call i32 @defined_after(1)
    %t10 = cmp eq i32 %t9, 8
    store typed i64 %t10, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t11 = load typed i64 $land__4
    branch %t11, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t12 = load typed i32 $cond__1
    return i32 %t12
}
