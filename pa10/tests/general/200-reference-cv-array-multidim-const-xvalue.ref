function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<16x4>
  slot $r : ptr
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr $a
    store i32 1, %t1
    %t2 = index i8 [projection=array_element] %t1, 4
    store i32 2, %t2
    %t3 = index i8 [projection=array_element] %t1, 8
    store i32 3, %t3
    %t4 = index i8 [projection=array_element] %t3, 4
    store i32 4, %t4
    %t5 = addr $a
    store ptr %t5, $r
    %t6 = load ptr $r
    %t7 = binary mul i64 0, 8
    %t8 = index i8 [projection=array_element] %t6, %t7
    %t9 = index i32 [projection=array_element] %t8, 0
    %t10 = addr $a
    %t11 = binary mul i64 0, 8
    %t12 = index i8 [projection=array_element] %t10, %t11
    %t13 = index i32 [projection=array_element] %t12, 0
    %t14 = cmp ne ptr %t9, %t13
    branch %t14, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t15 = load ptr $r
    %t16 = binary mul i64 1, 8
    %t17 = index i8 [projection=array_element] %t15, %t16
    %t18 = index i32 [projection=array_element] %t17, 1
    %t19 = load i32 %t18
    %t20 = cmp ne i32 %t19, 4
    %t21 = cmp ne i64 %t20, 0
    store i64 %t21, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t22 = load i64 $lor__1
    %t23 = convert trunc i32 i64 %t22
    return i32 %t23
}
