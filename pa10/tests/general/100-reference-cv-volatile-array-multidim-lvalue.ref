function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<16x4>
  slot $r : ptr

  block ^entry:
    %t1 = addr $a
    store i32 1, %t1
    %t2 = index i8 [projection=array_element] %t1, 4
    store i32 2, %t2
    %t3 = index i8 [projection=array_element] %t1, 8
    store i32 3, %t3
    %t4 = index i8 [projection=array_element] %t3, 4
    store i32 4, %t4
    %t5 = addr $a
    store ptr %t5, $r
    %t6 = load ptr $r
    %t7 = binary mul i64 1, 8
    %t8 = index i8 [projection=array_element] %t6, %t7
    %t9 = index i32 [projection=array_element] %t8, 1
    store volatile i32 5, %t9
    %t10 = addr $a
    %t11 = binary mul i64 1, 8
    %t12 = index i8 [projection=array_element] %t10, %t11
    %t13 = index i32 [projection=array_element] %t12, 1
    %t14 = load i32 %t13
    %t15 = binary sub i32 %t14, 5
    return i32 %t15
}
