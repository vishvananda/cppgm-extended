global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 4
  zero 8
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<12x4>

  block ^entry:
    %t1 = addr $values
    copyobj 12x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = index inbounds i32 [projection=array_element] %t2, 2
    %t4 = load typed i32 %t3
    return i32 %t4
}
