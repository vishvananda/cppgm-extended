function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $b : i32
  slot $p : obj<16x8>
  slot $r : ptr

  block ^entry:
    store i32 1, $a
    store i32 2, $b
    %t1 = addr $p
    %t2 = addr $a
    store ptr %t2, %t1
    %t3 = index i8 %t1, 8
    %t4 = addr $b
    store ptr %t4, %t3
    %t5 = addr $p
    store ptr %t5, $r
    %t6 = addr $a
    %t7 = load ptr $r
    %t8 = index ptr [projection=array_element] %t7, 1
    store volatile ptr %t6, %t8
    %t9 = addr $p
    %t10 = index ptr [projection=array_element] %t9, 1
    %t11 = load ptr %t10
    %t12 = load i32 %t11
    %t13 = binary sub i32 %t12, 1
    return i32 %t13
}
