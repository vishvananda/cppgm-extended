global @count : i32 [binding=strong, object=_Z5count] = zero
global @value : i32 [binding=strong, object=_Z5value] = zero

function @lhs() -> ptr [binding=strong, object=_Z3lhsv] {
  block ^entry:
    %t1 = load i32 @count
    %t2 = binary add i32 %t1, 1
    store i32 %t2, @count
    %t3 = addr @value
    return ptr %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call ptr @lhs()
    %t2 = load i32 %t1
    %t3 = binary add i32 %t2, 2
    store i32 %t3, %t1
    %t4 = load i32 @count
    return i32 %t4
}
