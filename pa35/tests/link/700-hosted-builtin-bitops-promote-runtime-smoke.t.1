int clz_unsigned_char(unsigned char value)
{
  return __builtin_clz(value);
}

int clzl_unsigned_char(unsigned char value)
{
  return __builtin_clzl(value);
}

int clzll_unsigned_char(unsigned char value)
{
  return __builtin_clzll(value);
}

int popcount_signed_char(signed char value)
{
  return __builtin_popcount(value);
}

int main()
{
  unsigned char value = 0x31;
  if(clz_unsigned_char(value) != 26) {
    return 1;
  }
  if(clzl_unsigned_char(value) != (int)(sizeof(unsigned long) * 8 - 6)) {
    return 2;
  }
  if(clzll_unsigned_char(value) != 58) {
    return 3;
  }
  if(popcount_signed_char((signed char)-1) != 32) {
    return 4;
  }
  return 0;
}
