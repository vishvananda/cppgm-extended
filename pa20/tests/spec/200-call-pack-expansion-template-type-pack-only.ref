function @sum(%a : i32, %b : i32) -> i32 [binding=strong, object=_Z3sumii] {
  slot $a : i32
  slot $b : i32

  block ^entry:
    store i32 %a, $a
    store i32 %b, $b
    %t1 = load i32 $a
    %t2 = load i32 $b
    %t3 = binary add i32 %t1, %t2
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    %t3 = call i32 @sizes_char__short_int___run(%t2)
    %t4 = cmp eq i32 %t3, 3
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
function @sizes_char__short_int___run(%this : ptr) -> i32 [binding=weak, object=_ZN5sizesIJcsEE3runEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = const i64 1
    %t2 = convert trunc i32 i64 %t1
    %t3 = const i64 2
    %t4 = convert trunc i32 i64 %t3
    %t5 = call i32 @sum(%t2, %t4)
    return i32 %t5
}
