global @alive : i32 [binding=strong, object=_Z5alive] = zero
global @pick : i32 [binding=strong, object=_Z4pick] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $p : i32
  slot $s : ptr
  slot $tmpobj__1 : obj<4x4>
  slot $cond__2 : i32

  block ^entry:
    store i32 0, $p
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = load i32 $p
    %t2 = cmp lt i32 %t1, 2
    branch %t2, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t3 = load i32 $p
    store i32 %t3, @pick
    %t4 = addr $tmpobj__1
    %t5 = load i32 @pick
    branch %t5, ^condobj_then_5, ^condobj_else_6

  block ^condobj_then_5:
    call void @S__S(%t4, 3)
    jump ^condobj_end_7

  block ^condobj_else_6:
    call void @S__S(%t4, 4)
    jump ^condobj_end_7

  block ^condobj_end_7:
    store ptr %t4, $s
    %t6 = load i32 @alive
    %t7 = cmp ne i32 %t6, 1
    branch %t7, ^if_then_8, ^lor_rhs_11

  block ^lor_rhs_11:
    %t8 = load ptr $s
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = load i32 %t9
    %t11 = load i32 @pick
    branch %t11, ^cond_then_12, ^cond_else_13

  block ^cond_then_12:
    store i32 3, $cond__2
    jump ^cond_end_14

  block ^cond_else_13:
    store i32 4, $cond__2
    jump ^cond_end_14

  block ^cond_end_14:
    %t12 = load i32 $cond__2
    %t13 = cmp ne i32 %t10, %t12
    branch %t13, ^if_then_8, ^if_else_9

  block ^if_then_8:
    call void @S___S(%t4)
    return i32 1

  block ^if_else_9:
    jump ^if_end_10

  block ^if_end_10:
    call void @S___S(%t4)
    %t14 = load i32 @alive
    branch %t14, ^if_then_15, ^if_else_16

  block ^if_then_15:
    return i32 2

  block ^if_else_16:
    jump ^if_end_17

  block ^if_end_17:
    jump ^for_iter_3

  block ^for_iter_3:
    %t15 = load i32 $p
    %t16 = binary add i32 %t15, 1
    store i32 %t16, $p
    jump ^for_cond_1

  block ^for_end_4:
    return i32 0
}
function @S__S(%this : ptr [object_bytes=4], %v : i32) -> void [unwind=no, binding=weak, object=_ZN1SC1Ei, inline_hint=yes] {
  slot $this : ptr
  slot $v : i32

  block ^entry:
    store ptr %this, $this
    store i32 %v, $v
    %t1 = load i32 $v
    %t2 = load ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store i32 %t1, %t3
    %t4 = load i32 @alive
    %t5 = binary add i32 %t4, 1
    store i32 %t5, @alive
    return void
}
function @S___S(%this : ptr [object_bytes=4]) -> void [unwind=no, binding=weak, object=_ZN1SD1Ev, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @alive
    %t2 = binary sub i32 %t1, 1
    store i32 %t2, @alive
    return void
}
alias object _ZN1SC2Ei = @S__S
alias object _ZN1SD2Ev = @S___S
