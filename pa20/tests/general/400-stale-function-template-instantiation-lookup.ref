function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $n : obj<16x8>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $n
    store i64 0, %t1
    %t2 = index i8 %t1, 8
    store i64 0, %t2
    %t3 = addr $n
    %t4 = index i8 [projection=base_subobject] %t3, 0
    %t5 = index i8 [projection=field] %t4, 0
    store ptr 0, %t5
    %t6 = addr $n
    %t7 = call ptr @descend(%t6)
    %t8 = addr $n
    %t9 = index i8 [projection=base_subobject] %t8, 0
    %t10 = index i8 [projection=field] %t9, 0
    %t11 = cmp eq ptr %t7, %t10
    branch %t11, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t12 = load i32 $cond__1
    return i32 %t12
}
function @descend(%nd : ptr) -> ptr [binding=weak, object=_Z7descendIiEPP4baseP4nodeIT_E] {
  slot $nd : ptr

  block ^entry:
    store ptr %nd, $nd
    %t1 = load ptr $nd
    %t2 = call ptr @addrof(%t1)
    %t3 = load ptr $nd
    %t4 = index i8 [projection=base_subobject] %t3, 0
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = call ptr @addrof__ov2(%t5)
    return ptr %t6
}
function @addrof(%x : ptr [pass=reference]) -> ptr [binding=weak, object=_Z6addrofI4nodeIiEEPT_RS2_] {
  slot $x : ptr

  block ^entry:
