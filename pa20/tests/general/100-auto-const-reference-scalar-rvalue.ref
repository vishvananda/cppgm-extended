function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : ptr
  slot $tmpref__1 : i32

  block ^entry:
    store i32 3, $tmpref__1
    %t1 = addr $tmpref__1
    store ptr %t1, $x
    %t2 = load ptr $x
    %t3 = load i32 %t2
    %t4 = cmp ne i32 %t3, 3
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
