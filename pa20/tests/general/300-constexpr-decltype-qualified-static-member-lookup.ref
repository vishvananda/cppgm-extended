declare global @S__value : u8 [binding=strong, object=_ZN1S5valueE]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @f()
    %t2 = cmp eq i32 %t1, 1
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @f() -> i32 [binding=weak, object=_Z1fv] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = load u8 @S__value
