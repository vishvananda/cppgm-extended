global @calls : i32 [binding=strong] = zero

function @get() -> i32 [binding=strong, object=_Z3getv] {
  block ^entry:
    %t1 = load i32 @calls
    %t2 = binary add i32 %t1, 1
    store i32 %t2, @calls
    return i32 3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : ptr
  slot $tmpref__1 : i32
  slot $lor__2 : i64

  block ^entry:
    %t1 = call i32 @get()
    store i32 %t1, $tmpref__1
    %t2 = addr $tmpref__1
    store ptr %t2, $x
    %t3 = load ptr $x
    %t4 = load i32 %t3
    %t5 = cmp ne i32 %t4, 3
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t6 = load i32 @calls
    %t7 = cmp ne i32 %t6, 1
    %t8 = cmp ne i64 %t7, 0
    store i64 %t8, $lor__2
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__2
    jump ^lor_end_3

  block ^lor_end_3:
    %t9 = load i64 $lor__2
    %t10 = convert trunc i32 i64 %t9
    return i32 %t10
}
