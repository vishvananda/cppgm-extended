function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64

  block ^entry:
    %t1 = call u32 @count()
    %t2 = cmp ne u32 %t1, 1
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = call u32 @count__2()
    %t4 = cmp ne u32 %t3, 3
    %t5 = cmp ne i64 %t4, 0
    store typed i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load typed i64 $lor__1
    %t7 = convert trunc i32 i64 %t6
    return i32 %t7
}
function @count() -> u32 [binding=weak, object=_Z5countIJEEjv] {
  slot $value : i64

  block ^entry:
    store typed i64 1, $value
    %t1 = load typed i64 $value
    %t2 = convert trunc u32 i64 %t1
    return u32 %t2
}
function @count__2() -> u32 [binding=weak, object=_Z5countIJicEEjv] {
  slot $value : i64

  block ^entry:
    store typed i64 3, $value
