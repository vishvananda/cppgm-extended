function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $s : ptr
  slot $tmpobj__1 : obj<4x4>

  block ^entry:
    %t1 = addr $tmpobj__1
    call void @S__S__aggregate(%t1, 3)
    store ptr %t1, $s
    %t2 = load ptr $s
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = load i32 %t3
    %t5 = cmp ne i32 %t4, 3
    %t6 = convert trunc i32 i64 %t5
    return i32 %t6
}
function @S__S__aggregate(%this : ptr, %x : i32) -> void [unwind=no, binding=internal] {
  slot $this : ptr
  slot $x : i32

  block ^entry:
    store ptr %this, $this
    store i32 %x, $x
    %t1 = load i32 $x
    %t2 = load ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store i32 %t1, %t3
    return void
}
