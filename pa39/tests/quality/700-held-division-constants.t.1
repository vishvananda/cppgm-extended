extern "C" int streams(int* state, int n);
extern "C" int seeded(int seed, int n);

extern "C" int next_seed(int seed) { return seed * 3 + 1; }

static int state[4] = {42, 7, 1000, 139000};

int main() {
    const int x = streams(state, 1000);
    return (x ^ state[0] ^ (state[3] >> 3) ^ seeded(13, 1000)) & 127;
}
