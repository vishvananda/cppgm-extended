machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @calls
  storage scalar i64
  init i64 0

function @effect
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rax, @calls
    add rax, 3
    store.i64 @calls, rax
    mov rax, rdi
    xor rax, 90
    ret rax

function @other
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rax, @calls
    add rax, 5
    store.i64 @calls, rax
    mov rax, rdi
    xor rax, 91
    ret rax

function @worker
  abi
    param %n -> rdi : i64
    param %x -> rsi : i64
    param %d -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>
    param-slot %d -> [rbp-<off0>] : i64

  block ^entry
    mov <gpr0>, rsi
    cmp.i64 rdi, 7
    ja ^fallback
    jump_table rdi, [^entry~c0, ^entry~c0, ^entry~c0, ^entry~c0, ^entry~c0, ^entry~c0, ^entry~c6, ^entry~c7]

  block ^fallback
    mov rax, 999
    ret rax

  block ^entry~c7
    store.i64 [rbp-<off0>], rdx

  block ^c7
    mov rdi, <gpr0>
    call @effect [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, <gpr0>
    cqo
    idiv [rbp-<off0>]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, <gpr0>
    xor rax, 255
    ret rax

  block ^entry~c6
    store.i64 [rbp-<off0>], rdx

  block ^c6
    mov rdi, <gpr0>
    call @other [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, <gpr0>
    mov rdx, 0
    div [rbp-<off0>]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, <gpr0>
    xor rax, 255
    ret rax

  block ^entry~c0
    store.i64 [rbp-<off0>], rdx

  block ^c0
    mov rdi, <gpr0>
    call @effect [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, <gpr0>
    mov rdx, 0
    div [rbp-<off0>]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, <gpr0>
    xor rax, 255
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov <gpr3>, 0
    mov <gpr0>, 781331
    mov <gpr4>, 0

  block ^loop
    mov <gpr5>, 6364136223846793005
    imul <gpr0>, <gpr5>
    add <gpr0>, 1
    mov rax, <gpr3>
    mov <gpr5>, -2049638230412172401
    mul <gpr5>
    shr rdx, 3
    imul rdx, 9
    mov rax, <gpr3>
    sub rax, rdx
    mov <gpr2>, rax
    zext.i32 rax, <gpr3>
    and rax, 63
    lea <gpr1>, [rax+<off0>]
    mov rdi, <gpr2>
    mov rsi, <gpr0>
    mov rdx, <gpr1>
    call @worker [args=(rdx,rsi,rdi)]
    mov rcx, rax
    cmp.i64 <gpr2>, 6
    sete rsi
    cmp.i64 <gpr2>, 8
    sete rdi
    test.u8 rsi, rsi
    mov <gpr5>, 91
    mov rax, 90
    cmovne rax, <gpr5>
    xor rax, <gpr0>
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    mov r8, rax
    xor r8, <gpr0>
    mov rax, r8
    mov rdx, 0
    div <gpr1>
    mov r9, rax
    mov rax, r8
    cqo
    idiv <gpr1>
    cmp.i64 <gpr2>, 7
    cmove r9, rax
    imul r9, 13
    add r9, 29
    xor r9, 77
    shl r9, 5
    or r9, 7
    add r9, <gpr0>
    xor r9, 255
    test.u8 rdi, rdi
    mov <gpr5>, 999
    cmovne r9, <gpr5>
    test.u8 rsi, rsi
    mov <gpr5>, 5
    mov rax, 3
    cmovne rax, <gpr5>
    mov <gpr5>, 0
    test.u8 rdi, rdi
    cmovne rax, <gpr5>
    add <gpr4>, rax
    load.i64 rax, @calls
    cmp.i64 rcx, r9
    setne rcx
    cmp.i64 rax, <gpr4>
    setne rax
    or.u8 rcx, rax
    jne ^fail

  block ^next
    add <gpr3>, 1
    cmp.i64 <gpr3>, 4096
    jne ^loop

  block ^done
    mov rax, 0
    ret rax

  block ^fail
    mov rax, 1
    ret rax
