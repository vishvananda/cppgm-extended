machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @offsets
  storage data
  item i8 16
  item i8 24
  item i8 16
  item i8 24
  item i8 16
  item i8 24
  item i8 16
  item i8 24

function @walk
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u16 rax, [rdi]
    and rax, 7
    mov r10, @offsets
    load.i8 rax, [r10+rax]
    load.ptr rax, [rdi+rax]
    ret rax

function @live_address
  abi
    param %key -> rdi : i64
    param %out -> rsi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov r10, @offsets
    add rax, r10
    load.i8 rcx, [rax]
    store.i8 [rsi], rcx
    ret rax

function @masked16
  abi
    param %x -> rdi : u16
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    and rax, 127
    mov r11, 1000
    cmove rax, r11
    ret rax

function @masked8
  abi
    param %x -> rdi : u8
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    and rax, 63
    mov r11, 1000
    cmove rax, r11
    ret rax

function @signed16
  abi
    param %x -> rdi : i16
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    and rax, -32768
    cmp.i16 rax, 0
    mov r11, 1000
    cmovge rax, r11
    ret rax

function @signed8
  abi
    param %x -> rdi : i8
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    and rax, -128
    cmp.i8 rax, 0
    mov r11, 1000
    cmovge rax, r11
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $node -> [rbp-32] : obj<32x8>
    slot $out -> [rbp-40] : i8
    temp %ok5 -> [rbp-48] : i64
    temp %ok6 -> [rbp-56] : i64
    temp %ok7 -> [rbp-64] : i64
    temp %ok8 -> [rbp-72] : i64
    temp %ok9 -> [rbp-80] : i64
    temp %ok10 -> [rbp-88] : i64

  block ^entry
    lea rbx, [rbp-16]
    lea r12, [rbp-8]
    store.ptr [rbx], rbx
    store.ptr [r12], r12
    store.u16 [rbp-32], 6
    lea rdi, [rbp-32]
    call @walk [args=(rdi)]
    cmp.ptr rax, rbx
    sete rbx
    movzx rbx, rbx
    store.u16 [rbp-32], 7
    lea rdi, [rbp-32]
    call @walk [args=(rdi)]
    cmp.ptr rax, r12
    sete r12
    movzx r12, r12
    mov rdi, 3
    lea rsi, [rbp-40]
    call @live_address [args=(rsi,rdi)]
    mov rcx, @offsets+3
    cmp.ptr rax, rcx
    sete r13
    movzx r13, r13
    cmp.i8 [rbp-40], 24
    sete r14
    movzx r14, r14
    mov rdi, 65535
    call @masked16 [args=(rdi)]
    cmp.i32 rax, 127
    sete r15
    movzx r15, r15
    mov rdi, 255
    call @masked8 [args=(rdi)]
    cmp.i32 rax, 63
    sete r10
    movzx r10, r10
    store.i64 [rbp-48], r10
    mov rdi, 128
    call @masked16 [args=(rdi)]
    cmp.i32 rax, 1000
    sete r10
    movzx r10, r10
    store.i64 [rbp-56], r10
    mov rdi, 128
    call @masked8 [args=(rdi)]
    cmp.i32 rax, 1000
    sete r10
    movzx r10, r10
    store.i64 [rbp-64], r10
    mov rdi, -1
    call @signed16 [args=(rdi)]
    cmp.i32 rax, -32768
    sete r10
    movzx r10, r10
    store.i64 [rbp-72], r10
    mov rdi, -1
    call @signed8 [args=(rdi)]
    cmp.i32 rax, -128
    sete r10
    movzx r10, r10
    store.i64 [rbp-80], r10
    mov rdi, 1
    call @signed16 [args=(rdi)]
    cmp.i32 rax, 1000
    sete r10
    movzx r10, r10
    store.i64 [rbp-88], r10
    mov rdi, 1
    call @signed8 [args=(rdi)]
    cmp.i32 rax, 1000
    sete rax
    movzx rax, rax
    and rbx, r12
    and rbx, r13
    and rbx, r14
    and rbx, r15
    and rbx, [rbp-48]
    and rbx, [rbp-56]
    and rbx, [rbp-64]
    and rbx, [rbp-72]
    and rbx, [rbp-80]
    and rbx, [rbp-88]
    and rbx, rax
    sete rax
    movzx rax, rax
    ret rax
