machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item ptr 11
  item ptr 37
  item ptr 73

function @masked_index
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rsi
    shr rax, 1
    and rax, 8
    load.ptr rax, [rdi+rax+8]

  block ^finish
    xor rdi, rsi
    xor rax, rdi
    ret rax

function @live_index
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rsi
    shr rax, 1
    and rax, 8
    load.ptr rcx, [rdi+rax+8]

  block ^finish
    xor rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14

  block ^entry
    mov rbx, @cells
    mov rdi, rbx
    mov rsi, 4
    call @masked_index [args=(rsi,rdi)]
    mov rcx, rbx
    xor rcx, 4
    xor rcx, 37
    cmp.i64 rax, rcx
    setne r12
    movzx r12, r12
    mov rdi, rbx
    mov rsi, 16
    call @masked_index [args=(rsi,rdi)]
    mov rcx, rbx
    xor rcx, 16
    xor rcx, 73
    cmp.i64 rax, rcx
    setne r13
    movzx r13, r13
    mov rdi, rbx
    mov rsi, 4
    call @live_index [args=(rsi,rdi)]
    cmp.i64 rax, 37
    setne r14
    movzx r14, r14
    mov rdi, rbx
    mov rsi, 16
    call @live_index [args=(rsi,rdi)]
    cmp.i64 rax, 65
    setne rax
    movzx rax, rax
    or.u32 r12, r13
    or.u32 r14, rax
    zext.i32 rax, r12
    or.u32 rax, r14
    ret rax
