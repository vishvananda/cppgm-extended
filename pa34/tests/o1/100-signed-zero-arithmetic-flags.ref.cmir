machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @negative32
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sub.i32 rdi, rsi
    sets rax
    movzx rax, rax
    ret rax

function @nonnegative64
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add rdi, rsi
    js ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @mixed_conditions
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i32 rdi, rsi
    cmp.i32 rdi, 0
    setg rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov rdi, -2147483648
    mov rsi, 1
    call @negative32 [args=(rsi,rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 2147483647
    mov rsi, -1
    call @negative32 [args=(rsi,rdi)]
    zext.i32 <gpr1>, rax
    mov rdi, 9223372036854775807
    mov rsi, 1
    call @nonnegative64 [args=(rsi,rdi)]
    zext.i32 <gpr2>, rax
    mov rdi, -9223372036854775808
    mov rsi, -1
    call @nonnegative64 [args=(rsi,rdi)]
    zext.i32 <gpr3>, rax
    mov rdi, 2147483647
    mov rsi, 1
    call @mixed_conditions [args=(rsi,rdi)]
    zext.i32 <gpr4>, rax
    mov rdi, -2147483648
    mov rsi, -1
    call @mixed_conditions [args=(rsi,rdi)]
    add.i32 <gpr0>, <gpr1>
    add.i32 <gpr2>, <gpr3>
    add.i32 <gpr4>, rax
    add.i32 <gpr0>, <gpr2>
    add.i32 <gpr0>, <gpr4>
    cmp.i32 <gpr0>, 3
    setne rax
    movzx rax, rax
    ret rax
