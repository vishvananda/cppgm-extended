machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @sum_bytes
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 r8, [rdi]
    shl.u32 r8, 13
    zext.i32 rax, r8
    load.i8 r8, [rdi+<off0>]
    shl.u32 r8, 11
    load.i8 r9, [rdi+<off1>]
    add.u32 r9, 91
    load.i8 rdi, [rdi+<off2>]
    imul.u32 rdi, 7
    add rax, r8
    add r9, rdi
    add rax, r9
    ret rax

function @right
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    zext.i32 rax, rdi
    shr rax, 7
    ret rax

function @wide
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rax, [rdi]
    shl rax, 13
    ret rax

function @zero
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    zext.i32 rdi
    shl.u32 rdi, 0
    zext.i32 rax, rdi
    ret rax

function @identity
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    imul.u32 rdi, 1
    zext.i32 rax, rdi
    ret rax

function @variable
  abi
    param %p -> rdi : ptr
    param %shift -> rsi : u32
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    zext.i32 rdi
    mov rcx, rsi
    shl rdi, rcx
    zext.i32 rax, rdi
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $bytes -> [rbp-<off0>] : obj<4x1>
    temp %variable0 -> [rbp-<off1>] : i64
    temp %variable1 -> [rbp-<off2>] : i64

  block ^entry
    store.i32 [rbp-<off0>], 4290806015
    lea rdi, [rbp-<off0>]
    call @sum_bytes [args=(rdi)]
    mov <gpr0>, rax
    lea rdi, [rbp-<off0>]
    call @right [args=(rdi)]
    mov <gpr1>, rax
    lea rdi, [rbp-<off0>]
    call @wide [args=(rdi)]
    mov <gpr2>, rax
    lea rdi, [rbp-<off0>]
    call @zero [args=(rdi)]
    mov <gpr3>, rax
    lea rdi, [rbp-<off0>]
    call @identity [args=(rdi)]
    mov <gpr4>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 0
    call @variable [args=(rsi,rdi)]
    mov <gpr5>, rax
    store.i64 [rbp-<off1>], <gpr5>
    lea rdi, [rbp-<off0>]
    mov rsi, 1
    call @variable [args=(rsi,rdi)]
    mov <gpr5>, rax
    store.i64 [rbp-<off2>], <gpr5>
    lea rdi, [rbp-<off0>]
    mov rsi, 31
    call @variable [args=(rsi,rdi)]
    cmp.i64 <gpr0>, 12884631572
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, 33554431
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 <gpr2>, -8192
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.i64 <gpr3>, 4294967295
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    cmp.i64 <gpr4>, 4294967295
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    cmp.i64 [rbp-<off1>], 4294967295
    setne r8
    movzx r8, r8
    cmp.i64 [rbp-<off2>], 4294967294
    setne r9
    movzx r9, r9
    cmp.i64 rax, 2147483648
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr2>, <gpr3>
    or <gpr4>, r8
    or r9, rax
    mov rax, <gpr0>
    or rax, <gpr2>
    or <gpr4>, r9
    or rax, <gpr4>
    ret rax
