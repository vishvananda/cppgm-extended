global @seen
  storage scalar f64
  init f64 0.0

function @clobber
  abi
    param %x0 -> xmm0 : f64
    param %x1 -> xmm1 : f64
    param %x2 -> <xmm0> : f64
    param %x3 -> <xmm1> : f64
    param %x4 -> <xmm2> : f64
    param %x5 -> <xmm3> : f64
    param %x6 -> <xmm4> : f64
    param %x7 -> <xmm5> : f64
    param %x8 -> [rbp+<off0>] : f64
    param %x9 -> [rbp+<off1>] : f64
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 @seen, <xmm5>
    ret

function @pressure
  abi
    param %src -> rdi : ptr
    param %out -> rsi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>
