machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @fields
  storage data
  item i64 11
  item i64 22
  item i64 77
  item i64 33
  item i64 44
  item i64 55
  item i64 66
  item i64 88

function @sparse_fields
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zero_bytes 16x1, [rdi]
    zero_bytes 32x1, [rdi+24]
    store.i64 [rdi+56], 9
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, @fields
    call @sparse_fields [args=(rdi), unwind=no]
    mov rax, 0

  block ^loop
    lea rcx, [rax*8]
    mov r10, @fields
    add rcx, r10
    mov rdx, 0
    cmp.i64 rax, 7
    mov r11, 9
    cmove rdx, r11
    cmp.i64 rax, 2
    mov r11, 77
    cmove rdx, r11
    cmp.i64 rdx, [rcx]
    jne ^fail

  block ^next
    add rax, 1
    cmp.i64 rax, 8
    jb ^loop

  block ^done
    mov rax, 0
    ret rax

  block ^fail
    mov rax, 1
    ret rax
