machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @storage
  storage scalar obj<512x8>
  init obj<512x8> 0

function @shared_cases
  abi
    param %p -> rdi : ptr
    param %kind -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 11
    ja ^fallback
    jump_table rsi, [^case0, ^case1, ^case2, ^case0, ^case1, ^case2, ^case0, ^case1, ^case2, ^case0, ^case1, ^case2]

  block ^fallback
    ret rdi

  block ^case2
    lea rax, [rdi-56]
    ret rax

  block ^case1
    lea rax, [rdi-48]
    ret rax

  block ^case0
    lea rax, [rdi-40]
    ret rax

function @distinct_cases
  abi
    param %p -> rdi : ptr
    param %kind -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 11
    ja ^fallback
    jump_table rsi, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5, ^case6, ^case7, ^case8, ^case9, ^case10, ^case11]

  block ^fallback
    ret rdi

  block ^case11
    lea rax, [rdi-128]
    ret rax

  block ^case10
    lea rax, [rdi-120]
    ret rax

  block ^case9
    lea rax, [rdi-112]
    ret rax

  block ^case8
    lea rax, [rdi-104]
    ret rax

  block ^case7
    lea rax, [rdi-96]
    ret rax

  block ^case6
    lea rax, [rdi-88]
    ret rax

  block ^case5
    lea rax, [rdi-80]
    ret rax

  block ^case4
    lea rax, [rdi-72]
    ret rax

  block ^case3
    lea rax, [rdi-64]
    ret rax

  block ^case2
    lea rax, [rdi-56]
    ret rax

  block ^case1
    lea rax, [rdi-48]
    ret rax

  block ^case0
    lea rax, [rdi-40]
    ret rax

function @shared_store_paths
  abi
    param %p -> rdi : ptr
    param %kind -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 11
    ja ^fallback
    jump_table rsi, [^case0, ^case1, ^case2, ^case0, ^case1, ^case2, ^case0, ^case1, ^case2, ^case0, ^case1, ^case2]

  block ^fallback
    store.i64 [rdi], 0
    jmp ^done

  block ^case2
    store.i64 [rdi], 3
    jmp ^done

  block ^case1
    store.i64 [rdi], 2
    jmp ^done

  block ^case0
    store.i64 [rdi], 1

  block ^done
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r13 r14 r15

  block ^entry
    mov rbx, @storage+256
    mov r14, 0

  block ^loop
    mov rdi, rbx
    mov rsi, r14
    call @shared_cases [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, rbx
    mov rsi, r14
    call @distinct_cases [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, rbx
    mov rsi, r14
    call @shared_store_paths [args=(rsi,rdi)]
    load.i64 rcx, [rbx]
    cmp.i64 r14, 12
    setb rsi
    mov rax, r14
    mov r11, -6148914691236517205
    mul r11
    shr rdx, 1
    imul rdx, 3
    mov rax, r14
    sub rax, rdx
    lea rdx, [rax+1]
    mov r11, 0
    test.u8 rsi, rsi
    cmove rdx, r11
    cmp.i64 rcx, rdx
    setne rcx
    imul rax, 8
    lea rdx, [r14*8]
    mov rdi, -40
    sub rdi, rax
    mov rax, -40
    sub rax, rdx
    lea rdi, [rbx+rdi]
    lea rax, [rbx+rax]
    test.u8 rsi, rsi
    cmove rdi, rbx
    cmove rax, rbx
    cmp.ptr r15, rdi
    setne r15
    cmp.ptr r13, rax
    setne r13
    or.u8 r15, r13
    or.u8 r15, rcx
    jne ^fail

  block ^next
    add r14, 1
    cmp.i64 r14, 16
    jne ^loop

  block ^done
    mov rax, 0
    ret rax

  block ^fail
    mov rax, 1
    ret rax
