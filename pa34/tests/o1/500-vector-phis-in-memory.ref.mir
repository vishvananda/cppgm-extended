    lea.i32 rax, [r8+r9]
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-288]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r8, xmm0
    sext.i32 r8
    fmov.v128 xmm15, [rbp-288]
    vector.toi32 r9, xmm15
    sext.i32 r9
    mov rdi, r8
    sub.i32 rdi, r9
    imul.i32 r8, 18
    add.i32 rax, r8
    add.i32 rax, rdi
    fmov.v128 xmm15, [rbp-304]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r8, xmm0
    sext.i32 r8
    fmov.v128 xmm15, [rbp-304]
    vector.toi32 r9, xmm15
    sext.i32 r9
    mov rdi, r8
    sub.i32 rdi, r9
    imul.i32 r8, 19
    add.i32 rax, r8
    add.i32 rax, rdi
    fmov.v128 xmm15, [rbp-320]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r8, xmm0
    sext.i32 r8
    fmov.v128 xmm15, [rbp-320]
    vector.toi32 r9, xmm15
    sext.i32 r9
    mov rdi, r8
    sub.i32 rdi, r9
    imul.i32 r8, 20
    add.i32 rax, r8
    add.i32 rax, rdi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 7
    call @rotate [args=(rdi)]
    cmp.i32 rax, 1960
    je ^pass

  block ^fail
    mov rax, 1
    ret rax

  block ^pass
    mov rax, 0
    ret rax
