    fmov.v128 xmm15, [rbp-160]
    fmov.v128 [rbp-144], xmm15
    fmov.v128 xmm15, [rbp-176]
    fmov.v128 [rbp-160], xmm15
    fmov.v128 xmm15, [rbp-192]
    fmov.v128 [rbp-176], xmm15
    fmov.v128 xmm15, [rbp-208]
    fmov.v128 [rbp-192], xmm15
    fmov.v128 xmm15, [rbp-224]
    fmov.v128 [rbp-208], xmm15
    fmov.v128 xmm15, [rbp-240]
    fmov.v128 [rbp-224], xmm15
    fmov.v128 xmm15, [rbp-256]
    fmov.v128 [rbp-240], xmm15
    fmov.v128 xmm15, [rbp-272]
    fmov.v128 [rbp-256], xmm15
    fmov.v128 xmm15, [rbp-288]
    fmov.v128 [rbp-272], xmm15
    fmov.v128 xmm15, [rbp-304]
    fmov.v128 [rbp-288], xmm15
    fmov.v128 xmm15, [rbp-320]
    fmov.v128 [rbp-304], xmm15
    fmov.v128 [rbp-320], xmm14
    cmp.i32 r12, rbx
    jge ^loop~done
    jmp ^body

  block ^done~check
    fmov.v128 xmm0, [rbp-336]

  block ^check
    vector.pshufd xmm1, xmm0, 3
    vector.toi32 r8, xmm1
    sext.i32 r8
    vector.toi32 r9, xmm0
    sext.i32 r9
    add.i32 r8, r9
    fmov.v128 xmm15, [rbp-32]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-32]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 1
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-48]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-48]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 2
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-64]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-64]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 3
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-16]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-16]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 4
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-80]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-80]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 5
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-96]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-96]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 6
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-112]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-112]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 7
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-128]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-128]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 8
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-144]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-144]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 9
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-160]
