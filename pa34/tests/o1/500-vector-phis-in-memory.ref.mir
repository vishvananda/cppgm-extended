machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ticks
  storage data
  item i32 0

function @tick
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i32 @ticks, 1
    ret

function @rotate
  abi
    param %rounds -> rdi : i32
    return i32 -> rax
  frame
    stack_size 448
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12
    temp %start0 -> [rbp-352] : v128
    temp %start14 -> [rbp-368] : v128
    temp %start15 -> [rbp-384] : v128
    temp %start16 -> [rbp-400] : v128
    temp %start17 -> [rbp-416] : v128
    temp %start18 -> [rbp-432] : v128
    temp %v0 -> [rbp-32] : v128
    temp %v1 -> [rbp-48] : v128
    temp %v2 -> [rbp-64] : v128
    temp %v3 -> [rbp-16] : v128
    temp %v4 -> [rbp-80] : v128
    temp %v5 -> [rbp-96] : v128
    temp %v6 -> [rbp-112] : v128
    temp %v7 -> [rbp-128] : v128
    temp %v8 -> [rbp-144] : v128
    temp %v9 -> [rbp-160] : v128
    temp %v10 -> [rbp-176] : v128
    temp %v11 -> [rbp-192] : v128
    temp %v12 -> [rbp-208] : v128
    temp %v13 -> [rbp-224] : v128
    temp %v14 -> [rbp-240] : v128
    temp %v15 -> [rbp-256] : v128
    temp %v16 -> [rbp-272] : v128
    temp %v17 -> [rbp-288] : v128
    temp %v18 -> [rbp-304] : v128
    temp %v19 -> [rbp-320] : v128
    temp %zero -> [rbp-336] : v128

  block ^entry
    mov r10, 1
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 2
    vector.fromi32 xmm1, r10
    vector.pshufd xmm1, xmm1, 0
    mov r10, 3
    vector.fromi32 xmm2, r10
    vector.pshufd xmm2, xmm2, 0
    mov r10, 4
    vector.fromi32 xmm3, r10
    vector.pshufd xmm3, xmm3, 0
    mov r10, 5
    vector.fromi32 xmm4, r10
    vector.pshufd xmm4, xmm4, 0
    mov r10, 6
    vector.fromi32 xmm5, r10
    vector.pshufd xmm5, xmm5, 0
    mov r10, 7
    vector.fromi32 xmm6, r10
    vector.pshufd xmm6, xmm6, 0
    mov r10, 8
    vector.fromi32 xmm7, r10
    vector.pshufd xmm7, xmm7, 0
    mov r10, 9
    vector.fromi32 xmm8, r10
    vector.pshufd xmm8, xmm8, 0
    mov r10, 10
    vector.fromi32 xmm9, r10
    vector.pshufd xmm9, xmm9, 0
    mov r10, 11
    vector.fromi32 xmm10, r10
    vector.pshufd xmm10, xmm10, 0
    mov r10, 12
    vector.fromi32 xmm11, r10
    vector.pshufd xmm11, xmm11, 0
    mov r10, 13
    vector.fromi32 xmm12, r10
    vector.pshufd xmm12, xmm12, 0
    mov r10, 14
    vector.fromi32 xmm13, r10
    vector.pshufd xmm13, xmm13, 0
    mov r10, 15
    fmov.v128 [rbp-352], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 16
    fmov.v128 [rbp-368], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 17
    fmov.v128 [rbp-384], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 18
    fmov.v128 [rbp-400], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 19
    fmov.v128 [rbp-416], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 20
    fmov.v128 [rbp-432], xmm0
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r12, 0
    mov rbx, rdi
    fmov.v128 xmm15, [rbp-352]
    fmov.v128 [rbp-32], xmm15
    fmov.v128 [rbp-48], xmm1
    fmov.v128 [rbp-64], xmm2
    fmov.v128 [rbp-16], xmm3
    fmov.v128 [rbp-80], xmm4
    fmov.v128 [rbp-96], xmm5
