    fmov.v128 [rbp-128], xmm7
    fmov.v128 [rbp-144], xmm8
    fmov.v128 [rbp-160], xmm9
    fmov.v128 [rbp-176], xmm10
    fmov.v128 [rbp-192], xmm11
    fmov.v128 [rbp-208], xmm12
    fmov.v128 [rbp-224], xmm13
    fmov.v128 xmm15, [rbp-368]
    fmov.v128 [rbp-240], xmm15
    fmov.v128 xmm15, [rbp-384]
    fmov.v128 [rbp-256], xmm15
    fmov.v128 xmm15, [rbp-400]
    fmov.v128 [rbp-272], xmm15
    fmov.v128 xmm15, [rbp-416]
    fmov.v128 [rbp-288], xmm15
    fmov.v128 xmm15, [rbp-432]
    fmov.v128 [rbp-304], xmm15
    fmov.v128 [rbp-320], xmm0
    vector.pzero xmm0

  block ^loop
    cmp.i32 r12, rbx
    jl ^body

  block ^loop~done
    fmov.v128 [rbp-336], xmm0

  block ^done
    call @tick [args=()]
    cmp.i32 rbx, 0
    je ^done~check

  block ^again
    call @tick [args=()]
    mov r12, 0
    mov rbx, 0
    vector.pzero xmm0
    cmp.i32 r12, rbx
    jge ^loop~done

  block ^body
    call @tick [args=()]
    add.i32 r12, 1
    fmov.v128 xmm0, [rbp-16]
    fmov.v128 xmm14, [rbp-32]
    fmov.v128 xmm15, [rbp-48]
    fmov.v128 [rbp-32], xmm15
    fmov.v128 xmm15, [rbp-64]
    fmov.v128 [rbp-48], xmm15
    fmov.v128 xmm15, [rbp-16]
    fmov.v128 [rbp-64], xmm15
