    sext.i32 r9
    fmov.v128 xmm15, [rbp-192]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 12
    add.i32 r8, r9
    add.i32 r8, rsi
    fmov.v128 xmm15, [rbp-208]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r9, xmm0
    sext.i32 r9
    fmov.v128 xmm15, [rbp-208]
    vector.toi32 rdi, xmm15
    sext.i32 rdi
    mov rsi, r9
    sub.i32 rsi, rdi
    imul.i32 r9, 13
    add.i32 r8, r9
