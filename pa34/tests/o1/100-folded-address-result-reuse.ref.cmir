machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item ptr 11
  item ptr 37
  item ptr 73

function @masked_index
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rsi
    shr rax, 1
    and rax, 8
    load.ptr rax, [rdi+rax+<off0>]

  block ^finish
    xor rdi, rsi
    xor rax, rdi
    ret rax

function @live_index
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rsi
    shr rax, 1
    and rax, 8
    load.ptr rcx, [rdi+rax+<off0>]

  block ^finish
    xor rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3>

  block ^entry
    mov <gpr0>, @cells
    mov rdi, <gpr0>
    mov rsi, 4
    call @masked_index [args=(rsi,rdi)]
    mov rcx, <gpr0>
    xor rcx, 4
    xor rcx, 37
    cmp.i64 rax, rcx
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdi, <gpr0>
    mov rsi, 16
    call @masked_index [args=(rsi,rdi)]
    mov rcx, <gpr0>
    xor rcx, 16
    xor rcx, 73
    cmp.i64 rax, rcx
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    mov rdi, <gpr0>
    mov rsi, 4
    call @live_index [args=(rsi,rdi)]
    cmp.i64 rax, 37
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdi, <gpr0>
    mov rsi, 16
    call @live_index [args=(rsi,rdi)]
    cmp.i64 rax, 65
    setne rax
    movzx rax, rax
    or.u32 <gpr2>, <gpr3>
    or.u32 <gpr1>, rax
    zext.i32 rax, <gpr2>
    or.u32 rax, <gpr1>
    ret rax
