machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @byte_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i8 [rdi], 1
    ret

function @word_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    xor.u16 [rdi], 32768
    ret

function @dword_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sub.i32 [rdi], 1
    ret

function @wide_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i16 [rdi], 1
    ret

function @truth_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    and rax, 1
    add rax, 1
    store.i8 [rdi], rax
    ret

function @volatile_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    add.u32 rax, 1
    zext.i8 rax
    store.i8 [rdi], rax
    ret

function @snapshot_update
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    store.i8 [rdi], 123
    add rax, 1
    store.i8 [rdi], rax
    ret

function @live_old_value
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    lea.i32 rcx, [rax+1]
    store.i8 [rdi], rcx
    ret rax

function @intervening_observation
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    load.u8 rcx, [rdi]
    add rax, 1
    store.i8 [rdi], rax
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $cell -> [rbp-8] : i64
    temp %bad_vol -> [rbp-16] : i64
    temp %bad_snapshot -> [rbp-24] : i64
    temp %bad_old -> [rbp-32] : i64
    temp %bad_new -> [rbp-40] : i64

  block ^entry
    store.i64 [rbp-8], 511
    lea rdi, [rbp-8]
    call @byte_update [args=(rdi)]
    cmp.i64 [rbp-8], 256
    setne rbx
    movzx rbx, rbx
    store.i64 [rbp-8], 65535
    lea rdi, [rbp-8]
    call @word_update [args=(rdi)]
    cmp.i64 [rbp-8], 32767
    setne r14
    movzx r14, r14
    store.i64 [rbp-8], 4294967296
    lea rdi, [rbp-8]
    call @dword_update [args=(rdi)]
    cmp.i64 [rbp-8], 8589934591
    setne r15
    movzx r15, r15
    store.i64 [rbp-8], 131071
    lea rdi, [rbp-8]
    call @wide_update [args=(rdi)]
    cmp.i64 [rbp-8], 65536
    setne r13
    movzx r13, r13
    store.i64 [rbp-8], 254
    lea rdi, [rbp-8]
    call @truth_update [args=(rdi)]
    cmp.i64 [rbp-8], 1
    setne r12
    movzx r12, r12
    store.i64 [rbp-8], 255
    lea rdi, [rbp-8]
    call @volatile_update [args=(rdi)]
    cmp.i64 [rbp-8], 0
    setne r10
    movzx r10, r10
    store.i64 [rbp-16], r10
    store.i64 [rbp-8], 254
    lea rdi, [rbp-8]
    call @snapshot_update [args=(rdi)]
    cmp.i64 [rbp-8], 255
    setne r10
    movzx r10, r10
    store.i64 [rbp-24], r10
    store.i64 [rbp-8], 255
    lea rdi, [rbp-8]
    call @live_old_value [args=(rdi)]
    cmp.i64 rax, 255
    setne r10
    movzx r10, r10
    store.i64 [rbp-32], r10
    cmp.i64 [rbp-8], 0
    setne r10
    movzx r10, r10
    store.i64 [rbp-40], r10
    store.i64 [rbp-8], 255
    lea rdi, [rbp-8]
    call @intervening_observation [args=(rdi)]
    cmp.i64 [rbp-8], 0
    setne rax
    movzx rax, rax
    or.u32 rbx, r14
    or.u32 r15, r13
    or.u32 r12, [rbp-16]
    load.u32 rcx, [rbp-24]
    or.u32 rcx, [rbp-32]
    or.u32 rbx, r15
    or.u32 r12, rcx
    or.u32 rbx, r12
    or.u32 rbx, [rbp-40]
    or.u32 rax, rbx
    ret rax
