machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @byte_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi], 128
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @half_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi+<off0>], 128
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @signed_promotion
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    test.i32 rdi, 256
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @before_store
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    and.i32 rax, 16
    store.i32 [rdi], 0
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @volatile_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rdi, [rdi]
    test.u8 rdi, 128
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @clear
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    store.i32 [rdi], 0
    mov rax, 0
    ret rax

function @before_call
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    load.u32 <gpr0>, [rdi]
    and.i32 <gpr0>, 16
    call @clear [args=(rdi)]
    cmp.i32 <gpr0>, 0
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @wide_mask
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi+<off1>], 1
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @two_readers
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    test.u8 rax, 16
    jne ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $data -> [rbp-<off0>] : i64
    temp %bad_full -> [rbp-<off1>] : i64
    temp %w -> [rbp-<off2>] : i32
    temp %f -> [rbp-<off3>] : i32
    temp %e -> [rbp-<off4>] : i32

  block ^entry
    store.i64 [rbp-<off0>], 4295000208
    lea rdi, [rbp-<off0>]
    call @byte_test [args=(rdi)]
    zext.i32 <gpr0>, rax
    lea rdi, [rbp-<off0>]
    call @half_test [args=(rdi)]
    zext.i32 <gpr1>, rax
    lea rdi, [rbp-<off0>]
    call @signed_promotion [args=(rdi)]
    zext.i32 <gpr2>, rax
    lea rdi, [rbp-<off0>]
    call @volatile_test [args=(rdi)]
    zext.i32 <gpr3>, rax
    lea rdi, [rbp-<off0>]
    call @wide_mask [args=(rdi)]
    zext.i32 <gpr4>, rax
    lea rdi, [rbp-<off0>]
    call @two_readers [args=(rdi)]
    cmp.i32 rax, 32912
    setne <gpr5>
    movzx <gpr5>, <gpr5>
    store.i64 [rbp-<off1>], <gpr5>
    lea rdi, [rbp-<off0>]
    call @before_store [args=(rdi)]
    store.i32 [rbp-<off2>], <gpr4>
    zext.i32 <gpr4>, rax
    store.i32 [rbp-<off0>], 32912
    lea rdi, [rbp-<off0>]
    call @before_call [args=(rdi)]
    zext.i32 <gpr5>, rax
    store.i32 [rbp-<off3>], <gpr5>
    lea rdi, [rbp-<off0>]
    call @byte_test [args=(rdi)]
    store.i32 [rbp-<off4>], <gpr4>
    sext.i32 <gpr4>, rax
    lea rdi, [rbp-<off0>]
    call @half_test [args=(rdi)]
    sext.i32 rax
    or <gpr4>, rax
    add.i32 <gpr0>, <gpr1>
    add.i32 <gpr2>, <gpr3>
    load.u32 rax, [rbp-<off4>]
    add.i32 rax, [rbp-<off3>]
    add.i32 <gpr0>, <gpr2>
    add.i32 <gpr0>, rax
    add.i32 <gpr0>, [rbp-<off2>]
    cmp.i32 <gpr0>, 7
    setne rax
    movzx rax, rax
    load.i64 <gpr6>, [rbp-<off1>]
    or rax, <gpr6>
    or rax, <gpr4>
    ret rax
