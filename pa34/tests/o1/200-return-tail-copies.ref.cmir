machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @probe
  abi
    param %array -> rdi : ptr
    param %key -> rsi : ptr
    param %mask -> rdx : u32
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rsi
    mov r9, rdx
    mov rax, 0
    mov rdx, 1
    mov rsi, 0
    load.ptr rcx, [rdi+rax*8]
    cmp.ptr rcx, -1
    jne ^occupied
    jmp ^found

  block ^end
    ret rsi

  block ^loop
    load.ptr rcx, [rdi+rax*8]
    cmp.ptr rcx, -1
    jne ^occupied

  block ^empty_bucket
    cmp.ptr rsi, 0
    je ^found

  block ^old_tomb
    ret rsi

  block ^found
    lea rax, [rdi+rax*8]
    ret rax

  block ^step
    lea.i32 rcx, [rdx+<off0>]
    add.u32 rax, rdx
    and.u32 rax, r9
    mov rdx, rcx
    load.ptr rcx, [rdi+rax*8]
    cmp.ptr rcx, -1
    je ^empty_bucket

  block ^occupied
    cmp.ptr rcx, r8
    je ^found

  block ^check_tomb
    cmp.ptr rcx, -2
    jne ^step

  block ^check_null
    cmp.ptr rsi, 0
    jne ^step

  block ^remember
    lea rsi, [rdi+rax*8]
    jmp ^step

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2>
    slot $data -> [rbp-<off0>] : obj<64x8>

  block ^entry
    lea <gpr0>, [rbp-<off0>]
    store.ptr [<gpr0>], -2
    lea <gpr1>, [<gpr0>+<off0>]
    store.ptr [<gpr1>], 3
    store.ptr [<gpr0>+<off1>], -1
    mov rdi, <gpr0>
    mov rsi, 3
    mov rdx, 7
    call @probe [args=(rdx,rsi,rdi)]
    mov <gpr2>, rax
    mov rdi, <gpr0>
    mov rsi, 4
    mov rdx, 7
    call @probe [args=(rdx,rsi,rdi)]
    cmp.ptr <gpr2>, <gpr1>
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.ptr rax, <gpr0>
    setne rax
    movzx rax, rax
    or rax, <gpr2>
    ret rax
