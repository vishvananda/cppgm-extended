machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @probe
  abi
    param %array -> rdi : ptr
    param %key -> rsi : ptr
    param %mask -> rdx : u32
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rcx, rsi
    mov rsi, rdi
    mov rax, rdx
    mov r8, 0
    mov rdi, 1
    mov rdx, 0
    load.ptr r9, [rsi+r8*8]
    cmp.ptr r9, -1
    jne ^occupied
    jmp ^found

  block ^end
    ret rdx

  block ^loop
    load.ptr r9, [rsi+r8*8]
    cmp.ptr r9, -1
    jne ^occupied

  block ^empty_bucket
    cmp.ptr rdx, 0
    je ^found

  block ^old_tomb
    ret rdx

  block ^found
    lea rax, [rsi+r8*8]
    ret rax

  block ^step
    lea.i32 r9, [rdi+<off0>]
    add.u32 r8, rdi
    and.u32 r8, rax
    mov rdi, r9
    load.ptr r9, [rsi+r8*8]
    cmp.ptr r9, -1
    je ^empty_bucket

  block ^occupied
    cmp.ptr r9, rcx
    je ^found

  block ^check_tomb
    cmp.ptr r9, -2
    jne ^step

  block ^check_null
    cmp.ptr rdx, 0
    jne ^step

  block ^remember
    lea rdx, [rsi+r8*8]
    jmp ^step

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2>
    slot $data -> [rbp-<off0>] : obj<64x8>

  block ^entry
    lea <gpr0>, [rbp-<off0>]
    store.ptr [<gpr0>], -2
    lea <gpr1>, [<gpr0>+<off0>]
    store.ptr [<gpr1>], 3
    store.ptr [<gpr0>+<off1>], -1
    mov rdi, <gpr0>
    mov rsi, 3
    mov rdx, 7
    call @probe [args=(rdx,rsi,rdi)]
    mov <gpr2>, rax
    mov rdi, <gpr0>
    mov rsi, 4
    mov rdx, 7
    call @probe [args=(rdx,rsi,rdi)]
    cmp.ptr <gpr2>, <gpr1>
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.ptr rax, <gpr0>
    setne rax
    movzx rax, rax
    or rax, <gpr2>
    ret rax
