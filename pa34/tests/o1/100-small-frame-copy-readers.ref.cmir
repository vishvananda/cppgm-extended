machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item i64 4
  item i64 0
  item i64 9

function @flag
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $copy -> [rbp-<off0>] : i64

  block ^entry
    load.i64 r8, [rdi]
    and r8, 4
    setne rax
    movzx rax, rax
    ret rax

function @mix
  abi
    param %p -> rdi : ptr
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $copy -> [rbp-<off0>] : i64

  block ^entry
    mov rax, rsi
    xor rax, [rdi+<off0>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, @data
    call @flag [args=(rdi)]
    mov <gpr0>, rax
    lea rdi, @data+8
    call @flag [args=(rdi)]
    mov <gpr1>, rax
    mov rdi, @data
    mov rsi, 4660
    call @mix [args=(rsi,rdi)]
    cmp.i64 <gpr0>, 1
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, 0
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 rax, 4669
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or rax, <gpr0>
    ret rax
