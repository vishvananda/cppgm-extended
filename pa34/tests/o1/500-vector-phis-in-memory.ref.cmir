machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ticks
  storage data
  item i32 0

function @tick
  abi
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i32 @ticks, 1
    ret

function @rotate
  abi
    param %rounds -> rdi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1>
    temp %start0 -> [rbp-<off0>] : v128
    temp %start14 -> [rbp-<off1>] : v128
    temp %start15 -> [rbp-<off2>] : v128
    temp %start16 -> [rbp-<off3>] : v128
    temp %start17 -> [rbp-<off4>] : v128
    temp %start18 -> [rbp-<off5>] : v128
    temp %v0 -> [rbp-<off6>] : v128
    temp %v1 -> [rbp-<off7>] : v128
    temp %v2 -> [rbp-<off8>] : v128
    temp %v3 -> [rbp-<off9>] : v128
    temp %v4 -> [rbp-<off10>] : v128
    temp %v5 -> [rbp-<off11>] : v128
    temp %v6 -> [rbp-<off12>] : v128
    temp %v7 -> [rbp-<off13>] : v128
    temp %v8 -> [rbp-<off14>] : v128
    temp %v9 -> [rbp-<off15>] : v128
    temp %v10 -> [rbp-<off16>] : v128
    temp %v11 -> [rbp-<off17>] : v128
    temp %v12 -> [rbp-<off18>] : v128
    temp %v13 -> [rbp-<off19>] : v128
    temp %v14 -> [rbp-<off20>] : v128
    temp %v15 -> [rbp-<off21>] : v128
    temp %v16 -> [rbp-<off22>] : v128
    temp %v17 -> [rbp-<off23>] : v128
    temp %v18 -> [rbp-<off24>] : v128
    temp %v19 -> [rbp-<off25>] : v128
    temp %zero -> [rbp-<off26>] : v128

  block ^entry
    mov <gpr2>, 1
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 2
    vector.fromi32 xmm1, <gpr2>
    vector.pshufd xmm1, xmm1, 0
    mov <gpr2>, 3
    vector.fromi32 <xmm0>, <gpr2>
    vector.pshufd <xmm0>, <xmm0>, 0
    mov <gpr2>, 4
    vector.fromi32 <xmm1>, <gpr2>
    vector.pshufd <xmm1>, <xmm1>, 0
    mov <gpr2>, 5
    vector.fromi32 <xmm2>, <gpr2>
    vector.pshufd <xmm2>, <xmm2>, 0
    mov <gpr2>, 6
    vector.fromi32 <xmm3>, <gpr2>
    vector.pshufd <xmm3>, <xmm3>, 0
    mov <gpr2>, 7
    vector.fromi32 <xmm4>, <gpr2>
    vector.pshufd <xmm4>, <xmm4>, 0
    mov <gpr2>, 8
    vector.fromi32 <xmm5>, <gpr2>
    vector.pshufd <xmm5>, <xmm5>, 0
    mov <gpr2>, 9
    vector.fromi32 xmm8, <gpr2>
    vector.pshufd xmm8, xmm8, 0
    mov <gpr2>, 10
    vector.fromi32 xmm9, <gpr2>
    vector.pshufd xmm9, xmm9, 0
    mov <gpr2>, 11
    vector.fromi32 xmm10, <gpr2>
    vector.pshufd xmm10, xmm10, 0
    mov <gpr2>, 12
    vector.fromi32 xmm11, <gpr2>
    vector.pshufd xmm11, xmm11, 0
    mov <gpr2>, 13
    vector.fromi32 xmm12, <gpr2>
    vector.pshufd xmm12, xmm12, 0
    mov <gpr2>, 14
    vector.fromi32 xmm13, <gpr2>
    vector.pshufd xmm13, xmm13, 0
    mov <gpr2>, 15
    fmov.v128 [rbp-<off0>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 16
    fmov.v128 [rbp-<off1>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 17
    fmov.v128 [rbp-<off2>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 18
    fmov.v128 [rbp-<off3>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 19
    fmov.v128 [rbp-<off4>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr2>, 20
    fmov.v128 [rbp-<off5>], xmm0
    vector.fromi32 xmm0, <gpr2>
    vector.pshufd xmm0, xmm0, 0
    mov <gpr1>, 0
    zext.i32 <gpr0>, rdi
    fmov.v128 xmm15, [rbp-<off0>]
    fmov.v128 [rbp-<off6>], xmm15
    fmov.v128 [rbp-<off7>], xmm1
    fmov.v128 [rbp-<off8>], <xmm0>
    fmov.v128 [rbp-<off9>], <xmm1>
    fmov.v128 [rbp-<off10>], <xmm2>
    fmov.v128 [rbp-<off11>], <xmm3>
    fmov.v128 [rbp-<off12>], <xmm4>
    fmov.v128 [rbp-<off13>], <xmm5>
    fmov.v128 [rbp-<off14>], xmm8
    fmov.v128 [rbp-<off15>], xmm9
    fmov.v128 [rbp-<off16>], xmm10
    fmov.v128 [rbp-<off17>], xmm11
    fmov.v128 [rbp-<off18>], xmm12
    fmov.v128 [rbp-<off19>], xmm13
    fmov.v128 xmm15, [rbp-<off1>]
    fmov.v128 [rbp-<off20>], xmm15
    fmov.v128 xmm15, [rbp-<off2>]
    fmov.v128 [rbp-<off21>], xmm15
    fmov.v128 xmm15, [rbp-<off3>]
    fmov.v128 [rbp-<off22>], xmm15
    fmov.v128 xmm15, [rbp-<off4>]
    fmov.v128 [rbp-<off23>], xmm15
    fmov.v128 xmm15, [rbp-<off5>]
    fmov.v128 [rbp-<off24>], xmm15
    fmov.v128 [rbp-<off25>], xmm0
    vector.pzero xmm0

  block ^loop
    cmp.i32 <gpr1>, <gpr0>
    jge ^loop~done

  block ^body
    call @tick [args=()]
    add.i32 <gpr1>, 1
    fmov.v128 xmm0, [rbp-<off9>]
    fmov.v128 xmm14, [rbp-<off6>]
    fmov.v128 xmm15, [rbp-<off7>]
    fmov.v128 [rbp-<off6>], xmm15
    fmov.v128 xmm15, [rbp-<off8>]
    fmov.v128 [rbp-<off7>], xmm15
    fmov.v128 xmm15, [rbp-<off9>]
    fmov.v128 [rbp-<off8>], xmm15
    fmov.v128 xmm15, [rbp-<off10>]
    fmov.v128 [rbp-<off9>], xmm15
    fmov.v128 xmm15, [rbp-<off11>]
    fmov.v128 [rbp-<off10>], xmm15
    fmov.v128 xmm15, [rbp-<off12>]
    fmov.v128 [rbp-<off11>], xmm15
    fmov.v128 xmm15, [rbp-<off13>]
    fmov.v128 [rbp-<off12>], xmm15
    fmov.v128 xmm15, [rbp-<off14>]
    fmov.v128 [rbp-<off13>], xmm15
    fmov.v128 xmm15, [rbp-<off15>]
    fmov.v128 [rbp-<off14>], xmm15
    fmov.v128 xmm15, [rbp-<off16>]
    fmov.v128 [rbp-<off15>], xmm15
    fmov.v128 xmm15, [rbp-<off17>]
    fmov.v128 [rbp-<off16>], xmm15
    fmov.v128 xmm15, [rbp-<off18>]
    fmov.v128 [rbp-<off17>], xmm15
    fmov.v128 xmm15, [rbp-<off19>]
    fmov.v128 [rbp-<off18>], xmm15
    fmov.v128 xmm15, [rbp-<off20>]
    fmov.v128 [rbp-<off19>], xmm15
    fmov.v128 xmm15, [rbp-<off21>]
    fmov.v128 [rbp-<off20>], xmm15
    fmov.v128 xmm15, [rbp-<off22>]
    fmov.v128 [rbp-<off21>], xmm15
    fmov.v128 xmm15, [rbp-<off23>]
    fmov.v128 [rbp-<off22>], xmm15
    fmov.v128 xmm15, [rbp-<off24>]
    fmov.v128 [rbp-<off23>], xmm15
    fmov.v128 xmm15, [rbp-<off25>]
    fmov.v128 [rbp-<off24>], xmm15
    fmov.v128 [rbp-<off25>], xmm14
    cmp.i32 <gpr1>, <gpr0>
    jl ^body

  block ^loop~done
    fmov.v128 [rbp-<off26>], xmm0

  block ^done
    call @tick [args=()]
    cmp.i32 <gpr0>, 0
    je ^done~check

  block ^again
    call @tick [args=()]
    mov <gpr1>, 0
    mov <gpr0>, 0
    vector.pzero xmm0
    cmp.i32 <gpr1>, <gpr0>
    jge ^loop~done
    jmp ^body

  block ^done~check
    fmov.v128 xmm0, [rbp-<off26>]

  block ^check
    vector.pshufd xmm1, xmm0, 3
    vector.toi32 rax, xmm1
    vector.toi32 rcx, xmm0
    sext.i32 rcx
    add.i32 rax, rcx
    fmov.v128 xmm15, [rbp-<off6>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off6>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 1
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off7>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off7>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 2
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off8>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off8>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 3
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off9>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off9>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 4
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off10>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off10>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 5
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off11>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off11>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 6
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off12>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off12>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 7
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off13>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off13>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 8
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off14>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off14>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 9
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off15>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off15>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 10
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off16>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off16>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 11
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off17>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off17>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 12
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off18>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off18>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 13
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off19>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off19>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 14
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off20>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off20>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 15
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off21>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off21>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 16
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off22>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off22>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 17
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off23>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off23>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 18
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off24>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off24>]
    vector.toi32 rdx, xmm15
    sext.i32 rdx
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 19
    add.i32 rax, rcx
    add.i32 rax, rsi
    fmov.v128 xmm15, [rbp-<off25>]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 rcx, xmm0
    fmov.v128 xmm15, [rbp-<off25>]
    vector.toi32 rdx, xmm15
    zext.i32 rsi, rcx
    sub.i32 rsi, rdx
    imul.i32 rcx, 20
    add.i32 rax, rcx
    add.i32 rax, rsi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 7
    call @rotate [args=(rdi)]
    cmp.i32 rax, 1960
    je ^pass

  block ^fail
    mov rax, 1
    ret rax

  block ^pass
    mov rax, 0
    ret rax
