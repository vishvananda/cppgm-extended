machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @negative32
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sub.i32 rdi, rsi
    sets rax
    movzx rax, rax
    ret rax

function @nonnegative64
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add rdi, rsi
    js ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @mixed_conditions
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i32 rdi, rsi
    cmp.i32 rdi, 0
    setg rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov rdi, -2147483648
    mov rsi, 1
    call @negative32 [args=(rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 2147483647
    mov rsi, -1
    call @negative32 [args=(rsi,rdi)]
    zext.i32 r12, rax
    mov rdi, 9223372036854775807
    mov rsi, 1
    call @nonnegative64 [args=(rsi,rdi)]
    zext.i32 r13, rax
    mov rdi, -9223372036854775808
    mov rsi, -1
    call @nonnegative64 [args=(rsi,rdi)]
    zext.i32 r14, rax
    mov rdi, 2147483647
    mov rsi, 1
    call @mixed_conditions [args=(rsi,rdi)]
    zext.i32 r15, rax
    mov rdi, -2147483648
    mov rsi, -1
    call @mixed_conditions [args=(rsi,rdi)]
    add.i32 rbx, r12
    add.i32 r13, r14
    add.i32 r15, rax
    add.i32 rbx, r13
    add.i32 rbx, r15
    cmp.i32 rbx, 3
    setne rax
    movzx rax, rax
    ret rax
