machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item i64 4
  item i64 0
  item i64 9

function @flag
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $copy -> [rbp-8] : i64

  block ^entry
    load.u32 rax, [rdi]
    and rax, 4
    setne rax
    movzx rax, rax
    ret rax

function @mix
  abi
    param %p -> rdi : ptr
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $copy -> [rbp-8] : i64

  block ^entry
    mov rax, rsi
    xor rax, [rdi+16]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12

  block ^entry
    mov rdi, @data
    call @flag [args=(rdi)]
    mov rbx, rax
    lea rdi, @data+8
    call @flag [args=(rdi)]
    mov r12, rax
    mov rdi, @data
    mov rsi, 4660
    call @mix [args=(rsi,rdi)]
    cmp.i64 rbx, 1
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 0
    setne r12
    movzx r12, r12
    cmp.i64 rax, 4669
    setne rax
    movzx rax, rax
    or.u32 rbx, r12
    or.u32 rax, rbx
    ret rax
