machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @byte_return
  abi
    param %p -> rdi : ptr
    return obj<1x1> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $result -> [rbp-<off0>] : obj<1x1>

  block ^entry
    load.u8 rax, [rdi]
    ret rax

function @half_return
  abi
    param %p -> rdi : ptr
    return obj<2x2> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $result -> [rbp-<off0>] : obj<2x2>

  block ^entry
    load.u16 rax, [rdi]
    ret rax

function @tail_return
  abi
    param %p -> rdi : ptr
    return obj<9x1> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $result -> [rbp-<off1>] : obj<9x1>

  block ^entry
    load.i64 rax, [rdi]
    load.u8 rdi, [rdi+<off0>]
    mov rdx, rdi
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $input -> [rbp-<off2>] : obj<16x8>
    slot $byte -> [rbp-<off3>] : obj<1x1>
    slot $half -> [rbp-<off4>] : obj<2x2>
    slot $tail -> [rbp-<off5>] : obj<9x1>
    temp %byte -> [rbp-<off0>] : obj<1x1>
    temp %half -> [rbp-<off6>] : obj<2x2>
    temp %tail -> [rbp-<off7>] : obj<9x1>

  block ^entry
    store.i64 [rbp-<off2>], -1
    store.u8 [rbp-<off1>], 137
    lea rdi, [rbp-<off2>]
    call @byte_return [args=(rdi)]
    store.i64 [rbp-<off0>], rax
    lea rdi, [rbp-<off2>]
    call @half_return [args=(rdi)]
    store.i64 [rbp-<off6>], rax
    lea rdi, [rbp-<off2>]
    call @tail_return [args=(rdi)]
    store.i64 [rbp-<off7>], rax
    store.i64 [rbp-<off8>], rdx
    copy_bytes 1x1, [rbp-<off3>], [rbp-<off0>]
    cmp.u8 [rbp-<off0>], 255
    setne rax
    movzx rax, rax
    cmp.u16 [rbp-<off6>], 65535
    setne rcx
    movzx rcx, rcx
    cmp.i64 [rbp-<off7>], -1
    setne rdx
    movzx rdx, rdx
    cmp.u8 [rbp-<off8>], 137
    setne rsi
    movzx rsi, rsi
    or rax, rcx
    or rdx, rsi
    or rax, rdx
    ret rax
