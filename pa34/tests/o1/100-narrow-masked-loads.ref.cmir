machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @byte
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    ret rax

function @half
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u16 rax, [rdi]
    ret rax

function @word
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    ret rax

function @signed_word
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    ret rax

function @signed_byte
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rax, [rdi]
    ret rax

function @no_widen_byte
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rax, [rdi]
    and rax, 65535
    ret rax

function @no_widen_half
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i16 rax, [rdi]
    and rax, 4294967295
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $data -> [rbp-<off0>] : i64
    temp %b5 -> [rbp-<off1>] : i64

  block ^entry
    store.i64 [rbp-<off0>], -1
    lea rdi, [rbp-<off0>]
    call @byte [args=(rdi)]
    cmp.i64 rax, 255
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    lea rdi, [rbp-<off0>]
    call @half [args=(rdi)]
    cmp.i64 rax, 65535
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    lea rdi, [rbp-<off0>]
    call @word [args=(rdi)]
    cmp.i64 rax, 4294967295
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    lea rdi, [rbp-<off0>]
    call @signed_word [args=(rdi)]
    cmp.i64 rax, 4294967295
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    store.i64 [rbp-<off0>], 255
    lea rdi, [rbp-<off0>]
    call @signed_byte [args=(rdi)]
    cmp.i64 rax, 255
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    lea rdi, [rbp-<off0>]
    call @no_widen_byte [args=(rdi)]
    cmp.i64 rax, 65535
    setne <gpr5>
    movzx <gpr5>, <gpr5>
    store.i64 [rbp-<off1>], <gpr5>
    store.i64 [rbp-<off0>], 65535
    lea rdi, [rbp-<off0>]
    call @no_widen_half [args=(rdi)]
    cmp.i64 rax, 4294967295
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr3>
    or <gpr0>, <gpr4>
    or <gpr0>, <gpr2>
    or <gpr0>, <gpr1>
    or <gpr0>, [rbp-<off1>]
    or rax, <gpr0>
    ret rax
