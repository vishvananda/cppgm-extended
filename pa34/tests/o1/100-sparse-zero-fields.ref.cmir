machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @fields
  storage data
  item i64 11
  item i64 22
  item i64 77
  item i64 33
  item i64 44
  item i64 55
  item i64 66
  item i64 88

function @sparse_fields
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zero_bytes 16x1, [rdi]
    zero_bytes 32x1, [rdi+<off0>]
    store.i64 [rdi+<off1>], 9
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, @fields
    call @sparse_fields [args=(rdi), unwind=no]
    mov rax, 0

  block ^loop
    lea rcx, [rax*8]
    mov <gpr0>, @fields
    add rcx, <gpr0>
    mov rdx, 0
    cmp.i64 rax, 7
    mov <gpr1>, 9
    cmove rdx, <gpr1>
    cmp.i64 rax, 2
    mov <gpr1>, 77
    cmove rdx, <gpr1>
    cmp.i64 rdx, [rcx]
    jne ^fail

  block ^next
    add rax, 1
    cmp.i64 rax, 8
    jb ^loop

  block ^done
    mov rax, 0
    ret rax

  block ^fail
    mov rax, 1
    ret rax
