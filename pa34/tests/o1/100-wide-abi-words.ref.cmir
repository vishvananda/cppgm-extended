machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pair
  abi
    param %low -> rdi : i64
    param %high -> rsi : i64
    return i128 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, rsi
    ret

function @parts
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    xor rax, rsi
    ret rax

function @stack_parts
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %value -> [rbp+<off0>] : i128
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rax, [rbp+<off0>]
    load.i64 rcx, [rbp+<off1>]
    xor rax, rcx
    add rax, r9
    ret rax

function @low_only
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @call_low_only
  abi
    param %low -> rdi : i64
    param %high -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @pair [args=(rsi,rdi)]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %low -> [rbp-<off0>] : i64

  block ^entry
    mov rdi, 305419896
    mov rsi, 4275878552
    call @pair [args=(rsi,rdi)]
    mov <gpr0>, rax
    mov <gpr3>, rdx
    cmp.i64 <gpr0>, 305419896
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    cmp.i64 <gpr3>, 4275878552
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdi, <gpr0>
    mov rsi, <gpr3>
    call @parts [args=(rsi,rdi)]
    mov <gpr1>, <gpr0>
    xor <gpr1>, <gpr3>
    store.i64 [rbp-<off0>], <gpr0>
    cmp.i64 rax, <gpr1>
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    sub rsp, 16
    load.i64 <gpr5>, [rbp-<off0>]
    store.i64 [rsp], <gpr5>
    store.i64 [rsp+<off0>], <gpr3>
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @stack_parts [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    add <gpr1>, 6
    cmp.i64 rax, <gpr1>
    setne rax
    movzx rax, rax
    or <gpr4>, <gpr2>
    or <gpr0>, rax
    or <gpr4>, <gpr0>
    load.i64 rdi, [rbp-<off0>]
    mov rsi, <gpr3>
    call @low_only [args=(rsi,rdi)]
    cmp.i64 rax, 305419896
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdi, 305419896
    mov rsi, 4275878552
    call @call_low_only [args=(rsi,rdi)]
    cmp.i64 rax, 305419896
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    mov rax, <gpr4>
    or rax, <gpr0>
    ret rax
