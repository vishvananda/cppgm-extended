machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @calls
  storage scalar i64
  init i64 0

function @effect
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rax, @calls
    add rax, 3
    store.i64 @calls, rax
    mov rax, rdi
    xor rax, 90
    ret rax

function @other
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rax, @calls
    add rax, 5
    store.i64 @calls, rax
    mov rax, rdi
    xor rax, 91
    ret rax

function @worker
  abi
    param %n -> rdi : i64
    param %x -> rsi : i64
    param %d -> rdx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx
    param-slot %d -> [rbp-8] : i64

  block ^entry
    mov rbx, rsi
    cmp.i64 rdi, 7
    ja ^fallback
    jump_table rdi, [^entry~c5, ^entry~c5, ^entry~c5, ^entry~c5, ^entry~c5, ^entry~c5, ^entry~c6, ^entry~c7]

  block ^entry~c5
    store.i64 [rbp-8], rdx

  block ^c5
    mov rdi, rbx
    call @effect [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, rbx
    mov rdx, 0
    div [rbp-8]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, rbx
    xor rax, 255
    ret rax

  block ^entry~c6
    store.i64 [rbp-8], rdx

  block ^c6
    mov rdi, rbx
    call @other [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, rbx
    mov rdx, 0
    div [rbp-8]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, rbx
    xor rax, 255
    ret rax

  block ^entry~c7
    store.i64 [rbp-8], rdx

  block ^c7
    mov rdi, rbx
    call @effect [args=(rdi)]
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    xor rax, rbx
    cqo
    idiv [rbp-8]
    imul rax, 13
    add rax, 29
    xor rax, 77
    shl rax, 5
    or rax, 7
    add rax, rbx
    xor rax, 255
    ret rax

  block ^fallback
    mov rax, 999
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov r12, 0
    mov rbx, 781331
    mov r13, 0

  block ^loop
    mov r11, 6364136223846793005
    imul rbx, r11
    add rbx, 1
    mov rax, r12
    mov r11, -2049638230412172401
    mul r11
    shr rdx, 3
    imul rdx, 9
    mov rax, r12
    sub rax, rdx
    mov r14, rax
    mov rax, r12
    and rax, 63
    lea r15, [rax+1]
    mov rdi, r14
    mov rsi, rbx
    mov rdx, r15
    call @worker [args=(rdx,rsi,rdi)]
    mov rcx, rax
    cmp.i64 r14, 6
    sete rsi
    cmp.i64 r14, 8
    sete rdi
    test.u8 rsi, rsi
    mov r11, 91
    mov rax, 90
    cmovne rax, r11
    xor rax, rbx
    xor rax, 33
    imul rax, 17
    add rax, 11
    shr rax, 3
    mov r8, rax
    xor r8, rbx
    mov rax, r8
    mov rdx, 0
    div r15
    mov r9, rax
    mov rax, r8
    cqo
    idiv r15
    cmp.i64 r14, 7
    cmove r9, rax
    imul r9, 13
    add r9, 29
    xor r9, 77
    shl r9, 5
    or r9, 7
    add r9, rbx
    xor r9, 255
    test.u8 rdi, rdi
    mov r11, 999
    cmovne r9, r11
    test.u8 rsi, rsi
    mov r11, 5
    mov rax, 3
    cmovne rax, r11
    test.u8 rdi, rdi
    mov r11, 0
    cmovne rax, r11
    add r13, rax
    load.i64 rax, @calls
    cmp.i64 rcx, r9
    setne rcx
    movzx rcx, rcx
    cmp.i64 rax, r13
    setne rax
    movzx rax, rax
    or rcx, rax
    jne ^fail

  block ^next
    add r12, 1
    cmp.i64 r12, 4096
    jne ^loop
    jmp ^done

  block ^fail
    mov rax, 1
    ret rax

  block ^done
    mov rax, 0
    ret rax
