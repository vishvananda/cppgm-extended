machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @byte_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi], 128
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @half_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi+1], 128
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @signed_promotion
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i8 rdi, [rdi]
    test.i32 rdi, 256
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @before_store
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    and.i32 rax, 16
    store.i32 [rdi], 0
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @volatile_test
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u8 rdi, [rdi]
    test.u8 rdi, 128
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @clear
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    store.i32 [rdi], 0
    mov rax, 0
    ret rax

function @before_call
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    load.u32 rbx, [rdi]
    and.i32 rbx, 16
    call @clear [args=(rdi)]
    cmp.i32 rbx, 0
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @wide_mask
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi+4], 1
    je ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @two_readers
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    test.u8 rax, 16
    je ^no

  block ^yes
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $data -> [rbp-8] : i64
    temp %bad_full -> [rbp-16] : i64
    temp %w -> [rbp-24] : i32
    temp %f -> [rbp-32] : i32
    temp %e -> [rbp-40] : i32

  block ^entry
    store.i64 [rbp-8], 4295000208
    lea rdi, [rbp-8]
    call @byte_test [args=(rdi)]
    zext.i32 rbx, rax
    lea rdi, [rbp-8]
    call @half_test [args=(rdi)]
    zext.i32 r12, rax
    lea rdi, [rbp-8]
    call @signed_promotion [args=(rdi)]
    zext.i32 r13, rax
    lea rdi, [rbp-8]
    call @volatile_test [args=(rdi)]
    zext.i32 r14, rax
    lea rdi, [rbp-8]
    call @wide_mask [args=(rdi)]
    zext.i32 r15, rax
    lea rdi, [rbp-8]
    call @two_readers [args=(rdi)]
    cmp.i32 rax, 32912
    setne r10
    movzx r10, r10
    store.i64 [rbp-16], r10
    lea rdi, [rbp-8]
    call @before_store [args=(rdi)]
    store.i32 [rbp-24], r15
    zext.i32 r15, rax
    store.i32 [rbp-8], 32912
    lea rdi, [rbp-8]
    call @before_call [args=(rdi)]
    zext.i32 r10, rax
    store.i32 [rbp-32], r10
    lea rdi, [rbp-8]
    call @byte_test [args=(rdi)]
    store.i32 [rbp-40], r15
    sext.i32 r15, rax
    lea rdi, [rbp-8]
    call @half_test [args=(rdi)]
    sext.i32 rax
    or r15, rax
    add.i32 rbx, r12
    add.i32 r13, r14
    load.u32 rax, [rbp-40]
    add.i32 rax, [rbp-32]
    add.i32 rbx, r13
    add.i32 rbx, rax
    add.i32 rbx, [rbp-24]
    cmp.i32 rbx, 7
    setne rax
    movzx rax, rax
    load.i64 r11, [rbp-16]
    or rax, r11
    or rax, r15
    ret rax
