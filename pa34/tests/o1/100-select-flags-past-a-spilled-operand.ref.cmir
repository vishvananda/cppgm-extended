machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @clamp
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %out -> rdx : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %y4 -> [rbp-<off0>] : i32
    temp %x5 -> [rbp-<off1>] : i32
    temp %y5 -> [rbp-<off2>] : i32
    temp %x6 -> [rbp-<off3>] : i32
    temp %y6 -> [rbp-<off4>] : i32
    temp %x7 -> [rbp-<off5>] : i32
    temp %y7 -> [rbp-<off6>] : i32
    temp %x8 -> [rbp-<off7>] : i32
    temp %y8 -> [rbp-<off8>] : i32
    temp %x9 -> [rbp-<off9>] : i32
    temp %y9 -> [rbp-<off10>] : i32
    temp %x10 -> [rbp-<off11>] : i32
    temp %y10 -> [rbp-<off12>] : i32
    temp %x11 -> [rbp-<off13>] : i32
    temp %y11 -> [rbp-<off14>] : i32
    temp %x12 -> [rbp-<off15>] : i32
    temp %y12 -> [rbp-<off16>] : i32
    temp %x13 -> [rbp-<off17>] : i32
    temp %y13 -> [rbp-<off18>] : i32
    temp %x14 -> [rbp-<off19>] : i32
    temp %y14 -> [rbp-<off20>] : i32
    temp %c8 -> [rbp-<off1>] : i32
    temp %c9 -> [rbp-<off3>] : i32
    temp %c10 -> [rbp-<off5>] : i32
    temp %c11 -> [rbp-<off7>] : i32
    temp %c12 -> [rbp-<off9>] : i32
    temp %c13 -> [rbp-<off11>] : i32

  block ^entry
    load.u32 rax, [rdi]
    load.u32 rcx, [rsi]
    load.u32 r8, [rdi+<off0>]
    load.u32 r9, [rsi+<off0>]
    load.u32 <gpr0>, [rdi+<off1>]
    load.u32 <gpr3>, [rsi+<off1>]
    load.u32 <gpr4>, [rdi+<off2>]
    load.u32 <gpr2>, [rsi+<off2>]
    load.u32 <gpr1>, [rdi+<off3>]
    load.u32 <gpr5>, [rsi+<off3>]
    store.i32 [rbp-<off0>], <gpr5>
    load.u32 <gpr5>, [rdi+<off4>]
    store.i32 [rbp-<off1>], <gpr5>
    load.u32 <gpr5>, [rsi+<off4>]
    store.i32 [rbp-<off2>], <gpr5>
    load.u32 <gpr5>, [rdi+<off5>]
    store.i32 [rbp-<off3>], <gpr5>
    load.u32 <gpr5>, [rsi+<off5>]
    store.i32 [rbp-<off4>], <gpr5>
    load.u32 <gpr5>, [rdi+<off6>]
    store.i32 [rbp-<off5>], <gpr5>
    load.u32 <gpr5>, [rsi+<off6>]
    store.i32 [rbp-<off6>], <gpr5>
    load.u32 <gpr5>, [rdi+<off7>]
    store.i32 [rbp-<off7>], <gpr5>
    load.u32 <gpr5>, [rsi+<off7>]
    store.i32 [rbp-<off8>], <gpr5>
    load.u32 <gpr5>, [rdi+<off8>]
    store.i32 [rbp-<off9>], <gpr5>
    load.u32 <gpr5>, [rsi+<off8>]
    store.i32 [rbp-<off10>], <gpr5>
    load.u32 <gpr5>, [rdi+<off9>]
    store.i32 [rbp-<off11>], <gpr5>
    load.u32 <gpr5>, [rsi+<off9>]
    store.i32 [rbp-<off12>], <gpr5>
    load.u32 <gpr5>, [rdi+<off10>]
    store.i32 [rbp-<off13>], <gpr5>
    load.u32 <gpr5>, [rsi+<off10>]
    store.i32 [rbp-<off14>], <gpr5>
    load.u32 <gpr5>, [rdi+<off11>]
    store.i32 [rbp-<off15>], <gpr5>
    load.u32 <gpr5>, [rsi+<off11>]
    store.i32 [rbp-<off16>], <gpr5>
    load.u32 <gpr5>, [rdi+<off12>]
    store.i32 [rbp-<off17>], <gpr5>
    load.u32 <gpr5>, [rsi+<off12>]
    store.i32 [rbp-<off18>], <gpr5>
    load.u32 <gpr5>, [rdi+<off13>]
    store.i32 [rbp-<off19>], <gpr5>
    load.u32 <gpr5>, [rsi+<off13>]
    store.i32 [rbp-<off20>], <gpr5>
    load.u32 rdi, [rdi+<off14>]
    load.u32 rsi, [rsi+<off14>]
    sub.i32 rax, rcx
    mov <gpr6>, 0
    cmp.i32 rax, 0
    cmovl rax, <gpr6>
    cmp.i32 rax, 255
    mov <gpr6>, 255
    cmovg rax, <gpr6>
    sub.i32 r8, r9
    mov <gpr6>, 0
    cmp.i32 r8, 0
    cmovl r8, <gpr6>
    cmp.i32 r8, 255
    mov <gpr6>, 255
    cmovg r8, <gpr6>
    sub.i32 <gpr0>, <gpr3>
    mov <gpr6>, 0
    cmp.i32 <gpr0>, 0
    cmovl <gpr0>, <gpr6>
    cmp.i32 <gpr0>, 255
    mov <gpr6>, 255
    cmovg <gpr0>, <gpr6>
    sub.i32 <gpr4>, <gpr2>
    mov <gpr6>, 0
    cmp.i32 <gpr4>, 0
    cmovl <gpr4>, <gpr6>
    cmp.i32 <gpr4>, 255
    mov <gpr6>, 255
    cmovg <gpr4>, <gpr6>
    sub.i32 <gpr1>, [rbp-<off0>]
    mov <gpr6>, 0
    cmp.i32 <gpr1>, 0
    cmovl <gpr1>, <gpr6>
    cmp.i32 <gpr1>, 255
    mov <gpr6>, 255
    cmovg <gpr1>, <gpr6>
    load.u32 rcx, [rbp-<off1>]
    sub.i32 rcx, [rbp-<off2>]
    mov <gpr6>, 0
    cmp.i32 rcx, 0
    cmovl rcx, <gpr6>
    cmp.i32 rcx, 255
    mov <gpr6>, 255
    cmovg rcx, <gpr6>
    load.u32 r9, [rbp-<off3>]
    sub.i32 r9, [rbp-<off4>]
    mov <gpr6>, 0
    cmp.i32 r9, 0
    cmovl r9, <gpr6>
    cmp.i32 r9, 255
    mov <gpr6>, 255
    cmovg r9, <gpr6>
    load.u32 <gpr3>, [rbp-<off5>]
    sub.i32 <gpr3>, [rbp-<off6>]
    mov <gpr6>, 0
    cmp.i32 <gpr3>, 0
    cmovl <gpr3>, <gpr6>
    cmp.i32 <gpr3>, 255
    mov <gpr6>, 255
    cmovg <gpr3>, <gpr6>
    load.u32 <gpr2>, [rbp-<off7>]
    sub.i32 <gpr2>, [rbp-<off8>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off1>], <gpr2>
    load.u32 <gpr2>, [rbp-<off9>]
    sub.i32 <gpr2>, [rbp-<off10>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off3>], <gpr2>
    load.u32 <gpr2>, [rbp-<off11>]
    sub.i32 <gpr2>, [rbp-<off12>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off5>], <gpr2>
    load.u32 <gpr2>, [rbp-<off13>]
    sub.i32 <gpr2>, [rbp-<off14>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off7>], <gpr2>
    load.u32 <gpr2>, [rbp-<off15>]
    sub.i32 <gpr2>, [rbp-<off16>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off9>], <gpr2>
    load.u32 <gpr2>, [rbp-<off17>]
    sub.i32 <gpr2>, [rbp-<off18>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    store.i32 [rbp-<off11>], <gpr2>
    load.u32 <gpr2>, [rbp-<off19>]
    sub.i32 <gpr2>, [rbp-<off20>]
    mov <gpr6>, 0
    cmp.i32 <gpr2>, 0
    cmovl <gpr2>, <gpr6>
    cmp.i32 <gpr2>, 255
    mov <gpr6>, 255
    cmovg <gpr2>, <gpr6>
    sub.i32 rdi, rsi
    mov <gpr6>, 0
    cmp.i32 rdi, 0
    cmovl rdi, <gpr6>
    cmp.i32 rdi, 255
    mov <gpr6>, 255
    cmovg rdi, <gpr6>
    store.i32 [rdx], rax
    store.i32 [rdx+<off0>], r8
    store.i32 [rdx+<off1>], <gpr0>
    store.i32 [rdx+<off2>], <gpr4>
    store.i32 [rdx+<off3>], <gpr1>
    store.i32 [rdx+<off4>], rcx
    store.i32 [rdx+<off5>], r9
    store.i32 [rdx+<off6>], <gpr3>
    load.u32 <gpr6>, [rbp-<off1>]
    store.i32 [rdx+<off7>], <gpr6>
    load.u32 <gpr6>, [rbp-<off3>]
    store.i32 [rdx+<off8>], <gpr6>
    load.u32 <gpr6>, [rbp-<off5>]
    store.i32 [rdx+<off9>], <gpr6>
    load.u32 <gpr6>, [rbp-<off7>]
    store.i32 [rdx+<off10>], <gpr6>
    load.u32 <gpr6>, [rbp-<off9>]
    store.i32 [rdx+<off11>], <gpr6>
    load.u32 <gpr6>, [rbp-<off11>]
    store.i32 [rdx+<off12>], <gpr6>
    store.i32 [rdx+<off13>], <gpr2>
    store.i32 [rdx+<off14>], rdi
    cmp.i32 rax, 0
    setne rax
    movzx rax, rax
    add.i32 rax, 0
    cmp.i32 r8, 0
    setne r8
    movzx r8, r8
    add.i32 rax, r8
    cmp.i32 <gpr0>, 0
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    add.i32 rax, <gpr0>
    cmp.i32 <gpr4>, 0
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    add.i32 rax, <gpr4>
    cmp.i32 <gpr1>, 0
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    add.i32 rax, <gpr1>
    cmp.i32 rcx, 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 r9, 0
    setne r9
    movzx r9, r9
    add.i32 rax, r9
    cmp.i32 <gpr3>, 0
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    add.i32 rax, <gpr3>
    cmp.i32 [rbp-<off1>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 [rbp-<off3>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 [rbp-<off5>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 [rbp-<off7>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 [rbp-<off9>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 [rbp-<off11>], 0
    setne rcx
    movzx rcx, rcx
    add.i32 rax, rcx
    cmp.i32 <gpr2>, 0
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    add.i32 rax, <gpr2>
    cmp.i32 rdi, 0
    setne rdi
    movzx rdi, rdi
    add.i32 rax, rdi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $a -> [rbp-<off2>] : obj<64x4>
    slot $b -> [rbp-<off15>] : obj<64x4>
    slot $out -> [rbp-<off21>] : obj<64x4>

  block ^entry
    store.i32 [rbp-<off2>], 1
    store.i32 [rbp-<off15>], 100
    store.i32 [rbp-<off22>], 2
    store.i32 [rbp-<off23>], 103
    store.i32 [rbp-<off0>], 3
    store.i32 [rbp-<off14>], 106
    store.i32 [rbp-<off24>], 4
    store.i32 [rbp-<off25>], 109
    store.i32 [rbp-<off11>], 5
    store.i32 [rbp-<off13>], 112
    store.i32 [rbp-<off26>], 6
    store.i32 [rbp-<off27>], 115
    store.i32 [rbp-<off9>], 7
    store.i32 [rbp-<off12>], 118
    store.i32 [rbp-<off28>], 8
    store.i32 [rbp-<off29>], 121
    store.i32 [rbp-<off7>], 9
    store.i32 [rbp-<off10>], 124
    store.i32 [rbp-<off30>], 10
    store.i32 [rbp-<off31>], 127
    store.i32 [rbp-<off5>], 11
    store.i32 [rbp-<off8>], 130
    store.i32 [rbp-<off32>], 12
    store.i32 [rbp-<off33>], 133
    store.i32 [rbp-<off3>], 13
    store.i32 [rbp-<off6>], 136
    store.i32 [rbp-<off34>], 14
    store.i32 [rbp-<off35>], 139
    store.i32 [rbp-<off1>], 15
    store.i32 [rbp-<off4>], 142
    store.i32 [rbp-<off36>], 16
    store.i32 [rbp-<off37>], 145
    lea rdi, [rbp-<off2>]
    lea rsi, [rbp-<off15>]
    lea rdx, [rbp-<off21>]
    call @clamp [args=(rdx,rsi,rdi)]
    ret rax
