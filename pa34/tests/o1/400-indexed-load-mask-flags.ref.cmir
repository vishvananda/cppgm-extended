machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @offsets
  storage data
  item i8 16
  item i8 24
  item i8 16
  item i8 24
  item i8 16
  item i8 24
  item i8 16
  item i8 24

function @walk
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u16 rax, [rdi]
    and rax, 7
    mov <gpr0>, @offsets
    load.i8 rax, [<gpr0>+rax]
    load.ptr rax, [rdi+rax]
    ret rax

function @live_address
  abi
    param %key -> rdi : i64
    param %out -> rsi : ptr
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov <gpr0>, @offsets
    add rax, <gpr0>
    load.i8 rcx, [rax]
    store.i8 [rsi], rcx
    ret rax

function @masked16
  abi
    param %x -> rdi : u16
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and rax, 127
    mov <gpr1>, 1000
    cmove rax, <gpr1>
    ret rax

function @masked8
  abi
    param %x -> rdi : u8
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and rax, 63
    mov <gpr1>, 1000
    cmove rax, <gpr1>
    ret rax

function @signed16
  abi
    param %x -> rdi : i16
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and.u32 rax, -32768
    cmp.i16 rax, 0
    mov <gpr1>, 1000
    cmovge rax, <gpr1>
    ret rax

function @signed8
  abi
    param %x -> rdi : i8
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and.u32 rax, -128
    cmp.i8 rax, 0
    mov <gpr1>, 1000
    cmovge rax, <gpr1>
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr2> <gpr3> <gpr4> <gpr5> <gpr6>
    slot $node -> [rbp-<off0>] : obj<32x8>
    slot $out -> [rbp-<off1>] : i8
    temp %ok5 -> [rbp-<off2>] : i64
    temp %ok6 -> [rbp-<off3>] : i64
    temp %ok7 -> [rbp-<off4>] : i64
    temp %ok8 -> [rbp-<off5>] : i64
    temp %ok9 -> [rbp-<off6>] : i64
    temp %ok10 -> [rbp-<off7>] : i64

  block ^entry
    lea <gpr2>, [rbp-<off8>]
    lea <gpr5>, [rbp-<off9>]
    store.ptr [<gpr2>], <gpr2>
    store.ptr [<gpr5>], <gpr5>
    store.u16 [rbp-<off0>], 6
    lea rdi, [rbp-<off0>]
    call @walk [args=(rdi)]
    cmp.ptr rax, <gpr2>
    sete <gpr2>
    movzx <gpr2>, <gpr2>
    store.u16 [rbp-<off0>], 7
    lea rdi, [rbp-<off0>]
    call @walk [args=(rdi)]
    cmp.ptr rax, <gpr5>
    sete <gpr5>
    movzx <gpr5>, <gpr5>
    mov rdi, 3
    lea rsi, [rbp-<off1>]
    call @live_address [args=(rsi,rdi)]
    mov rcx, @offsets+3
    cmp.ptr rax, rcx
    sete <gpr6>
    movzx <gpr6>, <gpr6>
    cmp.i8 [rbp-<off1>], 24
    sete <gpr4>
    movzx <gpr4>, <gpr4>
    mov rdi, 65535
    call @masked16 [args=(rdi)]
    cmp.i32 rax, 127
    sete <gpr3>
    movzx <gpr3>, <gpr3>
    mov rdi, 255
    call @masked8 [args=(rdi)]
    cmp.i32 rax, 63
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off2>], <gpr0>
    mov rdi, 128
    call @masked16 [args=(rdi)]
    cmp.i32 rax, 1000
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off3>], <gpr0>
    mov rdi, 128
    call @masked8 [args=(rdi)]
    cmp.i32 rax, 1000
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off4>], <gpr0>
    mov rdi, -1
    call @signed16 [args=(rdi)]
    cmp.i32 rax, -32768
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off5>], <gpr0>
    mov rdi, -1
    call @signed8 [args=(rdi)]
    cmp.i32 rax, -128
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off6>], <gpr0>
    mov rdi, 1
    call @signed16 [args=(rdi)]
    cmp.i32 rax, 1000
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    store.i64 [rbp-<off7>], <gpr0>
    mov rdi, 1
    call @signed8 [args=(rdi)]
    cmp.i32 rax, 1000
    sete rax
    movzx rax, rax
    and <gpr2>, <gpr5>
    and <gpr2>, <gpr6>
    and <gpr2>, <gpr4>
    and <gpr2>, <gpr3>
    and <gpr2>, [rbp-<off2>]
    and <gpr2>, [rbp-<off3>]
    and <gpr2>, [rbp-<off4>]
    and <gpr2>, [rbp-<off5>]
    and <gpr2>, [rbp-<off6>]
    and <gpr2>, [rbp-<off7>]
    test.i64 <gpr2>, rax
    sete rax
    movzx rax, rax
    ret rax
