machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %a -> rdi : i64
    param %n -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov r8, rdx
    mov rax, rcx
    mov rcx, 0
    mov rdx, 0

  block ^head
    shl rcx, 1
    lea r9, [rcx+<off0>]
    mov <gpr0>, rax
    and <gpr0>, rdi
    add rcx, 2
    test.i64 <gpr0>, <gpr0>
    cmove rcx, r9
    shr rax, 1
    add rdx, 1
    cmp.i64 rdx, rsi
    jb ^head

  block ^done
    lea rax, [rcx+r8]
    ret rax

function @in_rcx
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    shr rcx, 1
    lea rax, [rdi+rsi]
    add rax, rdx
    xor rax, rcx
    ret rax

function @variable
  abi
    param %x -> rdi : i64
    param %count -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rcx, rsi
    mov rax, rdi
    shl rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, 5
    mov rsi, 3
    mov rdx, 1
    mov rcx, 4
    call @walk [args=(rcx,rdx,rsi,rdi)]
    mov <gpr0>, rax
    mov rdi, 3
    mov rsi, 2
    call @variable [args=(rsi,rdi)]
    mov <gpr1>, rax
    mov rdi, 1
    mov rsi, 2
    mov rdx, 4
    mov rcx, 8
    call @in_rcx [args=(rcx,rdx,rsi,rdi)]
    add <gpr0>, <gpr1>
    add rax, <gpr0>
    sext.i32 rax
    ret rax
