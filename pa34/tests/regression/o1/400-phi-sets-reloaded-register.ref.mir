machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %p -> rdi : ptr
    param %n -> rsi : u32
    param %first -> rdx : u32
    return u32 -> rax
  frame
    stack_size 176
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    param-slot %p -> [rbp-112] : ptr
    param-slot %first -> [rbp-136] : u32
    temp %t -> [rbp-104] : i64
    temp %w1 -> [rbp-128] : u32
    temp %a1 -> [rbp-56] : i64
    temp %a2 -> [rbp-64] : i64
    temp %a3 -> [rbp-72] : i64
    temp %a4 -> [rbp-80] : i64
    temp %a5 -> [rbp-88] : i64
    temp %a6 -> [rbp-96] : i64
    temp %w -> [rbp-120] : u32
    temp %b0 -> [rbp-8] : i64
    temp %b1 -> [rbp-16] : i64
    temp %b2 -> [rbp-24] : i64
    temp %b3 -> [rbp-32] : i64
    temp %b4 -> [rbp-40] : i64
    temp %b5 -> [rbp-48] : i64

  block ^entry
    store.ptr [rbp-112], rdi
    store.u32 [rbp-136], rdx
    zext.i32 r13, rsi
    store.i64 [rbp-104], 0

  block ^head
    cmp.u32 r13, rdx
    jbe ^done

  block ^body
    lea.i32 rax, [r13-1]
    store.u32 [rbp-128], rax
    mov rax, 0
    mov r15, 0
    store.i64 [rbp-56], 1
    store.i64 [rbp-64], 2
    store.i64 [rbp-72], 3
    store.i64 [rbp-80], 4
    store.i64 [rbp-88], 5
    store.i64 [rbp-96], 6
    mov r14, 7
    mov rbx, 8
    mov r9, 9
    mov r8, 10
    mov rdi, 11
    mov rsi, 12
    mov rdx, 13
    mov rcx, 14
    store.u32 [rbp-120], r13

  block ^inner
    load.ptr r10, [rbp-112]
    load.i64 r13, [r10+rax*8]
    lea r12, [rax+1]
    imul r15, r12
    xor r15, r13
    store.i64 [rbp-8], r15
    lea r15, [rax+4]
    imul r15, [rbp-56]
    xor r15, r13
    store.i64 [rbp-16], r15
    lea r15, [rax+7]
    imul r15, [rbp-64]
    xor r15, r13
    store.i64 [rbp-24], r15
    lea r15, [rax+10]
    imul r15, [rbp-72]
    xor r15, r13
    store.i64 [rbp-32], r15
    lea r15, [rax+13]
    imul r15, [rbp-80]
    xor r15, r13
    store.i64 [rbp-40], r15
    lea r15, [rax+16]
    imul r15, [rbp-88]
    xor r15, r13
    store.i64 [rbp-48], r15
    lea r15, [rax+19]
    imul r15, [rbp-96]
    xor r15, r13
    lea r12, [rax+22]
    imul r14, r12
    xor r14, r13
    lea r12, [rax+25]
    imul rbx, r12
    xor rbx, r13
    lea r12, [rax+28]
    imul r9, r12
    xor r9, r13
    lea r12, [rax+31]
    imul r8, r12
    xor r8, r13
    lea r12, [rax+34]
    imul rdi, r12
    xor rdi, r13
    lea r12, [rax+37]
    imul rsi, r12
    xor rsi, r13
    lea r12, [rax+40]
    imul rdx, r12
    xor rdx, r13
    lea r12, [rax+43]
    imul rcx, r12
    xor rcx, r13
    add rax, 1
    cmp.i64 r13, 99
    je ^inner~found

  block ^next
    load.i64 r13, [rbp-8]
    add r13, [rbp-16]
    add r13, [rbp-24]
    add r13, [rbp-32]
    add r13, [rbp-40]
    add r13, [rbp-48]
    add r13, r15
    add r13, r14
    add r13, rbx
    add r13, r9
    add r13, r8
    add r13, rdi
    add r13, rsi
    add r13, rdx
    add r13, rcx
    add r13, [rbp-104]
    cmp.i64 rax, 4
    jge ^next~head

  block ^next~inner
    load.i64 r11, [rbp-16]
    store.i64 [rbp-56], r11
    load.i64 r11, [rbp-24]
    store.i64 [rbp-64], r11
    load.i64 r11, [rbp-32]
    store.i64 [rbp-72], r11
    load.i64 r11, [rbp-40]
    store.i64 [rbp-80], r11
    load.i64 r11, [rbp-48]
    store.i64 [rbp-88], r11
    store.i64 [rbp-96], r15
    load.i64 r15, [rbp-8]
    jmp ^inner

  block ^next~head
    store.i64 [rbp-104], r13
    load.u32 r13, [rbp-128]
    cmp.u32 r13, [rbp-136]
    ja ^body

  block ^done
    load.u32 r10, [rbp-104]
    zext.i32 rax, r10
    and.u32 rax, 255
    ret rax

  block ^inner~found
    load.u32 r13, [rbp-120]

  block ^found
    lea.i32 rax, [r13+1000]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx
    slot $data -> [rbp-32] : obj<32x8>

  block ^entry
    store.i64 [rbp-32], 1
    store.i64 [rbp-24], 2
    store.i64 [rbp-16], 3
    store.i64 [rbp-8], 4
    lea rdi, [rbp-32]
    mov rsi, 6
    mov rdx, 0
    call @walk [args=(rdx,rsi,rdi)]
    zext.i32 rbx, rax
    store.i64 [rbp-16], 99
    lea rdi, [rbp-32]
    mov rsi, 6
    mov rdx, 0
    call @walk [args=(rdx,rsi,rdi)]
    add.u32 rax, rbx
    and.i32 rax, 127
    ret rax
