machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item zero 104

function @wide
  abi
    param %w -> rdi : i64
    param %p -> rsi : ptr
    param %f -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    param-slot %w -> [rbp-<off0>] : i64
    param-slot %p -> [rbp-<off1>] : ptr
    param-slot %f -> [rbp-<off2>] : i64
    temp %v0 -> [rbp-<off3>] : i64
    temp %v1 -> [rbp-<off4>] : i64
    temp %b -> [rbp-<off5>] : i64
    temp %r -> [rbp-<off6>] : i64

  block ^entry
    store.i64 [rbp-<off0>], rdi
    store.ptr [rbp-<off1>], rsi
    store.i64 [rbp-<off2>], rdx
    load.i64 rax, [rsi+<off0>]
    store.i64 [rbp-<off3>], rax
    load.i64 rax, [rsi+<off1>]
    store.i64 [rbp-<off4>], rax
    load.i64 <gpr1>, [rsi+<off2>]
    load.i64 <gpr2>, [rsi+<off3>]
    load.i64 <gpr4>, [rsi+<off4>]
    load.i64 <gpr3>, [rsi+<off5>]
    load.i64 <gpr0>, [rsi+<off6>]
    load.i64 rdi, [rsi+<off7>]
    load.i64 rsi, [rsi+<off8>]
    load.ptr <gpr5>, [rbp-<off1>]
    load.i64 r9, [<gpr5>+<off0>]
    load.i64 r8, [<gpr5>+<off1>]
    load.i64 rcx, [<gpr5>+<off2>]
    load.i64 <gpr5>, [<gpr5>]
    store.i64 [rbp-<off5>], <gpr5>
    load.i64 rax, [rbp-<off0>]
    mul [rbp-<off5>]
    mov rax, rdx
    cmp.i64 [rbp-<off2>], 0
    jne ^entry~more

  block ^entry~done
    mov rdx, rax
    load.i64 rax, [rbp-<off4>]

  block ^done
    add rdx, [rbp-<off3>]
    add rdx, rax
    add rdx, <gpr1>
    add rdx, <gpr2>
    lea rax, [rdx+<gpr4>]
    add rax, <gpr3>
    add rax, <gpr0>
    add rax, rdi
    add rax, rsi
    add rax, r9
    add rax, r8
    add rax, rcx
    ret rax

  block ^entry~more
    store.i64 [rbp-<off6>], rax
    load.i64 rax, [rbp-<off4>]

  block ^more
    load.i64 rdx, [rbp-<off0>]
    imul rdx, [rbp-<off5>]
    add rdx, [rbp-<off3>]
    add rdx, rax
    add rdx, <gpr1>
    add rdx, <gpr2>
    add rdx, <gpr4>
    add rdx, <gpr3>
    add rdx, <gpr0>
    add rdx, rdi
    add rdx, rsi
    add rdx, r9
    add rdx, r8
    add rdx, rcx
    xor rdx, [rbp-<off3>]
    xor rdx, rax
    xor rdx, <gpr1>
    xor rdx, <gpr2>
    xor rdx, <gpr4>
    xor rdx, <gpr3>
    xor rdx, <gpr0>
    xor rdx, rdi
    xor rdx, rsi
    xor rdx, r9
    xor rdx, r8
    xor rdx, rcx
    add rdx, [rbp-<off6>]
    jmp ^done

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    store.i64 @table, 6
    store.i64 @table+8, 13
    store.i64 @table+16, 20
    store.i64 @table+24, 27
    store.i64 @table+32, 34
    store.i64 @table+40, 41
    store.i64 @table+48, 48
    store.i64 @table+56, 55
    store.i64 @table+64, 62
    store.i64 @table+72, 69
    store.i64 @table+80, 76
    store.i64 @table+88, 83
    store.i64 @table+96, 90
    mov rdi, -1
    lea rsi, @table
    mov rdx, 1
    call @wide [args=(rdx,rsi,rdi)]
    ret rax
