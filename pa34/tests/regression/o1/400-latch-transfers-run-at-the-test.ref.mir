machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @halvings
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^loop
    mov rcx, rdi
    shr rcx, 1
    add rax, 1
    cmp.i64 rdi, 1
    mov rdi, rcx
    ja ^loop
    ret rax

  block ^done
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rdi, 40
    call @halvings [args=(rdi)]
    zext.i32 rbx, rax
    mov rdi, 1
    call @halvings [args=(rdi)]
    imul rbx, 10
    add.u32 rax, rbx
    ret rax
