machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pair
  abi
    param %p -> rdi : ptr
    param %i -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi+rsi*4+<off0>]
    add.i32 rax, [rdi+rsi*4+<off1>]
    ret rax

function @before
  abi
    param %p -> rdi : ptr
    param %i -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi+rsi*4-<off0>]
    ret rax

function @wrapping
  abi
    param %p -> rdi : ptr
    param %i -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.u32 rsi, 1
    sext.i32 rsi
    load.u32 rax, [rdi+rsi*4]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1>
    slot $data -> [rbp-<off0>] : obj<16x4>

  block ^entry
    store.i32 [rbp-<off0>], 1
    store.i32 [rbp-<off1>], 2
    store.i32 [rbp-<off2>], 4
    store.i32 [rbp-<off3>], 8
    lea rdi, [rbp-<off0>]
    mov rsi, 1
    call @pair [args=(rsi,rdi)]
    zext.i32 <gpr0>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 1
    call @before [args=(rsi,rdi)]
    zext.i32 <gpr1>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 0
    call @wrapping [args=(rsi,rdi)]
    add.i32 <gpr0>, <gpr1>
    add.i32 rax, <gpr0>
    ret rax
