machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @flip
  abi
    param %k -> rdi : i64
    param %bits -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    sub rsi, 1
    mov rcx, rsi
    mov rax, 1
    shl rax, rcx
    mov rcx, rax
    mov rdx, 1
    mov rax, 0

  block ^head
    mov rsi, rdi
    and rsi, rdx
    mov r8, rax
    or r8, rcx
    test.i64 rsi, rsi
    cmovne rax, r8
    shr rcx, 1
    shl rdx, 1
    cmp.i64 rcx, 0
    jne ^head

  block ^out
    imul rax, 16
    add rax, rdi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 6
    mov rsi, 4
    call @flip [args=(rsi,rdi)]
    mov <gpr0>, rax
    mov rdi, 1
    mov rsi, 3
    call @flip [args=(rsi,rdi)]
    add rax, <gpr0>
    sext.i32 rax
    ret rax
