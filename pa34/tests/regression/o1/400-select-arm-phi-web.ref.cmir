machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @flip
  abi
    param %k -> rdi : i64
    param %bits -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rsi
    mov rsi, rdi
    sub r8, 1
    mov rcx, r8
    mov r9, 1
    shl r9, rcx
    mov rdi, 1
    mov r8, 0

  block ^head
    mov rdx, rsi
    and rdx, rdi
    mov rcx, r8
    or rcx, r9
    test.i64 rdx, rdx
    cmovne r8, rcx
    shr r9, 1
    shl rdi, 1
    cmp.i64 r9, 0
    jne ^head

  block ^out
    mov rax, r8
    imul rax, 16
    add rax, rsi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 6
    mov rsi, 4
    call @flip [args=(rsi,rdi)]
    mov <gpr0>, rax
    mov rdi, 1
    mov rsi, 3
    call @flip [args=(rsi,rdi)]
    add rax, <gpr0>
    sext.i32 rax
    ret rax
