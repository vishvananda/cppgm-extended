machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @both
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return obj<8x4> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $result -> [rbp-<off0>] : obj<8x4>

  block ^entry
    xor rdi, 5
    add.i32 rsi, 7
    mov <gpr0>, rsi
    shl <gpr0>, 32
    zext.i32 rax, rdi
    or rax, <gpr0>
    ret

function @constant_high
  abi
    param %a -> rdi : i32
    return obj<8x4> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $result -> [rbp-<off0>] : obj<8x4>

  block ^entry
    xor rdi, 5
    mov <gpr0>, 38654705664
    zext.i32 rax, rdi
    or rax, <gpr0>
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $x -> [rbp-<off0>] : obj<8x4>
    slot $y -> [rbp-<off1>] : obj<8x4>
    temp %vx -> [rbp-<off2>] : obj<8x4>
    temp %vy -> [rbp-<off3>] : obj<8x4>

  block ^entry
    mov rdi, 1
    mov rsi, 2
    call @both [args=(rsi,rdi)]
    store.i64 [rbp-<off2>], rax
    copy_bytes 8x4, [rbp-<off0>], [rbp-<off2>]
    mov rdi, 3
    call @constant_high [args=(rdi)]
    store.i64 [rbp-<off3>], rax
    copy_bytes 8x4, [rbp-<off1>], [rbp-<off3>]
    load.i32 rax, [rbp-<off0>]
    add.i32 rax, [rbp-<off4>]
    add.i32 rax, [rbp-<off1>]
    add.i32 rax, [rbp-<off5>]
    ret rax
