machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pick
  abi
    param %k -> rdi : i32
    param %a -> rsi : i64
    param %b -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 7
    je ^match

  block ^other
    lea rax, [rsi+rdx]

  block ^join
    xor rax, rsi
    ret rax

  block ^match
    mov rax, rsi
    imul rax, rdx
    jmp ^join

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 7
    mov rsi, 5
    mov rdx, 7
    call @pick [args=(rdx,rsi,rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 4
    mov rsi, 5
    mov rdx, 7
    call @pick [args=(rdx,rsi,rdi)]
    add.u32 rax, <gpr0>
    ret rax
