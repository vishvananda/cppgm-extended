machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @clean
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    fmov.f64 xmm1, 0.0

  block ^head
    lea rcx, [rax*8]
    add rcx, rdi
    fmov.f64 xmm0, [rcx]
    fcmp.f64 xmm0, xmm0
    jp ^skip

  block ^add
    fadd.f64 xmm1, xmm1, xmm0

  block ^next
    add rax, 1
    cmp.i64 rax, rsi
    jl ^head
    ret xmm1

  block ^skip
    fadd.f64 xmm1, xmm1, 1e+03
    add rax, 1
    cmp.i64 rax, rsi
    jl ^head
    ret xmm1

  block ^out
    ret xmm1

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $data -> [rbp-<off0>] : obj<32x8>

  block ^entry
    lea rdi, [rbp-<off0>]
    fsub.f64 xmm0, 0.0, 0.0
    fdiv.f64 xmm1, xmm0, xmm0
    fmov.f64 [rdi], 1.5
    mov rax, rdi
    add rax, 8
    fmov.f64 [rax], xmm1
    mov rax, rdi
    add rax, 16
    fmov.f64 [rax], 2.5
    mov rax, rdi
    add rax, 24
    fmov.f64 [rax], 3.0
    mov rsi, 4
    call @clean [args=(rsi,rdi)]
    fptosi.f64.i32 rcx, xmm0
    sext.i32 rcx
    mov <gpr0>, 2190262207
    mov rax, rcx
    imul rax, <gpr0>
    sar rax, 39
    mov rdx, rcx
    sar rdx, 63
    sub rax, rdx
    imul rax, 251
    mov rdx, rcx
    sub rdx, rax
    mov rax, rdx
    ret rax
