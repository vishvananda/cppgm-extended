machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @bits
  storage data
  item zero 16

function @word
  abi
    param %w -> rdi : ptr
    param %i -> rsi : u32
    return u8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rsi
    shr rax, 6
    load.i64 rdi, [rdi+rax*8]
    bt.i64 rdi, rsi
    setb rax
    ret rax

function @clear
  abi
    param %x -> rdi : i64
    param %n -> rsi : i64
    return u8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    bt.i64 rdi, rsi
    setae rax
    ret rax

function @moved
  abi
    param %x -> rdi : i64
    param %n -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rcx, rsi
    mov rax, rdi
    shl rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %f -> [rbp-<off0>] : u8
    temp %g -> [rbp-<off1>] : u8
    temp %k -> [rbp-<off2>] : i64

  block ^entry
    store.i64 @bits, 5
    store.i64 @bits+8, 4611686018427387904
    mov rdi, @bits
    mov rsi, 0
    call @word [args=(rsi,rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, @bits
    mov rsi, 1
    call @word [args=(rsi,rdi)]
    zext.i32 <gpr3>, rax
    mov rdi, @bits
    mov rsi, 2
    call @word [args=(rsi,rdi)]
    zext.i32 <gpr4>, rax
    mov rdi, @bits
    mov rsi, 126
    call @word [args=(rsi,rdi)]
    zext.i32 <gpr2>, rax
    mov rdi, @bits
    mov rsi, 127
    call @word [args=(rsi,rdi)]
    zext.i32 <gpr1>, rax
    mov rdi, 5
    mov rsi, 1
    call @clear [args=(rsi,rdi)]
    zext.i32 <gpr5>, rax
    store.u8 [rbp-<off0>], <gpr5>
    mov rdi, 5
    mov rsi, 2
    call @clear [args=(rsi,rdi)]
    zext.i32 <gpr5>, rax
    store.u8 [rbp-<off1>], <gpr5>
    mov rdi, 5
    mov rsi, 3
    call @moved [args=(rsi,rdi)]
    mov <gpr5>, rax
    store.i64 [rbp-<off2>], <gpr5>
    mov rdi, 5
    mov rsi, 67
    call @moved [args=(rsi,rdi)]
    cmp.u8 <gpr0>, 1
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.u8 <gpr3>, 0
    sete <gpr3>
    movzx <gpr3>, <gpr3>
    cmp.u8 <gpr4>, 1
    sete <gpr4>
    movzx <gpr4>, <gpr4>
    cmp.u8 <gpr2>, 1
    sete <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.u8 <gpr1>, 0
    sete <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.u8 [rbp-<off0>], 1
    sete rcx
    movzx rcx, rcx
    cmp.u8 [rbp-<off1>], 0
    sete rdx
    movzx rdx, rdx
    cmp.i64 [rbp-<off2>], 40
    sete rsi
    movzx rsi, rsi
    cmp.i64 rax, 40
    sete rax
    movzx rax, rax
    and.u32 <gpr0>, <gpr3>
    and.u32 <gpr0>, <gpr4>
    and.u32 <gpr0>, <gpr2>
    and.u32 <gpr0>, <gpr1>
    and.u32 <gpr0>, rcx
    and.u32 <gpr0>, rdx
    and.u32 <gpr0>, rsi
    and.u32 <gpr0>, rax
    mov rax, 1
    sub.i32 rax, <gpr0>
    ret rax
