machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pick
  abi
    param %f -> rdi : u32
    param %a -> rsi : i64
    param %b -> rdx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 rdi, 4
    jne ^marked

  block ^plain
    lea rax, [rsi+rdx]

  block ^join
    xor rax, rsi
    ret rax

  block ^marked
    mov rax, rsi
    imul rax, rdx
    jmp ^join

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rdi, 3
    mov rsi, 5
    mov rdx, 7
    call @pick [args=(rdx,rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 4
    mov rsi, 5
    mov rdx, 7
    call @pick [args=(rdx,rsi,rdi)]
    add.u32 rax, rbx
    ret rax
