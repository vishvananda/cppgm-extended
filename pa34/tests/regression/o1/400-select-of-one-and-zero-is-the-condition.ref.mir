machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @less
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    setl rax
    movzx rax, rax
    ret rax

function @not_less
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    setge rax
    movzx rax, rax
    ret rax

function @nonzero
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.i64 rdi, rdi
    setne rax
    movzx rax, rax
    ret rax

function @field
  abi
    param %p -> rdi : ptr
    param %v -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 [rdi], 0
    mov rax, 9
    cmovne rax, rsi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $cell -> [rbp-8] : i64
    temp %f -> [rbp-16] : i64
    temp %g -> [rbp-24] : i64

  block ^entry
    store.i64 [rbp-8], 0
    mov rdi, 1
    mov rsi, 2
    call @less [args=(rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 2
    mov rsi, 2
    call @less [args=(rsi,rdi)]
    zext.i32 r14, rax
    mov rdi, 1
    mov rsi, 2
    call @not_less [args=(rsi,rdi)]
    zext.i32 r15, rax
    mov rdi, 3
    mov rsi, 2
    call @not_less [args=(rsi,rdi)]
    zext.i32 r13, rax
    mov rdi, 0
    call @nonzero [args=(rdi)]
    mov r12, rax
    mov rdi, -4
    call @nonzero [args=(rdi)]
    mov r10, rax
    store.i64 [rbp-16], r10
    lea rdi, [rbp-8]
    mov rsi, 5
    call @field [args=(rsi,rdi)]
    mov r10, rax
    store.i64 [rbp-24], r10
    store.i64 [rbp-8], 3
    lea rdi, [rbp-8]
    mov rsi, 5
    call @field [args=(rsi,rdi)]
    cmp.i32 rbx, 1
    sete rbx
    movzx rbx, rbx
    cmp.i32 r14, 0
    sete r14
    movzx r14, r14
    cmp.i32 r15, 0
    sete r15
    movzx r15, r15
    cmp.i32 r13, 1
    sete r13
    movzx r13, r13
    cmp.i64 r12, 0
    sete r12
    movzx r12, r12
    cmp.i64 [rbp-16], 1
    sete rcx
    movzx rcx, rcx
    cmp.i64 [rbp-24], 9
    sete rdx
    movzx rdx, rdx
    cmp.i64 rax, 5
    sete rax
    movzx rax, rax
    and.u32 rbx, r14
    and.u32 rbx, r15
    and.u32 rbx, r13
    and.u32 rbx, r12
    and.u32 rbx, rcx
    and.u32 rbx, rdx
    and.u32 rbx, rax
    mov rax, 1
    sub.i32 rax, rbx
    ret rax
