machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @high
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mul rsi
    ret rdx

function @square
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mul rdi
    ret rdx

function @signed
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    imul rsi
    ret rdx

function @literal
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov <gpr0>, 0x0000000000000000abcc77118461cefd
    mov rax, rdi
    mul <gpr0>
    ret rdx

function @shared
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %f -> rcx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %x -> [rbp-<off0>] : i128

  block ^entry
    mov r8, rsi
    mov rsi, rdx
    mov r9, rcx
    zext.i128 [rbp-<off0>], rdi
    load.i64 rax, [rbp-<off0>]
    mul r8
    mov rcx, rdx
    cmp.i64 r9, 0
    je ^done

  block ^more
    load.i64 rax, [rbp-<off0>]
    mul rsi
    add rcx, rdx

  block ^done
    ret rcx

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov rdi, -1
    mov rsi, 6
    call @high [args=(rsi,rdi)]
    mov <gpr1>, rax
    mov rdi, -1
    call @square [args=(rdi)]
    mov <gpr2>, rax
    mov rdi, -1
    mov rsi, 6
    call @signed [args=(rsi,rdi)]
    mov <gpr3>, rax
    mov rdi, -1
    call @literal [args=(rdi)]
    mov <gpr4>, rax
    mov rdi, -1
    mov rsi, 6
    mov rdx, 10
    mov rcx, 1
    call @shared [args=(rcx,rdx,rsi,rdi)]
    cmp.i64 <gpr1>, 5
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 <gpr2>, -2
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.i64 <gpr3>, -1
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    cmp.i64 <gpr4>, -6067343680855748868
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    cmp.i64 rax, 14
    setne rax
    movzx rax, rax
    or <gpr1>, <gpr2>
    or <gpr1>, <gpr3>
    or <gpr1>, <gpr4>
    or rax, <gpr1>
    ret rax
