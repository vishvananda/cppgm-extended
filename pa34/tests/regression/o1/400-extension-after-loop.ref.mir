machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pack
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    mov rcx, 0

  block ^head
    shl.u32 rcx, 1
    load.u8 rdx, [rdi+rax]
    and rdx, 1
    zext.i32 r8, rcx
    or.u32 r8, 1
    test.u8 rdx, rdx
    cmovne rcx, r8
    add rax, 1
    cmp.i64 rax, rsi
    jb ^head

  block ^out
    sext.i8 rax, rcx
    load.i8 rdi, [rdi]
    add.i32 rax, rdi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $bits -> [rbp-8] : obj<8x1>

  block ^entry
    store.i32 [rbp-8], 16842753
    store.i32 [rbp-4], 16842752
    lea rdi, [rbp-8]
    mov rsi, 8
    call @pack [args=(rsi,rdi)]
    add.i32 rax, 200
    ret rax
