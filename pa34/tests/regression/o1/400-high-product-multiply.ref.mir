machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @high
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mul rsi
    ret rdx

function @square
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mul rdi
    ret rdx

function @signed
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    imul rsi
    ret rdx

function @literal
  abi
    param %a -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r11, 0x0000000000000000abcc77118461cefd
    mov rax, rdi
    mul r11
    ret rdx

function @shared
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %f -> rcx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %x -> [rbp-16] : i128

  block ^entry
    mov r8, rsi
    mov rsi, rdx
    mov r9, rcx
    zext.i128 [rbp-16], rdi
    load.i64 rax, [rbp-16]
    mul r8
    mov rcx, rdx
    cmp.i64 r9, 0
    je ^done

  block ^more
    load.i64 rax, [rbp-16]
    mul rsi
    add rcx, rdx

  block ^done
    ret rcx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14

  block ^entry
    mov rdi, -1
    mov rsi, 6
    call @high [args=(rsi,rdi)]
    mov rbx, rax
    mov rdi, -1
    call @square [args=(rdi)]
    mov r12, rax
    mov rdi, -1
    mov rsi, 6
    call @signed [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, -1
    call @literal [args=(rdi)]
    mov r14, rax
    mov rdi, -1
    mov rsi, 6
    mov rdx, 10
    mov rcx, 1
    call @shared [args=(rcx,rdx,rsi,rdi)]
    cmp.i64 rbx, 5
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, -2
    setne r12
    movzx r12, r12
    cmp.i64 r13, -1
    setne r13
    movzx r13, r13
    cmp.i64 r14, -6067343680855748868
    setne r14
    movzx r14, r14
    cmp.i64 rax, 14
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, r13
    or rbx, r14
    or rax, rbx
    ret rax
