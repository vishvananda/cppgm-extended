machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pack
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    mov rcx, 0

  block ^head
    shl rcx, 1
    load.u8 rdx, [rdi+rax]
    and rdx, 1
    mov r8, rcx
    or r8, 1
    test.u8 rdx, rdx
    cmovne rcx, r8
    add rax, 1
    cmp.i64 rax, rsi
    jb ^head

  block ^out
    sext.i8 rax, rcx
    load.i8 rdi, [rdi]
    add.i32 rax, rdi
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $bits -> [rbp-<off0>] : obj<8x1>

  block ^entry
    store.i32 [rbp-<off0>], 16842753
    store.i32 [rbp-<off1>], 16842752
    lea rdi, [rbp-<off0>]
    mov rsi, 8
    call @pack [args=(rsi,rdi)]
    add.i32 rax, 200
    ret rax
