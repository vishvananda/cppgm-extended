machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @next
  storage data
  item i64 0
  item i64 3
  item i64 0
  item i64 4
  item i64 0

function @last
  abi
    param %start -> rdi : i64
    param %skip -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 0
    je ^walk

  block ^entry~done
    mov rax, 99
    ret rax

  block ^walk
    lea rax, [rdi*8]
    mov r10, @next
    load.i64 rax, [r10+rax]
    cmp.i64 rax, 0
    je ^walk~done

  block ^walk~walk
    mov rdi, rax
    lea rax, [rdi*8]
    mov r10, @next
    load.i64 rax, [r10+rax]
    cmp.i64 rax, 0
    jne ^walk~walk

  block ^walk~done
    ret rdi

  block ^done
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rdi, 1
    mov rsi, 0
    call @last [args=(rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 2
    mov rsi, 1
    call @last [args=(rsi,rdi)]
    add.u32 rax, rbx
    ret rax
