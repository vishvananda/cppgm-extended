machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @last
  storage scalar i32
  init i32 42

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i32 rax, @last
    mov rcx, 0

  block ^loop
    imul rax, 3877
    lea rsi, [rax+29573]
    imul rax, rsi, 502748801
    sar rax, 46
    mov rdx, rsi
    sar rdx, 63
    sub rax, rdx
    imul rax, 139968
    mov rdx, rsi
    sub rdx, rax
    mov rax, rdx
    store.i32 @last, rax
    add.i32 rcx, 1
    cmp.i32 rcx, 5
    jl ^loop

  block ^done
    and.i32 rax, 255
    ret rax
