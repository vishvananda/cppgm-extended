machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @slow
  abi
    param %a -> xmm0 : f64
    param %b -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fadd.f64 xmm0, xmm0, xmm1
    ret xmm0

function @scaled_sum
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2>
    temp %s -> [rbp-<off0>] : f64
    param-slot %x -> [rbp-<off1>] : f64
    param-slot %y -> [rbp-<off2>] : f64

  block ^entry
    mov <gpr1>, rdi
    mov <gpr2>, rsi
    fmov.f64 <xmm0>, xmm0
    fmov.f64 <xmm1>, xmm1
    cmp.i64 <gpr2>, 0
    jle ^entry~done

  block ^entry~loop
    mov <gpr0>, 0
    fmov.f64 xmm1, 0.0

  block ^loop
    fmov.f64 xmm0, [<gpr1>+<gpr0>*8]
    fmul.f64 <xmm2>, xmm0, <xmm0>
    fadd.f64 <xmm2>, <xmm2>, <xmm1>
    fcmp.f64 <xmm2>, <xmm2>
    jp ^loop~cold

  block ^loop~next
    fmov.f64 xmm0, <xmm2>

  block ^next
    fadd.f64 xmm1, xmm1, xmm0
    add <gpr0>, 1
    cmp.i64 <gpr0>, <gpr2>
    jl ^loop

  block ^next~done
    fmov.f64 xmm0, xmm1
    jmp ^done

  block ^loop~cold
    fmov.f64 [rbp-<off0>], xmm1
    fmov.f64 [rbp-<off1>], <xmm0>
    fmov.f64 [rbp-<off2>], <xmm1>

  block ^cold
    fmov.f64 xmm1, [rbp-<off1>]
    call @slow [args=(xmm0,xmm1)]
    fmov.f64 xmm1, [rbp-<off0>]
    fmov.f64 <xmm0>, [rbp-<off1>]
    fmov.f64 <xmm1>, [rbp-<off2>]
    jmp ^next

  block ^entry~done
    fmov.f64 xmm0, 0.0

  block ^done
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $values -> [rbp-<off0>] : obj<16x8>

  block ^entry
    fmov.f64 [rbp-<off0>], 1.0
    fmov.f64 [rbp-<off1>], 2.0
    lea rdi, [rbp-<off0>]
    mov rsi, 2
    fmov.f64 xmm0, 2.0
    fmov.f64 xmm1, 1.0
    call @scaled_sum [args=(rsi,rdi,xmm0,xmm1)]
    fptosi.f64.i32 rax, xmm0
    sext.i32 rax
    ret rax
