machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @same
  abi
    param %map -> rdi : ptr
    param %flat -> rsi : ptr
    param %n -> rdx : i64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.ptr rax, [rdi]
    lea rcx, [rax+<off0>]
    lea rdx, [rsi+rdx*4]
    cmp.ptr rsi, rdx
    je ^equal

  block ^check
    load.u32 <gpr0>, [rax]
    cmp.i32 <gpr0>, [rsi]
    jne ^unequal

  block ^next
    lea rax, [rax+<off1>]
    cmp.ptr rax, rcx
    je ^advance

  block ^step
    lea rsi, [rsi+<off0>]
    cmp.ptr rsi, rdx
    je ^equal

  block ^step~check
    load.u32 <gpr0>, [rax]
    cmp.i32 <gpr0>, [rsi]
    je ^next

  block ^unequal
    mov rax, 0
    ret rax

  block ^advance
    lea rdi, [rdi+<off0>]
    load.ptr rax, [rdi]
    lea rcx, [rax+<off0>]
    jmp ^step

  block ^equal
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1>
    slot $data -> [rbp-<off0>] : obj<48x4>
    slot $flat -> [rbp-<off1>] : obj<48x4>
    slot $map -> [rbp-<off2>] : obj<32x8>

  block ^entry
    lea rcx, [rbp-<off0>]
    mov rax, 0

  block ^fill
    lea.i32 rdx, [rax+rax*2]
    store.i32 [rcx+rax*4], rdx
    store.i32 [rbp+rax*4-<off0>], rdx
    add rax, 1
    cmp.i64 rax, 12
    jb ^fill

  block ^link
    store.ptr [rbp-<off2>], rcx
    lea rax, [rcx+<off0>]
    store.ptr [rbp-<off3>], rax
    lea rcx, [rcx+<off1>]
    store.ptr [rbp-<off4>], rcx
    store.ptr [rbp-<off5>], 0
    lea rdi, [rbp-<off2>]
    lea rsi, [rbp-<off1>]
    mov rdx, 12
    call @same [args=(rdx,rsi,rdi)]
    zext.i32 <gpr1>, rax
    store.i32 [rbp-<off6>], 5
    lea rdi, [rbp-<off2>]
    lea rsi, [rbp-<off1>]
    mov rdx, 12
    call @same [args=(rdx,rsi,rdi)]
    imul.i32 <gpr1>, 2
    add.i32 <gpr1>, rax
    mov <gpr2>, 0
    cmp.i32 <gpr1>, 2
    mov rax, 1
    cmove rax, <gpr2>
    ret rax
