machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @last
  abi
    param %x -> rdi : u32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u32 rdi, 4294967295
    je ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @step
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea.i32 rax, [rdi-1]
    ret rax

function @mask
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and.u32 rax, 4294967280
    ret rax

function @last16
  abi
    param %x -> rdi : u16
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u16 rdi, 65535
    je ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @mask16
  abi
    param %x -> rdi : u16
    return u16 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and rax, 65520
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    temp %f -> [rbp-8] : i32
    temp %g -> [rbp-16] : i32

  block ^entry
    mov rdi, 4294967295
    call @last [args=(rdi)]
    zext.i32 rbx, rax
    mov rdi, 4294967294
    call @last [args=(rdi)]
    zext.i32 r14, rax
    mov rdi, 255
    call @last [args=(rdi)]
    zext.i32 r15, rax
    mov rdi, 8
    call @step [args=(rdi)]
    zext.i32 r13, rax
    mov rdi, 4294967295
    call @mask [args=(rdi)]
    zext.i32 r12, rax
    mov rdi, 65535
    call @last16 [args=(rdi)]
    zext.i32 r10, rax
    store.i32 [rbp-8], r10
    mov rdi, 255
    call @last16 [args=(rdi)]
    zext.i32 r10, rax
    store.i32 [rbp-16], r10
    mov rdi, 65535
    call @mask16 [args=(rdi)]
    cmp.u32 r13, 7
    sete r13
    movzx r13, r13
    cmp.u32 r12, 4294967280
    sete r12
    movzx r12, r12
    cmp.u16 rax, 65520
    sete rax
    movzx rax, rax
    add.i32 rbx, r14
    add.i32 rbx, r15
    add.i32 rbx, [rbp-8]
    add.i32 rbx, [rbp-16]
    shl.u32 r13, 2
    shl.u32 r12, 4
    shl.u32 rax, 5
    add.i32 rbx, r13
    add.i32 rbx, r12
    add.i32 rax, rbx
    ret rax
