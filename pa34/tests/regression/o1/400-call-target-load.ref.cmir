machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @one
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea rax, [rdi+<off0>]
    ret rax

function @through
  abi
    param %x -> rdi : i64
    param %cell -> rsi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call *[rsi] [args=(rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $cell -> [rbp-<off0>] : obj<8x8>

  block ^entry
    mov <gpr0>, @one
    store.ptr [rbp-<off0>], <gpr0>
    mov rdi, 41
    lea rsi, [rbp-<off0>]
    call @through [args=(rsi,rdi)]
    ret rax
