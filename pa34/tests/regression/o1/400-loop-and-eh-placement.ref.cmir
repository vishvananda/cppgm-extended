machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @node1
  storage data
  item ptr addr @node2

global @node2
  storage data
  item ptr 0

global @number
  storage scalar i64
  init i64 42

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk_unavoidable
  abi
    param %head -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.i64 rcx, @number
    mov rax, 0

  block ^loop
    cmp.ptr rdi, 0
    je ^exit

  block ^body
    cmp.i64 rcx, 42
    jne ^failure

  block ^advance
    load.ptr rdi, [rdi]
    add rax, 1
    cmp.ptr rdi, 0
    jne ^body

  block ^exit
    ret rax

  block ^failure
    mov rax, 99
    ret rax

function @walk_guarded
  abi
    param %head -> rdi : ptr
    param %run -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 0
    je ^entry~exit

  block ^entry~loop
    mov rax, 0

  block ^loop
    cmp.ptr rdi, 0
    je ^loop~exit

  block ^body
    load.ptr rdi, [rdi]
    add rax, 1
    cmp.ptr rdi, 0
    jne ^body

  block ^loop~exit
    ret rax

  block ^entry~exit
    mov rax, 0
    ret rax

  block ^exit
    ret rax

function @call_free_eh_load
  abi
    param %address -> rdi : ptr
    param %choose -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %value -> [rbp-<off0>] : i64
    temp %result -> [rbp-<off1>] : i64

  block ^entry
    eh_push ^handler, 0
    eh_pop
    load.i64 rdi, [rdi]
    store.i64 [rbp-<off0>], rdi
    cmp.i64 rsi, 0
    je ^right

  block ^left
    lea rax, [rdi+<off0>]
    store.i64 [rbp-<off1>], rax
    jmp ^done

  block ^right
    lea rax, [rdi-<off0>]
    store.i64 [rbp-<off1>], rax

  block ^done
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @call_crossing_eh_value
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %value -> [rbp-<off0>] : i64

  block ^entry
    eh_push ^handler, 0
    load.i64 rdi, [rdi]
    store.i64 [rbp-<off0>], rdi
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    eh_pop

  block ^done
    load.i64 rax, [rbp-<off0>]
    add rax, 1
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3>

  block ^entry
    lea rdi, @node1
    call @walk_unavoidable [args=(rdi), unwind=no]
    mov <gpr0>, rax
    lea rdi, @node1
    mov rsi, 0
    call @walk_guarded [args=(rsi,rdi), unwind=no]
    mov <gpr2>, rax
    lea rdi, @number
    mov rsi, 1
    call @call_free_eh_load [args=(rsi,rdi)]
    mov <gpr3>, rax
    lea rdi, @number
    mov rsi, 0
    call @call_free_eh_load [args=(rsi,rdi)]
    mov <gpr1>, rax
    lea rdi, @number
    call @call_crossing_eh_value [args=(rdi)]
    cmp.i64 <gpr0>, 2
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr2>, 0
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.i64 <gpr3>, 43
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    cmp.i64 <gpr1>, 41
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr2>
    or <gpr3>, <gpr1>
    or <gpr0>, <gpr3>
    or rax, <gpr0>
    ret rax
