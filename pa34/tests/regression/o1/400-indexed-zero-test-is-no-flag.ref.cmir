machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @seen
  storage scalar i64
  init i64 0

function @note
  abi
    param %v -> rdi : i64
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add @seen, rdi
    ret

function @count
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3>

  block ^entry
    mov <gpr3>, rdi
    mov <gpr1>, rsi
    mov <gpr0>, 0
    mov <gpr2>, 0

  block ^head
    cmp.i64 [<gpr3>+<gpr0>*8], 0
    jne ^nonzero

  block ^zero
    mov rdi, 1
    call @note [args=(rdi)]

  block ^next
    add <gpr0>, 1
    cmp.i64 <gpr0>, <gpr1>
    jge ^out

  block ^next~head
    cmp.i64 [<gpr3>+<gpr0>*8], 0
    je ^zero

  block ^nonzero
    mov rdi, 2
    call @note [args=(rdi)]
    add <gpr2>, 1
    add <gpr0>, 1
    cmp.i64 <gpr0>, <gpr1>
    jl ^next~head

  block ^out
    ret <gpr2>

function @flag
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add rdi, 8
    cmp.i64 [rdi], 0
    jne ^nonzero

  block ^zero
    mov rdi, 4
    call @note [args=(rdi)]
    mov rax, 1
    ret rax

  block ^nonzero
    mov rdi, 8
    call @note [args=(rdi)]
    mov rax, 2
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr2>
    slot $data -> [rbp-<off0>] : obj<32x8>

  block ^entry
    lea <gpr0>, [rbp-<off0>]
    store.i64 [<gpr0>], 0
    lea rax, [<gpr0>+<off0>]
    store.i64 [rax], 5
    lea rax, [<gpr0>+<off1>]
    store.i64 [rax], 0
    lea rax, [<gpr0>+<off2>]
    store.i64 [rax], 7
    mov rdi, <gpr0>
    mov rsi, 4
    call @count [args=(rsi,rdi)]
    zext.i32 <gpr2>, rax
    mov rdi, <gpr0>
    call @flag [args=(rdi)]
    add.u32 <gpr2>, @seen
    add.u32 rax, <gpr2>
    ret rax
