machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add.i32 [rdi], 1
    ret

function @three
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2>

  block ^entry
    mov <gpr0>, rdi
    mov <gpr1>, rsi
    mov <gpr2>, rdx
    call @touch [args=(rdi)]
    load.u32 rax, [<gpr0>]
    add.i32 rax, [<gpr1>]
    add.i32 rax, [<gpr2>]
    ret rax

function @five
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %d -> rcx : ptr
    param %e -> r8 : ptr
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr3> <gpr4> <gpr1> <gpr2>

  block ^entry
    mov <gpr0>, rdi
    mov <gpr1>, rsi
    mov <gpr2>, rdx
    mov <gpr4>, rcx
    mov <gpr3>, r8
    call @touch [args=(rdi)]
    load.u32 rax, [<gpr0>]
    add.i32 rax, [<gpr1>]
    add.i32 rax, [<gpr2>]
    add.i32 rax, [<gpr4>]
    add.i32 rax, [<gpr3>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>
    slot $v -> [rbp-<off0>] : obj<20x4>

  block ^entry
    store.i32 [rbp-<off0>], 1
    store.i32 [rbp-<off1>], 2
    store.i32 [rbp-<off2>], 3
    store.i32 [rbp-<off3>], 4
    store.i32 [rbp-<off4>], 5
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off1>]
    lea rdx, [rbp-<off2>]
    call @three [args=(rdx,rsi,rdi)]
    zext.i32 <gpr0>, rax
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off1>]
    lea rdx, [rbp-<off2>]
    lea rcx, [rbp-<off3>]
    lea r8, [rbp-<off4>]
    call @five [args=(rcx,rdx,rsi,rdi,r8)]
    add.i32 rax, <gpr0>
    ret rax
