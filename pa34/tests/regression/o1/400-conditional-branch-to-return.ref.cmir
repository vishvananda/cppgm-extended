machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @sum
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^head
    cmp.i64 rdi, 0
    jle ^done

  block ^body
    add rax, rdi
    sub rdi, 1
    cmp.i64 rdi, 0
    jg ^body
    ret rax

  block ^done
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 5
    call @sum [args=(rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 0
    call @sum [args=(rdi)]
    add.u32 rax, <gpr0>
    ret rax
