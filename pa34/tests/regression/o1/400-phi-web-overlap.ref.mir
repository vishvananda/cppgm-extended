machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item zero 64

function @walk
  abi
    param %n -> rdi : i64
    param %k -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, @table
    mov rax, rsi
    mov rcx, 0

  block ^head
    load.i64 rdx, [r8+rax*8]
    cmp.i64 rdx, rdi
    jge ^back

  block ^step
    add rax, 1

  block ^tail
    add rdx, 1
    add rcx, rdx
    cmp.i64 rcx, rdi
    jl ^tail~head
    ret rcx

  block ^tail~head
    load.i64 rdx, [r8+rax*8]
    cmp.i64 rdx, rdi
    jl ^step

  block ^back
    mov rax, rsi
    add rdx, 1
    add rcx, rdx
    cmp.i64 rcx, rdi
    jl ^tail~head
    ret rcx

  block ^out
    ret rcx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 4
    mov rsi, 0
    call @walk [args=(rsi,rdi)]
    ret rax
