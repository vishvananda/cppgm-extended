machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @table
  storage data
  item zero 16

function @sum_products
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i32
    param %out -> rdx : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rsi, 0
    jg ^entry~loop
    ret rsi

  block ^entry~loop
    mov rax, 0
    mov rcx, 0

  block ^loop
    load.u32 r8, [rdi+rax*4]
    imul.i32 r8, r8
    add.i32 rcx, r8
    add rax, 1
    cmp.i32 rax, rsi
    jl ^loop

  block ^loop~end
    zext.i32 rax, rcx

  block ^end
    store.i32 [rdx], rax
    ret rsi

  block ^done
    ret rsi

function @divides
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    cqo.i32
    idiv.i32 rsi
    cmp.i32 rdx, 0
    je ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12

  block ^entry
    store.i32 @table, 3
    store.i32 @table+4, 4
    store.i32 @table+8, 5
    lea rdi, @table
    mov rsi, 3
    lea rdx, @table+12
    call @sum_products [args=(rdx,rsi,rdi)]
    load.u32 rbx, @table+12
    mov rdi, 9
    mov rsi, 3
    call @divides [args=(rsi,rdi)]
    zext.i32 r12, rax
    mov rdi, 9
    mov rsi, 4
    call @divides [args=(rsi,rdi)]
    imul.i32 rbx, 2
    add.i32 rbx, r12
    sub.i32 rbx, rax
    ret rbx
