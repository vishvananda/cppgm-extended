machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %n -> rdi : i64
    param %rounds -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    mov rdx, 0
    mov rcx, 0

  block ^head
    cmp.i64 rax, 0
    je ^zero

  block ^body
    lea rdi, [rax-1]
    add rcx, rax
    mov rax, rdi

  block ^latch
    add rdx, 1
    cmp.i64 rdx, rsi
    jl ^latch~head
    ret rcx

  block ^latch~head
    cmp.i64 rax, 0
    jne ^body

  block ^zero
    add rcx, 100
    mov rax, 1
    add rdx, 1
    cmp.i64 rdx, rsi
    jl ^body
    ret rcx

  block ^out
    ret rcx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 5
    mov rsi, 40
    call @walk [args=(rsi,rdi)]
    sext.i32 rcx, rax
    mov r11, 2190262207
    mov rax, rcx
    imul rax, r11
    sar rax, 39
    mov rdx, rcx
    sar rdx, 63
    sub rax, rdx
    imul rax, 251
    mov rdx, rcx
    sub rdx, rax
    mov rax, rdx
    ret rax
