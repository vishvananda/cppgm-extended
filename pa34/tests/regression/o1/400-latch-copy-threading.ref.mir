machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %n -> rdi : i64
    param %rounds -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rcx, 0
    mov rax, 0

  block ^head
    cmp.i64 rdi, 0
    jne ^body

  block ^zero
    add rax, 100
    mov rdi, 1
    add rcx, 1
    cmp.i64 rcx, rsi
    jl ^body
    ret rax

  block ^body
    lea rdx, [rdi-1]
    add rax, rdi
    mov rdi, rdx

  block ^latch
    add rcx, 1
    cmp.i64 rcx, rsi
    jl ^latch~head
    ret rax

  block ^latch~head
    cmp.i64 rdi, 0
    jne ^body
    jmp ^zero

  block ^out
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 5
    mov rsi, 40
    call @walk [args=(rsi,rdi)]
    sext.i32 rcx, rax
    mov r11, 2190262207
    mov rax, rcx
    imul rax, r11
    sar rax, 39
    mov rdx, rcx
    sar rdx, 63
    sub rax, rdx
    imul rax, 251
    mov rdx, rcx
    sub rdx, rax
    mov rax, rdx
    ret rax
