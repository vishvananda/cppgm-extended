machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %a -> rdi : i64
    param %n -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rax, 0
    mov r8, 0

  block ^head
    shl rax, 1
    lea r9, [rax+1]
    mov rbx, rcx
    and rbx, rdi
    add rax, 2
    test.i64 rbx, rbx
    cmove rax, r9
    shr rcx, 1
    add r8, 1
    cmp.i64 r8, rsi
    jb ^head

  block ^done
    add rax, rdx
    ret rax

function @in_rcx
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    shr rcx, 1
    lea rax, [rdi+rsi]
    add rax, rdx
    xor rax, rcx
    ret rax

function @variable
  abi
    param %x -> rdi : i64
    param %count -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rcx, rsi
    mov rax, rdi
    shl rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r14

  block ^entry
    mov rdi, 5
    mov rsi, 3
    mov rdx, 1
    mov rcx, 4
    call @walk [args=(rcx,rdx,rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 3
    mov rsi, 2
    call @variable [args=(rsi,rdi)]
    zext.i32 r14, rax
    mov rdi, 1
    mov rsi, 2
    mov rdx, 4
    mov rcx, 8
    call @in_rcx [args=(rcx,rdx,rsi,rdi)]
    add.u32 rbx, r14
    add.u32 rax, rbx
    ret rax
