machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @walk
  abi
    param %a -> rdi : i64
    param %n -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov r8, rcx
    mov rcx, rdx
    mov rdx, rsi
    mov rsi, rdi
    mov r9, 0
    mov rdi, 0

  block ^head
    shl r9, 1
    lea rax, [r9+1]
    mov rbx, r8
    and rbx, rsi
    add r9, 2
    test.i64 rbx, rbx
    cmove r9, rax
    shr r8, 1
    add rdi, 1
    cmp.i64 rdi, rdx
    jb ^head

  block ^done
    lea rax, [r9+rcx]
    ret rax

function @in_rcx
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %mask -> rcx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    shr rcx, 1
    lea rax, [rdi+rsi]
    add rax, rdx
    xor rax, rcx
    ret rax

function @variable
  abi
    param %x -> rdi : i64
    param %count -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rcx, rsi
    mov rax, rdi
    shl rax, rcx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12

  block ^entry
    mov rdi, 5
    mov rsi, 3
    mov rdx, 1
    mov rcx, 4
    call @walk [args=(rcx,rdx,rsi,rdi)]
    mov rbx, rax
    mov rdi, 3
    mov rsi, 2
    call @variable [args=(rsi,rdi)]
    mov r12, rax
    mov rdi, 1
    mov rsi, 2
    mov rdx, 4
    mov rcx, 8
    call @in_rcx [args=(rcx,rdx,rsi,rdi)]
    add rbx, r12
    add rax, rbx
    sext.i32 rax
    ret rax
