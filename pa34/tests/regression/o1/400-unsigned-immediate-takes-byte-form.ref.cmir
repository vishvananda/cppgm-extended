machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @last
  abi
    param %x -> rdi : u32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u32 rdi, 4294967295
    je ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @step
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea.i32 rax, [rdi-<off0>]
    ret rax

function @mask
  abi
    param %x -> rdi : u32
    return u32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and.u32 rax, 4294967280
    ret rax

function @last16
  abi
    param %x -> rdi : u16
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u16 rdi, 65535
    je ^yes

  block ^no
    mov rax, 0
    ret rax

  block ^yes
    mov rax, 1
    ret rax

function @mask16
  abi
    param %x -> rdi : u16
    return u16 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    zext.i32 rax, rdi
    and rax, 65520
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %f -> [rbp-<off0>] : i32
    temp %g -> [rbp-<off1>] : i32

  block ^entry
    mov rdi, 4294967295
    call @last [args=(rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 4294967294
    call @last [args=(rdi)]
    zext.i32 <gpr3>, rax
    mov rdi, 255
    call @last [args=(rdi)]
    zext.i32 <gpr4>, rax
    mov rdi, 8
    call @step [args=(rdi)]
    zext.i32 <gpr2>, rax
    mov rdi, 4294967295
    call @mask [args=(rdi)]
    zext.i32 <gpr1>, rax
    mov rdi, 65535
    call @last16 [args=(rdi)]
    zext.i32 <gpr5>, rax
    store.i32 [rbp-<off0>], <gpr5>
    mov rdi, 255
    call @last16 [args=(rdi)]
    zext.i32 <gpr5>, rax
    store.i32 [rbp-<off1>], <gpr5>
    mov rdi, 65535
    call @mask16 [args=(rdi)]
    cmp.u32 <gpr2>, 7
    sete <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.u32 <gpr1>, 4294967280
    sete <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.u16 rax, 65520
    sete rax
    movzx rax, rax
    add.i32 <gpr0>, <gpr3>
    add.i32 <gpr0>, <gpr4>
    add.i32 <gpr0>, [rbp-<off0>]
    add.i32 <gpr0>, [rbp-<off1>]
    shl.u32 <gpr2>, 2
    shl.u32 <gpr1>, 4
    shl.u32 rax, 5
    add.i32 <gpr0>, <gpr2>
    add.i32 <gpr0>, <gpr1>
    add.i32 rax, <gpr0>
    ret rax
