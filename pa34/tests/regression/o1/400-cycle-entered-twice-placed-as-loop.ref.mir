machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @seen
  storage scalar i64
  init i64 0

function @note
  abi
    param %v -> rdi : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    add @seen, rdi
    ret

function @tangle
  abi
    param %n -> rdi : i64
    param %odd -> rsi : i64
    param %key -> rdx : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rbx, rdi
    cmp.i64 rdx, 7
    jne ^skip

  block ^enter
    cmp.i64 rsi, 0
    je ^a

  block ^b
    sub rbx, 1
    cmp.i64 rbx, 0
    jg ^a
    jmp ^done

  block ^a~b
    sub rbx, 1
    cmp.i64 rbx, 0
    jg ^a

  block ^done
    ret rbx

  block ^a
    cmp.i64 rbx, 3
    jge ^a~b

  block ^rare
    mov rdi, 1
    call @note [args=(rdi)]
    jmp ^b

  block ^skip
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rdi, 5
    mov rsi, 0
    mov rdx, 7
    call @tangle [args=(rdx,rsi,rdi)]
    zext.i32 rbx, rax
    mov rdi, 6
    mov rsi, 1
    mov rdx, 7
    call @tangle [args=(rdx,rsi,rdi)]
    add.u32 rbx, @seen
    add.u32 rax, rbx
    ret rax
