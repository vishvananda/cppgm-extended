machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @slow
  abi
    param %a -> xmm0 : f64
    param %b -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fadd.f64 xmm0, xmm0, xmm1
    ret xmm0

function @scaled_sum
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13
    param-slot %x -> [rbp-8] : f64
    param-slot %y -> [rbp-16] : f64
    temp %s -> [rbp-24] : f64

  block ^entry
    mov r12, rdi
    mov r13, rsi
    fmov.f64 [rbp-8], xmm0
    fmov.f64 [rbp-16], xmm1
    cmp.i64 r13, 0
    jle ^entry~done

  block ^entry~loop
    mov rbx, 0
    fmov.f64 xmm1, 0.0

  block ^loop
    fmov.f64 xmm0, [r12+rbx*8]
    fmul.f64 xmm2, xmm0, [rbp-8]
    fadd.f64 xmm2, xmm2, [rbp-16]
    fcmp.f64 xmm2, xmm2
    jp ^loop~cold

  block ^loop~next
    fmov.f64 xmm0, xmm2

  block ^next
    fadd.f64 xmm1, xmm1, xmm0
    add rbx, 1
    cmp.i64 rbx, r13
    jl ^loop
    jmp ^next~done

  block ^loop~cold
    fmov.f64 [rbp-24], xmm1

  block ^cold
    fmov.f64 xmm1, [rbp-8]
    call @slow [args=(xmm0,xmm1)]
    fmov.f64 xmm1, [rbp-24]
    jmp ^next

  block ^next~done
    fmov.f64 xmm0, xmm1
    jmp ^done

  block ^entry~done
    fmov.f64 xmm0, 0.0

  block ^done
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $values -> [rbp-16] : obj<16x8>

  block ^entry
    fmov.f64 [rbp-16], 1.0
    fmov.f64 [rbp-8], 2.0
    lea rdi, [rbp-16]
    mov rsi, 2
    fmov.f64 xmm0, 2.0
    fmov.f64 xmm1, 1.0
    call @scaled_sum [args=(rsi,rdi,xmm0,xmm1)]
    fptosi.f64.i32 rax, xmm0
    sext.i32 rax
    ret rax
