machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @three_way
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    jg ^above

  block ^rest
    jge ^same

  block ^below
    mov rax, 2
    ret rax

  block ^same
    mov rax, 3
    ret rax

  block ^above
    mov rax, 1
    ret rax

function @not_every_edge
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    param %e -> rdx : i32
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, rsi
    jle ^mid

  block ^entry~above
    mov rax, 1
    ret rax

  block ^mid
    cmp.i32 rdx, 0
    je ^rest

  block ^mid~above
    mov rax, 4
    ret rax

  block ^above
    ret rax

  block ^rest
    cmp.i32 rdi, rsi
    jge ^same

  block ^below
    mov rax, 2
    ret rax

  block ^same
    mov rax, 3
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %f -> [rbp-<off0>] : i32

  block ^entry
    mov rdi, 1
    mov rsi, 2
    call @three_way [args=(rsi,rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 2
    mov rsi, 1
    call @three_way [args=(rsi,rdi)]
    zext.i32 <gpr1>, rax
    mov rdi, 2
    mov rsi, 2
    call @three_way [args=(rsi,rdi)]
    zext.i32 <gpr2>, rax
    mov rdi, 1
    mov rsi, 2
    mov rdx, 0
    call @not_every_edge [args=(rdx,rsi,rdi)]
    zext.i32 <gpr3>, rax
    mov rdi, 2
    mov rsi, 2
    mov rdx, 0
    call @not_every_edge [args=(rdx,rsi,rdi)]
    zext.i32 <gpr4>, rax
    mov rdi, 2
    mov rsi, 2
    mov rdx, 1
    call @not_every_edge [args=(rdx,rsi,rdi)]
    zext.i32 <gpr5>, rax
    store.i32 [rbp-<off0>], <gpr5>
    mov rdi, 3
    mov rsi, 2
    mov rdx, 1
    call @not_every_edge [args=(rdx,rsi,rdi)]
    imul.i32 <gpr0>, 10
    add.i32 <gpr0>, <gpr1>
    imul.i32 <gpr0>, 10
    add.i32 <gpr0>, <gpr2>
    add.i32 <gpr3>, <gpr4>
    add.i32 <gpr3>, [rbp-<off0>]
    add.i32 <gpr3>, rax
    add.u32 <gpr0>, <gpr3>
    zext.i32 <gpr5>, <gpr0>
    imul rax, <gpr5>, 1374389535
    shr rax, 38
    imul rax, 200
    zext.i32 rdx, <gpr5>
    sub.u32 rdx, rax
    zext.i32 rax, rdx
    ret rax
