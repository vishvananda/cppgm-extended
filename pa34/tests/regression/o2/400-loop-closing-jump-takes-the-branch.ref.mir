machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @text
  storage data
  item u8 97
  item u8 98
  item u8 99
  item u8 100
  item u8 0
  item zero 3

global @found
  storage data
  item zero 16

function @scan
  abi
    param %p -> rdi : ptr
    param %out -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.u8 [rdi], 0
    jne ^second

  block ^entry~done
    mov rax, rdi

  block ^done
    mov rcx, rax
    sub rcx, rdi
    add rcx, 0
    store.i64 [rsi], rcx
    load.u8 rax, [rax]
    store.i64 [rsi+8], rax
    ret

  block ^second
    lea rax, [rdi+1]
    cmp.u8 [rax], 0
    je ^done

  block ^loop~loop
    lea rax, [rax+1]
    cmp.u8 [rax], 0
    jne ^loop~loop
    jmp ^done

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, @text
    mov rsi, @found
    call @scan [args=(rsi,rdi)]
    load.u32 rax, @found
    ret rax
