machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @seen
  storage scalar i64
  init i64 0

function @step
  abi
    param %v -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, rdi
    add rax, @seen
    store.i64 @seen, rax
    ret rax

function @walk
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    temp %g -> [rbp-8] : i64
    temp %h -> [rbp-16] : i64
    temp %k -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64
    param-slot %f -> [rbp-48] : i64

  block ^entry
    mov r13, rdi
    mov r14, rsi
    mov r15, rdx
    mov rax, r13
    imul rax, r14
    store.i64 [rbp-8], rax
    mov rax, r15
    imul rax, rcx
    store.i64 [rbp-16], rax
    mov rax, r8
    imul rax, r9
    store.i64 [rbp-24], rax
    mov rbx, 0
    mov r12, 0
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    store.i64 [rbp-48], r9

  block ^head
    mov rdi, rbx
    call @step [args=(rdi)]
    cmp.i64 rax, 1000
    jge ^done

  block ^head~latch
    load.i64 rcx, [rbp-32]
    load.i64 r8, [rbp-40]
    load.i64 r9, [rbp-48]

  block ^latch
    add r12, r13
    xor r12, r14
    add r12, r15
    xor r12, rcx
    add r12, r8
    xor r12, r9
    add r12, [rbp-8]
    xor r12, [rbp-16]
    add r12, [rbp-24]
    xor r12, r13
    add r12, r14
    xor r12, r15
    add r12, rcx
    xor r12, r8
    add r12, r9
    xor r12, [rbp-8]
    add r12, [rbp-16]
    xor r12, [rbp-24]
    add rbx, 7
    jmp ^head

  block ^done
    ret r12

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %r -> [rbp-8] : i64

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @walk [args=(rcx,rdx,rsi,rdi,r8,r9)]
    zext.i32 r10, rax
    and.i32 rax, 127
    ret rax
