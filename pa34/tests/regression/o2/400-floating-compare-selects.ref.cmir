machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @nan_bits
  storage scalar i64
  init i64 9221120237041090560

function @lt_f80
  abi
    param %a -> xmm0 : f64
    param %b -> xmm1 : f64
    param %x -> rdi : i64
    param %y -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues duplicated
    temp %p -> [rbp-<off0>] : f80
    temp %q -> [rbp-<off1>] : f80

  block ^entry
    fpext.f64.f80 [rbp-<off0>], xmm0
    fpext.f64.f80 [rbp-<off1>], xmm1
    flt.f80 rax, [rbp-<off0>], [rbp-<off1>]
    test.u8 rax, rax
    mov rax, rsi
    cmovne rax, rdi
    ret rax

