machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @rows
  storage data
  item u32 5
  item u32 1
  item u32 6
  item u32 4294967295
  item u32 7
  item u32 0
  item u32 8
  item u32 1

global @out
  storage data
  item zero 8

global @count
  storage data
  item zero 8

function @map
  abi
    param %rows -> rdi : ptr
    param %n -> rsi : i64
    param %out -> rdx : ptr
    param %count -> rcx : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r8, rcx
    cmp.i64 rsi, 0
    je ^done

  block ^entry~body
    mov rax, 0

  block ^body
    load.u32 rcx, [rdi+rax*8+4]
    cmp.u32 rcx, 4294967295
    jne ^record

  block ^step
    add rax, 1
    cmp.i64 rax, rsi
    jae ^done

  block ^step~body
    load.u32 rcx, [rdi+rax*8+4]
    cmp.u32 rcx, 4294967295
    je ^step

  block ^record
    store.u32 [rdx+rcx*4], rax
    load.u32 rcx, [rdi+rax*8+4]
    add.u32 [r8+rcx*4], 1
    add rax, 1
    cmp.i64 rax, rsi
    jb ^step~body
    ret

  block ^done
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, @rows
    mov rsi, 4
    mov rdx, @out
    mov rcx, @count
    call @map [args=(rcx,rdx,rsi,rdi)]
    imul.u32 rax, @out+4, 10
    add.u32 rax, @count+4
    ret rax
