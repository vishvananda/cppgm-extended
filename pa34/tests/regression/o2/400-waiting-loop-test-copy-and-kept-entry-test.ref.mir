machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @list
  storage data
  item zero 32

global @top
  storage scalar i32
  init i32 0

function @sort
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    store.i32 @top, 7
    mov rdx, @list
    mov rcx, 7
    mov rax, 1

  block ^test
    cmp.i32 rax, rcx
    jge ^pass_done

  block ^body
    load.u32 r8, [rdx+rax*4]
    lea rsi, [rax+1]
    load.u32 rdi, [rdx+rsi*4]
    cmp.i32 r8, rdi
    jle ^body~next

  block ^swap
    store.i32 [rdx+rax*4], rdi
    store.i32 [rdx+rsi*4], r8
    mov rax, rsi
    cmp.i32 rax, rcx
    jge ^pass_done
    jmp ^body

  block ^body~next
    mov rax, rsi

  block ^next
    cmp.i32 rax, rcx
    jl ^body

  block ^pass_done
    sub.i32 rcx, 1
    store.i32 @top, rcx
    cmp.i32 rcx, 1
    jg ^pass_done~next
    ret

  block ^pass_done~next
    mov rax, 1
    jmp ^next

  block ^done
    ret

function @mix
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea.i32 rax, [rdi+rsi]
    and.i32 rax, 3
    ret rax

function @walk
  abi
    param %m -> rdi : i32
    param %n -> rsi : i32
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    add rdi, 1
    mov rbx, rdi

  block ^outer
    cmp.i32 rsi, 0
    jne ^inner

  block ^outer~step
    mov rsi, 1
    sub rbx, 1
    je ^last

  block ^inner
    sub rsi, 1
    mov rdi, rbx
    call @mix [args=(rsi,rdi)]
    sext.i32 rax
    mov rsi, rax

  block ^step
    sub rbx, 1
    je ^last

  block ^step~outer
    cmp.i32 rsi, 0
    je ^outer~step
    jmp ^inner

  block ^bump
    mov rdi, rsi
    mov rsi, 7
    call @mix [args=(rsi,rdi)]
    zext.i32 rsi, rax
    jmp ^done

  block ^last
    add rsi, 1
    test.u8 rsi, 1
    jne ^bump

  block ^done
    ret rsi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

  block ^entry
    mov rbx, @list
    mov rax, 0

  block ^fill
    mov rcx, 8
    sub.i32 rcx, rax
    store.i32 [rbx+rax*4], rcx
    add rax, 1
    cmp.i32 rax, 8
    jl ^fill

  block ^run
    call @sort [args=()]
    load.u32 rbx, [rbx+8]
    mov rdi, 5
    mov rsi, 3
    call @walk [args=(rsi,rdi)]
    add.i32 rbx, rax
    sext.i32 rax, rbx
    ret rax
