#include <stdio.h>
#include <algorithm>
#include <math.h>
__attribute__((noinline)) double a1(double a, double b) { return a < b ? a : b; }
__attribute__((noinline)) double a2(double a, double b) { return a > b ? a : b; }
__attribute__((noinline)) double a3(double a, double b) { return a < b ? b : a; }
__attribute__((noinline)) double a4(double a, double b) { return a > b ? b : a; }
__attribute__((noinline)) double a5(double a, double b) { return a <= b ? a : b; }
__attribute__((noinline)) double a6(double a, double b) { return a >= b ? a : b; }
__attribute__((noinline)) double a7(double a) { return a <= 1e-30 ? a : 1e-30; }
__attribute__((noinline)) double a8(double a) { return a >= 2.5 ? 2.5 : a; }
__attribute__((noinline)) float b1(float a, float b) { return a < b ? a : b; }
__attribute__((noinline)) float b2(float a, float b) { return a > b ? a : b; }
__attribute__((noinline)) double c1(double a, double b) { return std::min(a, b); }
__attribute__((noinline)) double c2(double a, double b) { return std::max(a, b); }
__attribute__((noinline)) double a9(double a) { return a < 0.0 ? a : 0.0; }
__attribute__((noinline)) double a10(double a) { return a <= 0.0 ? a : 0.0; }
int main() {
  double v[] = { 0.0, -0.0, 1.0, -1.0, 2.5, 1e-30, NAN, -NAN, INFINITY, -INFINITY };
  for (double x : v) { printf("%a %a\n", a7(x), a8(x)); printf("%a %a\n", a9(x), a10(x));
    for (double y : v) printf("%a %a %a %a %a %a %a %a %a %a\n", a1(x,y), a2(x,y), a3(x,y), a4(x,y), a5(x,y), a6(x,y), (double)b1(x,y), (double)b2(x,y), c1(x,y), c2(x,y)); }
}
