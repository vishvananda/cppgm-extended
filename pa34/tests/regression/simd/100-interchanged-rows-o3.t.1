#include <stdio.h>

static double a[33][33], b[33][33], r[33][33];
static float fa[36][36], fb[36][36], fr[36][36];
static int ia[30][30], ib[30][30], ir[30][30];
static double same[33][33];

__attribute__((noinline)) static void inner(double* out, int i, int j)
{
	*out = 0;
	for (int k = 1; k <= 32; ++k)
		*out = *out + a[i][k] * b[k][j];
}

__attribute__((noinline)) static void product()
{
	for (int i = 1; i <= 32; ++i)
		for (int j = 1; j <= 32; ++j)
		{
			r[i][j] = 0;
			for (int k = 1; k <= 32; ++k)
				r[i][j] = r[i][j] + a[i][k] * b[k][j];
		}
}

__attribute__((noinline)) static int floats(int row)
{
	int k = 0, j = 0;
	for (j = 0; j < 36; ++j)
	{
		float s = 1e8f;
		for (k = 0; k < 36; ++k)
			s += fa[row][k] * fb[k][j];
		fr[row][j] = s;
	}
	return j * 100 + k;
}

__attribute__((noinline)) static void integers()
{
	for (int i = 0; i < 30; ++i)
		for (int j = 0; j < 30; ++j)
		{
			int val = 3;
			for (int k = 0; k < 30; ++k)
				val += ia[i][k] * ib[k][j];
			ir[i][j] = val;
		}
}

// The inner loop reads what the outer loop stores in this row.
__attribute__((noinline)) static void overlapping()
{
	for (int j = 0; j < 33; ++j)
	{
		double s = 0.5;
		for (int k = 0; k < 33; ++k)
			s += same[k][j] * 0.25;
		same[0][j] = s;
	}
}

// The inner count depends on the outer pass.
__attribute__((noinline)) static void triangle()
{
	for (int j = 0; j < 33; ++j)
	{
		double s = 0;
		for (int k = 0; k <= j; ++k)
			s += b[k][j];
		r[0][j] = s;
	}
}

// The columns come down: the lanes run backward.
__attribute__((noinline)) static void downward()
{
	for (int j = 32; j >= 0; --j)
	{
		double s = 2;
		for (int k = 0; k < 33; ++k)
			s += a[k][j] * b[k][j];
		r[32][j] = s;
	}
}

int main()
{
	for (int i = 0; i < 33; ++i)
		for (int j = 0; j < 33; ++j)
		{
			a[i][j] = 1.0 / (i + j + 1);
			b[i][j] = 1e15 * (i - j) + 0.125 * j;
			same[i][j] = i * 3 + j;
		}
	for (int i = 0; i < 36; ++i)
		for (int j = 0; j < 36; ++j)
		{
			fa[i][j] = 0.1f * (i + 1) * (j + 1);
			fb[i][j] = 1000.0f / (i * j + 1);
		}
	for (int i = 0; i < 30; ++i)
		for (int j = 0; j < 30; ++j)
		{
			ia[i][j] = i * 7 - j;
			ib[i][j] = j * 5 - i * 3;
		}
	product();
	double t = 0;
	inner(&t, 3, 5);
	printf("%.17g %.17g %.17g %.17g\n", r[1][1], r[3][5], r[32][32], t);
	printf("%d\n", floats(4));
	for (int j = 0; j < 36; ++j)
		printf("%.9g ", fr[4][j]);
	printf("\n");
	integers();
	for (int j = 0; j < 30; ++j)
		printf("%d ", ir[7][j]);
	printf("\n");
	overlapping();
	for (int j = 0; j < 33; ++j)
		printf("%.17g ", same[0][j]);
	printf("\n");
	triangle();
	for (int j = 0; j < 33; ++j)
		printf("%.17g ", r[0][j]);
	printf("\n");
	downward();
	for (int j = 0; j < 33; ++j)
		printf("%.17g ", r[32][j]);
	printf("\n");
	return 0;
}
