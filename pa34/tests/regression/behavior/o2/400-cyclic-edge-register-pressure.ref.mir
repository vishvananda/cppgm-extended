machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item i64 0
  item i64 0

global @a
  storage scalar i64
  init i64 1

global @b
  storage scalar i64
  init i64 2

global @c
  storage scalar i64
  init i64 3

global @d
  storage scalar i64
  init i64 4

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0
    ret rax

function @probe
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    slot $counter -> [rbp-8] : i64
    temp %a -> [rbp-16] : i64

  block ^entry
    mov r14, @data
    load.i64 rax, @a
    store.i64 [rbp-16], rax
    load.i64 r12, @b
    load.i64 r13, @c
    load.i64 r15, @d
    store.i64 [rbp-8], 0

  block ^condition
    load.i64 rbx, [rbp-8]
    cmp.i64 rbx, 2
    jae ^done

  block ^body
    store.i64 [r14+rbx*8], rbx
    call @noop [args=(), unwind=no]
    mov rax, r12
    add rax, [rbp-16]
    lea rcx, [r13+r15]
    lea rax, [rax+rcx+7]
    add rbx, 1
    store.i64 [rbp-8], rbx
    cmp.i64 rax, 17
    je ^condition

  block ^failure
    mov rax, 1
    ret rax

  block ^done
    cmp.i64 [r14+8], 1
    setne rax
    movzx rax, rax
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    call @probe [args=(), unwind=no]
    ret rax
