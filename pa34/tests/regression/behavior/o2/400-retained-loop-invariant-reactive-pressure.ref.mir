machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @state
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @arena
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @stats
  storage scalar i64
  init i64 0

global @result
  storage scalar i64
  init i64 0

global @node
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

global @edges
  storage data
  item u32 0
  item u32 1
  item u32 0
  item u32 4294967295

global @no_edge
  storage scalar u32
  init u32 4294967295

function @edge_at
  abi
    param %base -> rdi : ptr
    param %index -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    imul rsi, 8
    mov rax, rsi
    mov r10, @edges
    add rax, r10
    ret rax

function @node_at
  abi
    param %base -> rdi : ptr
    param %index -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, @node
    ret rax

function @payload
  abi
    param %arena_pointer -> rdi : ptr
    param %value -> rsi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rsi

function @append
  abi
    param %destination -> rdi : ptr
    param %value -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret

function @walk
  abi
    param %this -> rdi : ptr
    param %declarator -> rsi : u32
    param %fallback -> rdx : u32
    param %names -> rcx : ptr
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r13 r14 r15
    slot $fallback -> [rbp-16] : u32
    slot $payload -> [rbp-8] : u32

  block ^entry
    mov r13, rcx
    store.u32 [rbp-16], rdx
    lea rbx, [rdi+24]
    load.ptr rax, [rbx]
    lea rdi, [rax+32]
    call @node_at [args=(rsi,rdi), unwind=no]
    load.u32 r14, [rax+12]

  block ^outer_condition
    cmp.u32 r14, @no_edge
    je ^outer_done

  block ^outer_body
    load.ptr rax, [rbx]
    lea rdi, [rax+56]
    mov rsi, r14
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 r15, [rax]
    load.ptr rax, [rbx]
    load.ptr rcx, [rax+8]
    cmp.ptr rcx, 0
    je ^inspect

  block ^record
    add [rcx], 1

  block ^inspect
    lea rdi, [rax+32]
    mov rsi, r15
    call @node_at [args=(rsi,rdi), unwind=no]
    cmp.u16 [rax+30], 121
    sete rax
    cmp.u8 rax, 0
    jne ^inner_start

  block ^outer_iterate
    load.ptr rax, [rbx]
    lea rdi, [rax+56]
    mov rsi, r14
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 r14, [rax+4]
    cmp.u32 r14, @no_edge
    jne ^outer_body

  block ^outer_done
    mov rdi, r13
    lea rsi, [rbp-16]
    call @append [args=(rsi,rdi), unwind=no]
    ret

  block ^inner_start
    load.ptr rax, [rbx]
    lea rdi, [rax+32]
    mov rsi, r15
    call @node_at [args=(rsi,rdi), unwind=no]
    load.u32 r14, [rax+12]

  block ^inner_condition
    cmp.u32 r14, @no_edge
    je ^inner_done

  block ^inner_body
    load.ptr r15, [rbx]
    lea rdi, [r15+56]
    mov rsi, r14
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 rsi, [rax]
    mov rdi, r15
    call @payload [args=(rsi,rdi), unwind=no]
    store.u32 [rbp-8], rax
    mov rdi, r13
    lea rsi, [rbp-8]
    call @append [args=(rsi,rdi), unwind=no]
    load.ptr rax, [rbx]
    lea rdi, [rax+56]
    mov rsi, r14
    call @edge_at [args=(rsi,rdi), unwind=no]
    load.u32 r14, [rax+4]
    cmp.u32 r14, @no_edge
    jne ^inner_body

  block ^inner_done
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov r11, @arena
    store.ptr @state+24, r11
    mov r11, @stats
    store.ptr @arena+8, r11
    mov rdi, @state
    mov rsi, 0
    mov rdx, 0
    mov rcx, @result
    call @walk [args=(rcx,rdx,rsi,rdi), unwind=no]
    cmp.i64 @stats, 2
    setne rax
    movzx rax, rax
    ret rax
