machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @eh_loop
  abi
    param %n -> rdi : i64
    param %cleanups -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r13 r14 r15

  block ^entry
    mov r13, rdi
    mov r15, rsi
    mov r14, 0
    mov rbx, 0

  block ^for_cond_1
    cmp.i64 rbx, r13
    jge ^for_end_4

  block ^for_body_2
    mov rdi, rbx
    call @work [args=(rdi)]
    lea rax, [rbx+rax*2]
    add r14, rax
    add [r15], 1
    add rbx, 1
    cmp.i64 rbx, r13
    jl ^for_body_2

  block ^for_end_4
    ret r14

function @work
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea rax, [rdi+3]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $cleanups -> [rbp-8] : i64

  block ^entry
    store.i64 [rbp-8], 0
    mov rdi, 4
    lea rsi, [rbp-8]
    call @eh_loop [args=(rsi,rdi)]
    cmp.i64 rax, 42
    je ^land_rhs_4

  block ^land_short_5
    mov rax, 0

  block ^cond_else_2
    mov rax, 1

  block ^cond_end_3
    ret rax

  block ^land_rhs_4
    cmp.i64 [rbp-8], 4
    sete rax

  block ^land_end_6
    cmp.u8 rax, 0
    je ^cond_else_2

  block ^cond_then_1
    mov rax, 0
    jmp ^cond_end_3
