machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk
  abi
    param %root -> rdi : ptr
    param %input -> rsi : ptr
    param %length -> rdx : i64
    param %budget -> rcx : i32
    param %output -> r8 : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov <gpr3>, rdi
    mov <gpr4>, rsi
    mov <gpr2>, rdx
    zext.i32 <gpr0>, rcx
    mov rdi, r8
    cmp.ptr <gpr3>, 0
    setne rax
    cmp.i32 <gpr0>, 0
    setg rcx
    test.u8 rax, rcx
    jne ^start

  block ^empty
    mov rax, 0
    ret rax

  block ^start
    call @touch [args=(rdi)]
    mov r8, rax
    mov rsi, 0
    mov rax, <gpr3>
    mov rdi, 0
    mov rcx, 0

  block ^head
    cmp.i64 rsi, <gpr2>
    jae ^finish

  block ^byte
    load.u8 rdx, [<gpr4>+rsi]

  block ^step0
    lea.i32 r9, [rcx+<off0>]
    mov <gpr1>, rdx
    shr <gpr1>, 7
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check0
    cmp.u8 [rax+<off0>], 0
    jne ^leaf0

  block ^merge0
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step1
    lea.i32 r9, [rcx+<off1>]
    mov <gpr1>, rdx
    shr <gpr1>, 6
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check1
    cmp.u8 [rax+<off0>], 0
    jne ^leaf1

  block ^merge1
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step2
    lea.i32 r9, [rcx+<off2>]
    mov <gpr1>, rdx
    shr <gpr1>, 5
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check2
    cmp.u8 [rax+<off0>], 0
    jne ^leaf2

  block ^merge2
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step3
    lea.i32 r9, [rcx+<off3>]
    mov <gpr1>, rdx
    shr <gpr1>, 4
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check3
    cmp.u8 [rax+<off0>], 0
    jne ^leaf3

  block ^merge3
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step4
    lea.i32 r9, [rcx+<off4>]
    mov <gpr1>, rdx
    shr <gpr1>, 3
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check4
    cmp.u8 [rax+<off0>], 0
    jne ^leaf4

  block ^merge4
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step5
    lea.i32 r9, [rcx+<off5>]
    mov <gpr1>, rdx
    shr <gpr1>, 2
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check5
    cmp.u8 [rax+<off0>], 0
    jne ^leaf5

  block ^merge5
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step6
    lea.i32 r9, [rcx+<off6>]
    mov <gpr1>, rdx
    shr <gpr1>, 1
    and <gpr1>, 1
    imul <gpr1>, 8
    load.ptr rax, [rax+<gpr1>+<off0>]
    cmp.ptr rax, 0
    je ^tail

  block ^check6
    cmp.u8 [rax+<off0>], 0
    jne ^leaf6

  block ^merge6
    cmp.i32 r9, <gpr0>
    jge ^tail

  block ^step7
    add.i32 rcx, 8
    shr rdx, 0
    and rdx, 1
    imul rdx, 8
    load.ptr rax, [rax+rdx+<off0>]
    cmp.ptr rax, 0
    je ^step7~tail

  block ^check7
    cmp.u8 [rax+<off0>], 0
    je ^step7~tail

  block ^leaf7
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>

  block ^step7~tail
    zext.i32 r9, rcx
    jmp ^tail

  block ^leaf6
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge6

  block ^leaf5
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge5

  block ^leaf4
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge4

  block ^leaf3
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge3

  block ^leaf2
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge2

  block ^leaf1
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge1

  block ^leaf0
    load.u8 rax, [rax+<off1>]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, <gpr3>
    jmp ^merge0

  block ^tail
    add rsi, 1
    zext.i32 rcx, r9
    cmp.i32 r9, <gpr0>
    jge ^finish_tail

  block ^tail~head
    cmp.i64 rsi, <gpr2>
    jb ^byte

  block ^finish
    ret rdi

  block ^finish_tail
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr3> <gpr4>
    slot $root -> [rbp-<off0>] : obj<24x8>
    slot $left -> [rbp-<off1>] : obj<24x8>
    slot $right -> [rbp-<off2>] : obj<24x8>
    slot $bytes -> [rbp-<off3>] : obj<2x1>
    slot $out -> [rbp-<off4>] : obj<16x1>

  block ^entry
    lea rax, [rbp-<off1>]
    lea rcx, [rbp-<off2>]
    store.u8 [rax+<off1>], 2
    store.u8 [rcx+<off3>], 7
    store.u8 [rax+<off0>], 1
    store.u8 [rcx+<off4>], 1
    store.ptr [rbp-<off5>], rax
    store.ptr [rbp-<off6>], rcx
    store.i16 [rbp-<off3>], 61610
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off3>]
    mov rdx, 2
    mov rcx, 13
    lea r8, [rbp-<off4>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 13
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rax, 0
    mov rcx, 0

  block ^sum
    load.u8 rdx, [rbp+rax-<off0>]
    add rcx, rdx
    add rax, 1
    cmp.i64 rax, 13
    jb ^sum

  block ^finish
    cmp.i64 rcx, 66
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off3>]
    mov rdx, 2
    mov rcx, 0
    lea r8, [rbp-<off4>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    store.ptr [rbp-<off6>], 0
    lea rdi, [rbp-<off0>]
    lea rsi, [rbp-<off3>]
    mov rdx, 1
    mov rcx, 8
    lea r8, [rbp-<off4>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or.u32 <gpr0>, <gpr3>
    or.u32 <gpr0>, <gpr4>
    or.u32 rax, <gpr0>
    ret rax
