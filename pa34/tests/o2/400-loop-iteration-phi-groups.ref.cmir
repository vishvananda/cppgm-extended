machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk
  abi
    param %root -> rdi : ptr
    param %input -> rsi : ptr
    param %length -> rdx : i64
    param %budget -> rcx : i32
    param %output -> r8 : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr1> <gpr2> <gpr3>
    param-slot %length -> [rbp-<off0>] : i64

  block ^entry
    mov <gpr3>, rdi
    mov <gpr1>, rsi
    zext.i32 <gpr0>, rcx
    cmp.ptr <gpr3>, 0
    setne rax
    cmp.i32 <gpr0>, 0
    setg rcx
    test.u8 rax, rcx
    je ^empty

  block ^entry~start
    store.i64 [rbp-<off0>], rdx

  block ^start
    mov rdi, r8
    call @touch [args=(rdi)]
    mov r9, rax
    mov rdi, 0
    mov rcx, <gpr3>
    mov r8, 0
    mov rdx, 0

  block ^head
    cmp.i64 rdi, [rbp-<off0>]
    jae ^finish

  block ^byte
    load.u8 rsi, [<gpr1>+rdi]

  block ^step0
    lea.i32 <gpr2>, [rdx+<off0>]
    mov rax, rsi
    shr rax, 7
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check0
    cmp.u8 [rax+<off0>], 0
    jne ^leaf0

  block ^merge0
    cmp.i32 <gpr2>, <gpr0>
    jge ^step0~tail

  block ^step1
    lea.i32 <gpr2>, [rdx+<off1>]
    mov rcx, rsi
    shr rcx, 6
    and rcx, 1
    imul rcx, 8
    load.ptr rcx, [rax+rcx+<off0>]
    cmp.ptr rcx, 0
    je ^tail

  block ^check1
    cmp.u8 [rcx+<off0>], 0
    jne ^leaf1

  block ^merge1
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step2
    lea.i32 <gpr2>, [rdx+<off2>]
    mov rax, rsi
    shr rax, 5
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check2
    cmp.u8 [rax+<off0>], 0
    jne ^leaf2

  block ^check2~merge2
    mov rcx, rax

  block ^merge2
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step3
    lea.i32 <gpr2>, [rdx+<off3>]
    mov rax, rsi
    shr rax, 4
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check3
    cmp.u8 [rax+<off0>], 0
    jne ^leaf3

  block ^check3~merge3
    mov rcx, rax

  block ^merge3
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step4
    lea.i32 <gpr2>, [rdx+<off4>]
    mov rax, rsi
    shr rax, 3
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check4
    cmp.u8 [rax+<off0>], 0
    jne ^leaf4

  block ^check4~merge4
    mov rcx, rax

  block ^merge4
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step5
    lea.i32 <gpr2>, [rdx+<off5>]
    mov rax, rsi
    shr rax, 2
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check5
    cmp.u8 [rax+<off0>], 0
    jne ^leaf5

  block ^check5~merge5
    mov rcx, rax

  block ^merge5
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step6
    lea.i32 <gpr2>, [rdx+<off6>]
    mov rax, rsi
    shr rax, 1
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check6
    cmp.u8 [rax+<off0>], 0
    jne ^leaf6

  block ^check6~merge6
    mov rcx, rax

  block ^merge6
    cmp.i32 <gpr2>, <gpr0>
    jge ^tail

  block ^step7
    add.i32 rdx, 8
    zext.i32 rax, rsi
    shr rax, 0
    and rax, 1
    imul rax, 8
    load.ptr rax, [rcx+rax+<off0>]
    cmp.ptr rax, 0
    je ^step7~tail

  block ^check7
    cmp.u8 [rax+<off0>], 0
    je ^step7~tail

  block ^leaf7
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rax, <gpr3>

  block ^step7~tail
    zext.i32 <gpr2>, rdx
    mov rcx, rax
    jmp ^tail

  block ^leaf6
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge6

  block ^leaf5
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge5

  block ^leaf4
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge4

  block ^leaf3
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge3

  block ^leaf2
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge2

  block ^leaf1
    load.u8 rcx, [rcx+<off1>]
    store.u8 [r9+r8], rcx
    add r8, 1
    mov rcx, <gpr3>
    jmp ^merge1

  block ^leaf0
    load.u8 rax, [rax+<off1>]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rax, <gpr3>
    jmp ^merge0

  block ^step0~tail
    mov rcx, rax

  block ^tail
    add rdi, 1
    zext.i32 rdx, <gpr2>
    cmp.i32 <gpr2>, <gpr0>
    jge ^finish_tail

  block ^tail~head
    cmp.i64 rdi, [rbp-<off0>]
    jb ^byte

  block ^finish
    ret r8

  block ^finish_tail
    ret r8

  block ^empty
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0> <gpr2> <gpr3>
    slot $root -> [rbp-<off1>] : obj<24x8>
    slot $left -> [rbp-<off2>] : obj<24x8>
    slot $right -> [rbp-<off3>] : obj<24x8>
    slot $bytes -> [rbp-<off4>] : obj<2x1>
    slot $out -> [rbp-<off5>] : obj<16x1>

  block ^entry
    lea rax, [rbp-<off2>]
    lea rcx, [rbp-<off3>]
    store.u8 [rax+<off1>], 2
    store.u8 [rcx+<off1>], 7
    store.u8 [rax+<off0>], 1
    store.u8 [rcx+<off0>], 1
    store.ptr [rbp-<off6>], rax
    store.ptr [rbp-<off7>], rcx
    store.i16 [rbp-<off4>], 61610
    lea rdi, [rbp-<off1>]
    lea rsi, [rbp-<off4>]
    mov rdx, 2
    mov rcx, 13
    lea r8, [rbp-<off5>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 13
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rax, 0
    mov rcx, 0

  block ^sum
    load.u8 rdx, [rbp+rax-<off0>]
    add rcx, rdx
    add rax, 1
    cmp.i64 rax, 13
    jb ^sum

  block ^finish
    cmp.i64 rcx, 66
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    lea rdi, [rbp-<off1>]
    lea rsi, [rbp-<off4>]
    mov rdx, 2
    mov rcx, 0
    lea r8, [rbp-<off5>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    store.ptr [rbp-<off7>], 0
    lea rdi, [rbp-<off1>]
    lea rsi, [rbp-<off4>]
    mov rdx, 1
    mov rcx, 8
    lea r8, [rbp-<off5>]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or.u32 <gpr0>, <gpr2>
    or.u32 <gpr0>, <gpr3>
    or.u32 rax, <gpr0>
    ret rax
