machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @masked_alias
  abi
    param %p -> rdi : ptr
    param %yes -> rsi : i64
    param %no -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    test.u8 [rdi], 127
    mov rax, rdx
    cmovne rax, rsi
    ret rax

function @stored_after_mask
  abi
    param %p -> rdi : ptr
    param %yes -> rsi : i64
    param %no -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rax, [rdi]
    and.i32 rax, 127
    store.i32 [rdi], 0
    mov rax, rdx
    cmovne rax, rsi
    ret rax

function @shared_load
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rdi, [rdi]
    test.u8 rdi, 127
    mov <gpr0>, 11
    mov rax, 29
    cmovne rax, <gpr0>
    add.i32 rax, rdi
    sext.i32 rax
    ret rax

function @volatile_mask
  abi
    param %p -> rdi : ptr
    param %yes -> rsi : i64
    param %no -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    load.u32 rdi, [rdi]
    test.u8 rdi, 127
    mov rax, rdx
    cmovne rax, rsi
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1> <gpr2> <gpr3> <gpr4> <gpr5>
    slot $data -> [rbp-<off0>] : i32

  block ^entry
    mov <gpr1>, 0xffffffffffffffff00000000ffffff00

  block ^loop
    store.i32 [rbp-<off0>], <gpr1>
    zext.i32 rax, <gpr1>
    and.i32 rax, 127
    mov <gpr0>, 11
    mov <gpr4>, 29
    cmovne <gpr4>, <gpr0>
    lea rdi, [rbp-<off0>]
    mov rsi, 11
    mov rdx, 29
    call @masked_alias [args=(rdx,rsi,rdi)]
    mov <gpr5>, rax
    lea rdi, [rbp-<off0>]
    call @shared_load [args=(rdi)]
    mov <gpr3>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 11
    mov rdx, 29
    call @volatile_mask [args=(rdx,rsi,rdi)]
    mov <gpr2>, rax
    lea rdi, [rbp-<off0>]
    mov rsi, 11
    mov rdx, 29
    call @stored_after_mask [args=(rdx,rsi,rdi)]
    sext.i32 rcx, <gpr1>
    add rcx, <gpr4>
    cmp.i64 <gpr5>, <gpr4>
    setne <gpr5>
    cmp.i64 <gpr3>, rcx
    setne <gpr3>
    cmp.i64 <gpr2>, <gpr4>
    setne <gpr2>
    cmp.i64 rax, <gpr4>
    setne rax
    cmp.i32 [rbp-<off0>], 0
    setne rcx
    or.u8 <gpr5>, <gpr3>
    or.u8 <gpr2>, rax
    or.u8 <gpr5>, <gpr2>
    or.u8 <gpr5>, rcx
    jne ^failed

  block ^next
    add.i32 <gpr1>, 1
    cmp.i32 <gpr1>, 256
    jl ^loop

  block ^done
    mov rax, 0
    ret rax

  block ^failed
    mov rax, 1
    ret rax
