    mov rdi, 0
    mov rsi, 0
    mov rdx, 43
    call @dispatch [args=(rdx,rsi,rdi)]
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    mov rbx, rax
    or rbx, 0
    mov rdi, 1
    mov rsi, 0
    mov rdx, 43
    call @dispatch [args=(rdx,rsi,rdi)]
    cmp.i64 rax, 43
