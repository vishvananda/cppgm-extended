machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dispatch
  abi
    param %selector -> rdi : i64
    param %guard -> rsi : i64
    param %seed -> rdx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 0
    je ^skip

  block ^check
    cmp.i64 rdi, 5
    ja ^outside

  block ^choose
    cmp.i64 rsi, 0
    jl ^left

  block ^right
    xor rdx, 4
    mov r8, rdx
    mov r10, rdi
    jump_table r10, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case0
    lea rax, [r8+1]
    ret rax

  block ^skip
    ret rdx

  block ^outside
    mov rax, rdx
    xor rax, rdi
    ret rax

  block ^left
    add rdx, 17
    mov r8, rdx
    mov r10, rdi
    jump_table r10, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case1
    lea rax, [r8-7]
    ret rax

  block ^table
    mov r10, rdi
    jump_table r10, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case2
    lea rax, [r8+r8*2]
    ret rax

  block ^case3
    mov rax, r8
    xor rax, 19
    ret rax

  block ^case4
    mov rax, r8
    or rax, 16
    ret rax

  block ^case5
    mov rax, r8
    and rax, 127
    ret rax

  block ^impossible
    trap

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx

