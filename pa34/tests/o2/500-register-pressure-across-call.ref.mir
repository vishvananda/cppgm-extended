machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15
    param-slot %n -> [rbp-40] : i64
    temp %t50 -> [rbp-8] : i64
    temp %t51 -> [rbp-16] : i64
    temp %t52 -> [rbp-24] : i64
    temp %t53 -> [rbp-32] : i64

  block ^entry
    store.i64 [rbp-40], rdi
    mov r14, 1
    mov r15, 2
    mov r13, 3
    mov r12, 4
    store.i64 [rbp-8], 5
    store.i64 [rbp-16], 6
    store.i64 [rbp-24], 7
    store.i64 [rbp-32], 8
    mov rbx, 0

  block ^for_cond_1
    cmp.i64 rbx, rdi
    jge ^for_end_4

  block ^for_body_2
    mov rdi, rbx
    call @step [args=(rdi)]
    add r14, rax
    add r15, r14
    add r13, r15
    add r12, r13
    mov rax, r12
    add rax, [rbp-8]
    mov rcx, rax
    add rcx, [rbp-16]
    mov rdx, rcx
    add rdx, [rbp-24]
    mov rsi, rdx
    add rsi, [rbp-32]
    add rbx, 1
    store.i64 [rbp-8], rax
    store.i64 [rbp-16], rcx
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rsi
    cmp.i64 rbx, [rbp-40]
    jl ^for_body_2

  block ^for_end_4
    lea rax, [r14+r15]
    add rax, r13
    add rax, r12
    add rax, [rbp-8]
    add rax, [rbp-16]
    add rax, [rbp-24]
    add rax, [rbp-32]
    ret rax

function @step
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea rax, [rdi+1]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 3
    call @pressure [args=(rdi)]
    cmp.i64 rax, 1008
    je ^cond_then_1

  block ^cond_else_2
    mov rax, 1
    ret rax

  block ^cond_end_3
    ret rax

  block ^cond_then_1
    mov rax, 0
    ret rax
