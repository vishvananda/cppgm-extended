machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dispatch
  abi
    param %selector -> rdi : i64
    param %guard -> rsi : i64
    param %seed -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i64 rsi, 0
    je ^skip

  block ^check
    cmp.i64 rdi, 5
    ja ^outside

  block ^choose
    cmp.i64 rsi, 0
    jl ^left

  block ^right
    mov rax, rdx
    xor rax, 4
    jump_table rdi, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case0
    add rax, 1
    ret rax

  block ^skip
    ret rdx

  block ^outside
    mov rax, rdx
    xor rax, rdi
    ret rax

  block ^left
    lea rax, [rdx+<off0>]
    jump_table rdi, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case1
    sub rax, 7
    ret rax

  block ^table
    jump_table rdi, [^case0, ^case1, ^case2, ^case3, ^case4, ^case5]

  block ^case2
    imul rax, 3
    ret rax

  block ^case3
    xor rax, 19
    ret rax

  block ^case4
    or rax, 16
    ret rax

  block ^case5
    and rax, 127
    ret rax

  block ^impossible
    trap

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 0
    mov rsi, 0
    mov rdx, 43
    call @dispatch [args=(rdx,rsi,rdi)]
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    mov <gpr0>, rax
    or <gpr0>, 0
    mov rdi, 1
    mov rsi, 0
    mov rdx, 43
    call @dispatch [args=(rdx,rsi,rdi)]
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    mov rdi, 2
    mov rsi, 0
    mov rdx, 43
