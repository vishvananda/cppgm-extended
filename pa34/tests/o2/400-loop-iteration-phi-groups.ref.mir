machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk
  abi
    param %root -> rdi : ptr
    param %input -> rsi : ptr
    param %length -> rdx : i64
    param %budget -> rcx : i32
    param %output -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14
    param-slot %length -> [rbp-8] : i64

  block ^entry
    mov r13, rdi
    mov r14, rsi
    mov rbx, rcx
    cmp.ptr r13, 0
    setne rax
    movzx rax, rax
    cmp.i32 rbx, 0
    setg rcx
    movzx rcx, rcx
    test.i64 rax, rcx
    je ^empty

  block ^entry~start
    store.i64 [rbp-8], rdx

  block ^start
    mov rdi, r8
    call @touch [args=(rdi)]
    mov r9, rax
    mov rdi, 0
    mov rdx, r13
    mov r8, 0
    mov rcx, 0

  block ^head
    cmp.i64 rdi, [rbp-8]
    jae ^finish

  block ^byte
    load.u8 rsi, [r14+rdi]

  block ^step0
    lea.i32 r12, [rcx+1]
    mov rax, rsi
    shr rax, 7
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check0
    cmp.u8 [rax+5], 0
    jne ^leaf0

  block ^merge0
    cmp.i32 r12, rbx
    jge ^step0~tail

  block ^step1
    lea.i32 r12, [rcx+2]
    mov rdx, rsi
    shr rdx, 6
    and rdx, 1
    imul rdx, 8
    load.ptr rdx, [rax+rdx+8]
    cmp.ptr rdx, 0
    je ^tail

  block ^check1
    cmp.u8 [rdx+5], 0
    jne ^leaf1

  block ^merge1
    cmp.i32 r12, rbx
    jge ^tail

  block ^step2
    lea.i32 r12, [rcx+3]
    mov rax, rsi
    shr rax, 5
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check2
    cmp.u8 [rax+5], 0
    jne ^leaf2

  block ^check2~merge2
    mov rdx, rax

  block ^merge2
    cmp.i32 r12, rbx
    jge ^tail

  block ^step3
    lea.i32 r12, [rcx+4]
    mov rax, rsi
    shr rax, 4
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check3
    cmp.u8 [rax+5], 0
    jne ^leaf3

  block ^check3~merge3
    mov rdx, rax

  block ^merge3
    cmp.i32 r12, rbx
    jge ^tail

  block ^step4
    lea.i32 r12, [rcx+5]
    mov rax, rsi
    shr rax, 3
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check4
    cmp.u8 [rax+5], 0
    jne ^leaf4

  block ^check4~merge4
    mov rdx, rax

  block ^merge4
    cmp.i32 r12, rbx
    jge ^tail

  block ^step5
    lea.i32 r12, [rcx+6]
    mov rax, rsi
    shr rax, 2
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check5
    cmp.u8 [rax+5], 0
    jne ^leaf5

  block ^check5~merge5
    mov rdx, rax

  block ^merge5
    cmp.i32 r12, rbx
    jge ^tail

  block ^step6
    lea.i32 r12, [rcx+7]
    mov rax, rsi
    shr rax, 1
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step0~tail

  block ^check6
    cmp.u8 [rax+5], 0
    jne ^leaf6

  block ^check6~merge6
    mov rdx, rax

  block ^merge6
    cmp.i32 r12, rbx
    jge ^tail

  block ^step7
    add.i32 rcx, 8
    mov rax, rsi
    shr rax, 0
    and rax, 1
    imul rax, 8
    load.ptr rax, [rdx+rax+8]
    cmp.ptr rax, 0
    je ^step7~tail

  block ^check7
    cmp.u8 [rax+5], 0
    je ^step7~tail

  block ^leaf7
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rax, r13

  block ^step7~tail
    mov r12, rcx
    mov rdx, rax
    jmp ^tail

  block ^leaf6
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rdx, r13
    jmp ^merge6

  block ^leaf5
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rdx, r13
    jmp ^merge5

  block ^leaf4
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rdx, r13
    jmp ^merge4

  block ^leaf3
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rdx, r13
    jmp ^merge3

  block ^leaf2
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rdx, r13
    jmp ^merge2

  block ^leaf1
    load.u8 rdx, [rdx+4]
    store.u8 [r9+r8], rdx
    add r8, 1
    mov rdx, r13
    jmp ^merge1

  block ^leaf0
    load.u8 rax, [rax+4]
    store.u8 [r9+r8], rax
    add r8, 1
    mov rax, r13
    jmp ^merge0

  block ^step0~tail
    mov rdx, rax

  block ^tail
    add rdi, 1
    cmp.i32 r12, rbx
    jge ^finish_tail

  block ^tail~head
    mov rcx, r12
    cmp.i64 rdi, [rbp-8]
    jb ^byte

  block ^finish
    ret r8

  block ^finish_tail
    ret r8

  block ^empty
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13
    slot $root -> [rbp-48] : obj<24x8>
    slot $left -> [rbp-72] : obj<24x8>
    slot $right -> [rbp-96] : obj<24x8>
    slot $bytes -> [rbp-24] : obj<2x1>
    slot $out -> [rbp-16] : obj<16x1>

  block ^entry
    lea rax, [rbp-72]
    lea rcx, [rbp-96]
    store.u8 [rax+4], 2
    store.u8 [rcx+4], 7
    store.u8 [rax+5], 1
    store.u8 [rcx+5], 1
    store.ptr [rbp-40], rax
    store.ptr [rbp-32], rcx
    store.i16 [rbp-24], 61610
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 2
    mov rcx, 13
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 13
    setne rbx
    movzx rbx, rbx
    mov rax, 0
    mov rcx, 0

  block ^sum
    load.u8 rdx, [rbp+rax-16]
    add rcx, rdx
    add rax, 1
    cmp.i64 rax, 13
    jae ^finish

  block ^sum~sum
    load.u8 rdx, [rbp+rax-16]
    add rcx, rdx
    add rax, 1
    cmp.i64 rax, 13
    jb ^sum~sum

  block ^finish
    cmp.i64 rcx, 66
    setne r12
    movzx r12, r12
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 2
    mov rcx, 0
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne r13
    movzx r13, r13
    store.ptr [rbp-32], 0
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 1
    mov rcx, 8
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, r13
    or rax, rbx
    ret rax
