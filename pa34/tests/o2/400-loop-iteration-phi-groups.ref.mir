machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    param %p -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    ret rdi

function @walk
  abi
    param %root -> rdi : ptr
    param %input -> rsi : ptr
    param %length -> rdx : i64
    param %budget -> rcx : i32
    param %output -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov r14, rdi
    mov r15, rsi
    mov r13, rdx
    zext.i32 rbx, rcx
    mov rdi, r8
    cmp.ptr r14, 0
    setne rax
    cmp.i32 rbx, 0
    setg rcx
    test.u8 rax, rcx
    jne ^start

  block ^empty
    mov rax, 0
    ret rax

  block ^start
    call @touch [args=(rdi)]
    mov r8, rax
    mov rsi, 0
    mov rax, r14
    mov rdi, 0
    mov rcx, 0

  block ^head
    cmp.i64 rsi, r13
    jae ^finish

  block ^byte
    load.u8 rdx, [r15+rsi]

  block ^step0
    lea.i32 r9, [rcx+1]
    mov r12, rdx
    shr r12, 7
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check0
    cmp.u8 [rax+5], 0
    jne ^leaf0

  block ^merge0
    cmp.i32 r9, rbx
    jge ^tail

  block ^step1
    lea.i32 r9, [rcx+2]
    mov r12, rdx
    shr r12, 6
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check1
    cmp.u8 [rax+5], 0
    jne ^leaf1

  block ^merge1
    cmp.i32 r9, rbx
    jge ^tail

  block ^step2
    lea.i32 r9, [rcx+3]
    mov r12, rdx
    shr r12, 5
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check2
    cmp.u8 [rax+5], 0
    jne ^leaf2

  block ^merge2
    cmp.i32 r9, rbx
    jge ^tail

  block ^step3
    lea.i32 r9, [rcx+4]
    mov r12, rdx
    shr r12, 4
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check3
    cmp.u8 [rax+5], 0
    jne ^leaf3

  block ^merge3
    cmp.i32 r9, rbx
    jge ^tail

  block ^step4
    lea.i32 r9, [rcx+5]
    mov r12, rdx
    shr r12, 3
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check4
    cmp.u8 [rax+5], 0
    jne ^leaf4

  block ^merge4
    cmp.i32 r9, rbx
    jge ^tail

  block ^step5
    lea.i32 r9, [rcx+6]
    mov r12, rdx
    shr r12, 2
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check5
    cmp.u8 [rax+5], 0
    jne ^leaf5

  block ^merge5
    cmp.i32 r9, rbx
    jge ^tail

  block ^step6
    lea.i32 r9, [rcx+7]
    mov r12, rdx
    shr r12, 1
    and r12, 1
    imul r12, 8
    load.ptr rax, [rax+r12+8]
    cmp.ptr rax, 0
    je ^tail

  block ^check6
    cmp.u8 [rax+5], 0
    jne ^leaf6

  block ^merge6
    cmp.i32 r9, rbx
    jge ^tail

  block ^step7
    add.i32 rcx, 8
    shr rdx, 0
    and rdx, 1
    imul rdx, 8
    load.ptr rax, [rax+rdx+8]
    cmp.ptr rax, 0
    je ^step7~tail

  block ^check7
    cmp.u8 [rax+5], 0
    je ^step7~tail

  block ^leaf7
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14

  block ^step7~tail
    zext.i32 r9, rcx
    jmp ^tail

  block ^leaf6
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge6

  block ^leaf5
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge5

  block ^leaf4
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge4

  block ^leaf3
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge3

  block ^leaf2
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge2

  block ^leaf1
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge1

  block ^leaf0
    load.u8 rax, [rax+4]
    store.u8 [r8+rdi], rax
    add rdi, 1
    mov rax, r14
    jmp ^merge0

  block ^tail
    add rsi, 1
    zext.i32 rcx, r9
    cmp.i32 r9, rbx
    jge ^finish_tail

  block ^tail~head
    cmp.i64 rsi, r13
    jb ^byte

  block ^finish
    ret rdi

  block ^finish_tail
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r14 r15
    slot $root -> [rbp-48] : obj<24x8>
    slot $left -> [rbp-72] : obj<24x8>
    slot $right -> [rbp-96] : obj<24x8>
    slot $bytes -> [rbp-24] : obj<2x1>
    slot $out -> [rbp-16] : obj<16x1>

  block ^entry
    lea rax, [rbp-72]
    lea rcx, [rbp-96]
    store.u8 [rax+4], 2
    store.u8 [rcx+4], 7
    store.u8 [rax+5], 1
    store.u8 [rcx+5], 1
    store.ptr [rbp-40], rax
    store.ptr [rbp-32], rcx
    store.i16 [rbp-24], 61610
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 2
    mov rcx, 13
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 13
    setne rbx
    movzx rbx, rbx
    mov rax, 0
    mov rcx, 0

  block ^sum
    load.u8 rdx, [rbp+rax-16]
    add rcx, rdx
    add rax, 1
    cmp.i64 rax, 13
    jb ^sum

  block ^finish
    cmp.i64 rcx, 66
    setne r14
    movzx r14, r14
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 2
    mov rcx, 0
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne r15
    movzx r15, r15
    store.ptr [rbp-32], 0
    lea rdi, [rbp-48]
    lea rsi, [rbp-24]
    mov rdx, 1
    mov rcx, 8
    lea r8, [rbp-16]
    call @walk [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or.u32 rbx, r14
    or.u32 rbx, r15
    or.u32 rax, rbx
    ret rax
