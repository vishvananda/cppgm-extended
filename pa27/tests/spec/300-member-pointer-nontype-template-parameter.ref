  slot $fx : obj<1x1>
  slot $fy : obj<1x1>

  block ^entry:
    store ptr %p, $p
    %t1 = addr $fx
    %t2 = addr $fy
    %t3 = addr $fx
    %t4 = load ptr $p
    %t5 = call i32 @foo_1___bar(%t3, %t4)
    %t6 = addr $fy
    %t7 = load ptr $p
    %t8 = call i32 @foo_5___bar(%t6, %t7)
    %t9 = binary add i32 %t5, %t8
    return i32 %t9
}
