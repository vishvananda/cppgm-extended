volatile int total;
__attribute__((noinline)) void observe(int* value) { total += *value; }
template<int N> __attribute__((noinline)) void check() {
 int value=N;
 observe(&value);
 {int value=N+1; observe(&value);}
 {int value=N+2; observe(&value);}
 observe(&value);
}
#define BLOCK(N) {int value=N; observe(&value);}
int main() {
 int value=10;
 observe(&value);
 BLOCK(20) BLOCK(30)
 observe(&value);
 check<40>();
 return total!=233;
}
