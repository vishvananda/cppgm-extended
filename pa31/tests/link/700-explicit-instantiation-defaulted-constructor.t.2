#include <cstdio>
#include <cstring>
#include <memory>
#include <new>
#include <utility>
#include <vector>

template<class T> struct PassList {
  explicit PassList() = default;
  PassList(PassList&& other) : passes(std::move(other.passes)) {}
  std::vector<std::unique_ptr<T> > passes;
};
extern template struct PassList<int>;

int main() {
  typedef PassList<int> List;
  alignas(List) unsigned char storage[sizeof(List)];
  std::memset(storage, 0xa5, sizeof(storage));
  List* list = new (storage) List;
  for (int i = 0; i != 64; ++i)
    list->passes.push_back(std::unique_ptr<int>(new int(i)));
  int sum = 0;
  for (const auto& value : list->passes)
    sum += *value;
  std::printf("%lu %d\n", static_cast<unsigned long>(list->passes.size()), sum);
  list->~List();
  return sum == 2016 ? 0 : 1;
}
