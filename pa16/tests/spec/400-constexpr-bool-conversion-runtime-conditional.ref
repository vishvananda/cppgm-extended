global @constant [storage=readonly, binding=internal, object=_ZL8constant] = {
  zero 1
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    %t3 = call u8 @flag__operatorbool(%t2)
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 7, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 9, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load typed i32 $cond__1
    %t5 = cmp ne i32 %t4, 7
    %t6 = convert trunc i32 i64 %t5
    return i32 %t6
}
function @flag__operatorbool(%this : ptr [object_bytes=1]) -> u8 [binding=weak, object=_ZNK4flagcvbEv, inline_hint=yes] {
