  block ^land_end_6:
    %t12 = load typed i64 $land__2
    branch %t12, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t13 = addr $second
    %t14 = index i32 [projection=array_element] %t13, 0
    %t15 = load typed i32 %t14
    %t16 = cmp eq i32 %t15, 4
    store typed i64 %t16, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t17 = load typed i64 $land__3
    branch %t17, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t18 = addr $second
    %t19 = index i32 [projection=array_element] %t18, 1
    %t20 = load typed i32 %t19
    %t21 = cmp eq i32 %t20, 9
    store typed i64 %t21, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t22 = load typed i64 $land__4
    branch %t22, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t23 = addr $second
    %t24 = index i32 [projection=array_element] %t23, 2
    %t25 = load typed i32 %t24
    %t26 = cmp eq i32 %t25, 0
    store typed i64 %t26, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store typed i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t27 = load typed i64 $land__5
    branch %t27, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t28 = load typed i32 $cond__1
