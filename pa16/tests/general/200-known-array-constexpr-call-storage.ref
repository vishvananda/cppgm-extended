global @seed : i32 [storage=readonly, binding=internal, object=_ZL4seed] = 4
global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 4
  i32 9
  zero 4
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : obj<12x4>
  slot $second : obj<12x4>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64

  block ^entry:
    %t1 = addr $first
    copyobj 12x4 @__constexpr_template__1, %t1
    %t2 = addr $second
    copyobj 12x4 @__constexpr_template__1, %t2
    %t3 = addr $first
    %t4 = index i32 [projection=array_element] %t3, 1
    store typed i32 11, %t4
    %t5 = addr $first
    %t6 = addr $second
    %t7 = cmp ne ptr %t5, %t6
    branch %t7, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t8 = addr $first
    %t9 = index i32 [projection=array_element] %t8, 1
    %t10 = load typed i32 %t9
    %t11 = cmp eq i32 %t10, 11
    store typed i64 %t11, $land__2
    jump ^land_end_6

