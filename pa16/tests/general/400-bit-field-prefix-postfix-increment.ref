function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $bits : obj<4x4>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $bits
    %t2 = binary and u32 1, 1
    %t3 = addr $bits
    %t4 = index i8 [projection=field] %t3, 0
    store u32 %t2, %t4
    %t5 = addr $bits
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load u32 %t6
    %t8 = binary and u32 %t7, 4294967289
    %t9 = binary and u32 3, 1
    %t10 = binary shl u32 %t9, 1
    %t11 = binary or u32 %t8, %t10
    %t12 = addr $bits
    %t13 = index i8 [projection=field] %t12, 0
    store u32 %t11, %t13
    %t14 = addr $bits
    %t15 = index i8 [projection=field] %t14, 0
    %t16 = load i32 %t15
    %t17 = binary shr i32 %t16, 1
    %t18 = binary and i32 %t17, 3
    %t19 = binary add i32 %t18, 1
    %t20 = addr $bits
    %t21 = index i8 [projection=field] %t20, 0
    %t22 = binary and i32 %t19, 3
    %t23 = binary shl i32 %t22, 1
    %t24 = load i32 %t21
    %t25 = binary and i32 %t24, 4294967289
    %t26 = binary or i32 %t25, %t23
    store i32 %t26, %t21
    %t27 = addr $bits
    %t28 = index i8 [projection=field] %t27, 0
    %t29 = load i32 %t28
    %t30 = binary shr i32 %t29, 1
    %t31 = binary and i32 %t30, 3
    %t32 = binary add i32 %t31, 1
    %t33 = binary and i32 %t32, 3
    %t34 = binary shl i32 %t33, 1
    %t35 = load i32 %t28
    %t36 = binary and i32 %t35, 4294967289
    %t37 = binary or i32 %t36, %t34
    store i32 %t37, %t28
    %t38 = addr $bits
    %t39 = index i8 [projection=field] %t38, 0
    %t40 = load i32 %t39
    %t41 = binary and i32 %t40, 1
    %t42 = cmp eq u32 %t41, 1
    branch %t42, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t43 = addr $bits
    %t44 = index i8 [projection=field] %t43, 0
    %t45 = load i32 %t44
    %t46 = binary shr i32 %t45, 1
    %t47 = binary and i32 %t46, 3
    %t48 = cmp eq u32 %t47, 3
    %t49 = cmp ne i64 %t48, 0
    store i64 %t49, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t50 = load i64 $land__2
    branch %t50, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t51 = load i32 $cond__1
    return i32 %t51
}
