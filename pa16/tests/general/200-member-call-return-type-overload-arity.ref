function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $stream : obj<1x1>

  block ^entry:
    %t1 = addr $stream
    %t2 = addr $stream
    call void @Stream__state(%t2, 1)
    return i32 0
}
function @Stream__state(%this : ptr, %__param1 : i32) -> void [binding=weak, object=_ZN6Stream5stateEi] {
  slot $this : ptr
  slot $__param1 : i32

  block ^entry:
    store ptr %this, $this
    store i32 %__param1, $__param1
    return void
}
