function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<4x4>
  slot $b : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $a
    %t2 = addr $b
    %t3 = addr $a
    %t4 = index i8 [projection=field] %t3, 0
    store i32 7, %t4
    %t5 = addr $b
    %t6 = index i8 [projection=field] %t5, 0
    store i32 1, %t6
    %t7 = addr $b
    %t8 = addr $a
    %t9 = call ptr @Iter__operator___ov2(%t7, %t8)
    %t10 = addr $b
    %t11 = call ptr @Iter__operator_(%t10)
    %t12 = index i8 [projection=field] %t11, 0
    %t13 = load i32 %t12
    %t14 = cmp eq i32 %t13, 7
    branch %t14, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t15 = load i32 $cond__1
    return i32 %t15
}
function @Iter__operator_(%this : ptr) -> ptr [binding=weak, object=_ZN4IterdeEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    return ptr %t1
}
function @Iter__operator___ov2(%this : ptr, %other : ptr [pass=reference]) -> ptr [unwind=no, binding=weak, object=_ZN4IteraSERKS_] {
  slot $this : ptr
  slot $other : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %other, $other
    %t1 = load ptr $this
    %t2 = load ptr $other
    copyobj 4x4 %t2, %t1
    %t3 = load ptr $this
    return ptr %t3
}
