    store i32 0, $i
    jump ^for_cond_1

  block ^for_cond_1:
    %t5 = load i32 $i
    %t6 = cmp ne i32 %t5, 1
    branch %t6, ^for_body_2, ^for_end_4

  block ^for_body_2:
    jump ^for_iter_3

  block ^for_iter_3:
    %t7 = load i32 $i
    %t8 = binary add i32 %t7, 1
    store i32 %t8, $i
    %t9 = addr $it
