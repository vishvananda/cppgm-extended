function @take(%x : f64) -> i32 [binding=strong, object=_Z4taked] {
  slot $x : f64
  slot $cond__1 : i32

  block ^entry:
    store f64 %x, $x
    %t1 = load f64 $x
    %t2 = cmp eq f64 %t1, 2.0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : f64
  slot $h : obj<8x8>

  block ^entry:
    store f64 2.0, $x
    %t1 = addr $h
    %t2 = addr $x
    call void @holder__holder(%t1, %t2)
    %t3 = addr $h
    %t4 = index i8 [projection=reference_field] %t3, 0
    %t5 = load ptr %t4
    %t6 = load f64 %t5
    %t7 = call i32 @take(%t6)
    return i32 %t7
}
function @holder__holder(%this : ptr, %x : ptr [pass=reference]) -> void [binding=weak, object=_ZN6holderC1EOd] {
  slot $this : ptr
  slot $x : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %x, $x
    %t1 = load ptr $x
    %t2 = load ptr $this
    %t3 = index i8 [projection=field] %t2, 0
    store ptr %t1, %t3
    return void
}
alias object _ZN6holderC2EOd = @holder__holder
