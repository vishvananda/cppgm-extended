global @table [binding=internal, object=_ZL5table] = {
  i32 13
  i32 1
  i32 30
  i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr @table
    %t2 = unary decay ptr %t1
    %t3 = binary mul i64 1, 8
    %t4 = index i8 [projection=array_element] %t2, %t3
    %t5 = index i8 [projection=field] %t4, 4
    %t6 = load i32 %t5
    %t7 = cmp eq i32 %t6, 2
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
