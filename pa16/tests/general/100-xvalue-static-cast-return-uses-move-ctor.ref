  slot $source : obj<4x4>
  slot $result : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $source
    call void @Owner__Owner(%t1)
    %t2 = addr $result
    %t3 = addr $source
    call void @make(%t2, %t3)
