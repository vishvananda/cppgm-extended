function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $object : obj<4x4>
  slot $ref : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $object
    %t2 = addr $object
    store ptr %t2, $ref
    %t3 = addr $object
    %t4 = load ptr $ref
    %t5 = cmp eq ptr %t3, %t4
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load i32 $cond__1
    return i32 %t6
}
