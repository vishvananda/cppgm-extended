function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<4x4>

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = call i32 @B__D__f(%t2)
    return i32 %t3
}
function @B__D__f(%this : ptr) -> i32 [binding=weak, object=_ZN1B1D1fEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=base_subobject] %t1, 0
    %t3 = index i8 [projection=field] %t2, 0
    store i32 0, %t3
    return i32 0
}
