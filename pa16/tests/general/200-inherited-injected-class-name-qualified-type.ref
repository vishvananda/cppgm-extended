function @as_base(%d : ptr) -> ptr [binding=strong, object=_Z7as_baseP7Derived] {
  slot $d : ptr

  block ^entry:
    store ptr %d, $d
    %t1 = load ptr $d
    %t2 = index i8 [projection=base_subobject] %t1, 0
    return ptr %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<4x4>
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = index i8 [projection=base_subobject] %t2, 0
    %t4 = index i8 [projection=field] %t3, 0
    store i32 7, %t4
    %t5 = addr $d
    %t6 = call ptr @as_base(%t5)
    store ptr %t6, $p
    %t7 = load ptr $p
    %t8 = index i8 [projection=field] %t7, 0
    %t9 = load i32 %t8
    %t10 = cmp eq i32 %t9, 7
    branch %t10, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t11 = load i32 $cond__1
    return i32 %t11
}
