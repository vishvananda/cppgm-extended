function @choose(%condition : u8, %left : ptr [pass=reference], %right : ptr [pass=reference]) -> ptr [binding=strong, object=_Z6choosebRiS_] {
  slot $condition : u8
  slot $left : ptr
  slot $right : ptr
  slot $condaddr__1 : ptr

  block ^entry:
    store u8 %condition, $condition
    store ptr %left, $left
    store ptr %right, $right
    %t1 = load u8 $condition
    branch %t1, ^condaddr_then_1, ^condaddr_else_2

  block ^condaddr_then_1:
    %t2 = load ptr $left
    store ptr %t2, $condaddr__1
    jump ^condaddr_end_3

  block ^condaddr_else_2:
    %t3 = load ptr $right
    store ptr %t3, $condaddr__1
    jump ^condaddr_end_3

  block ^condaddr_end_3:
    %t4 = load ptr $condaddr__1
    return ptr %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $left : i32
  slot $right : i32

  block ^entry:
    store i32 1, $left
    store i32 2, $right
    %t1 = addr $left
    %t2 = addr $right
    %t3 = call ptr @choose(0, %t1, %t2)
    store i32 3, %t3
    %t4 = load i32 $right
    %t5 = binary sub i32 %t4, 3
    return i32 %t5
}
