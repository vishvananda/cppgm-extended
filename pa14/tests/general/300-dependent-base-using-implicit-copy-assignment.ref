function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $source : obj<4x4>
  slot $target : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $source
    %t2 = addr $source
    %t3 = index i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $target
    %t5 = addr $target
    %t6 = index i8 %t5, 0
    %t7 = index i8 [projection=field] %t6, 0
    store typed i32 0, %t7
    %t8 = addr $target
    %t9 = index i8 %t8, 0
    %t10 = addr $source
    copyobj 4x4 %t10, %t9
    %t11 = addr $target
    %t12 = index i8 %t11, 0
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = load typed i32 %t13
    %t15 = cmp eq i32 %t14, 7
    branch %t15, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store typed i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t16 = load typed i32 $cond__1
    return i32 %t16
}
