global @values [binding=strong, object=_Z6values] = {
  i32 1
  i32 2
  i32 3
}
global @cursor : ptr [binding=strong, object=_Z6cursor] = addr @values

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = load ptr @cursor
    %t2 = index i32 [projection=array_element] %t1, 1
    store i32 9, %t2
    %t3 = addr @values
    %t4 = unary decay ptr %t3
    %t5 = index i32 [projection=array_element] %t4, 1
    %t6 = load i32 %t5
    %t7 = cmp eq i32 %t6, 9
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
