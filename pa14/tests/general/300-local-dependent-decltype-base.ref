function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @capture(7)
    %t2 = call i32 @capture__2(9)
    %t3 = binary add nowrap i32 %t1, %t2
    %t4 = binary sub nowrap i32 %t3, 16
    return i32 %t4
}
function @capture(%value : i32) -> i32 [binding=weak, object=_Z7captureIiEiT_] {
  slot $value : i32
  slot $copy : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    store typed i32 %t1, $copy
    %t2 = load typed i32 $copy
    return i32 %t2
}
function @capture__2(%value : i64) -> i32 [binding=weak, object=_Z7captureIlEiT_] {
  slot $value : i64
