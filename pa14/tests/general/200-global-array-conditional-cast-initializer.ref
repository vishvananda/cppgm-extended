global @text [binding=internal, object=_ZL4text] = {
  i8 65
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = addr @text
    %t2 = unary decay ptr %t1
    %t3 = index i8 [projection=array_element] %t2, 0
    %t4 = load i8 %t3
    %t5 = convert sext i32 i8 %t4
    %t6 = binary sub i32 %t5, 65
    return i32 %t6
}
