function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @blocked__ov2(0)
    return i32 %t1
}
function @blocked__ov2(%value : i32) -> i32 [binding=weak, object=_Z7blockedi] {
  slot $value : i32

  block ^entry:
    store i32 %value, $value
    %t1 = load i32 $value
    return i32 %t1
}
