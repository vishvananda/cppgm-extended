function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $o : obj<1x1>

  block ^entry:
    %t1 = addr $o
    %t2 = addr $o
    %t3 = call i32 @owner_int___run(%t2)
    return i32 %t3
}
function @owner_int___run(%this : ptr) -> i32 [binding=weak, object=_ZN5ownerIiE3runEv] {
  slot $this : ptr
  slot $task : obj<8x8>
  slot $cond__1 : i32

  block ^entry:
    store ptr %this, $this
    %t1 = addr $task
    %t2 = load ptr $this
    store ptr %t2, %t1
    %t3 = const i64 2
    %t4 = const i64 2
    %t5 = cmp eq i64 %t3, %t4
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load i32 $cond__1
    return i32 %t6
}
