function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : u8
  slot $b : u8
  slot $c : u8
  slot $d : u8
  slot $e : u8
  slot $f : u8
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64

  block ^entry:
    store u8 1, $a
    store u8 0, $b
    store u8 1, $c
    store u8 0, $d
    %t1 = cmp ne i64 1, 0
    store u8 %t1, $e
    %t2 = cmp ne i64 0, 0
    store u8 %t2, $f
    %t3 = load u8 $a
    branch %t3, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t4 = load u8 $b
    %t5 = cmp eq u8 %t4, 0
    %t6 = cmp ne i64 %t5, 0
    store i64 %t6, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t7 = load i64 $land__6
    branch %t7, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t8 = load u8 $c
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t10 = load i64 $land__5
    branch %t10, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t11 = load u8 $d
    %t12 = cmp eq u8 %t11, 0
    %t13 = cmp ne i64 %t12, 0
    store i64 %t13, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t14 = load i64 $land__4
    branch %t14, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t15 = load u8 $e
    %t16 = cmp ne i64 %t15, 0
    store i64 %t16, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t17 = load i64 $land__3
    branch %t17, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t18 = load u8 $f
    %t19 = cmp eq u8 %t18, 0
    %t20 = cmp ne i64 %t19, 0
    store i64 %t20, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t21 = load i64 $land__2
    branch %t21, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t22 = load i32 $cond__1
    return i32 %t22
}
