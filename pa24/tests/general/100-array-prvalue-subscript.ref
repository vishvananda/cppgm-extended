function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $arraytmp__2 : obj<1x1>

  block ^entry:
    %t1 = addr $arraytmp__2
    store u8 1, %t1
    %t2 = unary decay ptr %t1
    %t3 = index u8 [projection=array_element] %t2, 0
    %t4 = load u8 %t3
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
