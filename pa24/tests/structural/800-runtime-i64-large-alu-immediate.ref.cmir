machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 3472328296227680304
    cmp.i64 <gpr0>, 3472328296227680304
    jne ^bad_add
    jmp ^check_sub

  block ^bad_add
    mov rax, 1
    ret rax

  block ^check_sub
    mov <gpr0>, 0
    cmp.i64 <gpr0>, 0
    jne ^bad_sub
    jmp ^ok

  block ^bad_sub
    mov rax, 2
    ret rax

  block ^ok
    mov rax, 0
    ret rax
