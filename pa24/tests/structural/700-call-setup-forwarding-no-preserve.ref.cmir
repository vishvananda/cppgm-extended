machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @mix
  abi
    param %a -> rdi : i64
    param %b -> xmm0 : f64
    param %c -> rsi : i64
    param %d -> xmm1 : f64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %b -> [rbp-<off0>] : f64
    param-slot %d -> [rbp-<off1>] : f64

  block ^entry
    fmov.f64 [rbp-<off0>], xmm0
    fmov.f64 [rbp-<off1>], xmm1
    fptosi.f64.i64 r8, [rbp-<off0>]
    fptosi.f64.i64 r9, [rbp-<off1>]
    add rdi, rsi
    add r8, r9
    add rdi, r8
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 10
    sitofp.i64.f64 xmm0, <gpr0>
    mov <gpr0>, 20
    sitofp.i64.f64 xmm1, <gpr0>
    mov rdi, 10
    mov rsi, 20
    call @mix [args=(rsi,rdi,xmm0,xmm1)]
    cmp.i64 rax, 50
    sete rax
    movzx rax, rax
    ret rax
