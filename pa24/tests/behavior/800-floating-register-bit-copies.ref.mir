machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @bits32
  abi
    param %x -> xmm0 : f32
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    param-slot %x -> [rbp-8] : f32

  block ^entry
    fmov.f32 [rbp-8], xmm0
    fmul.f32 xmm0, [rbp-8], 2.0f
    fmov.f32 rax, xmm0
    sext.i32 rax
    ret rax

function @bits64
  abi
    param %x -> xmm0 : f64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    param-slot %x -> [rbp-8] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fmul.f64 xmm0, [rbp-8], 2.0
    fmov.f64 rax, xmm0
    ret rax

function @roundtrip
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f64 xmm0, rdi
    fneg.f64 xmm0, xmm0
    fmov.f64 rax, xmm0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14

  block ^entry
    fmov.f32 xmm0, -0.5f
    call @bits32 [args=(xmm0)]
    sext.i32 rax
    mov rdx, -1082130432
    cmp.i32 rax, rdx
    setne rbx
    movzx rbx, rbx
    fmov.f32 xmm0, -0.0f
    call @bits32 [args=(xmm0)]
    sext.i32 rax
    mov rdx, -2147483648
    cmp.i32 rax, rdx
    setne r12
    movzx r12, r12
    fmov.f64 xmm0, 1.0
    call @bits64 [args=(xmm0)]
    mov rdx, 4611686018427387904
    cmp.i64 rax, rdx
    setne r13
    movzx r13, r13
    fmov.f64 xmm0, -0.0
    call @bits64 [args=(xmm0)]
    mov rdx, -9223372036854775808
    cmp.i64 rax, rdx
    setne r14
    movzx r14, r14
    mov rdi, 4607182418800017408
    call @roundtrip [args=(rdi)]
    mov rdx, -4616189618054758400
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or rbx, r13
    or rbx, rax
    ret rbx
