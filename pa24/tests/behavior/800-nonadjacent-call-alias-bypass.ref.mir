machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @src
  storage data
  item i64 77

global @other
  storage data
  item i64 11

function @g
  abi
    param %a -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @f
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %src -> rcx : ptr
    return ptr -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    mov r8, rcx
    copy_bytes 8x8, [rbp-8], rcx
    mov rdi, r8
    call @g [args=(rdi)]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov r8, @other
    mov rbx, @src
    mov rdi, r8
    mov rsi, r8
    mov rdx, r8
    mov rcx, rbx
    call @f [args=(rcx,rdx,rsi,rdi)]
    mov r9, rax
    cmp.ptr r9, rbx
    jne ^bad_ptr
    jmp ^check_value

  block ^bad_ptr
    mov rax, 1
    ret rax

  block ^check_value
    load.i64 r8, [r9]
    cmp.i64 r8, 77
    setne rax
    movzx rax, rax
    ret rax
