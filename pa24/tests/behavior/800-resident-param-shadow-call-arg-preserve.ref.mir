machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 0

global @bad
  storage scalar i64
  init i64 0

function @clobber
  abi
    param %temp -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %wrong -> r8 : ptr
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @assign
  abi
    param %lhs -> rdi : ptr
    param %rhs -> rsi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], 99
    ret

function @reset
  abi
    param %target -> rdi : ptr
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $temp -> [rbp-40] : obj<40x8>

  block ^entry
    mov rbx, rdi
    lea rdi, [rbp-40]
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, @bad
    call @clobber [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdi, rbx
    lea rsi, [rbp-40]
    call @assign [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @good
    call @reset [args=(rdi)]
    load.i64 r8, @good
    load.i64 r9, @bad
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
