machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @reload_to_return_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 13
    ret rax

function @reload_to_same_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 30
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @reload_to_return_register [args=()]
    mov rbx, rax
    call @reload_to_same_register [args=()]
    cmp.i64 rbx, 13
    setne rbx
    movzx rbx, rbx
    cmp.i64 rax, 30
    setne rax
    movzx rax, rax
    or rbx, rax
    sext.i32 rbx
    ret rbx
