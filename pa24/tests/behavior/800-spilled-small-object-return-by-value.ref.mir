machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @copied
  storage data
  item i64 0

function @make_tag_spilled
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 77
    load.i64 rax, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @make_tag_spilled [args=()]
    store.i64 @copied, rax
    cmp.i64 @copied, 77
    sete r8
    movzx r8, r8
    cmp.i64 r8, 0
    sete r8
    movzx r8, r8
    ret r8
