machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @low_signed
  abi
    param %p -> rdi : obj<8x8>
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-8] : obj<8x8>
    param-slot %p -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    load.i32 rax, [rbp-8]
    ret rax

