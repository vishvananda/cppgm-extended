machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar u32
  init u32 4294967295

function @barrier
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @return_u32
  abi
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 4294967295
    ret rax

function @load_frame
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @barrier [args=()]
    mov rax, 4294967295
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    load.u32 rbx, @value
    call @load_frame [args=()]
    mov r12, rax
    call @return_u32 [args=()]
    zext.i32 rax
    cmp.i64 rbx, 4294967295
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 4294967295
    setne r12
    movzx r12, r12
    cmp.i64 rax, 4294967295
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, rax
    sext.i32 rbx
    ret rbx
