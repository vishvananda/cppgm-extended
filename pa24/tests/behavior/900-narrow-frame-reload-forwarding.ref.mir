machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @return_i8
  abi
    return i8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -1
    ret rax

function @extend_i8
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 255
    ret rax

function @extend_u16
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 48879
    ret rax

function @extend_i32
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 4294967295
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    call @return_i8 [args=()]
    sext.i8 rax
    mov rbx, rax
    zext.i8 rbx
    call @extend_i8 [args=()]
    mov r12, rax
    call @extend_u16 [args=()]
    mov r13, rax
    call @extend_i32 [args=()]
    cmp.i64 rbx, 255
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 255
    setne r12
    movzx r12, r12
    cmp.i64 r13, 48879
    setne r13
    movzx r13, r13
    cmp.i64 rax, 4294967295
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, rax
    or rbx, r13
    sext.i32 rbx
    ret rbx
