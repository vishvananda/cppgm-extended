machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_source
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -17
    ret rax

function @unsigned_source
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 250
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @signed_source [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @unsigned_source [args=()]
    zext.i8 rax
    cmp.i64 rbx, -17
    setne rbx
    movzx rbx, rbx
    cmp.i64 rax, 250
    setne rax
    movzx rax, rax
    mov r10, 17
    cmp.i32 r10, 17
    setne r8
    movzx r8, r8
    or rbx, rax
    or rbx, r8
    sext.i32 rbx
    ret rbx
