machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @false_condition
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @clobber_return_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @false_condition [args=()]
    mov rbx, rax
    call @clobber_return_register [args=()]
    cmp.u8 rbx, 0
    jne ^wrong
    jmp ^correct

  block ^wrong
    mov rax, 1
    ret rax

  block ^correct
    mov rax, 0
    ret rax
