machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %floating -> [rbp-16] : f80

  block ^entry
    jmp ^convert

  block ^detour
    call @noop [args=()]
    jmp ^convert

  block ^convert
    mov r11, -38
    sitofp.i8.f80 [rbp-16], r11
    fptosi.f80.i64 r8, [rbp-16]
    cmp.i64 r8, -38
    setne r8
    movzx r8, r8
    ret r8
