machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @store_boolean
  abi
    param %input -> rdi : i8
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $flag -> [rbp-8] : i1

  block ^entry
    mov r11, rdi
    and r11, 1
    store.i1 [rbp-8], r11
    load.u8 rax, [rbp-8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rdi, 3
    call @store_boolean [args=(rdi)]
    mov rbx, rax
    sext.i32 rbx
    mov rdi, 2
    call @store_boolean [args=(rdi)]
    mov r12, rax
    sext.i32 r12
    mov rdi, -1
    call @store_boolean [args=(rdi)]
    sext.i32 rax
    add.i32 rbx, r12
    sext.i32 rbx
    add.i32 rbx, rax
    sext.i32 rbx
    cmp.i32 rbx, 2
    setne rbx
    movzx rbx, rbx
    ret rbx
