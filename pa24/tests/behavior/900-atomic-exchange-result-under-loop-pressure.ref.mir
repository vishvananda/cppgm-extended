machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 0

function @pressure
  abi
    param %seed -> rdi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov r8, rdi
    add r8, 1
    mov r9, rdi
    add r9, 2
    mov rsi, rdi
    add rsi, 3
    mov rbx, rdi
    add rbx, 4
    mov r12, rdi
    add r12, 5
    jmp ^exchange

  block ^exchange
    mov r13, rdi
    add r13, 6
    mov r14, @g
    mov rax, r13
    xchg.i64 [r14], rax
    mov r15, rax
    mov rax, r15
    cmp.i64 rax, 0
    jne ^exchange
    jmp ^done

  block ^done
    mov r13, r8
    add r13, r9
    mov r8, rsi
    add r8, rbx
    add r13, r8
    add r13, r12
    ret r13

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    call @pressure [args=(rdi)]
    mov rdx, 65
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
