machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @probe_result
  storage scalar i64
  init i64 0

function @consume
  abi
    param %this -> rdi : ptr
    param %position -> rsi : i64
    param %first -> rdx : ptr
    param %last -> rcx : ptr
    param %tag -> r8 : i8
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %this -> [rbp-8] : ptr
    param-slot %position -> [rbp-16] : obj<8x8>
    param-slot %first -> [rbp-24] : ptr
    param-slot %last -> [rbp-32] : ptr
    param-slot %tag -> [rbp-33] : obj<1x1>

  block ^entry
    store.ptr [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.ptr [rbp-24], rdx
    store.ptr [rbp-32], rcx
    store.i8 [rbp-33], r8
    load.ptr r8, [rbp-32]
    sub r8, [rbp-24]
    ret r8

function @build
  abi
    param %ret -> rdi : ptr
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $ident -> [rbp-16] : obj<16x1>
    slot $argobj -> [rbp-24] : obj<8x8>
    slot $tag -> [rbp-25] : obj<1x1>
    slot $retobj -> [rbp-40] : obj<8x8>

  block ^entry
    mov r8, rdi
    store.u8 [rbp-16], 127
    store.u8 [rbp-15], 69
    store.u8 [rbp-1], 0
    load.ptr r9, [r8+8]
    lea rbx, [rbp-16]
    lea rbx, [rbx+16]
    lea rdi, [rbp-40]
    load.ptr rsi, [r8]
    sub r9, rsi
    lea r12, [rsi+r9]
    store.ptr [rdi], r12
    copy_bytes 8x8, [rbp-24], [rbp-40]
    mov rdi, r8
    load.i64 rsi, [rbp-24]
    lea rdx, [rbp-16]
    mov rcx, rbx
    load.i8 r8, [rbp-25]
    call @consume [args=(rcx,rdx,rsi,rdi,r8), unwind=no]
    store.i64 @probe_result, rax
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $image -> [rbp-24] : obj<24x8>

  block ^entry
    store.ptr [rbp-24], 0
    store.ptr [rbp-16], 0
    store.ptr [rbp-8], 0
    lea rdi, [rbp-24]
    call @build [args=(rdi), unwind=no]
    load.i64 r8, @probe_result
    mov rdx, 16
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    zext.i64 rax
    sext.i32 rax
    ret rax
