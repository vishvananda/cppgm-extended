    mov rax, -7
    cqo
    idiv r11
    sext.i8 rax
    zext.i8 rax
    cmp.i64 rax, 255
    setne rsi
    movzx rsi, rsi
    mov r11, 4
    mov rax, -7
    cqo
    idiv r11
    zext.i8 rdx
    cmp.i64 rdx, 253
    setne rcx
    movzx rcx, rcx
