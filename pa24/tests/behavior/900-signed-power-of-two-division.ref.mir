machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @div2
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 2
    mov rax, rdi
    cqo
    idiv r11
    ret rax

function @mod8
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 8
    mov rax, rdi
    cqo
    idiv r11
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 144
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %bad_q4_positive -> [rbp-8] : i64
    temp %bad_r4_positive -> [rbp-16] : i64
    temp %bad_q4_zero -> [rbp-24] : i64
    temp %bad_q7 -> [rbp-32] : i64
    temp %bad_r7 -> [rbp-40] : i64

