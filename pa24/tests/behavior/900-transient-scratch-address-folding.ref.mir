machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_result
  storage data
  item i64 17

global @pair_result
  storage data
  item i64 0
  item i64 0

function @make_single
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-8]
    ret

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 29
    store.i64 [rbp-8], 31
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @make_single [args=()]
    store.i64 @single_result, rax
    call @make_pair [args=()]
    store.i64 @pair_result, rax
    store.i64 @pair_result+8, rdx
    load.i64 r8, @single_result
    load.i64 r9, @pair_result
    load.i64 rdi, @pair_result+8
    cmp.i64 r8, 23
    setne r8
    movzx r8, r8
    cmp.i64 r9, 29
    setne r9
    movzx r9, r9
    cmp.i64 rdi, 31
    setne rdi
    movzx rdi, rdi
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
