machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @calc
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $n -> [rbp-8] : i64

  block ^entry
    add rdi, 0
    store.i64 [rbp-8], rdi
    load.i64 r8, [rbp-8]
    add r8, 2
    add r8, [rbp-8]
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    call @calc [args=(rdi)]
    mov rdx, 22
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
