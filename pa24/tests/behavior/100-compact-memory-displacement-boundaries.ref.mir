machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @bytes
  storage data
  item zero 512

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i8 @bytes+127, 11
    store.i8 @bytes+128, 22
    store.i8 @bytes+255, 33
    store.i8 @bytes+256, 44
    store.i8 @bytes+257, 55
    store.i8 @bytes+383, 66
    store.i8 @bytes+384, 77
    cmp.i8 @bytes+127, 11
    setne r8
    movzx r8, r8
    cmp.i8 @bytes+128, 22
    setne r9
    movzx r9, r9
    or r8, r9
    cmp.i8 @bytes+255, 33
    setne r9
    movzx r9, r9
    cmp.i8 @bytes+256, 44
    setne rdi
    movzx rdi, rdi
    or r9, rdi
    cmp.i8 @bytes+257, 55
    setne rdi
    movzx rdi, rdi
    cmp.i8 @bytes+383, 66
    setne rsi
    movzx rsi, rsi
    or rdi, rsi
    cmp.i8 @bytes+384, 77
    setne rsi
    movzx rsi, rsi
    or r8, r9
    or rdi, rsi
    or r8, rdi
    sext.i32 r8
    ret r8
