machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %gate -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    param-slot %d -> [rbp-8] : i64
    param-slot %gate -> [rbp-16] : i64
    slot $selected -> [rbp-24] : i64

  block ^entry
    store.i64 [rbp-8], rcx
    load.i64 rax, [rbp+16]
    store.i64 [rbp-16], rax
    load.i64 rax, [rbp-16]
    cmp.i64 rax, 0
    jne ^shift
    jmp ^short

  block ^shift
    mov rbx, rdi
    and rbx, 7
    mov r12, 1
    mov rcx, rbx
    shl r12, cl
    store.i64 [rbp-24], r12
    jmp ^merge

  block ^short
    store.i64 [rbp-24], 0
    jmp ^merge

  block ^merge
    load.i64 rbx, [rbp-24]
    mov r12, rdi
    add r12, rsi
    add rdx, [rbp-8]
    add r8, r9
    add r12, rdx
    add r12, r8
    add r12, rbx
    ret r12

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %actual -> [rbp-8] : i64

  block ^entry
    sub rsp, 16
    mov rdi, 6
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 1
    store.i64 [rsp], r11
    call @pressure [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-8], rax
    load.i64 r8, [rbp-8]
    mov rdx, 90
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
