machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 42

global @sink
  storage scalar i64
  init i64 0

global @object
  storage data
  item i64 0
  item i64 0

function @read_first
  abi
    param %p -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @run
  abi
    param %p -> rdi : ptr
    param %q -> rsi : i64
    param %r -> rdx : i64
    param %s -> rcx : i64
    param %t -> r8 : i64
    param %u -> r9 : i64
    param %v -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %v -> [rbp-8] : i64
    slot $p -> [rbp-16] : ptr
    slot $scratch -> [rbp-24] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-8], rax
    store.ptr [rbp-16], rdi
    store.i64 [rbp-24], 5
    jmp ^call

  block ^call
    load.i64 rax, [rbp-24]
    store.i64 @sink, rax
    load.ptr r8, [rbp-16]
    mov r9, @object
    lea r9, [r9+8]
    store.i64 [r9], 123456789
    mov rdi, r8
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    call @read_first [args=(rcx,rdx,rsi,rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rsp, 16
    mov rdi, @good
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    call @run [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    mov r8, rax
    mov rdx, 42
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    load.i64 r9, @sink
    mov rdx, 5
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdi, @object
    lea rdi, [rdi+8]
    load.i64 rsi, [rdi]
    mov rdx, 123456789
    cmp.i64 rsi, rdx
    sete rsi
    movzx rsi, rsi
    and r8, r9
    and r8, rsi
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
