machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r10, 255
    cmp.i64 r10, 255
    setne r8
    movzx r8, r8
    mov r10, -1
    cmp.i64 r10, -1
    setne r9
    movzx r9, r9
    mov r10, 65535
    cmp.i32 r10, 65535
    setne rdi
    movzx rdi, rdi
    mov r10, -1
    cmp.i32 r10, -1
    setne rsi
    movzx rsi, rsi
    or r8, r9
    or rdi, rsi
    or r8, rdi
    sext.i32 r8
    ret r8
