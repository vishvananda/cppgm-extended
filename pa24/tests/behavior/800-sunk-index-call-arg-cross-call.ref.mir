machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @object
  storage data
  item i64 0
  item i64 0

global @wrong
  storage data
  item i64 0
  item i64 0

function @make
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %wrong_base -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 42
    ret rax

function @store_value
  abi
    param %p -> rdi : ptr
    param %value -> rsi : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi], rsi
    ret

function @run
  abi
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @object+8
    mov r8, @wrong
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    call @make [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdi, rbx
    mov rsi, rax
    call @store_value [args=(rsi,rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @run [args=()]
    load.i64 r8, @object+8
    load.i64 r9, @wrong+8
    cmp.i64 r8, 42
    sete r8
    movzx r8, r8
    cmp.i64 r9, 0
    sete r9
    movzx r9, r9
    and r8, r9
    cmp.i64 r8, 0
    sete r8
    movzx r8, r8
    ret r8
