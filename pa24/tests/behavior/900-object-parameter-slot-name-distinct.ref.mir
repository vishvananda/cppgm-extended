machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 77
    load.i64 rax, [rbp-8]
    ret

function @read_parameter
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %value -> [rbp-8] : obj<8x8>
    slot $value -> [rbp-16] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], 99
    load.i64 rax, [rbp-8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %value -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_value [args=()]
    store.i64 [rbp-8], rax
    load.i64 rdi, [rbp-8]
    call @read_parameter [args=(rdi)]
    mov rdx, 77
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    mov rdx, 0
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
