machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 9
    xchg.i64 @g, r8
    load.i64 r9, @g
    cmp.i64 r8, 7
    sete r8
    movzx r8, r8
    cmp.i64 r9, 9
    sete r9
    movzx r9, r9
    and r8, r9
    ret r8
