machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, -1
    shr r8, 1
    cmp.i64 r8, 9223372036854775807
    sete r8
    movzx r8, r8
    mov r11, 7
    mov rax, -1
    mov rdx, 0
    div r11
    cmp.i64 rdx, 1
    sete rdx
    movzx rdx, rdx
    mov r10, 4611686018427387900
    cmp.i64 r10, 4611686018427387900
    sete r9
    movzx r9, r9
    add r8, rdx
    add r8, r9
    ret r8
