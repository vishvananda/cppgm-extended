machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @divide
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 1
    neg r8
    sext.i32 r8
    mov rax, rdi
    cqo
    idiv r8
    sext.i32 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, -2147483648
    call @divide [args=(rdi)]
    sext.i32 rax
    cmp.i32 rax, -2147483648
    setne rax
    movzx rax, rax
    ret rax
