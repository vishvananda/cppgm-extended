machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @byte_value
  storage scalar u8
  init u8 0

global @short_value
  storage scalar u16
  init u16 0

global @wide_value
  storage scalar i64
  init i64 0

global @words
  storage data
  item u32 0
  item u32 0
  item u32 0
  item u32 0

function @store_dereference
  abi
    param %address -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.u16 [rdi], 4660
    ret

function @store_indexed
  abi
    param %base -> rdi : ptr
    param %index -> rsi : i64
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.u32 [rdi+rsi*4], 305419896
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    store.u8 @byte_value, 171
    mov rdi, @short_value
    call @store_dereference [args=(rdi)]
    mov rbx, @words
    mov rdi, rbx
    mov rsi, 2
    call @store_indexed [args=(rsi,rdi)]
    store.i64 @wide_value, -2147483648
    load.u8 r8, @byte_value
    load.u16 r9, @short_value
    load.u32 rbx, [rbx+8]
    load.i64 rdi, @wide_value
    cmp.u8 r8, 171
    setne r8
    movzx r8, r8
    cmp.u16 r9, 4660
    setne r9
    movzx r9, r9
    cmp.u32 rbx, 305419896
    setne rbx
    movzx rbx, rbx
    mov r10, 2147483647
    cmp.i64 r10, 2147483647
    setne rsi
    movzx rsi, rsi
    mov r10, 4294967296
    cmp.i64 r10, 4294967296
    setne rdx
    movzx rdx, rdx
    cmp.i64 rdi, -2147483648
    setne rdi
    movzx rdi, rdi
    or r8, r9
    or rbx, rsi
    or rdx, rdi
    or r8, rbx
    or r8, rdx
    sext.i32 r8
    ret r8
