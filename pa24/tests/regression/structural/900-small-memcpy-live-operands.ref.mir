machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @memory_copy
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %count -> rdx : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 0
    jmp ^test

  block ^test
    cmp.i64 r8, rdx
    je ^return
    jmp ^body

  block ^body
    load.u8 r9, [rsi+r8]
    store.u8 [rdi+r8], r9
    mov r9, r8
    add r9, 1
    mov r8, r9
    jmp ^test

  block ^return
    ret rdi

function @copy_keep
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %value -> rdx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    copy_bytes 13x1, [rdi], [rsi]
    add rdx, [rdi]
    ret rdx

function @read_fixed
  abi
    param %source -> rdi : ptr
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $word -> [rbp-8] : i64

  block ^entry
    copy_bytes 8x1, [rbp-8], [rdi]
    add rsi, [rbp-8]
    ret rsi

function @copy_pressure
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %a -> rdx : i64
    param %b -> rcx : i64
    param %c -> r8 : i64
    param %d -> r9 : i64
    param %e -> [rbp+16] : i64
    param %f -> [rbp+24] : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %e -> [rbp-8] : i64
    param-slot %f -> [rbp-16] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-8], rax
    load.i64 rax, [rbp+24]
    store.i64 [rbp-16], rax
    copy_bytes 32x1, [rdi], [rsi]
    load.i64 rdi, [rdi]
    add rdx, rcx
    add r8, r9
    load.i64 r9, [rbp-8]
    add r9, [rbp-16]
    add rdx, r8
    add rdx, r9
    add rdx, rdi
    ret rdx

function @zero_copy
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %value -> rdx : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 144
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $source -> [rbp-48] : obj<48x1>
    slot $destination -> [rbp-96] : obj<48x1>

  block ^entry
    zero_bytes 48x1, [rbp-48]
    zero_bytes 48x1, [rbp-96]
    lea rbx, [rbp-47]
    lea r12, [rbp-93]
    store.i64 [rbx], 42
    store.u8 [rbx+12], 77
    store.u8 [rbx+31], 88
    store.u8 [r12+32], 99
    mov rdi, r12
    mov rsi, rbx
    mov rdx, 19
    call @copy_keep [args=(rdx,rsi,rdi), unwind=no]
    cmp.i64 rax, 61
    setne r13
    movzx r13, r13
    mov rdi, r12
    mov rsi, 31
    call @read_fixed [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 73
    setne r14
    movzx r14, r14
    sub rsp, 16
    mov rdi, r12
    mov rsi, rbx
    mov rdx, 1
    mov rcx, 2
    mov r8, 3
    mov r9, 4
    mov r11, 5
    store.i64 [rsp], r11
    mov r11, 6
    store.i64 [rsp+8], r11
    call @copy_pressure [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16, unwind=no]
    add rsp, 16
    cmp.i64 rax, 63
    setne r15
    movzx r15, r15
    mov rdi, r12
    mov rsi, rbx
    mov rdx, 91
    call @zero_copy [args=(rdx,rsi,rdi), unwind=no]
    cmp.i64 rax, 91
    setne rax
    movzx rax, rax
    cmp.u8 [r12+12], 77
    setne r8
    movzx r8, r8
    cmp.u8 [r12+31], 88
    setne r9
    movzx r9, r9
    cmp.u8 [r12+32], 99
    setne rdi
    movzx rdi, rdi
    or r13, r14
    or r15, rax
    or r8, r9
    or r13, r15
    or r8, rdi
    or r13, r8
    ret r13
