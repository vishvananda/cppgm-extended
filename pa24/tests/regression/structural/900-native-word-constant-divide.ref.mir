machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_quotient
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 8
    mov rax, rdi
    cqo.i32
    idiv.i32 r11
    ret rax

function @signed_remainder
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 8
    mov rax, rdi
    cqo.i32
    idiv.i32 r11
    ret rdx

function @negative_quotient
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, -3
    mov rax, rdi
    cqo.i32
    idiv.i32 r11
    ret rax

function @unsigned_quotient
  abi
    param %a -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 3
    mov rax, rdi
    mov rdx, 0
    div.i32 r11
    ret rax

function @unsigned_max_divisor
  abi
    param %a -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 4294967295
    mov rax, rdi
    mov rdx, 0
    div.i32 r11
    ret rax

function @unsigned_signed_op
  abi
    param %a -> rdi : u32
    return u32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 8
    mov rax, rdi
    cqo.i32
    idiv.i32 r11
    ret rax

function @signed_unsigned_op
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, 3
    mov rax, rdi
    mov rdx, 0
    div.i32 r11
    ret rax

function @negative_one
  abi
    param %a -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, -1
    mov rax, rdi
    cqo
    idiv r11
    ret rax

function @dynamic
  abi
    param %a -> rdi : i32
    param %divisor -> rsi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    cqo
    idiv rsi
    ret rax

function @from_pointer
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i32 r8, [rdi]
    mov r11, 8
    mov rax, r8
    cqo.i32
    idiv.i32 r11
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $input -> [rbp-16] : obj<16x8>

  block ^entry
    lea rbx, [rbp-16]
    store.i64 [rbx], -2147483648
    mov rdi, -2147483648
    call @signed_quotient [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -268435456
    setne r12
    movzx r12, r12
    mov rdi, 2147483647
    call @signed_quotient [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 268435455
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -31
    call @signed_quotient [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -3
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -31
    call @signed_remainder [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -7
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -2147483648
    call @negative_quotient [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 715827882
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, 4294967295
    call @unsigned_quotient [args=(rdi), unwind=no]
    zext.i32 rax
    cmp.u32 rax, 1431655765
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, 4294967295
    call @unsigned_max_divisor [args=(rdi), unwind=no]
    zext.i32 rax
    cmp.u32 rax, 1
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, 4294967294
    call @unsigned_max_divisor [args=(rdi), unwind=no]
    zext.i32 rax
    cmp.u32 rax, 0
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, 2147483648
    call @unsigned_signed_op [args=(rdi), unwind=no]
    zext.i32 rax
    cmp.u32 rax, 4026531840
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -1
    call @signed_unsigned_op [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 1431655765
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -2147483648
    call @negative_one [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -2147483648
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, -2147483648
    mov rsi, -1
    call @dynamic [args=(rsi,rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -2147483648
    setne rax
    movzx rax, rax
    or r12, rax
    mov rdi, rbx
    call @from_pointer [args=(rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, -268435456
    setne rax
    movzx rax, rax
    or r12, rax
    ret r12
