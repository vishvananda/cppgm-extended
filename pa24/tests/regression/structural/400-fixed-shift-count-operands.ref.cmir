machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov <gpr0>, 48
    cmp.i64 <gpr0>, 48
    setne r8
    movzx r8, r8
    mov <gpr0>, 4611686018427387900
    cmp.i64 <gpr0>, 4611686018427387900
    setne r9
    movzx r9, r9
    mov <gpr0>, -8
    cmp.i64 <gpr0>, -8
    setne rdi
    movzx rdi, rdi
    mov <gpr0>, 7
    cmp.i64 <gpr0>, 7
    setne rsi
    movzx rsi, rsi
    or rdi, rsi
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
