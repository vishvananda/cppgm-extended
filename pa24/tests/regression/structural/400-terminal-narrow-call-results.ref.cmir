machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @raw_signed
  abi
    return i8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -127
    ret rax

function @raw_unsigned
  abi
    return u8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 255
    ret rax

function @raw_true
  abi
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @raw_false
  abi
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @forward_signed
  abi
    return i8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_signed [args=()]
    ret rax

function @forward_unsigned
  abi
    return u8 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_unsigned [args=()]
    ret rax

function @forward_true
  abi
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_true [args=()]
    ret rax

function @forward_false
  abi
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_false [args=()]
    ret rax

function @widen_signed
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_signed [args=()]
    sext.i8 rax
    ret rax

function @widen_unsigned
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_unsigned [args=()]
    zext.i8 rax
    ret rax

function @branch_false
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_false [args=()]
    cmp.i1 rax, 0
    jne ^wrong
    jmp ^right

  block ^wrong
    mov rax, 1
    ret rax

  block ^right
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1> <gpr2>

  block ^entry
    call @widen_signed [args=()]
    mov <gpr0>, rax
    call @widen_unsigned [args=()]
    mov <gpr1>, rax
    call @forward_true [args=()]
    mov <gpr2>, rax
    call @branch_false [args=()]
    cmp.i64 <gpr0>, -127
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, 255
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i1 <gpr2>, 1
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr2>, rax
    or <gpr0>, <gpr2>
    sext.i32 <gpr0>
    ret <gpr0>
