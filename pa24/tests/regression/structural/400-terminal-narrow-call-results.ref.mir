machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @raw_signed
  abi
    return i8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -127
    ret rax

function @raw_unsigned
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 255
    ret rax

function @raw_true
  abi
    return i1 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @raw_false
  abi
    return i1 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @forward_signed
  abi
    return i8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_signed [args=()]
    ret rax

function @forward_unsigned
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_unsigned [args=()]
    ret rax

function @forward_true
  abi
    return i1 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_true [args=()]
    ret rax

function @forward_false
  abi
    return i1 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @raw_false [args=()]
    ret rax

function @widen_signed
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_signed [args=()]
    sext.i8 rax
    ret rax

function @widen_unsigned
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_unsigned [args=()]
    zext.i8 rax
    ret rax

function @branch_false
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_false [args=()]
    mov r8, rax
    and r8, 1
    cmp.i1 r8, 0
    jne ^wrong
    jmp ^right

  block ^wrong
    mov rax, 1
    ret rax

  block ^right
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    call @widen_signed [args=()]
    mov rbx, rax
    call @widen_unsigned [args=()]
    mov r12, rax
    call @forward_true [args=()]
    mov r13, rax
    and r13, 1
    call @branch_false [args=()]
    cmp.i64 rbx, -127
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 255
    setne r12
    movzx r12, r12
    cmp.i1 r13, 1
    setne r13
    movzx r13, r13
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, rax
    or rbx, r13
    sext.i32 rbx
    ret rbx
