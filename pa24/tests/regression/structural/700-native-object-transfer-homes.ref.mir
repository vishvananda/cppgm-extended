machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0
  item i64 0

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 17
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @disturb
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 99
    store.i64 [rbp-8], 100
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @direct_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-16] : obj<16x8>

  block ^entry
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @delayed_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-16] : obj<16x8>
    temp %value -> [rbp-32] : obj<16x8>

  block ^entry
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-32], rax
    store.i64 [rbp-24], rdx
    call @disturb [args=(), unwind=no]
    copy_bytes 16x8, [rbp-16], [rbp-32]
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @make_small
  abi
    return obj<3x1> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<3x1>

  block ^entry
    store.u8 [rbp-8], 42
    store.u8 [rbp-7], 43
    store.u8 [rbp-6], 44
    load.i64 rax, [rbp-8]
    ret

function @small_guard
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $buffer -> [rbp-8] : obj<8x1>
    temp %value -> [rbp-16] : obj<3x1>

  block ^entry
    store.u8 [rbp-5], 77
    call @make_small [args=(), unwind=no]
    store.i64 [rbp-16], rax
    copy_bytes 3x1, [rbp-8], [rbp-16]
    load.u8 r8, [rbp-8]
    load.u8 r9, [rbp-6]
    load.u8 rdi, [rbp-5]
    cmp.u8 r8, 42
    setne r8
    movzx r8, r8
    cmp.u8 r9, 44
    setne r9
    movzx r9, r9
    cmp.u8 rdi, 77
    setne rdi
    movzx rdi, rdi
    or r8, r9
    or r8, rdi
    ret r8

function @clear
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    zero_bytes 16x8, rdi
    ret

function @param_first
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $object -> [rbp-16] : obj<16x8>
    param-slot %value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], rdi
    store.i64 [rbp-8], rsi
    load.i64 r8, [rbp-16]
    add r8, [rbp-8]
    ret r8

function @param_touched
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $object -> [rbp-16] : obj<16x8>
    param-slot %value -> [rbp-32] : obj<16x8>

  block ^entry
    store.i64 [rbp-32], rdi
    store.i64 [rbp-24], rsi
    zero_bytes 16x8, [rbp-16]
    copy_bytes 16x8, [rbp-16], [rbp-32]
    load.i64 r8, [rbp-16]
    add r8, [rbp-8]
    ret r8

function @param_escaped
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $object -> [rbp-16] : obj<16x8>
    param-slot %value -> [rbp-32] : obj<16x8>

  block ^entry
    store.i64 [rbp-32], rdi
    store.i64 [rbp-24], rsi
    lea rbx, [rbp-16]
    mov rdi, rbx
    call @clear [args=(rdi), unwind=no]
    copy_bytes 16x8, rbx, [rbp-32]
    load.i64 r8, [rbx]
    add r8, [rbx+8]
    ret r8

function @param_twice
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $first -> [rbp-16] : obj<16x8>
    slot $second -> [rbp-32] : obj<16x8>
    param-slot %value -> [rbp-48] : obj<16x8>

  block ^entry
    store.i64 [rbp-48], rdi
    store.i64 [rbp-40], rsi
    copy_bytes 16x8, [rbp-16], [rbp-48]
    zero_bytes 16x8, [rbp-16]
    copy_bytes 16x8, [rbp-32], [rbp-48]
    load.i64 r8, [rbp-32]
    add r8, [rbp-24]
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    temp %pair -> [rbp-16] : obj<16x8>

  block ^entry
    call @direct_pair [args=(), unwind=no]
    store.i64 @result, rax
    store.i64 @result+8, rdx
    load.i64 r8, @result
    load.i64 r9, @result+8
    cmp.i64 r8, 17
    setne r8
    movzx r8, r8
    cmp.i64 r9, 23
    setne r9
    movzx r9, r9
    mov rbx, r8
    or rbx, r9
    call @delayed_pair [args=(), unwind=no]
    store.i64 @result, rax
    store.i64 @result+8, rdx
    load.i64 r8, @result
    load.i64 r9, @result+8
    cmp.i64 r8, 17
    setne r8
    movzx r8, r8
    cmp.i64 r9, 23
    setne r9
    movzx r9, r9
    or rbx, r8
    or rbx, r9
    call @small_guard [args=(), unwind=no]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or rbx, rax
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    load.i64 rdi, [rbp-16]
    load.i64 rsi, [rbp-8]
    call @param_first [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or rbx, rax
    load.i64 rdi, [rbp-16]
    load.i64 rsi, [rbp-8]
    call @param_touched [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or rbx, rax
    load.i64 rdi, [rbp-16]
    load.i64 rsi, [rbp-8]
    call @param_escaped [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or rbx, rax
    load.i64 rdi, [rbp-16]
    load.i64 rsi, [rbp-8]
    call @param_twice [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or rbx, rax
    ret rbx
