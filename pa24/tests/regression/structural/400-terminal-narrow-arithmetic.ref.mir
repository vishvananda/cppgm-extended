machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @wrap_unsigned
  abi
    param %value -> rdi : u8
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 1
    ret rdi

function @wrap_signed
  abi
    param %value -> rdi : i8
    return i8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rdi, 1
    ret rdi

function @store_word
  abi
    param %value -> rdi : u16
    param %destination -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 1
    store.u16 [rsi], rdi
    ret

function @widen_unsigned
  abi
    param %value -> rdi : u8
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 1
    zext.i8 rdi
    ret rdi

function @widen_signed
  abi
    param %value -> rdi : i8
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rdi, 1
    sext.i8 rdi
    ret rdi

function @wrap_bool
  abi
    param %value -> rdi : i1
    return i1 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, 1
    and rdi, 1
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $word -> [rbp-8] : u16
    temp %false -> [rbp-16] : i1

  block ^entry
    mov rdi, 255
    call @wrap_unsigned [args=(rdi), unwind=no]
    cmp.u8 rax, 0
    setne rbx
    movzx rbx, rbx
    mov rdi, -128
    call @wrap_signed [args=(rdi), unwind=no]
    cmp.i8 rax, 127
    setne r12
    movzx r12, r12
    lea rsi, [rbp-8]
    mov rdi, 65535
    call @store_word [args=(rsi,rdi), unwind=no]
    load.u16 r8, [rbp-8]
    cmp.u16 r8, 0
    setne r13
    movzx r13, r13
    mov rdi, 255
    call @widen_unsigned [args=(rdi), unwind=no]
    cmp.i64 rax, 0
    setne r14
    movzx r14, r14
    mov rdi, -128
    call @widen_signed [args=(rdi), unwind=no]
    cmp.i64 rax, 127
    setne r15
    movzx r15, r15
    mov rdi, 1
    call @wrap_bool [args=(rdi), unwind=no]
    mov r10, rax
    and r10, 1
    store.i1 [rbp-16], r10
    mov rdi, 0
    call @wrap_bool [args=(rdi), unwind=no]
    cmp.i1 [rbp-16], 0
    setne r8
    movzx r8, r8
    cmp.i1 rax, 1
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or r15, r8
    or rbx, r13
    or r15, rax
    or rbx, r15
    ret rbx
