machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @variadic_identity
  abi
    param %tag -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %va-register-save -> [rbp-<off0>] : obj<176x16>

  block ^entry
    store.i64 [rbp-<off0>], rdi
    store.i64 [rbp-<off1>], rsi
    store.i64 [rbp-<off2>], rdx
    store.i64 [rbp-<off3>], rcx
    store.i64 [rbp-<off4>], r8
    store.i64 [rbp-<off5>], r9
    fmov.i128 [rbp-<off6>], xmm0
    fmov.i128 [rbp-<off7>], xmm1
    fmov.i128 [rbp-<off8>], <xmm0>
    fmov.i128 [rbp-<off9>], <xmm1>
    fmov.i128 [rbp-<off10>], <xmm2>
    fmov.i128 [rbp-<off11>], <xmm3>
    fmov.i128 [rbp-<off12>], <xmm4>
    fmov.i128 [rbp-<off13>], <xmm5>
    ret rdi

function @callee
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @aliased_caller
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @callee [args=(rdi)]
    ret rax

function @extended
  abi
    param %value -> [rbp+<off0>] : f80
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fptosi.f80.i64 rax, [rbp+<off0>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, 17
    mov rsi, 29
    mov rax, 0
    call @variadic_identity [args=(rax,rsi,rdi), variadic]
    mov <gpr0>, rax
    mov rdi, 31
    call @aliased_caller [args=(rdi)]
    mov <gpr1>, rax
    sub rsp, 16
    fmov.f80 [rsp], 43.5L
    call @extended [args=(), stack=16]
    add rsp, 16
    cmp.i64 <gpr0>, 17
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, 31
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr0>, rax
    sext.i32 <gpr0>
    ret <gpr0>
