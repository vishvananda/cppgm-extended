machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0
  item i64 0

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-<off0>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off0>], 17
    store.i64 [rbp-<off1>], 23
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @disturb
  abi
    return obj<16x8> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-<off0>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off0>], 99
    store.i64 [rbp-<off1>], 100
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @direct_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-<off0>] : obj<16x8>

  block ^entry
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-<off0>], rax
    store.i64 [rbp-<off1>], rdx
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @delayed_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-<off0>] : obj<16x8>
    temp %value -> [rbp-<off2>] : obj<16x8>

  block ^entry
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-<off2>], rax
    store.i64 [rbp-<off3>], rdx
    call @disturb [args=(), unwind=no]
    copy_bytes 16x8, [rbp-<off0>], [rbp-<off2>]
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @make_small
  abi
    return obj<3x1> -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-<off1>] : obj<3x1>

  block ^entry
    store.u8 [rbp-<off1>], 42
    store.u8 [rbp-<off4>], 43
    store.u8 [rbp-<off5>], 44
    load.i64 rax, [rbp-<off1>]
    ret

function @small_guard
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $buffer -> [rbp-<off1>] : obj<8x1>
    temp %value -> [rbp-<off0>] : obj<3x1>

  block ^entry
    store.u8 [rbp-<off6>], 77
    call @make_small [args=(), unwind=no]
    store.i64 [rbp-<off0>], rax
    copy_bytes 3x1, [rbp-<off1>], [rbp-<off0>]
    load.u8 r8, [rbp-<off1>]
    load.u8 r9, [rbp-<off5>]
    load.u8 rdi, [rbp-<off6>]
    cmp.u8 r8, 42
    setne r8
    movzx r8, r8
    cmp.u8 r9, 44
    setne r9
    movzx r9, r9
    cmp.u8 rdi, 77
    setne rdi
    movzx rdi, rdi
    or r8, r9
    or r8, rdi
    ret r8

function @clear
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    zero_bytes 16x8, rdi
    ret

function @param_first
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $object -> [rbp-<off0>] : obj<16x8>
    param-slot %value -> [rbp-<off0>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off0>], rdi
    store.i64 [rbp-<off1>], rsi
    load.i64 r8, [rbp-<off0>]
    add r8, [rbp-<off1>]
    ret r8

function @param_touched
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $object -> [rbp-<off0>] : obj<16x8>
    param-slot %value -> [rbp-<off2>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off2>], rdi
    store.i64 [rbp-<off3>], rsi
    zero_bytes 16x8, [rbp-<off0>]
    copy_bytes 16x8, [rbp-<off0>], [rbp-<off2>]
    load.i64 r8, [rbp-<off0>]
    add r8, [rbp-<off1>]
    ret r8

function @param_escaped
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0>
    slot $object -> [rbp-<off0>] : obj<16x8>
    param-slot %value -> [rbp-<off2>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off2>], rdi
    store.i64 [rbp-<off3>], rsi
    lea <gpr0>, [rbp-<off0>]
    mov rdi, <gpr0>
    call @clear [args=(rdi), unwind=no]
    copy_bytes 16x8, <gpr0>, [rbp-<off2>]
    load.i64 r8, [<gpr0>]
    add r8, [<gpr0>+<off0>]
    ret r8

function @param_twice
  abi
    param %value -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $first -> [rbp-<off0>] : obj<16x8>
    slot $second -> [rbp-<off2>] : obj<16x8>
    param-slot %value -> [rbp-<off7>] : obj<16x8>

  block ^entry
    store.i64 [rbp-<off7>], rdi
    store.i64 [rbp-<off8>], rsi
    copy_bytes 16x8, [rbp-<off0>], [rbp-<off7>]
    zero_bytes 16x8, [rbp-<off0>]
    copy_bytes 16x8, [rbp-<off2>], [rbp-<off7>]
    load.i64 r8, [rbp-<off2>]
    add r8, [rbp-<off3>]
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0>
    temp %pair -> [rbp-<off0>] : obj<16x8>

  block ^entry
    call @direct_pair [args=(), unwind=no]
    store.i64 @result, rax
    store.i64 @result+8, rdx
    load.i64 r8, @result
    load.i64 r9, @result+8
    cmp.i64 r8, 17
    setne r8
    movzx r8, r8
    cmp.i64 r9, 23
    setne r9
    movzx r9, r9
    mov <gpr0>, r8
    or <gpr0>, r9
    call @delayed_pair [args=(), unwind=no]
    store.i64 @result, rax
    store.i64 @result+8, rdx
    load.i64 r8, @result
    load.i64 r9, @result+8
    cmp.i64 r8, 17
    setne r8
    movzx r8, r8
    cmp.i64 r9, 23
    setne r9
    movzx r9, r9
    or <gpr0>, r8
    or <gpr0>, r9
    call @small_guard [args=(), unwind=no]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    call @make_pair [args=(), unwind=no]
    store.i64 [rbp-<off0>], rax
    store.i64 [rbp-<off1>], rdx
    load.i64 rdi, [rbp-<off0>]
    load.i64 rsi, [rbp-<off1>]
    call @param_first [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    load.i64 rdi, [rbp-<off0>]
    load.i64 rsi, [rbp-<off1>]
    call @param_touched [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    load.i64 rdi, [rbp-<off0>]
    load.i64 rsi, [rbp-<off1>]
    call @param_escaped [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    load.i64 rdi, [rbp-<off0>]
    load.i64 rsi, [rbp-<off1>]
    call @param_twice [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 40
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    ret <gpr0>
