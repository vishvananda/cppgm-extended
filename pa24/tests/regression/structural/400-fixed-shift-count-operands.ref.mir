machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r10, 48
    cmp.i64 r10, 48
    setne r8
    movzx r8, r8
    mov r10, 4611686018427387900
    cmp.i64 r10, 4611686018427387900
    setne r9
    movzx r9, r9
    mov r10, -8
    cmp.i64 r10, -8
    setne rdi
    movzx rdi, rdi
    mov r10, 7
    cmp.i64 r10, 7
    setne rsi
    movzx rsi, rsi
    or rdi, rsi
    or r9, rdi
    or r8, r9
    sext.i32 r8
    ret r8
