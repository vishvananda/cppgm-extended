machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @variadic_identity
  abi
    param %tag -> rdi : i64
    return i64 -> rax
  frame
    stack_size 176
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %va-register-save -> [rbp-176] : obj<176x16>

  block ^entry
    store.i64 [rbp-176], rdi
    store.i64 [rbp-168], rsi
    store.i64 [rbp-160], rdx
    store.i64 [rbp-152], rcx
    store.i64 [rbp-144], r8
    store.i64 [rbp-136], r9
    fmov.i128 [rbp-128], xmm0
    fmov.i128 [rbp-112], xmm1
    fmov.i128 [rbp-96], xmm2
    fmov.i128 [rbp-80], xmm3
    fmov.i128 [rbp-64], xmm4
    fmov.i128 [rbp-48], xmm5
    fmov.i128 [rbp-32], xmm6
    fmov.i128 [rbp-16], xmm7
    ret rdi

function @callee
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @aliased_caller
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @callee [args=(rdi)]
    ret rax

function @extended
  abi
    param %value -> [rbp+16] : f80
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fptosi.f80.i64 rax, [rbp+16]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov rdi, 17
    mov rsi, 29
    mov rax, 0
    call @variadic_identity [args=(rax,rsi,rdi), variadic]
    mov rbx, rax
    mov rdi, 31
    call @aliased_caller [args=(rdi)]
    mov r12, rax
    sub rsp, 16
    fmov.f80 [rsp], 43.5L
    call @extended [args=(), stack=16]
    add rsp, 16
    cmp.i64 rbx, 17
    setne rbx
    movzx rbx, rbx
    cmp.i64 r12, 31
    setne r12
    movzx r12, r12
    cmp.i64 rax, 43
    setne rax
    movzx rax, rax
    or rbx, r12
    or rbx, rax
    sext.i32 rbx
    ret rbx
