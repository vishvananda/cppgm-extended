machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @memory_copy
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %count -> rdx : i64
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 0
    jmp ^test

  block ^test
    cmp.i64 r8, rdx
    je ^return
    jmp ^body

  block ^body
    load.u8 r9, [rsi+r8]
    store.u8 [rdi+r8], r9
    mov r9, r8
    add r9, 1
    mov r8, r9
    jmp ^test

  block ^return
    ret rdi

function @copy_keep
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %value -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    copy_bytes 13x1, [rdi], [rsi]
    add rdx, [rdi]
    ret rdx

function @read_fixed
  abi
    param %source -> rdi : ptr
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $word -> [rbp-<off0>] : i64

  block ^entry
    copy_bytes 8x1, [rbp-<off0>], [rdi]
    add rsi, [rbp-<off0>]
    ret rsi

function @copy_pressure
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %a -> rdx : i64
    param %b -> rcx : i64
    param %c -> r8 : i64
    param %d -> r9 : i64
    param %e -> [rbp+<off0>] : i64
    param %f -> [rbp+<off1>] : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %e -> [rbp-<off0>] : i64
    param-slot %f -> [rbp-<off1>] : i64

  block ^entry
    load.i64 rax, [rbp+<off0>]
    store.i64 [rbp-<off0>], rax
    load.i64 rax, [rbp+<off1>]
    store.i64 [rbp-<off1>], rax
    copy_bytes 32x1, [rdi], [rsi]
    load.i64 rdi, [rdi]
    add rdx, rcx
    add r8, r9
    load.i64 r9, [rbp-<off0>]
    add r9, [rbp-<off1>]
    add rdx, r8
    add rdx, r9
    add rdx, rdi
    ret rdx

function @zero_copy
  abi
    param %destination -> rdi : ptr
    param %source -> rsi : ptr
    param %value -> rdx : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $source -> [rbp-<off2>] : obj<48x1>
    slot $destination -> [rbp-<off3>] : obj<48x1>

  block ^entry
    zero_bytes 48x1, [rbp-<off2>]
    zero_bytes 48x1, [rbp-<off3>]
    lea <gpr0>, [rbp-<off4>]
    lea <gpr1>, [rbp-<off5>]
    store.i64 [<gpr0>], 42
    store.u8 [<gpr0>+<off0>], 77
    store.u8 [<gpr0>+<off1>], 88
    store.u8 [<gpr1>+<off0>], 99
    mov rdi, <gpr1>
    mov rsi, <gpr0>
    mov rdx, 19
    call @copy_keep [args=(rdx,rsi,rdi), unwind=no]
    cmp.i64 rax, 61
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdi, <gpr1>
    mov rsi, 31
    call @read_fixed [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 73
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    sub rsp, 16
    mov rdi, <gpr1>
    mov rsi, <gpr0>
    mov rdx, 1
    mov rcx, 2
    mov r8, 3
    mov r9, 4
    mov <gpr5>, 5
    store.i64 [rsp], <gpr5>
    mov <gpr5>, 6
    store.i64 [rsp+<off0>], <gpr5>
    call @copy_pressure [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16, unwind=no]
    add rsp, 16
    cmp.i64 rax, 63
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    mov rdi, <gpr1>
    mov rsi, <gpr0>
    mov rdx, 91
    call @zero_copy [args=(rdx,rsi,rdi), unwind=no]
    cmp.i64 rax, 91
    setne rax
    movzx rax, rax
    cmp.u8 [<gpr1>+<off1>], 77
    setne r8
    movzx r8, r8
    cmp.u8 [<gpr1>+<off2>], 88
    setne r9
    movzx r9, r9
    cmp.u8 [<gpr1>+<off0>], 99
    setne rdi
    movzx rdi, rdi
    or <gpr2>, <gpr3>
    or <gpr4>, rax
    or r8, r9
    or <gpr2>, <gpr4>
    or r8, rdi
    or <gpr2>, r8
    ret <gpr2>
