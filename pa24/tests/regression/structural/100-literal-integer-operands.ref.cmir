machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @masked
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    and rdi, -16
    ret rdi

function @unsigned_shift
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 268435455
    ret rax

function @signed_shift
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -32
    ret rax

function @narrow
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -128
    ret rax

function @truncated
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 254
    ret rax

function @boolean
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -1
    ret rax

function @out_of_range
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 1
    shl r8, 32
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>

  block ^entry
    mov rdi, 12345
    call @masked [args=(rdi), unwind=no]
    cmp.i64 rax, 12336
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    call @unsigned_shift [args=(), unwind=no]
    cmp.i64 rax, 268435455
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    call @signed_shift [args=(), unwind=no]
    cmp.i64 rax, -32
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    call @narrow [args=(), unwind=no]
    cmp.i64 rax, -128
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    call @truncated [args=(), unwind=no]
    cmp.i64 rax, 254
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    call @boolean [args=(), unwind=no]
    cmp.i64 rax, -1
    setne rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr2>, <gpr3>
    or <gpr4>, rax
    or <gpr0>, <gpr2>
    or <gpr0>, <gpr4>
    ret <gpr0>
