machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed
  abi
    param %which -> rdi : i32
    param %keep -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea r10, [rdi+4]
    cmp.i64 r10, 11
    ja ^fallback
    jump_table r10, [^c0, ^c1, ^c2, ^c3, ^c4, ^c5, ^c6, ^c7, ^c8, ^c9, ^c10, ^c11]

  block ^c0
    add rsi, 7
    ret rsi

  block ^c1
    add rsi, 20
    ret rsi

  block ^c2
    add rsi, 33
    ret rsi

  block ^c3
    add rsi, 46
    ret rsi

  block ^c4
    add rsi, 59
    ret rsi

  block ^c5
    add rsi, 72
    ret rsi

  block ^c6
    add rsi, 85
    ret rsi

  block ^c7
    add rsi, 98
    ret rsi

  block ^c8
    add rsi, 111
    ret rsi

  block ^c9
    add rsi, 124
    ret rsi

  block ^c10
    add rsi, 137
    ret rsi

  block ^c11
    add rsi, 150
    ret rsi

  block ^fallback
    mov rax, -999
    ret rax

