function @sparse
  abi
    param %which -> rdi : i64
    param %keep -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, 0
    je ^c0
    cmp.i64 rdi, 10000
    je ^c1
    cmp.i64 rdi, 20000
    je ^c2
    cmp.i64 rdi, 30000
    je ^c3
    cmp.i64 rdi, 40000
    je ^c4
    cmp.i64 rdi, 50000
    je ^c5
    jmp ^fallback

  block ^c0
    add rsi, 7
    ret rsi

  block ^c1
    add rsi, 20
    ret rsi

  block ^c2
    add rsi, 33
    ret rsi

  block ^c3
    add rsi, 46
    ret rsi

  block ^c4
    add rsi, 59
    ret rsi

  block ^c5
    add rsi, 72
    ret rsi

  block ^fallback
    mov rax, -999
    ret rax

