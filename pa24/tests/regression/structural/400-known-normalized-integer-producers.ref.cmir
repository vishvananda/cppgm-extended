machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @shift_with_typed_count
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 12
    ret rax

function @explicit_truncation
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    call @shift_with_typed_count [args=()]
    mov <gpr0>, rax
    sext.i32 <gpr0>
    call @explicit_truncation [args=()]
    sext.i32 rax
    cmp.i32 <gpr0>, 12
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i32 rax, 1
    setne rax
    movzx rax, rax
    or <gpr0>, rax
    sext.i32 <gpr0>
    ret <gpr0>
