machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @immediate
  abi
    param %x -> rdi : i32
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i32 rdi, 7
    sete rdi
    movzx rdi, rdi
    ret rdi

function @large_immediate
  abi
    param %x -> rdi : i64
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, 4294967297
    sete rdi
    movzx rdi, rdi
    ret rdi

function @boolean_branch
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i1 [rdi], 0
    jne ^yes
    jmp ^no

  block ^yes
    mov rax, 17
    ret rax

  block ^no
    mov rax, 29
    ret rax

function @volatile_boolean
  abi
    param %p -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i1 rdi, [rdi]
    cmp.i1 rdi, 0
    jne ^yes
    jmp ^no

  block ^yes
    mov rax, 17
    ret rax

  block ^no
    mov rax, 29
    ret rax

function @floating_identity
  abi
    param %x -> xmm0 : f64
    return f64 -> xmm0
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %x -> [rbp-8] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fmov.f64 xmm0, [rbp-8]
    ret xmm0

function @mixed
  abi
    param %f -> xmm0 : f32
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %f -> [rbp-8] : f32

  block ^entry
    fmov.f32 [rbp-8], xmm0
    mov r8, rdi
    add r8, rsi
    xor rdi, rsi
    imul r8, rdi
    fptosi.f32.i64 r9, [rbp-8]
    add r8, r9
    ret r8

function @extended_to_double
  abi
    param %v -> [rbp+16] : f80
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fptrunc.f80.f64 xmm0, [rbp+16]
    ret xmm0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $flag -> [rbp-8] : i1
    temp %f -> [rbp-16] : f64

  block ^entry
    store.i1 [rbp-8], 1
    lea rbx, [rbp-8]
    mov rdi, 7
    call @immediate [args=(rdi)]
    mov r12, rax
    sext.i32 r12
    mov rdi, 4294967297
    call @large_immediate [args=(rdi)]
    mov r13, rax
    sext.i32 r13
    mov rdi, rbx
    call @boolean_branch [args=(rdi)]
    mov r14, rax
    sext.i32 r14
    mov rdi, rbx
    call @volatile_boolean [args=(rdi)]
    mov rbx, rax
    sext.i32 rbx
    fmov.f64 xmm0, 1.5
    call @floating_identity [args=(xmm0)]
    fmov.f64 xmm14, xmm0
    fmov.f64 [rbp-16], xmm14
    mov rdi, 3
    mov rsi, 5
    fmov.f32 xmm0, 2.0f
    call @mixed [args=(rsi,rdi,xmm0)]
    mov r15, rax
    sub rsp, 16
    fmov.f80 [rsp], 1.5L
    call @extended_to_double [args=(), stack=16]
    add rsp, 16
    fne.f64 r8, xmm0, 1.5
    cmp.i32 r12, 1
    setne r12
    movzx r12, r12
    or r12, r8
    cmp.i32 r13, 1
    setne r13
    movzx r13, r13
    cmp.i32 r14, 17
    setne r14
    movzx r14, r14
    cmp.i32 rbx, 17
    setne rbx
    movzx rbx, rbx
    fne.f64 r8, [rbp-16], 1.5
    cmp.i64 r15, 50
    setne r15
    movzx r15, r15
    or r12, r13
    or r14, rbx
    or r8, r15
    or r12, r14
    or r12, r8
    sext.i32 r12
    ret r12
