machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 41

function @direct_storage_use
  abi
    param %replacement -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, @value
    store.i64 @value, rdi
    ret rax

function @observe_address
  abi
    return ptr -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @value
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, 42
    call @direct_storage_use [args=(rdi), unwind=no]
    mov <gpr0>, rax
    load.i64 <gpr1>, @value
    call @observe_address [args=(), unwind=no]
    cmp.i64 <gpr0>, 41
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    cmp.i64 <gpr1>, 42
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.ptr rax, 0
    sete rax
    movzx rax, rax
    or <gpr0>, <gpr1>
    or <gpr0>, rax
    ret <gpr0>
