machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @masked
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    and rdi, -16
    ret rdi

function @unsigned_shift
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 268435455
    ret rax

function @signed_shift
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -32
    ret rax

function @narrow
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -128
    ret rax

function @truncated
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 254
    ret rax

function @boolean
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -1
    ret rax

function @out_of_range
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 1
    shl r8, 32
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov rdi, 12345
    call @masked [args=(rdi), unwind=no]
    cmp.i64 rax, 12336
    setne rbx
    movzx rbx, rbx
    call @unsigned_shift [args=(), unwind=no]
    cmp.i64 rax, 268435455
    setne r12
    movzx r12, r12
    call @signed_shift [args=(), unwind=no]
    cmp.i64 rax, -32
    setne r13
    movzx r13, r13
    call @narrow [args=(), unwind=no]
    cmp.i64 rax, -128
    setne r14
    movzx r14, r14
    call @truncated [args=(), unwind=no]
    cmp.i64 rax, 254
    setne r15
    movzx r15, r15
    call @boolean [args=(), unwind=no]
    cmp.i64 rax, -1
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or r15, rax
    or rbx, r13
    or rbx, r15
    ret rbx
