machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @dirty
  abi
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -1
    ret rax

function @signed_byte
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov <gpr0>, rdi
    mov <gpr1>, rsi
    call @dirty [args=(), unwind=no]
    cmp.i64 <gpr0>, <gpr1>
    setl rax
    ret rax

function @unsigned_byte
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, rsi
    setb rax
    ret rax

function @pointer_byte
  abi
    param %p -> rdi : ptr
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.ptr rdi, 0
    setne rax
    ret rax

function @forward_byte
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i1 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @signed_byte [args=(rsi,rdi), unwind=no]
    ret rax

function @signed_wide
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov <gpr0>, rdi
    mov <gpr1>, rsi
    call @dirty [args=(), unwind=no]
    cmp.i64 <gpr0>, <gpr1>
    setl <gpr0>
    movzx <gpr0>, <gpr0>
    ret <gpr0>

function @forward_wide
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_byte [args=(rsi,rdi), unwind=no]
    and rax, 1
    ret rax

function @branch_byte
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @signed_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 0
    jne ^yes
    jmp ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @branch_wide
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @signed_byte [args=(rsi,rdi), unwind=no]
    and rax, 1
    cmp.i64 rax, 0
    jne ^yes
    jmp ^no

  block ^yes
    mov rax, 1
    ret rax

  block ^no
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>
    slot $input -> [rbp-<off0>] : obj<16x8>

  block ^entry
    lea <gpr0>, [rbp-<off0>]
    store.i64 [<gpr0>], -2147483648
    mov rdi, -2
    mov rsi, 1
    call @signed_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 1
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdi, 2
    mov rsi, 1
    call @signed_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, -1
    mov rsi, 0
    call @unsigned_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 0
    mov rsi, -1
    call @unsigned_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 0
    call @pointer_byte [args=(rdi), unwind=no]
    cmp.i1 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, <gpr0>
    call @pointer_byte [args=(rdi), unwind=no]
    cmp.i1 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 2
    mov rsi, 1
    call @forward_byte [args=(rsi,rdi), unwind=no]
    cmp.i1 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, -2
    mov rsi, 1
    call @signed_wide [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 2
    mov rsi, 1
    call @signed_wide [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, -2
    mov rsi, 1
    call @forward_wide [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 2
    mov rsi, 1
    call @forward_wide [args=(rsi,rdi), unwind=no]
    cmp.i64 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, -2
    mov rsi, 1
    call @branch_byte [args=(rsi,rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 2
    mov rsi, 1
    call @branch_byte [args=(rsi,rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, -2
    mov rsi, 1
    call @branch_wide [args=(rsi,rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 1
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    mov rdi, 2
    mov rsi, 1
    call @branch_wide [args=(rsi,rdi), unwind=no]
    sext.i32 rax
    cmp.i32 rax, 0
    setne rax
    movzx rax, rax
    or <gpr1>, rax
    ret <gpr1>
