machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @shift_with_typed_count
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 12
    ret rax

function @explicit_truncation
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @shift_with_typed_count [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @explicit_truncation [args=()]
    sext.i32 rax
    cmp.i32 rbx, 12
    setne rbx
    movzx rbx, rbx
    cmp.i32 rax, 1
    setne rax
    movzx rax, rax
    or rbx, rax
    sext.i32 rbx
    ret rbx
