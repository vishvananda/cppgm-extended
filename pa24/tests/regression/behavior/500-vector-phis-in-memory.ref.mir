    fmov.v128 xmm15, [rbp-448]
    fmov.v128 [rbp-432], xmm15
    fmov.v128 xmm15, [rbp-464]
    fmov.v128 [rbp-448], xmm15
    fmov.v128 xmm15, [rbp-480]
    fmov.v128 [rbp-464], xmm15
    fmov.v128 xmm15, [rbp-496]
    fmov.v128 [rbp-480], xmm15
    fmov.v128 xmm15, [rbp-512]
    fmov.v128 [rbp-496], xmm15
    fmov.v128 [rbp-512], xmm14
    jmp ^loop

  block ^done
    call @tick [args=()]
    cmp.i32 rbx, 0
    jne ^again
    jmp ^check

  block ^again
    call @tick [args=()]
    mov r12, 0
    mov rbx, 0
    vector.pzero xmm15
    fmov.v128 [rbp-528], xmm15
    jmp ^loop

  block ^check
    fmov.v128 xmm15, [rbp-528]
    vector.pshufd xmm0, xmm15, 3
    vector.toi32 r8, xmm0
    sext.i32 r8
    fmov.v128 xmm15, [rbp-528]
    vector.toi32 r9, xmm15
    sext.i32 r9
    add r8, r9
    sext.i32 r8
    fmov.v128 xmm15, [rbp-208]
