    vector.pshufd xmm14, xmm15, 0
    fmov.v128 [rbp-192], xmm14
    mov r12, 0
    mov rbx, rdi
    fmov.v128 [rbp-208], xmm0
    fmov.v128 [rbp-224], xmm1
    fmov.v128 [rbp-240], xmm2
    fmov.v128 [rbp-256], xmm3
    fmov.v128 [rbp-272], xmm4
