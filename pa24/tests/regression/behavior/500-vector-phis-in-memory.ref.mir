machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ticks
  storage data
  item i32 0

function @tick
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i32 r8, @ticks
    add r8, 1
    sext.i32 r8
    store.i32 @ticks, r8
    ret

function @rotate
  abi
    param %rounds -> rdi : i32
    return i32 -> rax
  frame
    stack_size 544
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    temp %low14 -> [rbp-16] : v128
    temp %start14 -> [rbp-32] : v128
    temp %low15 -> [rbp-48] : v128
    temp %start15 -> [rbp-64] : v128
    temp %low16 -> [rbp-80] : v128
    temp %start16 -> [rbp-96] : v128
    temp %low17 -> [rbp-112] : v128
    temp %start17 -> [rbp-128] : v128
    temp %low18 -> [rbp-144] : v128
    temp %start18 -> [rbp-160] : v128
    temp %low19 -> [rbp-176] : v128
    temp %start19 -> [rbp-192] : v128
    temp %v0 -> [rbp-208] : v128
    temp %v1 -> [rbp-224] : v128
    temp %v2 -> [rbp-240] : v128
    temp %v3 -> [rbp-256] : v128
    temp %v4 -> [rbp-272] : v128
    temp %v5 -> [rbp-288] : v128
    temp %v6 -> [rbp-304] : v128
    temp %v7 -> [rbp-320] : v128
    temp %v8 -> [rbp-336] : v128
    temp %v9 -> [rbp-352] : v128
    temp %v10 -> [rbp-368] : v128
    temp %v11 -> [rbp-384] : v128
    temp %v12 -> [rbp-400] : v128
    temp %v13 -> [rbp-416] : v128
    temp %v14 -> [rbp-432] : v128
    temp %v15 -> [rbp-448] : v128
    temp %v16 -> [rbp-464] : v128
    temp %v17 -> [rbp-480] : v128
    temp %v18 -> [rbp-496] : v128
    temp %v19 -> [rbp-512] : v128
    temp %zero -> [rbp-528] : v128

  block ^entry
    mov r10, 1
    vector.fromi32 xmm0, r10
    vector.pshufd xmm0, xmm0, 0
    mov r10, 2
    vector.fromi32 xmm1, r10
    vector.pshufd xmm1, xmm1, 0
    mov r10, 3
