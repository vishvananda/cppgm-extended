    mov r10, 9
    vector.fromi32 xmm8, r10
    vector.pshufd xmm8, xmm8, 0
    mov r10, 10
    vector.fromi32 xmm9, r10
    vector.pshufd xmm9, xmm9, 0
    mov r10, 11
    vector.fromi32 xmm10, r10
    vector.pshufd xmm10, xmm10, 0
    mov r10, 12
    vector.fromi32 xmm11, r10
    vector.pshufd xmm11, xmm11, 0
    mov r10, 13
    vector.fromi32 xmm12, r10
    vector.pshufd xmm12, xmm12, 0
    mov r10, 14
    vector.fromi32 xmm13, r10
    vector.pshufd xmm13, xmm13, 0
    mov r10, 15
    vector.fromi32 xmm14, r10
    fmov.v128 [rbp-16], xmm14
    fmov.v128 xmm15, [rbp-16]
    vector.pshufd xmm14, xmm15, 0
    fmov.v128 [rbp-32], xmm14
    mov r10, 16
    vector.fromi32 xmm14, r10
    fmov.v128 [rbp-48], xmm14
    fmov.v128 xmm15, [rbp-48]
    vector.pshufd xmm14, xmm15, 0
    fmov.v128 [rbp-64], xmm14
    mov r10, 17
    vector.fromi32 xmm14, r10
    fmov.v128 [rbp-80], xmm14
    fmov.v128 xmm15, [rbp-80]
    vector.pshufd xmm14, xmm15, 0
    fmov.v128 [rbp-96], xmm14
