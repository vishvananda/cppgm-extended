machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 305419896
    bswap.u32 r8
    zext.i32 r8
    cmp.u32 r8, 2018915346
    sete r9
    movzx r9, r9
    sitofp.u32.f64 xmm0, r8
    fptosi.f64.u32 r8, xmm0
    zext.i32 r8
    cmp.u32 r8, 2018915346
    sete r8
    movzx r8, r8
    add r9, r8
    cmp.i64 r9, 2
    sete r9
    movzx r9, r9
    cmp.i64 r9, 0
    sete r9
    movzx r9, r9
    ret r9
