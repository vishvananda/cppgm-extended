machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    mov rcx, r8
    mov rdx, 5
    mov rax, 5
    lock_xadd.i64 [rcx], rax
    add rax, rdx
    mov r9, rax
    mov rdx, 12
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    load.i64 rdi, [r8]
    mov rdx, 12
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    and r9, rdi
    sext.i1 r9
    ret r9
