extern "C" void* memcpy(void*, const void*, unsigned long);
extern "C" long host_value(long);
template<int N> long leaf(int seed) {
    volatile unsigned char bytes[N];
    long sum = 0;
    for (int i = 0; i != N; ++i) bytes[i] = (seed + i) & 255;
    for (int i = N; i != 0; --i) sum += bytes[i - 1];
    return sum;
}
long incoming(long a, long b, long c, long d, long e, long f, long g, long h) {
    volatile long value = a + b + c + d + e + f + g + h;
    return value + g + h;
}
long nonleaf(long seed) {
    volatile long value = seed;
    long other = host_value(seed);
    return value + other;
}
long copied(long* input) {
    long value = 0;
    memcpy(&value, input, sizeof(value));
    return value;
}
long expected(int n, int seed) {
    long sum = 0;
    for (int i = 0; i != n; ++i) sum += (seed + i) & 255;
    return sum;
}
int main() {
    long value = 712345;
    int bad = copied(&value) != value;
    for (int seed = 0; seed != 12; ++seed) {
        bad += leaf<1>(seed) != expected(1, seed);
        bad += leaf<96>(seed) != expected(96, seed);
        bad += leaf<112>(seed) != expected(112, seed);
        bad += leaf<128>(seed) != expected(128, seed);
        bad += leaf<160>(seed) != expected(160, seed);
        bad += nonleaf(seed) != 3 * seed + 1;
        bad += incoming(1, 2, 3, 4, 5, 6, 7, seed) != 35 + 2 * seed;
    }
    return bad != 0;
}
