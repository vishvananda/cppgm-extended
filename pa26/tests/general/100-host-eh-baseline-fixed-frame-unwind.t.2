extern int cleaned;
long through_frame(int);
int main() {
    int bad = 0;
    for (int i = 0; i != 20; ++i) {
        try {
            long value = through_frame(i);
            bad += (i & 1) != 0 || value != 1003 + i;
        } catch (int value) {
            bad += (i & 1) == 0 || value != i;
        }
        bad += cleaned != i + 1;
    }
    return bad != 0;
}
