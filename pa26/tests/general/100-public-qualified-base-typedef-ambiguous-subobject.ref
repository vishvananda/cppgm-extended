function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $object : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    store i32 0, $value
    %t1 = addr $object
    %t2 = load i32 $value
    %t3 = addr $object
    %t4 = call i32 @outer__color(%t3)
    %t5 = binary add i32 %t2, %t4
    %t6 = cmp eq i32 %t5, 3
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load i32 $cond__1
    return i32 %t7
}
function @outer__color(%this : ptr) -> i32 [binding=weak, object=_ZN5outer5colorEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=base_subobject] %t1, 0
    %t3 = index i8 [projection=base_subobject] %t2, 0
    %t4 = call i32 @impl__color(%t3)
    return i32 %t4
}
function @impl__color(%this : ptr) -> i32 [binding=weak, object=_ZN4impl5colorEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return i32 3
}
