declare function @__builtin_fill_bytes(%arg0 : ptr, %arg1 : i32, %arg2 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_fill_bytes]

function @construct_at_end(%vector : ptr, %n : i64, %value : ptr) -> void {
