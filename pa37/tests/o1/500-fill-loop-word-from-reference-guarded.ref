declare function @__builtin_fill_units(%arg0 : ptr, %arg1 : i64, %arg2 : i64, %arg3 : i64) -> ptr [unwind=no, binding=strong, object=cppgm_builtin_fill_units]

function @fill_words(%first : ptr, %n : i64, %value : ptr) -> void {
  block ^entry:
    %bytes = binary shl i64 %n, 2
    %last = index i8 %first, %bytes
    %t3 = binary ushr i64 %bytes, 2
    %t4 = index i8 %value, 4
    %t5 = cmp ule ptr %t4, %first
    %t6 = cmp uge ptr %value, %last
    %t7 = binary or i1 %t5, %t6
    %t8 = binary sub ptr %value, %first
    %t9 = binary and i64 %t8, 3
    %t10 = cmp eq i64 %t9, 0
    %t11 = binary or i1 %t7, %t10
    %t12 = cmp uge i64 %t3, 16
    %t13 = binary and i1 %t11, %t12
    branch %t13, ^__fill_fast_4, ^cond

  block ^cond:
    %p = phi ptr [^entry: %first, ^body: %next]
    %more = cmp ne ptr %p, %last
    branch %more, ^body, ^done

  block ^body:
    %v = load u32 %value
    store u32 %v, %p
    %next = index i8 %p, 4
    jump ^cond

  block ^done:
    return void

  block ^__fill_fast_4:
    %t0 = load u32 %value
    %t1 = convert zext i64 u32 %t0
    %t2 = call ptr @__builtin_fill_units(%first, %t1, %t3, 4)
    jump ^done
}
