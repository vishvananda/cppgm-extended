#include "500-virtual-base-runtime.h"
extern "C" __attribute__((noinline)) int visit_shared(Shared* p) { return p->score(); }
extern "C" __attribute__((noinline)) Shared* self_shared(Shared* p) { return p->self(); }
extern "C" __attribute__((noinline)) Right* cross_shared(Left* p) { return dynamic_cast<Right*>(p); }
extern "C" Shared* make_shared() { return new Whole; }
