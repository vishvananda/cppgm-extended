// Inspect the target ABI's complete-destructor entry and its physical result.
extern "C" void* finish_shared(Shared* p) {
 void** table = *reinterpret_cast<void***>(p);
 typedef void* (*CompleteDestructor)(Shared*);
 return reinterpret_cast<CompleteDestructor>(table[0])(p);
}
