function @checked_virtual(%object : ptr) -> u8 [linkage=c, binding=strong] {
  block ^entry:
    %t1 = load typed ptr %object
    %t2 = load typed ptr %t1
    %t3 = call ptr %t2(%object) as (%arg0 : ptr [object_bytes=8]) -> ptr [return=nonnull]
