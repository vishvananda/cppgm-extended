}
function @unchecked(%p : ptr) -> u8 [linkage=c, binding=strong] {
  block ^entry:
    %t1 = call ptr @optional(%p)
    %t2 = cmp ne ptr %t1, 0
    %t3 = convert trunc u8 i64 %t2
    return u8 %t3
}
function @checked_template(%p : ptr) -> u8 [linkage=c, binding=strong] {
