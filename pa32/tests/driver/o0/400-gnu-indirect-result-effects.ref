    copyobj 16x8 %t11, %t9
    %t12 = addr $a
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = load typed i64 %t13
    %t15 = load typed i64 $i
    %t16 = cmp ne i64 %t14, %t15
    branch %t16, ^if_then_5, ^lor_rhs_8

  block ^lor_rhs_8:
    %t17 = addr $a
    %t18 = index i8 [projection=field] %t17, 8
    %t19 = load typed i64 %t18
    %t20 = load typed i64 $i
    %t21 = binary add nowrap i64 %t20, 1
