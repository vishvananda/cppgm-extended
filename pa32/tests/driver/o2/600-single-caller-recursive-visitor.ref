    jump ^cond_end_2

  block ^cond_end_2:
    %t4 = phi u32 [^cond_then_1: %t3, ^entry: 1]
    return u32 %t4
}
function @retained(%n : u32) -> u32 [binding=internal, object=_ZL8retainedj, no_inline=yes] {
