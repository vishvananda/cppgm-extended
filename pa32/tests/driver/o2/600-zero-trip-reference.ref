function @first_or(%p : ptr, %n : i32, %r : i32) -> i32 [binding=strong, object=_Z8first_orPKiii, no_inline=yes] {
  block ^entry:
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = phi i32 [^entry: 0, ^for_body_2: %t7]
    %t2 = phi i32 [^entry: %r, ^for_body_2: %t6]
    %t3 = cmp lt i32 %t1, %n
    branch %t3, ^for_body_2, ^for_end_3

  block ^for_body_2:
    %t4 = load typed i32 %p
    %t5 = binary add nowrap i32 %t4, %t1
    %t6 = binary add nowrap i32 %t5, %t2
    %t7 = binary add nowrap i32 %t1, 1
    jump ^for_cond_1

  block ^for_end_3:
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @first_or(0, 0, 7)
    %t2 = cmp eq i32 %t1, 7
    %t3 = select i32 %t2, 0, 1
    return i32 %t3
}
