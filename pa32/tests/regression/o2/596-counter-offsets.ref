function @rows(%base : ptr, %step : i32, %row : i32, %plane : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t2 = binary add i32 %row, %plane
    jump ^body

  block ^body:
    %c = phi i32 [^entry: 0, ^body: %c1]
    %at = phi i32 [^entry: %t2, ^body: %at1]
    %t = phi i64 [^entry: 0, ^body: %t1]
    %p = index f64 %base, %at
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %at1 = binary add nowrap i32 %step, %at
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @wrapping(%base : ptr, %start : i32, %step : i32, %row : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t2 = binary add i32 %start, %row
    jump ^body

  block ^body:
    %c = phi i32 [^entry: 0, ^body: %c1]
    %at = phi i32 [^entry: %t2, ^body: %at1]
    %t = phi i64 [^entry: 0, ^body: %t1]
    %p = index f64 %base, %at
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %at1 = binary add i32 %step, %at
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @read_after(%step : i64, %row : i64, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %c = phi i64 [^entry: 0, ^body: %c1]
    %at = phi i64 [^entry: %row, ^body: %at1]
    %a = copy i64 %at
    %at1 = binary add i64 %step, %at
    %c1 = binary add i64 %c, 1
    %d = cmp lt i64 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %a
}
function @some_passes(%base : ptr, %step : i32, %row : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %c = phi i32 [^entry: 0, ^tail: %c1]
    %at = phi i32 [^entry: %row, ^tail: %at1]
    %t = phi i64 [^entry: 0, ^tail: %t1]
    %odd = binary and i32 %c, 1
    branch %odd, ^read, ^tail

  block ^read:
    %p = index f64 %base, %at
    %v = load i64 %p
    %w = binary add i64 %t, %v
    jump ^tail

  block ^tail:
    %t1 = phi i64 [^body: %t, ^read: %w]
    %at1 = binary add i32 %step, %at
    %c1 = binary add nowrap i32 %c, 1
    %d = cmp lt i32 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @tested(%base : ptr, %row : i64, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %at = phi i64 [^entry: 0, ^body: %at1]
    %t = phi i64 [^entry: 0, ^body: %t1]
    %a = binary add i64 %row, %at
    %p = index f64 %base, %a
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %at1 = binary add i64 %at, 3
    %d = cmp lt i64 %at1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @varying(%base : ptr, %step : i64, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %c = phi i64 [^entry: 0, ^body: %c1]
    %at = phi i64 [^entry: 0, ^body: %at1]
    %t = phi i64 [^entry: 0, ^body: %t1]
    %a = binary add i64 %at, %t
    %p = index f64 %base, %a
    %v = load i64 %p
    %t1 = binary add i64 %t, %v
    %at1 = binary add i64 %step, %at
    %c1 = binary add i64 %c, 1
    %d = cmp lt i64 %c1, %n
    branch %d, ^body, ^done

  block ^done:
    return i64 %t1
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
