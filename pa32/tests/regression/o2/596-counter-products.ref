declare function @use(%x : i64) -> void [linkage=c, binding=strong]

function @rows(%a : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %t1 = phi i64 [^entry: 164, ^body: %t12]
    %i = phi i64 [^entry: 1, ^body: %next]
    %s = phi i64 [^entry: 0, ^body: %sum]
    %m = copy i64 %t1
    %p = index i8 %a, %m
    %v = load i64 %p
    %q = index i8 %p, %m
    %w = load i64 %q
    %x = binary add i64 %s, %v
    %sum = binary add i64 %w, %x
    %next = binary add i64 %i, 2
    %t12 = binary add i64 %t1, 328
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return i64 %sum
}
function @down(%a : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = convert sext i64 i32 %n
    %t2 = binary mul i64 %t1, 164
    jump ^body

  block ^body:
    %t3 = phi i64 [^entry: %t2, ^body: %t12]
    %i = phi i32 [^entry: %n, ^body: %next]
    %s = phi i64 [^entry: 0, ^body: %sum]
    %w = convert sext i64 i32 %i
    %m = copy i64 %t3
    %p = index i8 %a, %m
    %v = load i64 %p
    %sum = binary add i64 %s, %v
    %next = binary sub nowrap i32 %i, 1
    %t12 = binary add i64 %t3, -164
    %c = cmp gt i32 %next, 0
    branch %c, ^body, ^done

  block ^done:
    return i64 %sum
}
function @wraps(%a : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i32 [^entry: 0, ^body: %next]
    %s = phi i64 [^entry: 0, ^body: %sum]
    %w = convert sext i64 i32 %i
    %m = binary mul i64 %w, 164
    %p = index i8 %a, %m
    %v = load i64 %p
    %sum = binary add i64 %s, %v
    %next = binary add i32 %i, 1
    %c = cmp ne i32 %n, %next
    branch %c, ^body, ^done

  block ^done:
    return i64 %sum
}
function @cheap(%a : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %s = phi i64 [^entry: 0, ^body: %sum]
    %m = binary mul i64 %i, 9
    %t = binary mul i64 %i, 8
    %x = binary add i64 %s, %m
    %sum = binary add i64 %t, %x
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return i64 %sum
}
function @calls(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %m = binary mul i64 %i, 164
    call void @use(%m)
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
