declare function @sqrt(%x : f64) -> f64 [linkage=c, binding=strong, object=sqrt]
declare function @sqrtf(%x : f32) -> f32 [linkage=c, binding=strong, object=sqrtf]

function @one(%x : f64) -> f64 [no_inline=yes] {
  block ^entry:
    %t1 = unary sqrt f64 %x
    %t2 = cmp lt f64 %x, 0
    branch %t2, ^split_2, ^split_1

  block ^split_1:
    %r = phi f64 [^entry: %t1, ^split_2: %t5]
    %s = binary add f64 %r, 1
    return f64 %s

  block ^split_2:
    %t5 = call f64 @sqrt(%x)
    jump ^split_1
}
function @narrow(%x : f32) -> f32 [no_inline=yes] {
  block ^entry:
    %t1 = unary sqrt f32 %x
    %t2 = cmp lt f32 %x, 0f
    branch %t2, ^split_2, ^split_1

  block ^split_1:
    %r = phi f32 [^entry: %t1, ^split_2: %t4]
    return f32 %r

  block ^split_2:
    %t4 = call f32 @sqrtf(%x)
    jump ^split_1
}
function @two(%x : f64, %y : f64) -> f64 [no_inline=yes] {
  block ^entry:
    %t1 = unary sqrt f64 %x
    %t2 = cmp lt f64 %x, 0
    branch %t2, ^split_3, ^split_1

  block ^split_1:
    %r = phi f64 [^entry: %t1, ^split_3: %t8]
    %t4 = unary sqrt f64 %y
    %t5 = cmp lt f64 %y, 0
    branch %t5, ^split_4, ^split_2

  block ^split_2:
    %t = phi f64 [^split_1: %t4, ^split_4: %t9]
    %s = binary add f64 %r, %t
    return f64 %s

  block ^split_3:
    %t8 = call f64 @sqrt(%x)
    jump ^split_1

  block ^split_4:
    %t9 = call f64 @sqrt(%y)
    jump ^split_2
}
function @square(%x : f64) -> f64 [no_inline=yes] {
  block ^entry:
    %m = binary mul f64 %x, %x
    %r = unary sqrt f64 %m
    return f64 %r
}
function @in_loop(%p : ptr, %q : ptr, %n : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %scale = load typed f64 %q
    jump ^loop

  block ^loop:
    %i = phi i64 [^entry: 0, ^split_2: %next]
    %sum = phi f64 [^entry: 0, ^split_2: %more]
    %at = index f64 %p, %i
    %v = load typed f64 %at
    %m = binary mul f64 %scale, %v
    %t7 = unary sqrt f64 %m
    %t8 = cmp lt f64 %m, 0
    branch %t8, ^split_4, ^split_2

  block ^split_2:
    %r = phi f64 [^loop: %t7, ^split_4: %t13]
    %more = binary add f64 %sum, %r
    %next = binary add nowrap i64 %i, 1
    %again = cmp lt i64 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return f64 %more

  block ^split_4:
    %t13 = call f64 @sqrt(%m)
    jump ^split_2
}
