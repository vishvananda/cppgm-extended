function @direct(%p : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %has = cmp gt i32 %n, 0
    branch %has, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    jump ^loop

  block ^loop:
    %t2 = phi i64 [^loop: %t7, ^loop_preheader_1: 0]
    %sum = phi i64 [^loop: %more, ^loop_preheader_1: 0]
    %at = index i64 %p, %t2
    %v = load typed i64 %at
    %more = binary add i64 %sum, %v
    %t7 = binary add nowrap i64 %t2, 1
    %next = convert trunc exact i32 i64 %t7
    %again = cmp lt i32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i64 [^entry: 0, ^loop: %more]
    return i64 %r
}
function @offsets(%p : ptr, %q : ptr, %start : i32, %k : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = convert sext i64 i32 %start
    %t2 = index i64 %p, %k
    %t3 = index i64 %q, %k
    jump ^loop

  block ^loop:
    %t4 = phi i64 [^entry: %t1, ^loop: %t21]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %at_a = index i64 %t2, %t4
    %va = load typed i64 %at_a
    %t8 = index i64 %p, %t4
    %at_b = index i64 %t8, 3
    %vb = load typed i64 %at_b
    %s1 = binary add i64 %va, %vb
    %t12 = index i64 %q, %t4
    %at_c = index i64 %t12, -1
    %vc = load typed i64 %at_c
    %t15 = index i64 %t3, %t4
    %at_d = index i64 %t15, -1
    %vd = load typed i64 %at_d
    %s2 = binary add i64 %vc, %vd
    %s3 = binary add i64 %s1, %s2
    %more = binary add i64 %sum, %s3
    %t21 = binary add nowrap i64 %t4, 1
    %next = convert trunc exact i32 i64 %t21
    %again = cmp lt i32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @next_value(%p : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %t1 = phi i64 [^entry: 0, ^loop: %t10]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %t3 = index i64 %p, %t1
    %at = index i64 %t3, 1
    %v = load typed i64 %at
    %here = index i64 %p, %t1
    %w = load typed i64 %here
    %d = binary sub i64 %v, %w
    %more = binary add i64 %sum, %d
    %t10 = binary add nowrap i64 %t1, 1
    %next = convert trunc exact i32 i64 %t10
    %again = cmp lt i32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @moving_base(%p : ptr, %k : i32, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = load typed ptr %p
    %t2 = convert sext i64 i32 %k
    jump ^loop

  block ^loop:
    %base = phi ptr [^entry: %t1, ^loop: %at]
    %t4 = phi i64 [^entry: 0, ^loop: %t10]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %t6 = binary add i64 %t4, %t2
    %at = index i64 %base, %t6
    %v = load typed i64 %at
    %more = binary add i64 %sum, %v
    store typed ptr %at, %p
    %t10 = binary add nowrap i64 %t4, 1
    %next = convert trunc exact i32 i64 %t10
    %again = cmp lt i32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @downward(%p : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = convert sext i64 i32 %n
    jump ^loop

  block ^loop:
    %t2 = phi i64 [^entry: %t1, ^loop: %t7]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %at = index i64 %p, %t2
    %v = load typed i64 %at
    %more = binary add i64 %sum, %v
    %t7 = binary sub nowrap i64 %t2, 1
    %next = convert trunc exact i32 i64 %t7
    %again = cmp ge i32 %next, 0
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @unsigned(%p : ptr, %n : u32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %t1 = phi i64 [^entry: 2, ^loop: %t6]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %at = index i64 %p, %t1
    %v = load typed i64 %at
    %more = binary add i64 %sum, %v
    %t6 = binary add nowrap i64 %t1, 2
    %next = convert trunc exact u32 i64 %t6
    %again = cmp ult u32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @also_narrow(%p : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %t1 = phi i64 [^entry: 0, ^loop: %t10]
    %sum = phi i64 [^entry: 0, ^loop: %more]
    %i = convert trunc exact i32 i64 %t1
    %at = index i64 %p, %t1
    %v = load typed i64 %at
    %d = binary div i32 %i, 3
    %w = convert sext i64 i32 %d
    %s = binary add i64 %v, %w
    %more = binary add i64 %sum, %s
    %t10 = binary add nowrap i64 %t1, 1
    %next = convert trunc exact i32 i64 %t10
    %again = cmp lt i32 %next, %n
    branch %again, ^loop, ^done

  block ^done:
    return i64 %more
}
function @nested(%p : ptr, %n : i32, %m : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^outer

  block ^outer:
    %t1 = phi i64 [^entry: 0, ^outer_next: %t12]
    %total = phi i64 [^entry: 0, ^outer_next: %sum2]
    %t3 = copy i64 %t1
    jump ^inner

  block ^inner:
    %t4 = phi i64 [^outer: %t3, ^inner: %t9]
    %sum = phi i64 [^outer: %total, ^inner: %sum2]
    %at = index i64 %p, %t4
    %v = load typed i64 %at
    %sum2 = binary add i64 %sum, %v
    %t9 = binary add nowrap i64 %t4, 1
    %j2 = convert trunc exact i32 i64 %t9
    %again = cmp lt i32 %j2, %m
    branch %again, ^inner, ^outer_next

  block ^outer_next:
    %t12 = binary add nowrap i64 %t1, 1
    %i2 = convert trunc exact i32 i64 %t12
    %more = cmp lt i32 %i2, %n
    branch %more, ^outer, ^done

  block ^done:
    return i64 %sum2
}
function @wrapping(%p : ptr, %n : i32) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^loop

  block ^loop:
    %i = phi i32 [^entry: 0, ^latch: %next]
    %sum = phi i64 [^entry: 0, ^latch: %more]
    %at = index i64 %p, %i
    %v = load typed i64 %at
    %odd = cmp eq i64 %v, 0
    branch %odd, ^done, ^latch

  block ^latch:
    %next = binary add i32 %i, 7
    %again = cmp ne i32 %n, %next
    %more = binary add i64 %sum, %v
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i64 [^loop: 0, ^latch: %more]
    return i64 %r
}
