global @cleanups : i64 = 0

function @raise(%n : i64) -> i64 [binding=strong, no_inline=yes] {
  block ^entry:
    %big = cmp ugt i64 %n, 3
    branch %big, ^throw, ^ok

  block ^throw:
    throw i64 %n

  block ^ok:
    %r = binary add i64 %n, 10
    return i64 %r
}
function @middle(%n : i64) -> i64 [binding=internal] {
  block ^entry:
    jump ^loop

  block ^loop:
    %i = phi i64 [^entry: 0, ^loop: %next]
    %sum = phi i64 [^entry: 0, ^loop: %total]
    eh_try ^cleanup_2
    %r_3 = call i64 @raise(%i)
    eh_end
    %total = binary add i64 %sum, %r_3
    %next = binary add i64 %i, 1
    %more = cmp ult i64 %next, %n
    branch %more, ^loop, ^done

  block ^cleanup_2:
    %c_7 = load i64 @cleanups
    %d_8 = binary add i64 %c_7, 1
    store i64 %d_8, @cleanups
    resume

  block ^done:
    return i64 %total
}
function @main() -> i64 [role=entry] {
  block ^entry:
    eh_try ^handler
    %x = call i64 @middle(3)
    %y = call i64 @middle(5)
    eh_end
    %z = binary add i64 %x, %y
    return i64 %z

  block ^handler:
    %e = exception i64
    %c = load i64 @cleanups
    %s = binary mul i64 %c, 100
    %t = binary add i64 %e, %s
    return i64 %t
}
