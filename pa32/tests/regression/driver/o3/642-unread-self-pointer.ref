    %t4 = index f64 [projection=array_element] %start, 2
    %t5 = load typed f64 %t4
    %t6 = index f64 [projection=array_element] %start, 3
    %t7 = load typed f64 %t6
    %t8 = cmp gt i32 %steps, 0
    branch %t8, ^loop_preheader_1, ^for_end_3

  block ^loop_preheader_1:
    %t9 = copy f64 1
    jump ^for_body_2

  block ^for_body_2:
    %t10 = phi i32 [^for_body_2: %t23, ^loop_preheader_1: 0]
    %t11 = phi f64 [^for_body_2: %t16, ^loop_preheader_1: %t1]
    %t12 = phi f64 [^for_body_2: %t18, ^loop_preheader_1: %t3]
    %t13 = phi f64 [^for_body_2: %t20, ^loop_preheader_1: %t5]
    %t14 = phi f64 [^for_body_2: %t22, ^loop_preheader_1: %t7]
    %t15 = binary mul f64 %t11, %t11
    %t16 = binary sub f64 %t15, %t9
    %t17 = binary mul f64 %t12, %t12
    %t18 = binary sub f64 %t17, %t9
    %t19 = binary mul f64 %t13, %t13
    %t20 = binary sub f64 %t19, %t9
    %t21 = binary mul f64 %t14, %t14
    %t22 = binary sub f64 %t21, %t9
    %t23 = binary add nowrap i32 %t10, 1
    %t24 = cmp lt i32 %t23, %steps
    branch %t24, ^for_body_2, ^for_end_3

  block ^for_end_3:
    %t25 = phi f64 [^entry: %t1, ^for_body_2: %t16]
    %t26 = phi f64 [^entry: %t3, ^for_body_2: %t18]
    %t27 = phi f64 [^entry: %t5, ^for_body_2: %t20]
    %t28 = phi f64 [^entry: %t7, ^for_body_2: %t22]
    %t29 = binary add f64 %t26, %t25
