function @move(%to : ptr, %from : ptr) -> void [binding=strong, object=_Z4moveP7OperandPKS_] {
  block ^entry:
    %t1 = copy nonnull ptr %to
    %t2 = copy nonnull ptr %from
    copyobj 8x4 %t2, %t1
    return void
}
function @move__ov2(%to : ptr, %from : ptr) -> void [binding=strong, object=_Z4moveP4PairPKS_] {
  block ^entry:
    %t1 = copy nonnull ptr %to
    %t2 = copy nonnull ptr %from
    %t3 = load typed u32 %t2
    store typed u32 %t3, %t1
    %t4 = index i8 [projection=field] %t2, 4
    %t5 = index i8 [projection=field] %t1, 4
    %t6 = load typed u32 %t4
    store typed u32 %t6, %t5
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
