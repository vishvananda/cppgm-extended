  block ^entry:
    %t1 = load typed u32 %from
    store typed u32 %t1, %to
    %t2 = index i8 [projection=field] %from, 4
    %t3 = index i8 [projection=field] %to, 4
    %t4 = load typed u32 %t2
    store typed u32 %t4, %t3
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
