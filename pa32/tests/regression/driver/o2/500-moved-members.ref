    %t3 = index i8 %t1, 16
    %t4 = copy nonnull ptr %t3
    store typed f64 3, %t4
    %t5 = index i8 [projection=field] %t4, 8
    store typed f64 4, %t5
    %t6 = addr $b
    jump ^for_cond_1

  block ^for_cond_1:
    %t7 = phi i64 [^entry: 0, ^for_body_2: %t20]
    %t8 = phi i64 [^entry: 0, ^for_body_2: %t19]
    %t9 = cmp lt i64 %t8, 2
    branch %t9, ^for_body_2, ^inline_cont_3

  block ^for_body_2:
    %t10 = copy i64 %t7
    %t11 = index i8 [projection=array_element] %t6, %t10
    %t12 = index i8 [projection=array_element] %t1, %t10
    %t13 = copy nonnull ptr %t11
    %t14 = copy nonnull ptr %t12
    %t15 = load typed f64 %t14
    store typed f64 %t15, %t13
    %t16 = index i8 [projection=field] %t14, 8
    %t17 = index i8 [projection=field] %t13, 8
    %t18 = load typed f64 %t16
    store typed f64 %t18, %t17
    %t19 = binary add nowrap i64 %t8, 1
    %t20 = binary add i64 %t7, 16
    jump ^for_cond_1

  block ^inline_cont_3:
    %t21 = index i8 [projection=field] %t6, 24
    %t22 = load typed f64 %t21
    %t23 = convert fptosi i32 f64 %t22
    %t24 = binary add nowrap i32 %t23, 3
