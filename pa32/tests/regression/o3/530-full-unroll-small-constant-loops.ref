declare function @touch(%value : i64) -> void [unwind=no]

global @observed : i64 = 0

function @unroll_four() -> i64 [no_inline=yes] {
  block ^entry:
    store i64 0, @observed
    store i64 1, @observed
    store i64 3, @observed
    store i64 6, @observed
    return i64 6
}
function @unroll_decrement() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 6
}
function @unroll_inverted_exit() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 4
}
function @unroll_unsigned() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 4
}
function @unroll_zero_trip() -> i64 [no_inline=yes] {
  block ^entry:
    return i64 7
}
function @keep_five_trips() -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %t1 = phi i64 [^body: %next, ^entry: 0]
    call void @touch(%t1)
    %next = binary add i64 %t1, 1
    %t3 = cmp lt i64 %next, 5
    branch %t3, ^body, ^exit

  block ^exit:
    %t4 = phi i64 [^body: %next]
    return i64 %t4
}
function @keep_branching_body(%choose : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %choose, ^body, ^loop_preheader_2

  block ^body:
    %t1 = phi i64 [^body: %next, ^entry: 0]
    call void @touch(1)
    %next = binary add i64 %t1, 1
    %t3 = cmp lt i64 %next, 2
    branch %t3, ^body, ^exit

  block ^loop_preheader_2:
    %t4 = phi i64 [^loop_preheader_2: %t5, ^entry: 0]
    call void @touch(2)
    %t5 = binary add i64 %t4, 1
    %t6 = cmp lt i64 %t5, 2
    branch %t6, ^loop_preheader_2, ^exit

  block ^exit:
    %t7 = phi i64 [^body: %next, ^loop_preheader_2: %t5]
    return i64 %t7
}
function @keep_clone_budget() -> i64 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %t1 = phi i64 [^body: %next, ^entry: 0]
    call void @touch(0)
    call void @touch(1)
    call void @touch(2)
    call void @touch(3)
    call void @touch(4)
    call void @touch(5)
    call void @touch(6)
    call void @touch(7)
    call void @touch(8)
    call void @touch(9)
    call void @touch(10)
    call void @touch(11)
    call void @touch(12)
    call void @touch(13)
    call void @touch(14)
    call void @touch(15)
    %next = binary add i64 %t1, 1
    %t3 = cmp lt i64 %next, 4
    branch %t3, ^body, ^exit

  block ^exit:
    %t4 = phi i64 [^body: %next]
    return i64 %t4
}
