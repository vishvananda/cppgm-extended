global @table : obj<320x8> = {
  zero 320
}
global @other : obj<320x8> = {
  zero 320
}

function @same_object() -> void [no_inline=yes] {
  block ^entry:
    %second = index i64 @table, 1
    jump ^body

  block ^body:
    %t2 = phi i64 [^body: %next, ^entry: 0]
    %p = index i64 @table, %t2
    store i64 1, %p
    %q = index i64 %second, %t2
    store i64 2, %q
    %next = binary add i64 %t2, 1
    %t6 = cmp lt i64 %next, 30
    branch %t6, ^body, ^done

  block ^done:
    return void
}
function @two_pointers(%a : ptr, %b : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 %a, 240
    %t2 = index i8 %b, 240
    %t3 = cmp ule ptr %t1, %b
    %t4 = cmp ule ptr %t2, %a
    %t5 = binary or i64 %t3, %t4
    branch %t5, ^loop_preheader_1, ^loop_preheader_3

  block ^loop_preheader_1:
    %t6 = vector fromi64 1
    %t7 = vector pshufd %t6, 68
    %t8 = vector fromi64 2
    %t9 = vector pshufd %t8, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t10 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t13]
    %t11 = index i64 %a, %t10
    store v128 %t7, %t11
    %t12 = index i64 %b, %t10
    store v128 %t9, %t12
    %t13 = binary add i64 %t10, 2
    %t14 = cmp lt i64 %t13, 28
    branch %t14, ^wide_loop_2, ^loop_preheader_3

  block ^loop_preheader_3:
    %t15 = phi i64 [^entry: 0, ^wide_loop_2: %t13]
    jump ^body

  block ^body:
    %t16 = phi i64 [^body: %next, ^loop_preheader_3: %t15]
    %p = index i64 %a, %t16
    store i64 1, %p
    %q = index i64 %b, %t16
    store i64 2, %q
    %next = binary add i64 %t16, 1
    %t20 = cmp lt i64 %next, 30
    branch %t20, ^body, ^done

  block ^done:
    return void
}
