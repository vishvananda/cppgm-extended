global @total : obj<8x8> = {
  zero 8
}
global @other : obj<8x8> = {
  zero 8
}
global @pair : obj<16x8> = {
  zero 16
}
global @table : obj<80x8> = {
  zero 80
}
global @values : obj<80x8> = {
  zero 80
}
global @first : i64 = 0
global @second : i64 = 0

function @opaque(%x : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %r = binary add i64 %x, 1
    return i64 %r
}
function @read(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %f = index i8 %p, 8
    %v = load i64 %f
    return i64 %v
}
function @reduction(%n : i64, %p : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    jump ^head

  block ^head:
    %t = phi i64 [^entry: %t1, ^head: %u]
    %i = phi i64 [^entry: 0, ^head: %next]
    %at = index i64 %p, %i
    %v = load typed i32 %at
    %x = convert sext i64 i32 %v
    %u = binary add i64 %x, %t
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_2

  block ^loop_exit_2:
    store typed i64 %u, @total
    return void
}
function @two_exits(%n : i64, %p : ptr, %f : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    %t2 = load i64 @other
    jump ^head

  block ^head:
    %t3 = phi i64 [^entry: %t2, ^tail: %w]
    %t = phi i64 [^entry: %t1, ^tail: %u]
    %i = phi i64 [^entry: 0, ^tail: %next]
    %at = index i32 %p, %i
    %v = load typed i32 %at
    %x = convert sext i64 i32 %v
    %u = binary add i64 %x, %t
    %w = binary xor i64 %x, %t3
    %e = cmp eq i64 %f, %x
    branch %e, ^loop_exit_3, ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_4

  block ^loop_exit_3:
    store typed i64 %w, @other
    store typed i64 %u, @total
    return i64 1

  block ^loop_exit_4:
    store typed i64 %w, @other
    store typed i64 %u, @total
    return i64 0
}
function @through_pointer(%n : i64, %s : ptr, %q : ptr, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 %s, 8
    %t2 = load i64 %t1
    %t3 = cmp ugt i64 %n, 0
    %t4 = cmp ugt i64 %n, 2
    %t5 = binary and i64 %t3, %t4
    branch %t5, ^loop_preheader_1, ^loop_preheader_3

  block ^loop_preheader_1:
    %t6 = binary add i64 %n, -2
    %t7 = vector fromf64 %v
    %t8 = vector pshufd %t7, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t9 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t13]
    %t10 = phi i64 [^loop_preheader_1: %t2, ^wide_loop_2: %t12]
    %t11 = index f64 %q, %t9
    store v128 %t8, %t11
    %t12 = binary add nowrap i64 %t10, 2
    %t13 = binary add nowrap i64 %t9, 2
    %t14 = cmp ult i64 %t13, %t6
    branch %t14, ^wide_loop_2, ^loop_preheader_3

  block ^loop_preheader_3:
    %t15 = phi i64 [^entry: 0, ^wide_loop_2: %t13]
    %t16 = phi i64 [^entry: %t2, ^wide_loop_2: %t12]
    jump ^head

  block ^head:
    %t17 = phi i64 [^loop_preheader_3: %t16, ^head: %u]
    %i = phi i64 [^loop_preheader_3: %t15, ^head: %next]
    %at = index f64 %q, %i
    store typed f64 %v, %at
    %u = binary add i64 %t17, 1
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_5

  block ^loop_exit_5:
    store typed i64 %u, %t1
    return void
}
function @nested(%n : i64, %m : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 @total
    jump ^outer

  block ^outer:
    %t2 = phi i64 [^entry: %t1, ^latch: %u]
    %i = phi i64 [^entry: 0, ^latch: %i_next]
    %t4 = cmp ugt i64 %m, 0
    %t5 = cmp ugt i64 %m, 2
    %t6 = binary and i64 %t4, %t5
    branch %t6, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t7 = binary add i64 %m, -2
    %t8 = vector fromi64 %t2
    %t9 = vector pzero
    %t10 = vector fromi64 1
    %t11 = vector punpcklqdq %t9, %t10
    %t12 = vector paddq %t9, %t11
    %t13 = vector fromi64 2
    %t14 = vector pshufd %t13, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t15 = phi v128 [^loop_preheader_2: %t8, ^wide_loop_3: %t18]
    %t16 = phi v128 [^loop_preheader_2: %t12, ^wide_loop_3: %t20]
    %t17 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t19]
    %t18 = vector paddq %t16, %t15
    %t19 = binary add nowrap i64 %t17, 2
    %t20 = vector paddq %t16, %t14
    %t21 = cmp ult i64 %t19, %t7
    branch %t21, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t22 = vector pshufd %t18, 78
    %t23 = vector paddq %t18, %t22
    %t24 = vector toi64 %t23
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t25 = phi i64 [^outer: %t2, ^loop_exit_4: %t24]
    %t26 = phi i64 [^outer: 0, ^loop_exit_4: %t19]
    jump ^inner

  block ^inner:
    %t = phi i64 [^loop_preheader_5: %t25, ^inner: %u]
    %j = phi i64 [^loop_preheader_5: %t26, ^inner: %j_next]
    %u = binary add i64 %t, %j
    %j_next = binary add i64 %j, 1
    %d = cmp ult i64 %j_next, %m
    branch %d, ^inner, ^latch

  block ^latch:
    %i_next = binary add i64 %i, 1
    %c = cmp ult i64 %i_next, %n
    branch %c, ^outer, ^loop_exit_8

  block ^loop_exit_8:
    store typed i64 %u, @total
    return void
}
function @escaped_slot(%n : i64) -> i64 [no_inline=yes] {
  slot $s : obj<16x8>

  block ^entry:
    %p = addr $s
    %f = index i8 %p, 8
    store i64 %n, %f
    %t3 = cmp ugt i64 %n, 0
    %t4 = cmp ugt i64 %n, 2
    %t5 = binary and i64 %t3, %t4
    branch %t5, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t6 = binary add i64 %n, -2
    %t7 = vector fromi64 %n
    %t8 = vector pzero
    %t9 = vector fromi64 1
    %t10 = vector punpcklqdq %t8, %t9
    %t11 = vector paddq %t8, %t10
    %t12 = vector fromi64 2
    %t13 = vector pshufd %t12, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t14 = phi v128 [^loop_preheader_1: %t7, ^wide_loop_2: %t17]
    %t15 = phi v128 [^loop_preheader_1: %t11, ^wide_loop_2: %t19]
    %t16 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t18]
    %t17 = vector paddq %t15, %t14
    %t18 = binary add nowrap i64 %t16, 2
    %t19 = vector paddq %t15, %t13
    %t20 = cmp ult i64 %t18, %t6
    branch %t20, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t21 = vector pshufd %t17, 78
    %t22 = vector paddq %t17, %t21
    %t23 = vector toi64 %t22
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t24 = phi i64 [^entry: %n, ^loop_exit_3: %t23]
    %t25 = phi i64 [^entry: 0, ^loop_exit_3: %t18]
    jump ^head

  block ^head:
    %t = phi i64 [^loop_preheader_4: %t24, ^head: %u]
    %i = phi i64 [^loop_preheader_4: %t25, ^head: %next]
    %u = binary add i64 %t, %i
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_6

  block ^loop_exit_6:
    store i64 %u, %f
    %r = call i64 @read(%p)
    return i64 %r
}
function @some_passes(%n : i64, %f : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %e = cmp eq i64 %f, %i
    branch %e, ^write, ^tail

  block ^write:
    store typed i64 %i, @total
    jump ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @exit_before_store(%n : i64, %f : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %e = cmp eq i64 %f, %i
    branch %e, ^done, ^tail

  block ^tail:
    store typed i64 %i, @total
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @call_in_loop(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    store typed i64 %i, @total
    %next = call i64 @opaque(%i)
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @volatile_in_loop(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    store typed i64 %i, @total
    %v = load volatile i64 @other
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @back_without_store(%n : i64, %f : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next, ^write: %next]
    %next = binary add i64 %i, 1
    %e = cmp eq i64 %f, %i
    branch %e, ^head, ^write

  block ^write:
    store typed i64 %i, @total
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @pointer_walk(%p : ptr, %e : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = binary sub ptr %e, %p
    %t2 = cmp ult ptr %p, %e
    %t3 = cmp uge i64 %t1, 16
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t5 = index i8 %e, -16
    %t6 = vector fromi64 1
    %t7 = vector pshufd %t6, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t8 = phi ptr [^loop_preheader_1: %p, ^wide_loop_2: %t9]
    store v128 %t7, %t8
    %t9 = index i8 %t8, 16
    %t10 = cmp ule ptr %t9, %t5
    branch %t10, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t11 = cmp ult ptr %t9, %e
    branch %t11, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t12 = phi ptr [^entry: %p, ^loop_exit_3: %t9]
    jump ^head

  block ^head:
    %at = phi ptr [^loop_preheader_4: %t12, ^head: %next]
    store typed i64 1, %at
    %next = index i64 %at, 1
    %c = cmp ne ptr %e, %next
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @may_overlap_store(%n : i64, %s : ptr, %q : ptr) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %at = index i64 %q, %i
    store typed i64 %i, %at
    store typed i64 %i, %s
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @may_overlap_load(%n : i64, %s : ptr, %q : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %r = phi i64 [^entry: 0, ^head: %t]
    %at = index i64 %q, %i
    %v = load typed i64 %at
    %t = binary add i64 %r, %v
    store typed i64 %i, %s
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return i64 %t
}
function @other_width(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %a = load i32 @pair
    %x = convert sext i64 i32 %a
    %u = binary add i64 %i, %x
    store i64 %u, @pair
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @neighbouring_field(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^loop_exit_2

  block ^loop_exit_2:
    %t4 = index i8 @pair, 8
    store i64 %next, %t4
    store i64 %i, @pair
    return void
}
function @stepped(%n : i64, %p : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp ugt i64 %n, 0
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    %t6 = vector fromi64 1
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector paddq %t5, %t7
    %t9 = vector fromi64 2
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t11 = phi v128 [^loop_preheader_1: %t8, ^wide_loop_2: %t15]
    %t12 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t14]
    %t13 = index i64 %p, %t12
    store v128 %t11, %t13
    %t14 = binary add nowrap i64 %t12, 2
    %t15 = vector paddq %t11, %t10
    %t16 = cmp ule i64 %t14, %t4
    branch %t16, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = cmp ult i64 %t14, %n
    branch %t17, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t18 = phi i64 [^entry: 0, ^loop_exit_3: %t14]
    jump ^head

  block ^head:
    %i = phi i64 [^loop_preheader_4: %t18, ^head: %next]
    %at = index i64 %p, %i
    store typed i64 %i, %at
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @large_values(%n : i64, %v : f64) -> void [no_inline=yes] {
  block ^entry:
    %e = convert fpext f80 f64 %v
    %q = call i64 @opaque(%n)
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^head: %next]
    %a = index i8 @pair, 0
    store f80 %e, %a
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^head, ^done

  block ^done:
    return void
}
function @through_unknown_step(%row : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %p = index i64 @table, %row
    %t2 = cmp gt i64 %n, 0
    %t3 = cmp ugt i64 %n, 2
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t5 = binary add i64 %n, -2
    %t6 = vector pzero
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t7 = phi v128 [^loop_preheader_1: %t6, ^wide_loop_2: %t11]
    %t8 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t12]
    %t9 = index i64 @values, %t8
    %t10 = load v128 %t9
    %t11 = vector paddq %t7, %t10
    %t12 = binary add nowrap i64 %t8, 2
    %t13 = cmp lt i64 %t12, %t5
    branch %t13, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t14 = vector pshufd %t11, 78
    %t15 = vector paddq %t11, %t14
    %t16 = vector toi64 %t15
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t17 = phi i64 [^entry: 0, ^loop_exit_3: %t16]
    %t18 = phi i64 [^entry: 0, ^loop_exit_3: %t12]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t18, ^body: %next]
    %s = phi i64 [^loop_preheader_4: %t17, ^body: %t]
    %q = index i64 @values, %i
    %v = load typed i64 %q
    %t = binary add i64 %s, %v
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^loop_exit_6

  block ^loop_exit_6:
    store typed i64 %t, %p
    return void
}
function @changing_step(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    %t6 = vector fromi64 1
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector paddq %t5, %t7
    %t9 = vector fromi64 2
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t11 = phi v128 [^loop_preheader_1: %t8, ^wide_loop_2: %t15]
    %t12 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t14]
    %t13 = index i64 @table, %t12
    store v128 %t11, %t13
    %t14 = binary add nowrap i64 %t12, 2
    %t15 = vector paddq %t11, %t10
    %t16 = cmp le i64 %t14, %t4
    branch %t16, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = cmp lt i64 %t14, %n
    branch %t17, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t18 = phi i64 [^entry: 0, ^loop_exit_3: %t14]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t18, ^body: %next]
    %p = index i64 @table, %i
    store typed i64 %i, %p
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @two_loops(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^one

  block ^one:
    %i = phi i64 [^entry: 0, ^one: %i2]
    %i2 = binary add i64 %i, 1
    %c = cmp lt i64 %i2, %n
    branch %c, ^one, ^loop_exit_2

  block ^loop_exit_2:
    store typed i64 %i, @first
    jump ^two

  block ^two:
    %j = phi i64 [^two: %j2, ^loop_exit_2: 0]
    %j2 = binary add i64 %j, 1
    %d = cmp lt i64 %j2, %n
    branch %d, ^two, ^loop_exit_4

  block ^loop_exit_4:
    store typed i64 %j, @second
    return void
}
