global @bodies : obj<112x8> = {
  zero 112
}

function @kick(%p : ptr, %i : i32, %j : i32, %dx : f64, %dy : f64) -> void [binding=strong, no_inline=yes] {
  block ^entry:
    %a = convert sext i64 i32 %i
    %b = convert sext i64 i32 %j
    %x = binary mul i64 %a, 56
    %y = binary mul i64 %b, 56
    %e = index i8 %p, %x
    %f = index i8 %p, %y
    %mass = index i8 %f, 48
    %vx = index i8 %e, 24
    %m1 = load typed f64 %mass
    %t10 = load v128 %vx
    %t11 = vector fromf64 %dx
    %t12 = vector fromf64 %dy
    %t13 = vector unpcklpd %t11, %t12
    %t14 = vector fromf64 %m1
    %t15 = vector pshufd %t14, 68
    %t16 = vector mulpd %t13, %t15
    %t17 = vector subpd %t10, %t16
    store v128 %t17, %vx
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %c = index i8 @bodies, 104
    store typed f64 2, %c
    call void @kick(@bodies, 0, 1, 3.0, 4.0)
    %q = index i8 @bodies, 24
    %r = index i8 @bodies, 32
    %a = load typed f64 %q
    %b = load typed f64 %r
    %s = binary add f64 %a, %b
    %t = convert fptosi i32 f64 %s
    return i32 %t
}
