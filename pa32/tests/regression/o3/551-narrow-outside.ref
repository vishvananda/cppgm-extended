function @byte_of_extension(%first : ptr, %count : i32, %v : i8) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp ugt i32 %count, 16
    %t3 = binary and i64 %more, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i32 %count, -16
    %t5 = vector pzero
    %t6 = convert zext i32 i8 %v
    %t7 = binary mul i32 %t6, 257
    %t8 = vector fromi32 %t7
    %t9 = vector pshuflw %t8, 0
    %t10 = vector pshufd %t9, 0
    %t11 = convert sext i64 i32 %t4
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t12 = phi v128 [^loop_preheader_2: %t5, ^wide_loop_3: %t17]
    %t13 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t18]
    %t14 = index i8 %first, %t13
    %t15 = load v128 %t14
    %t16 = vector paddb %t10, %t15
    %t17 = vector paddb %t16, %t12
    %t18 = binary add nowrap i64 %t13, 16
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp lt i64 %t18, %t11
    branch %t20, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t21 = vector pshufd %t17, 78
    %t22 = vector paddb %t17, %t21
    %t23 = vector pshufd %t22, 177
    %t24 = vector paddb %t22, %t23
    %t25 = vector psrldi %t24, 16
    %t26 = vector paddb %t24, %t25
    %t27 = vector psrlwi %t26, 8
    %t28 = vector paddb %t26, %t27
    %t29 = vector toi32 %t28
    %t30 = convert trunc i8 i32 %t29
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t31 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t30]
    %t32 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t19]
    %t33 = convert sext i64 i32 %t32
    %t34 = convert sext i64 i32 %count
    jump ^loop

  block ^loop:
    %sum = phi i8 [^loop_preheader_5: %t31, ^loop: %t40]
    %t36 = phi i64 [^loop_preheader_5: %t33, ^loop: %t41]
    %p = index i8 %first, %t36
    %x = load i8 %p
    %t39 = binary add i8 %v, %x
    %t40 = binary add i8 %sum, %t39
    %t41 = binary add nowrap i64 %t36, 1
    %again = cmp lt i64 %t41, %t34
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %t40]
    return i8 %r
}
function @byte_of_parameter(%first : ptr, %count : i32, %v : i32) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %t1 = convert trunc i8 i32 %v
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t3 = cmp ugt i32 %count, 16
    %t4 = binary and i64 %more, %t3
    branch %t4, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t5 = binary add i32 %count, -16
    %t6 = vector pzero
    %t7 = convert zext i32 i8 %t1
    %t8 = binary mul i32 %t7, 257
    %t9 = vector fromi32 %t8
    %t10 = vector pshuflw %t9, 0
    %t11 = vector pshufd %t10, 0
    %t12 = convert sext i64 i32 %t5
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t13 = phi v128 [^loop_preheader_2: %t6, ^wide_loop_3: %t18]
    %t14 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t19]
    %t15 = index i8 %first, %t14
    %t16 = load v128 %t15
    %t17 = vector paddb %t11, %t16
    %t18 = vector paddb %t17, %t13
    %t19 = binary add nowrap i64 %t14, 16
    %t20 = convert trunc i32 i64 %t19
    %t21 = cmp lt i64 %t19, %t12
    branch %t21, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t22 = vector pshufd %t18, 78
    %t23 = vector paddb %t18, %t22
    %t24 = vector pshufd %t23, 177
    %t25 = vector paddb %t23, %t24
    %t26 = vector psrldi %t25, 16
    %t27 = vector paddb %t25, %t26
    %t28 = vector psrlwi %t27, 8
    %t29 = vector paddb %t27, %t28
    %t30 = vector toi32 %t29
    %t31 = convert trunc i8 i32 %t30
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t32 = phi i8 [^loop_preheader_1: 0, ^loop_exit_4: %t31]
    %t33 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t20]
    %t34 = convert sext i64 i32 %t33
    %t35 = convert sext i64 i32 %count
    jump ^loop

  block ^loop:
    %sum = phi i8 [^loop_preheader_5: %t32, ^loop: %t41]
    %t37 = phi i64 [^loop_preheader_5: %t34, ^loop: %t42]
    %p = index i8 %first, %t37
    %x = load i8 %p
    %t40 = binary add i8 %x, %t1
    %t41 = binary add i8 %sum, %t40
    %t42 = binary add nowrap i64 %t37, 1
    %again = cmp lt i64 %t42, %t35
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %t41]
    return i8 %r
}
function @short_of_phi(%first : ptr, %count : i32, %c : i1, %v : i32, %w : i32) -> i16 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    %v2 = binary add i32 %v, 3
    %t3 = select i32 %c, %v2, %w
    %t4 = convert trunc i16 i32 %t3
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t5 = cmp ugt i32 %count, 8
    %t6 = binary and i64 %more, %t5
    branch %t6, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t7 = binary add i32 %count, -8
    %t8 = vector pzero
    %t9 = convert zext i32 i16 %t4
    %t10 = vector fromi32 %t9
    %t11 = vector pshuflw %t10, 0
    %t12 = vector pshufd %t11, 0
    %t13 = convert sext i64 i32 %t7
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t14 = phi v128 [^loop_preheader_2: %t8, ^wide_loop_3: %t19]
    %t15 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t20]
    %t16 = index i16 %first, %t15
    %t17 = load v128 %t16
    %t18 = vector pmullw %t12, %t17
    %t19 = vector paddw %t18, %t14
    %t20 = binary add nowrap i64 %t15, 8
    %t21 = convert trunc i32 i64 %t20
    %t22 = cmp lt i64 %t20, %t13
    branch %t22, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t23 = vector pshufd %t19, 78
    %t24 = vector paddw %t19, %t23
    %t25 = vector pshufd %t24, 177
    %t26 = vector paddw %t24, %t25
    %t27 = vector psrldi %t26, 16
    %t28 = vector paddw %t26, %t27
    %t29 = vector toi32 %t28
    %t30 = convert trunc i16 i32 %t29
    jump ^loop_preheader_5

  block ^loop_preheader_5:
    %t31 = phi i16 [^loop_preheader_1: 0, ^loop_exit_4: %t30]
    %t32 = phi i32 [^loop_preheader_1: 0, ^loop_exit_4: %t21]
    %t33 = convert sext i64 i32 %t32
    %t34 = convert sext i64 i32 %count
    jump ^loop

  block ^loop:
    %sum = phi i16 [^loop_preheader_5: %t31, ^loop: %t40]
    %t36 = phi i64 [^loop_preheader_5: %t33, ^loop: %t41]
    %p = index i16 %first, %t36
    %x = load typed i16 %p
    %t39 = binary mul i16 %x, %t4
    %t40 = binary add i16 %sum, %t39
    %t41 = binary add nowrap i64 %t36, 1
    %again = cmp lt i64 %t41, %t34
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i16 [^entry: 0, ^loop: %t40]
    return i16 %r
}
function @byte_shift_stays(%first : ptr, %count : i32, %v : i32) -> i8 [binding=strong, no_inline=yes] {
  block ^entry:
    %more = cmp gt i32 %count, 0
    branch %more, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = convert sext i64 i32 %count
    jump ^loop

  block ^loop:
    %sum = phi i8 [^loop_preheader_1: 0, ^loop: %next_sum]
    %t4 = phi i64 [^loop_preheader_1: 0, ^loop: %t12]
    %p = index i8 %first, %t4
    %x = load i8 %p
    %ex = convert sext i32 i8 %x
    %a = binary shr i32 %ex, %v
    %es = convert sext i32 i8 %sum
    %b = binary add nowrap i32 %a, %es
    %next_sum = convert trunc i8 i32 %b
    %t12 = binary add nowrap i64 %t4, 1
    %again = cmp lt i64 %t12, %t2
    branch %again, ^loop, ^done

  block ^done:
    %r = phi i8 [^entry: 0, ^loop: %next_sum]
    return i8 %r
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
