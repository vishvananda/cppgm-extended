global @out : obj<8192x8> = {
  zero 8192
}
global @left : obj<8192x8> = {
  zero 8192
}
global @right : obj<8192x8> = {
  zero 8192
}
global @counts : obj<4096x4> = {
  zero 4096
}
global @ints : obj<4096x4> = {
  zero 4096
}

function @product(%i : i64) -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %a = addr @left
    %b = addr @right
    %row = binary mul i64 %i, 256
    %ri = index i8 %r, %row
    %ai = index i8 %a, %row
    %t7 = vector fromf64 0
    %t8 = vector pshufd %t7, 68
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t9 = phi i64 [^entry: 0, ^wide_loop_1: %t11]
    %t10 = index f64 %ri, %t9
    store v128 %t8, %t10
    %t11 = binary add nowrap i64 %t9, 2
    %t12 = cmp le i64 %t11, 30
    branch %t12, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t13 = cmp lt i64 %t11, 32
    branch %t13, ^loop_preheader_3, ^loop_preheader_5

  block ^loop_preheader_3:
    %t14 = phi i64 [^loop_exit_2: %t11]
    jump ^for_body_4

  block ^for_body_4:
    %t15 = phi i64 [^loop_preheader_3: %t14, ^for_body_4: %t17]
    %t16 = index f64 %ri, %t15
    store typed f64 0, %t16
    %t17 = binary add i64 %t15, 1
    %t18 = cmp lt i64 %t17, 32
    branch %t18, ^for_body_4, ^loop_preheader_5

  block ^loop_preheader_5:
    jump ^terms

  block ^terms:
    %k = phi i64 [^next: %k1, ^loop_preheader_5: 0]
    %p = index f64 %ai, %k
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    %v = load typed f64 %p
    %t26 = vector fromf64 %v
    %t27 = vector pshufd %t26, 68
    jump ^wide_loop_7

  block ^wide_loop_7:
    %t28 = phi i64 [^terms: 0, ^wide_loop_7: %t35]
    %t29 = index f64 %ri, %t28
    %t30 = load v128 %t29
    %t31 = index f64 %rowk, %t28
    %t32 = load v128 %t31
    %t33 = vector mulpd %t27, %t32
    %t34 = vector addpd %t30, %t33
    store v128 %t34, %t29
    %t35 = binary add nowrap i64 %t28, 2
    %t36 = cmp le i64 %t35, 30
    branch %t36, ^wide_loop_7, ^loop_exit_8

  block ^loop_exit_8:
    %t37 = cmp lt i64 %t35, 32
    branch %t37, ^loop_preheader_9, ^next

  block ^loop_preheader_9:
    %t38 = phi i64 [^loop_exit_8: %t35]
    jump ^columns

  block ^columns:
    %j = phi i64 [^loop_preheader_9: %t38, ^columns: %j1]
    %cell = index f64 %ri, %j
    %s = load typed f64 %cell
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %m = binary mul f64 %v, %w
    %sum = binary add f64 %s, %m
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^next

  block ^next:
    %t48 = cmp lt i64 %k1, 32
    branch %t48, ^terms, ^done

  block ^done:
    return void
}
function @started() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @counts
    %b = addr @ints
    %t3 = vector fromi32 5
    %t4 = vector pshufd %t3, 0
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t5 = phi i64 [^entry: 0, ^wide_loop_1: %t7]
    %t6 = index i32 %r, %t5
    store v128 %t4, %t6
    %t7 = binary add nowrap i64 %t5, 4
    %t8 = cmp le i64 %t7, 28
    branch %t8, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t9 = cmp lt i64 %t7, 32
    branch %t9, ^loop_preheader_3, ^loop_preheader_5

  block ^loop_preheader_3:
    %t10 = phi i64 [^loop_exit_2: %t7]
    jump ^for_body_4

  block ^for_body_4:
    %t11 = phi i64 [^loop_preheader_3: %t10, ^for_body_4: %t13]
    %t12 = index i32 %r, %t11
    store typed i32 5, %t12
    %t13 = binary add i64 %t11, 1
    %t14 = cmp lt i64 %t13, 32
    branch %t14, ^for_body_4, ^loop_preheader_5

  block ^loop_preheader_5:
    jump ^terms

  block ^terms:
    %k = phi i64 [^next: %k1, ^loop_preheader_5: 0]
    %scaled = binary mul i64 %k, 128
    %rowk = index i8 %b, %scaled
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    jump ^wide_loop_7

  block ^wide_loop_7:
    %t20 = phi i64 [^wide_loop_7: %t26, ^terms: 0]
    %t21 = index i32 %r, %t20
    %t22 = load v128 %t21
    %t23 = index i32 %rowk, %t20
    %t24 = load v128 %t23
    %t25 = vector paddd %t22, %t24
    store v128 %t25, %t21
    %t26 = binary add nowrap i64 %t20, 4
    %t27 = cmp le i64 %t26, 28
    branch %t27, ^wide_loop_7, ^loop_exit_8

  block ^loop_exit_8:
    %t28 = cmp lt i64 %t26, 32
    branch %t28, ^loop_preheader_9, ^next

  block ^loop_preheader_9:
    %t29 = phi i64 [^loop_exit_8: %t26]
    jump ^columns

  block ^columns:
    %j = phi i64 [^loop_preheader_9: %t29, ^columns: %j1]
    %cell = index i32 %r, %j
    %s = load typed i32 %cell
    %q = index i32 %rowk, %j
    %w = load typed i32 %q
    %sum = binary add i32 %s, %w
    store typed i32 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^next

  block ^next:
    %t38 = cmp lt i64 %k1, 32
    branch %t38, ^terms, ^done

  block ^done:
    return void
}
function @reads_cell() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %r, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @triangle() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp le i64 %k1, %j
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @consecutive() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t5 = phi f64 [^wide_loop_2: %t14, ^columns: 0]
    %t6 = phi i64 [^wide_loop_2: %t15, ^columns: 0]
    %t7 = index f64 %b, %t6
    %t8 = load v128 %t7
    %t9 = vector mulpd %t8, %t8
    %t10 = vector tof64 %t9
    %t11 = binary add f64 %t5, %t10
    %t12 = vector pshufd %t9, 238
    %t13 = vector tof64 %t12
    %t14 = binary add f64 %t11, %t13
    %t15 = binary add nowrap i64 %t6, 2
    %t16 = cmp lt i64 %t15, 30
    branch %t16, ^wide_loop_2, ^terms

  block ^terms:
    %k = phi i64 [^terms: %k1, ^wide_loop_2: %t15]
    %s = phi f64 [^terms: %sum, ^wide_loop_2: %t14]
    %q = index f64 %b, %k
    %w = load typed f64 %q
    %m = binary mul f64 %w, %w
    %sum = binary add f64 %s, %m
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
