  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @reads_inner() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %e = binary add i64 %j, %k1
    %d = cmp lt i64 %e, 60
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @wide_read() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %twice = binary mul i64 %j, 2
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %twice
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @wide_cell() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %twice = binary mul i64 %j, 2
    %cell = index f64 %r, %twice
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
