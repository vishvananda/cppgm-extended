  block ^done:
    return void
}
function @wide_read() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    %twice = binary mul i64 %j, 2
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
