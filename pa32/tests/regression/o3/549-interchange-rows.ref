function @varied_start() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    %f = convert sitofp f64 i64 %j
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: %f, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
