global @out : obj<8192x8> = {
  zero 8192
}
global @left : obj<8192x8> = {
  zero 8192
}
global @right : obj<8192x8> = {
  zero 8192
}
global @counts : obj<4096x4> = {
  zero 4096
}
global @ints : obj<4096x4> = {
  zero 4096
}

function @product(%i : i64) -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %row = binary mul i64 %i, 256
    %ri = index i8 %r, %row
    %t4 = vector fromf64 0
    %t5 = vector pshufd %t4, 68
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t6 = phi i64 [^entry: 0, ^wide_loop_1: %t8]
    %t7 = index f64 %ri, %t6
    store v128 %t5, %t7
    %t8 = binary add nowrap i64 %t6, 2
    %t9 = cmp le i64 %t8, 30
    branch %t9, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t10 = cmp lt i64 %t8, 32
    branch %t10, ^loop_preheader_3, ^loop_preheader_5

  block ^loop_preheader_3:
    %t11 = phi i64 [^loop_exit_2: %t8]
    jump ^for_body_4

  block ^for_body_4:
    %t12 = phi i64 [^loop_preheader_3: %t11, ^for_body_4: %t14]
    %t13 = index f64 %ri, %t12
    store typed f64 0, %t13
    %t14 = binary add i64 %t12, 1
    %t15 = cmp lt i64 %t14, 32
    branch %t15, ^for_body_4, ^loop_preheader_5

  block ^loop_preheader_5:
    %a = addr @left
    %b = addr @right
    %ai = index i8 %a, %row
    jump ^terms

  block ^terms:
    %k = phi i64 [^next: %k1, ^loop_preheader_5: 0]
    %p = index f64 %ai, %k
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %v = load typed f64 %p
    %t24 = vector fromf64 %v
    %t25 = vector pshufd %t24, 68
    jump ^wide_loop_7

  block ^wide_loop_7:
    %t26 = phi i64 [^terms: 0, ^wide_loop_7: %t33]
    %t27 = index f64 %ri, %t26
    %t28 = load v128 %t27
    %t29 = index f64 %rowk, %t26
    %t30 = load v128 %t29
    %t31 = vector mulpd %t25, %t30
    %t32 = vector addpd %t28, %t31
    store v128 %t32, %t27
    %t33 = binary add nowrap i64 %t26, 2
    %t34 = cmp le i64 %t33, 30
    branch %t34, ^wide_loop_7, ^loop_exit_8

  block ^loop_exit_8:
    %t35 = cmp lt i64 %t33, 32
    branch %t35, ^loop_preheader_9, ^next

  block ^loop_preheader_9:
    %t36 = phi i64 [^loop_exit_8: %t33]
    jump ^columns

  block ^columns:
    %j = phi i64 [^loop_preheader_9: %t36, ^columns: %j1]
    %cell = index f64 %ri, %j
    %s = load typed f64 %cell
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %m = binary mul f64 %v, %w
    %sum = binary add f64 %s, %m
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^next

  block ^next:
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^done

  block ^done:
    return void
}
function @started() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @counts
    %t2 = vector fromi32 5
    %t3 = vector pshufd %t2, 0
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t4 = phi i64 [^entry: 0, ^wide_loop_1: %t6]
    %t5 = index i32 %r, %t4
    store v128 %t3, %t5
    %t6 = binary add nowrap i64 %t4, 4
    %t7 = cmp le i64 %t6, 28
    branch %t7, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t8 = cmp lt i64 %t6, 32
    branch %t8, ^loop_preheader_3, ^loop_preheader_5

  block ^loop_preheader_3:
    %t9 = phi i64 [^loop_exit_2: %t6]
    jump ^for_body_4

  block ^for_body_4:
    %t10 = phi i64 [^loop_preheader_3: %t9, ^for_body_4: %t12]
    %t11 = index i32 %r, %t10
    store typed i32 5, %t11
    %t12 = binary add i64 %t10, 1
    %t13 = cmp lt i64 %t12, 32
    branch %t13, ^for_body_4, ^loop_preheader_5

  block ^loop_preheader_5:
    %b = addr @ints
    jump ^terms

  block ^terms:
    %k = phi i64 [^next: %k1, ^loop_preheader_5: 0]
    %scaled = binary mul i64 %k, 128
    %rowk = index i8 %b, %scaled
    jump ^wide_loop_7

  block ^wide_loop_7:
    %t18 = phi i64 [^wide_loop_7: %t24, ^terms: 0]
    %t19 = index i32 %r, %t18
    %t20 = load v128 %t19
    %t21 = index i32 %rowk, %t18
    %t22 = load v128 %t21
    %t23 = vector paddd %t20, %t22
    store v128 %t23, %t19
    %t24 = binary add nowrap i64 %t18, 4
    %t25 = cmp le i64 %t24, 28
    branch %t25, ^wide_loop_7, ^loop_exit_8

  block ^loop_exit_8:
    %t26 = cmp lt i64 %t24, 32
    branch %t26, ^loop_preheader_9, ^next

  block ^loop_preheader_9:
    %t27 = phi i64 [^loop_exit_8: %t24]
    jump ^columns

  block ^columns:
    %j = phi i64 [^loop_preheader_9: %t27, ^columns: %j1]
    %cell = index i32 %r, %j
    %s = load typed i32 %cell
    %q = index i32 %rowk, %j
    %w = load typed i32 %q
    %sum = binary add i32 %s, %w
    store typed i32 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^next

  block ^next:
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^done

  block ^done:
    return void
}
function @reads_cell() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %r, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @triangle() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp le i64 %k1, %j
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @consecutive() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t4 = phi f64 [^wide_loop_2: %t13, ^columns: 0]
    %t5 = phi i64 [^wide_loop_2: %t14, ^columns: 0]
    %t6 = index f64 %b, %t5
    %t7 = load v128 %t6
    %t8 = vector mulpd %t7, %t7
    %t9 = vector tof64 %t8
    %t10 = binary add f64 %t4, %t9
    %t11 = vector pshufd %t8, 238
    %t12 = vector tof64 %t11
    %t13 = binary add f64 %t10, %t12
    %t14 = binary add nowrap i64 %t5, 2
    %t15 = cmp lt i64 %t14, 30
    branch %t15, ^wide_loop_2, ^terms

  block ^terms:
    %k = phi i64 [^terms: %k1, ^wide_loop_2: %t14]
    %s = phi f64 [^terms: %sum, ^wide_loop_2: %t13]
    %q = index f64 %b, %k
    %w = load typed f64 %q
    %m = binary mul f64 %w, %w
    %sum = binary add f64 %s, %m
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    %cell = index f64 %r, %j
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @from_outer() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: %j, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
