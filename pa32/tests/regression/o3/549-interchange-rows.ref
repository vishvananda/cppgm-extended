global @out : obj<8192x8> = {
  zero 8192
}
global @left : obj<8192x8> = {
  zero 8192
}
global @right : obj<8192x8> = {
  zero 8192
}
global @counts : obj<4096x4> = {
  zero 4096
}
global @ints : obj<4096x4> = {
  zero 4096
}

function @product(%i : i64) -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %a = addr @left
    %b = addr @right
    %row = binary mul i64 %i, 256
    %ri = index i8 %r, %row
    %ai = index i8 %a, %row
    %t7 = vector fromf64 0
    %t8 = vector pshufd %t7, 68
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t9 = phi i64 [^entry: 0, ^wide_loop_1: %t11]
    %t10 = index f64 %ri, %t9
    store v128 %t8, %t10
    %t11 = binary add i64 %t9, 2
    %t12 = cmp lt i64 %t11, 30
    branch %t12, ^wide_loop_1, ^loop_preheader_2

  block ^loop_preheader_2:
    %t13 = phi i64 [^wide_loop_1: %t11]
    jump ^for_body_3

  block ^for_body_3:
    %t14 = phi i64 [^loop_preheader_2: %t13, ^for_body_3: %t16]
    %t15 = index f64 %ri, %t14
    %t16 = binary add i64 %t14, 1
    %t17 = cmp lt i64 %t16, 32
    store typed f64 0, %t15
    branch %t17, ^for_body_3, ^loop_preheader_4

  block ^loop_preheader_4:
    jump ^terms

  block ^terms:
    %k = phi i64 [^loop_preheader_4: 0, ^next: %k1]
    %p = index f64 %ai, %k
    %v = load typed f64 %p
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %k1 = binary add i64 %k, 1
    %t24 = vector fromf64 %v
    %t25 = vector pshufd %t24, 68
    jump ^wide_loop_6

  block ^wide_loop_6:
    %t26 = phi i64 [^terms: 0, ^wide_loop_6: %t33]
    %t27 = index f64 %ri, %t26
    %t28 = load v128 %t27
    %t29 = index f64 %rowk, %t26
    %t30 = load v128 %t29
    %t31 = vector mulpd %t25, %t30
    %t32 = vector addpd %t28, %t31
    store v128 %t32, %t27
    %t33 = binary add i64 %t26, 2
    %t34 = cmp lt i64 %t33, 30
    branch %t34, ^wide_loop_6, ^loop_preheader_7

  block ^loop_preheader_7:
    %t35 = phi i64 [^wide_loop_6: %t33]
    jump ^columns

  block ^columns:
    %j = phi i64 [^loop_preheader_7: %t35, ^columns: %j1]
    %cell = index f64 %ri, %j
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    %s = load typed f64 %cell
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %m = binary mul f64 %v, %w
    %sum = binary add f64 %s, %m
    %c = cmp lt i64 %k1, 32
    store typed f64 %sum, %cell
    branch %d, ^columns, ^next

  block ^next:
    %t46 = cmp lt i64 %k1, 32
    branch %t46, ^terms, ^done

  block ^done:
    return void
}
function @started() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @counts
    %b = addr @ints
    %t3 = vector fromi32 5
    %t4 = vector pshufd %t3, 0
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t5 = phi i64 [^entry: 0, ^wide_loop_1: %t7]
    %t6 = index i32 %r, %t5
    store v128 %t4, %t6
    %t7 = binary add i64 %t5, 4
    %t8 = cmp lt i64 %t7, 28
    branch %t8, ^wide_loop_1, ^loop_preheader_2

  block ^loop_preheader_2:
    %t9 = phi i64 [^wide_loop_1: %t7]
    jump ^for_body_3

  block ^for_body_3:
    %t10 = phi i64 [^loop_preheader_2: %t9, ^for_body_3: %t12]
    %t11 = index i32 %r, %t10
    %t12 = binary add i64 %t10, 1
    %t13 = cmp lt i64 %t12, 32
    store typed i32 5, %t11
    branch %t13, ^for_body_3, ^loop_preheader_4

  block ^loop_preheader_4:
    jump ^terms

  block ^terms:
    %k = phi i64 [^loop_preheader_4: 0, ^next: %k1]
    %scaled = binary mul i64 %k, 128
    %rowk = index i8 %b, %scaled
    %k1 = binary add i64 %k, 1
    jump ^wide_loop_6

  block ^wide_loop_6:
    %t18 = phi i64 [^wide_loop_6: %t24, ^terms: 0]
    %t19 = index i32 %r, %t18
    %t20 = load v128 %t19
    %t21 = index i32 %rowk, %t18
    %t22 = load v128 %t21
    %t23 = vector paddd %t20, %t22
    store v128 %t23, %t19
    %t24 = binary add i64 %t18, 4
    %t25 = cmp lt i64 %t24, 28
    branch %t25, ^wide_loop_6, ^columns

  block ^columns:
    %j = phi i64 [^columns: %j1, ^wide_loop_6: %t24]
    %cell = index i32 %r, %j
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    %s = load typed i32 %cell
    %q = index i32 %rowk, %j
    %w = load typed i32 %q
    %sum = binary add i32 %s, %w
    %c = cmp lt i64 %k1, 32
    store typed i32 %sum, %cell
    branch %d, ^columns, ^next

  block ^next:
    %t35 = cmp lt i64 %k1, 32
    branch %t35, ^terms, ^done

  block ^done:
    return void
}
function @reads_cell() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %r, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @triangle() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^terms

  block ^terms:
    %k = phi i64 [^columns: 0, ^terms: %k1]
    %s = phi f64 [^columns: 0, ^terms: %sum]
    %scaled = binary mul i64 %k, 256
    %rowk = index i8 %b, %scaled
    %q = index f64 %rowk, %j
    %w = load typed f64 %q
    %sum = binary add f64 %s, %w
    %k1 = binary add i64 %k, 1
    %c = cmp le i64 %k1, %j
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
function @consecutive() -> void [no_inline=yes] {
  block ^entry:
    %r = addr @out
    %b = addr @right
    jump ^columns

  block ^columns:
    %j = phi i64 [^entry: 0, ^next: %j1]
    %cell = index f64 %r, %j
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t5 = phi f64 [^wide_loop_2: %t14, ^columns: 0]
    %t6 = phi i64 [^wide_loop_2: %t15, ^columns: 0]
    %t7 = index f64 %b, %t6
    %t8 = load v128 %t7
    %t9 = vector mulpd %t8, %t8
    %t10 = vector tof64 %t9
    %t11 = binary add f64 %t5, %t10
    %t12 = vector pshufd %t9, 238
    %t13 = vector tof64 %t12
    %t14 = binary add f64 %t11, %t13
    %t15 = binary add i64 %t6, 2
    %t16 = cmp lt i64 %t15, 30
    branch %t16, ^wide_loop_2, ^terms

  block ^terms:
    %k = phi i64 [^terms: %k1, ^wide_loop_2: %t15]
    %s = phi f64 [^terms: %sum, ^wide_loop_2: %t14]
    %q = index f64 %b, %k
    %w = load typed f64 %q
    %m = binary mul f64 %w, %w
    %sum = binary add f64 %s, %m
    %k1 = binary add i64 %k, 1
    %c = cmp lt i64 %k1, 32
    branch %c, ^terms, ^next

  block ^next:
    store typed f64 %sum, %cell
    %j1 = binary add i64 %j, 1
    %d = cmp lt i64 %j1, 32
    branch %d, ^columns, ^done

  block ^done:
    return void
}
