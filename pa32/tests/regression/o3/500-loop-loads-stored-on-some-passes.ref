global @best : i32 = 0
global @limit : i32 = 40

function @scan() -> i32 [no_inline=yes] {
  block ^entry:
    %t1 = load i32 @best
    %n = load i32 @limit
    jump ^head

  block ^head:
    %b = phi i32 [^entry: %t1, ^keep: %b, ^raise: %v]
    %i = phi i32 [^entry: 0, ^keep: %j, ^raise: %j]
    %count = phi i32 [^entry: 0, ^keep: %count, ^raise: %more]
    %m = binary mul i32 %i, 7919
    %a = binary add i32 %m, 13
    %v = binary mod i32 %a, 1000
    %j = binary add i32 %i, 1
    %up = cmp gt i32 %v, %b
    branch %up, ^raise, ^keep

  block ^raise:
    store i32 %v, @best
    %more = binary add i32 %count, 1
    %go = cmp lt i32 %j, %n
    branch %go, ^head, ^done

  block ^keep:
    %on = cmp lt i32 %j, %n
    branch %on, ^head, ^done

  block ^done:
    %c = phi i32 [^raise: %more, ^keep: %count]
    return i32 %c
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %c = call i32 @scan()
    %b = load i32 @best
    %s = binary mul i32 %c, 1000
    %r = binary add i32 %b, %s
    %w = binary mod i32 %r, 251
    return i32 %w
}
