function @two_blocks(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^tail: %next]
    %o = index i32 %d, %i
    %v = load typed i32 %o
    branch %v, ^then, ^tail

  block ^then:
    store typed i32 0, %o
    jump ^tail

  block ^tail:
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @select_i64(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %t = cmp lt i64 %v, 5
    %r = select i64 %t, %v, 5
    %o = index i64 %d, %i
    store typed i64 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @moving_bound(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %b = phi i64 [^entry: %n, ^body: %b2]
    %o = index i32 %d, %i
    store typed i32 1, %o
    %b2 = binary sub i64 %b, 1
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %b2
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @wrapping_index(%d : ptr, %n : i64, %s : i32) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %j = phi i32 [^entry: %s, ^body: %j2]
    %w = convert sext i64 i32 %j
    %o = index i32 %d, %w
    store typed i32 1, %o
    %j2 = binary add i32 %j, 1
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @wrapping_step(%d : ptr, %n : i32) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i32 [^entry: 0, ^body: %next]
    %a = binary add i32 %i, 2
    %w = convert sext i64 i32 %a
    %o = index i32 %d, %w
    store typed i32 1, %o
    %next = binary add nowrap i32 %i, 1
