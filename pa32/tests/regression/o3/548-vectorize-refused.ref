  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %p = index u32 %x, %i
    %v = load typed u32 %p
    %w = convert uitofp f32 u32 %v
    %o = index f32 %d, %i
    store typed f32 %w, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
