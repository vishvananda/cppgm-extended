function @second_counter(%d : ptr, %n : i64, %s : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -4
    %t5 = vector fromi32 1
    %t6 = vector pshufd %t5, 0
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t7 = phi i64 [^loop_preheader_1: %s, ^wide_loop_2: %t11]
    %t8 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t10]
    %t9 = index i32 %d, %t7
    store v128 %t6, %t9
    %t10 = binary add nowrap i64 %t8, 4
    %t11 = binary add nowrap i64 %t7, 4
    %t12 = cmp le i64 %t10, %t4
    branch %t12, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t13 = cmp lt i64 %t10, %n
    branch %t13, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t14 = phi i64 [^entry: %s, ^loop_exit_3: %t11]
    %t15 = phi i64 [^entry: 0, ^loop_exit_3: %t10]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t15, ^body: %next]
    %j = phi i64 [^loop_preheader_4: %t14, ^body: %j2]
    %o = index i32 %d, %j
    store typed i32 1, %o
    %j2 = binary add i64 %j, 1
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @step_after_widening(%d : ptr, %n : i32) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i32 %n, 0
    %t2 = cmp uge i32 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i32 %n, -4
    %t5 = vector fromi32 1
    %t6 = vector pshufd %t5, 0
    %t7 = convert sext i64 i32 %t4
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t8 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t12]
    %t9 = copy i64 %t8
    %t10 = binary add i64 %t9, 2
    %t11 = index i32 %d, %t10
    store v128 %t6, %t11
    %t12 = binary add nowrap i64 %t8, 4
    %t13 = convert trunc i32 i64 %t12
    %t14 = cmp le i64 %t12, %t7
    branch %t14, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t15 = cmp lt i32 %t13, %n
    branch %t15, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t16 = phi i32 [^entry: 0, ^loop_exit_3: %t13]
    %t17 = convert sext i64 i32 %t16
    %t18 = convert sext i64 i32 %n
    jump ^body

  block ^body:
    %t19 = phi i64 [^loop_preheader_4: %t17, ^body: %t23]
    %w = copy i64 %t19
    %a = binary add i64 %w, 2
    %o = index i32 %d, %a
    store typed i32 1, %o
    %t23 = binary add nowrap i64 %t19, 1
    %c = cmp lt i64 %t23, %t18
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @counter_by_two(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %j = phi i64 [^entry: 0, ^body: %j2]
    %p = index i32 %d, %j
    store typed i32 1, %p
    %j2 = binary add i64 %j, 1
    %next = binary add i64 %i, 2
    %c = cmp ne i64 %n, %next
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
