declare function @touch(%x : i32) -> void [unwind=no]

global @shared : i32 = 0

function @counter_as_data(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -4
    %t5 = vector fromi64 8589934592
    %t6 = vector fromi64 25769803780
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector fromi32 3
    %t9 = vector pshufd %t8, 0
    %t10 = vector paddd %t9, %t7
    %t11 = vector fromi32 7
    %t12 = vector pshufd %t11, 0
    %t13 = vector fromi32 8
    %t14 = vector pshufd %t13, 0
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t15 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t28]
    %t16 = phi v128 [^loop_preheader_1: %t10, ^wide_loop_2: %t27]
    %t17 = phi i32 [^loop_preheader_1: 3, ^wide_loop_2: %t26]
    %t18 = vector pmuludq %t16, %t12
    %t19 = vector psrlqi %t16, 32
    %t20 = vector psrlqi %t12, 32
    %t21 = vector pmuludq %t19, %t20
    %t22 = vector pshufd %t18, 8
    %t23 = vector pshufd %t21, 8
    %t24 = vector punpckldq %t22, %t23
    %t25 = index i32 %d, %t15
    store v128 %t24, %t25
    %t26 = binary add nowrap i32 %t17, 8
    %t27 = vector paddd %t16, %t14
    %t28 = binary add nowrap i64 %t15, 4
    %t29 = cmp le i64 %t28, %t4
    branch %t29, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t30 = cmp lt i64 %t28, %n
    branch %t30, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t31 = phi i64 [^entry: 0, ^loop_exit_3: %t28]
    %t32 = phi i32 [^entry: 3, ^loop_exit_3: %t26]
    %t33 = binary mul i32 %t32, 7
    jump ^body

  block ^body:
    %t34 = phi i32 [^loop_preheader_4: %t33, ^body: %t38]
    %j = phi i64 [^loop_preheader_4: %t31, ^body: %j2]
    %m = copy i32 %t34
    %o = index i32 %d, %j
    store typed i32 %m, %o
    %t38 = binary add i32 %t34, 14
    %j2 = binary add i64 %j, 1
    %c = cmp lt i64 %j2, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @long_counter_as_data(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 2
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -2
    %t5 = vector pzero
    %t6 = vector fromi64 1
    %t7 = vector punpcklqdq %t5, %t6
    %t8 = vector paddq %t5, %t7
    %t9 = vector fromi64 2
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t11 = phi v128 [^loop_preheader_1: %t8, ^wide_loop_2: %t15]
    %t12 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t14]
    %t13 = index i64 %d, %t12
    store v128 %t11, %t13
    %t14 = binary add nowrap i64 %t12, 2
    %t15 = vector paddq %t11, %t10
    %t16 = cmp le i64 %t14, %t4
    branch %t16, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = cmp lt i64 %t14, %n
    branch %t17, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t18 = phi i64 [^entry: 0, ^loop_exit_3: %t14]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t18, ^body: %next]
    %o = index i64 %d, %i
    store typed i64 %i, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @calls(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %o = index i32 %d, %i
    %v = load typed i32 %o
    call void @touch(%v)
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @volatile_load(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %o = index i32 %d, %i
    %v = load volatile i32 %o
    %r = binary add i32 %v, 1
    store typed i32 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @strided(%d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %j = binary mul i64 %i, 2
    %o = index i32 %d, %j
    store typed i32 1, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @gather(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %q = index i32 %d, %v
    store typed i32 1, %q
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @from_long(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %w = convert sitofp f64 i64 %v
    %o = index f64 %d, %i
    store typed f64 %w, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
