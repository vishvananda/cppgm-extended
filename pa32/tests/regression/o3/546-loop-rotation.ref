declare function @touch(%value : i64) -> void [unwind=no]

global @last : i64 = 0

function @count_down(%n : i32) -> void [no_inline=yes] {
  block ^entry:
    %next = binary sub nowrap i32 %n, 1
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = load i64 @last
    jump ^body

  block ^body:
    %t3 = phi i64 [^body: %w, ^loop_preheader_1: %t2]
    %t4 = phi i32 [^body: %t6, ^loop_preheader_1: %next]
    %w = binary mul i64 %t3, 3
    %t6 = binary sub nowrap i32 %t4, 1
    branch %t4, ^body, ^loop_exit_3

  block ^loop_exit_3:
    store typed i64 %w, @last
    jump ^done

  block ^done:
    return void
}
function @only_calls(%n : i64) -> void [no_inline=yes] {
  block ^entry:
    %c = cmp gt i64 %n, 0
    branch %c, ^body, ^done

  block ^body:
    %t2 = phi i64 [^body: %next, ^entry: 0]
    call void @touch(%t2)
    %next = binary add i64 %t2, 1
    %t4 = cmp lt i64 %next, %n
    branch %t4, ^body, ^done

  block ^done:
    return void
}
function @literal_guard(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %t1 = vector pzero
    jump ^wide_loop_1

  block ^wide_loop_1:
    %t2 = phi v128 [^entry: %t1, ^wide_loop_1: %t6]
    %t3 = phi i64 [^entry: 0, ^wide_loop_1: %t7]
    %t4 = index i64 %p, %t3
    %t5 = load v128 %t4
    %t6 = vector paddq %t5, %t2
    %t7 = binary add i64 %t3, 2
    %t8 = cmp lt i64 %t7, 998
    branch %t8, ^wide_loop_1, ^loop_exit_2

  block ^loop_exit_2:
    %t9 = vector pshufd %t6, 78
    %t10 = vector paddq %t6, %t9
    %t11 = vector toi64 %t10
    jump ^body

  block ^body:
    %t12 = phi i64 [^body: %t, ^loop_exit_2: %t11]
    %t13 = phi i64 [^body: %next, ^loop_exit_2: %t7]
    %q = index i64 %p, %t13
    %v = load i64 %q
    %t = binary add i64 %v, %t12
    %next = binary add i64 %t13, 1
    %t18 = cmp lt i64 %next, 1000
    branch %t18, ^body, ^done

  block ^done:
    return i64 %t
}
function @swap(%n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    jump ^header

  block ^header:
    %a = phi i64 [^entry: 1, ^body: %b]
    %b = phi i64 [^entry: 2, ^body: %a]
    %i = phi i64 [^entry: 0, ^body: %next]
    %c = cmp lt i64 %i, %n
    branch %c, ^body, ^done

  block ^body:
    call void @touch(%a)
    %next = binary add i64 %i, 1
    jump ^header

  block ^done:
    return i64 %b
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
