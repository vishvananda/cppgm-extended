    %t21 = index i8 %t14, 16
    %t22 = cmp ge i32 %t19, 4
    branch %t22, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t23 = cmp gt i32 %t19, 0
    branch %t23, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t24 = phi ptr [^entry: %d, ^loop_preheader_1: %d, ^loop_exit_4: %t21]
    %t25 = phi ptr [^entry: %x, ^loop_preheader_1: %x, ^loop_exit_4: %t20]
    %t26 = phi i32 [^entry: %n, ^loop_preheader_1: %n, ^loop_exit_4: %t19]
    jump ^body

  block ^body:
    %i = phi i32 [^loop_preheader_5: %t26, ^body: %next]
    %a = phi ptr [^loop_preheader_5: %t25, ^body: %a2]
    %b = phi ptr [^loop_preheader_5: %t24, ^body: %b2]
    %v = load typed i32 %a
    %r = binary add i32 %v, 1
    store typed i32 %r, %b
    %a2 = index i32 %a, 1
    %b2 = index i32 %b, 1
    %next = binary sub nowrap i32 %i, 1
    branch %next, ^body, ^done

  block ^done:
    return void
}
function @pointer_counter(%d : ptr, %e : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = binary sub ptr %e, %d
    %t2 = cmp ult ptr %d, %e
    %t3 = cmp uge ptr %t1, 16
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t5 = index i8 %e, -16
    %t6 = vector fromi32 1
    %t7 = vector pshufd %t6, 0
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t8 = phi ptr [^loop_preheader_1: %d, ^wide_loop_2: %t11]
    %t9 = load v128 %t8
    %t10 = vector paddd %t9, %t7
    store v128 %t10, %t8
    %t11 = index i8 %t8, 16
    %t12 = cmp ule ptr %t11, %t5
    branch %t12, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t13 = cmp ult ptr %t11, %e
    branch %t13, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t14 = phi ptr [^entry: %d, ^loop_exit_3: %t11]
    jump ^body

  block ^body:
    %p = phi ptr [^loop_preheader_4: %t14, ^body: %q]
    %v = load typed i32 %p
    %r = binary add i32 %v, 1
    store typed i32 %r, %p
    %q = index i32 %p, 1
    %c = cmp ne ptr %e, %q
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @step_two(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %p = index i32 %x, %i
    %v = load typed i32 %p
    %r = binary add i32 %v, 1
    %o = index i32 %d, %i
    store typed i32 %r, %o
    %next = binary add i64 %i, 2
    %c = cmp ne i64 %n, %next
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
