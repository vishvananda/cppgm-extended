}
function @running(%d : ptr, %x : ptr, %n : i64) -> i32 [no_inline=yes] {
  block ^entry:
    jump ^body

  block ^body:
    %i = phi i64 [^entry: 0, ^body: %next]
    %s = phi i32 [^entry: 0, ^body: %sum]
    %p = index i32 %x, %i
    %a = load i32 %p
    %sum = binary add i32 %s, %a
    %u = binary add i32 %sum, 1
    %o = index i32 %d, %i
    store i32 %u, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return i32 %sum
}
