function @add_bytes(%d : ptr, %x : ptr, %y : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 16
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = index i8 %x, %n
    %t5 = index i8 %d, %n
    %t6 = cmp ule ptr %t4, %d
    %t7 = cmp ule ptr %t5, %x
    %t8 = binary or i64 %t6, %t7
    %t9 = index i8 %y, %n
    %t10 = cmp ule ptr %t9, %d
    %t11 = cmp ule ptr %t5, %y
    %t12 = binary or i64 %t10, %t11
    %t13 = binary and i64 %t8, %t12
    branch %t13, ^loop_preheader_2, ^loop_preheader_4

  block ^loop_preheader_2:
    %t14 = binary add i64 %n, -16
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t15 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t22]
    %t16 = index u8 %x, %t15
    %t17 = load v128 %t16
    %t18 = index u8 %y, %t15
    %t19 = load v128 %t18
    %t20 = vector paddb %t17, %t19
    %t21 = index u8 %d, %t15
    store v128 %t20, %t21
    %t22 = binary add i64 %t15, 16
    %t23 = cmp lt i64 %t22, %t14
    branch %t23, ^wide_loop_3, ^loop_preheader_4

  block ^loop_preheader_4:
    %t24 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^wide_loop_3: %t22]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t24, ^body: %next]
    %p = index u8 %x, %i
    %a = load u8 %p
    %q = index u8 %y, %i
    %b = load u8 %q
    %t = binary add u8 %a, %b
    %o = index u8 %d, %i
    store u8 %t, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @sum_bytes(%x : ptr, %n : i64) -> i8 [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 16
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -16
    %t5 = vector fromi32 253
    %t6 = vector fromi32 2570
    %t7 = vector pshuflw %t6, 0
    %t8 = vector pshufd %t7, 0
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t9 = phi v128 [^loop_preheader_1: %t5, ^wide_loop_2: %t14]
    %t10 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t15]
    %t11 = index i8 %x, %t10
    %t12 = load v128 %t11
    %t13 = vector pand %t12, %t8
    %t14 = vector paddb %t13, %t9
    %t15 = binary add i64 %t10, 16
    %t16 = cmp lt i64 %t15, %t4
    branch %t16, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = vector pshufd %t14, 78
    %t18 = vector paddb %t14, %t17
    %t19 = vector pshufd %t18, 177
    %t20 = vector paddb %t18, %t19
    %t21 = vector psrldi %t20, 16
    %t22 = vector paddb %t20, %t21
    %t23 = vector psrlwi %t22, 8
    %t24 = vector paddb %t22, %t23
    %t25 = vector toi32 %t24
    %t26 = convert trunc i8 i32 %t25
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t27 = phi i8 [^entry: -3, ^loop_exit_3: %t26]
    %t28 = phi i64 [^entry: 0, ^loop_exit_3: %t15]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t28, ^body: %next]
    %s = phi i8 [^loop_preheader_4: %t27, ^body: %t34]
    %p = index i8 %x, %i
    %a = load i8 %p
    %t33 = binary and i8 %a, 10
    %t34 = binary add i8 %s, %t33
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return i8 %t34
}
function @sum_shorts(%x : ptr, %n : i64) -> u16 [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 8
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = binary add i64 %n, -8
    %t5 = vector fromi32 7
    %t6 = vector fromi32 3
    %t7 = vector pshuflw %t6, 0
    %t8 = vector pshufd %t7, 0
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t9 = phi v128 [^loop_preheader_1: %t5, ^wide_loop_2: %t14]
    %t10 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t15]
    %t11 = index u16 %x, %t10
    %t12 = load v128 %t11
    %t13 = vector pmullw %t12, %t8
    %t14 = vector paddw %t13, %t9
    %t15 = binary add i64 %t10, 8
    %t16 = cmp lt i64 %t15, %t4
    branch %t16, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t17 = vector pshufd %t14, 78
    %t18 = vector paddw %t14, %t17
    %t19 = vector pshufd %t18, 177
    %t20 = vector paddw %t18, %t19
    %t21 = vector psrldi %t20, 16
    %t22 = vector paddw %t20, %t21
    %t23 = vector toi32 %t22
    %t24 = convert trunc u16 i32 %t23
    jump ^loop_preheader_4

  block ^loop_preheader_4:
    %t25 = phi u16 [^entry: 7, ^loop_exit_3: %t24]
    %t26 = phi i64 [^entry: 0, ^loop_exit_3: %t15]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t26, ^body: %next]
    %s = phi u16 [^loop_preheader_4: %t25, ^body: %t32]
    %p = index u16 %x, %i
    %a = load typed u16 %p
    %t31 = binary mul u16 %a, 3
    %t32 = binary add u16 %s, %t31
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
