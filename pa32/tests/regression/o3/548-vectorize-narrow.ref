}
function @mul_bytes(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = index i8 %x, %n
    %t5 = index i8 %d, %n
    %t6 = cmp ule ptr %t4, %d
    %t7 = cmp ule ptr %t5, %x
    %t8 = binary or i64 %t6, %t7
    branch %t8, ^loop_preheader_2, ^loop_preheader_4

  block ^loop_preheader_2:
    %t9 = binary add i64 %n, -4
    %t10 = vector pzero
    %t11 = vector fromi32 3
    %t12 = vector pshufd %t11, 0
    %t13 = vector fromi32 255
    %t14 = vector pshuflw %t13, 0
    %t15 = vector pshufd %t14, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t16 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t36]
    %t17 = index u8 %x, %t16
    %t18 = load i32 %t17
    %t19 = vector fromi32 %t18
    %t20 = vector punpcklbw %t19, %t10
    %t21 = vector punpcklwd %t20, %t10
    %t22 = vector pmuludq %t21, %t12
    %t23 = vector psrlqi %t21, 32
    %t24 = vector psrlqi %t12, 32
    %t25 = vector pmuludq %t23, %t24
    %t26 = vector pshufd %t22, 8
    %t27 = vector pshufd %t25, 8
    %t28 = vector punpckldq %t26, %t27
    %t29 = vector pslldi %t28, 16
    %t30 = vector psradi %t29, 16
    %t31 = vector packssdw %t30, %t30
    %t32 = vector pand %t31, %t15
    %t33 = vector packuswb %t32, %t32
    %t34 = index u8 %d, %t16
    %t35 = vector toi32 %t33
    store i32 %t35, %t34
    %t36 = binary add i64 %t16, 4
    %t37 = cmp lt i64 %t36, %t9
    branch %t37, ^wide_loop_3, ^loop_preheader_4

  block ^loop_preheader_4:
    %t38 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^wide_loop_3: %t36]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t38, ^body: %next]
    %p = index u8 %x, %i
    %a = load u8 %p
    %w = convert zext i32 u8 %a
    %m = binary mul i32 %w, 3
    %t = convert trunc u8 i32 %m
    %o = index u8 %d, %i
    store u8 %t, %o
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @both(%d : ptr, %e : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp ugt i64 %n, 4
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t4 = index i8 %x, %n
    %t5 = binary mul i64 %n, 4
    %t6 = index i8 %e, %t5
    %t7 = cmp ule ptr %t4, %e
    %t8 = cmp ule ptr %t6, %x
    %t9 = binary or i64 %t7, %t8
    %t10 = index i8 %d, %n
    %t11 = cmp ule ptr %t4, %d
    %t12 = cmp ule ptr %t10, %x
    %t13 = binary or i64 %t11, %t12
    %t14 = binary and i64 %t9, %t13
    %t15 = cmp ule ptr %t6, %d
    %t16 = cmp ule ptr %t10, %e
    %t17 = binary or i64 %t15, %t16
    %t18 = binary and i64 %t14, %t17
    branch %t18, ^loop_preheader_2, ^loop_preheader_4

  block ^loop_preheader_2:
    %t19 = binary add i64 %n, -4
    %t20 = vector pzero
    %t21 = vector fromi32 300
    %t22 = vector pshufd %t21, 0
    %t23 = vector fromi32 11308
    %t24 = vector pshuflw %t23, 0
    %t25 = vector pshufd %t24, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t26 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t37]
    %t27 = index u8 %x, %t26
    %t28 = load i32 %t27
    %t29 = vector fromi32 %t28
    %t30 = vector punpcklbw %t29, %t20
    %t31 = vector punpcklwd %t30, %t20
    %t32 = vector paddd %t31, %t22
    %t33 = index i32 %e, %t26
    store v128 %t32, %t33
    %t34 = vector paddb %t29, %t25
    %t35 = index u8 %d, %t26
    %t36 = vector toi32 %t34
    store i32 %t36, %t35
    %t37 = binary add i64 %t26, 4
    %t38 = cmp lt i64 %t37, %t19
    branch %t38, ^wide_loop_3, ^loop_preheader_4

  block ^loop_preheader_4:
    %t39 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^wide_loop_3: %t37]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t39, ^body: %next]
    %p = index u8 %x, %i
    %a = load u8 %p
    %w = convert zext i32 u8 %a
    %s = binary add i32 %w, 300
    %o = index i32 %e, %i
    store i32 %s, %o
    %t = binary add u8 %a, 44
    %q = index u8 %d, %i
    store u8 %t, %q
    %next = binary add i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @other_sign(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
