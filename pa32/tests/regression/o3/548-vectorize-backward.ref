    branch %t16, ^wide_loop_1, ^loop_preheader_2

  block ^loop_preheader_2:
    %t17 = phi i32 [^entry: %first, ^wide_loop_1: %t15]
    jump ^body

  block ^body:
    %i = phi i32 [^loop_preheader_2: %t17, ^body: %next]
