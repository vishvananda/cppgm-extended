# budget from 500-optional-payload-select.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 5
blocks <= 4
count(call) <= 3
count(load) <= 3
count(store) <= 3
count(phi) <= 3
instructions <= 5 in @select

# outcomes from 500-optional-payload-select.ref: what the course solution removed stays removed (a call inlined, memory promoted, a definition pruned)
none(load)
none(store)
none(phi)
none(zeroinit)
