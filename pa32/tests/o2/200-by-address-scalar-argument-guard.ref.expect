# budget generated by scripts/make_ir_expect.pl from 200-by-address-scalar-argument-guard.ref at 10% tolerance
instructions <= 71
blocks <= 11
count(call) <= 11
count(load) <= 9
count(store) <= 15
count(phi) <= 1
instructions <= 4 in @read_i64
instructions <= 6 in @bump_i64
instructions <= 4 in @read_i32
instructions <= 4 in @read_f64
instructions <= 6 in @difference
instructions <= 11 in @known_on_edge
instructions <= 45 in @main

# outcome lines derived by scripts/make_ir_outcome.pl: what the course solution removed stays removed
none(call @plus_one)
absent(@plus_one)

# A scalar temporary passed to a by_address parameter stands for storage
# holding its value: the call passes that storage's address, never the
# value as a literal, and no load reads through a literal address.
none(/\bcall\b.*[(,] *-?[0-9]/)
none(/\bload\b \S+ -?[0-9]/)
