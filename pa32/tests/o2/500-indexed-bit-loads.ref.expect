# Bound repeated address/choice work without fixing an instruction sequence.
count(load) <= 1 in @shifted
count(load) <= 1 in @inverted
count(load) <= 1 in @high_bit
count(branch) <= 0 in @shifted
count(branch) <= 0 in @inverted
count(branch) <= 0 in @high_bit
instructions <= 16 in @shifted
instructions <= 16 in @inverted
instructions <= 16 in @high_bit
