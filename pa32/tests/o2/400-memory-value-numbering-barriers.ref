declare function @may_throw() -> void

global @value : i64 = 3

function @atomic_barrier() -> i64 {
  block ^entry:
    %before = load i64 @value
    %address = addr @value
    %observed = atomic_load i64 %address, 5
    %sum1 = binary add i64 %before, %observed
    %after = load i64 @value
    %sum2 = binary add i64 %after, %sum1
    return i64 %sum2
}
function @exception_region() -> i64 {
  block ^entry:
    eh_try ^cleanup
    %before = load i64 @value
    %sum = binary add i64 %before, %before
    call void @may_throw()
    eh_end
    return i64 %sum

  block ^cleanup:
    resume
}
